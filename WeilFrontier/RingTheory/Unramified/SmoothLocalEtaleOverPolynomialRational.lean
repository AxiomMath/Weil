module

public import Weil.Attr
public import WeilFrontier.Defs.AlgebraicGeometry.Etale.Morphisms.EtaleLocalHom
public import WeilFrontier.Defs.RingTheory.Smooth.Locus
public import Mathlib.RingTheory.Unramified.LocalStructure

/-!
# Smooth local homomorphisms with trivial residue field extension

Let `A → B` be a smooth local homomorphism of noetherian local rings, i.e. `B` is the
localization of a smooth `A`-algebra at a prime ideal. If the residue field extension
`κ(A) → κ(B)` is trivial, then there are `x₁, …, x_r ∈ 𝔪_B` such that the `A`-algebra map
`ψ : A[T₁, …, T_r] → B`, `T_ν ↦ x_ν`, pulls `𝔪_B` back to the ideal `(𝔪_A, T₁, …, T_r)`, and the
induced local homomorphism `A[T₁, …, T_r]_{(𝔪_A, T₁, …, T_r)} → B` is local-étale.

The proof starts from the local structure of smooth algebras: after inverting an element outside
the prime, a smooth algebra is standard étale over a polynomial ring
(`Algebra.IsSmoothAt.exists_isStandardEtale_mvPolynomial`). This gives elements `x_ν ∈ B` for
which the localized map is local-étale (`Algebra.isEtaleAt_iff_isEtaleLocalHom`). Since the
residue field extension is trivial, there are `a_ν ∈ A` with `x_ν - a_ν ∈ 𝔪_B`; composing with the
automorphism `T_ν ↦ T_ν - a_ν` of the polynomial ring replaces `x_ν` by `x_ν - a_ν`.

## Main results

* `Algebra.IsSmoothLocalization.exists_mvPolynomial_isEtaleLocalHom_of_surjective_residueField`:
  the statement above.

## Implementation notes

The hypothesis on residue fields is surjectivity of `κ(A) → κ(B)`; a homomorphism of fields is
injective, so this is the same as `κ(A) → κ(B)` being an isomorphism. The induced homomorphism of
the localization is given as a local ring homomorphism `φ` from the localization of
`A[T₁, …, T_r]` at `ψ⁻¹(𝔪_B)` with `φ ∘ (A[T] → A[T]_{ψ⁻¹(𝔪_B)}) = ψ`, which determines it.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FK88], I.7
-/

@[expose] public section

universe u v

open MvPolynomial IsLocalRing

namespace Algebra.IsSmoothLocalization

/-- A polynomial minus its constant term lies in the ideal generated by the variables. -/
private theorem sub_C_constantCoeff_mem_span_range_X {R σ : Type*} [CommRing R]
    (F : MvPolynomial σ R) :
    F - C (constantCoeff F) ∈ Ideal.span (Set.range (X : σ → MvPolynomial σ R)) := by
  induction F using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
    have := add_mem hp hq
    rwa [map_add, map_add, add_sub_add_comm]
  | mul_X p i _ =>
    simpa using Ideal.mul_mem_left _ p (Ideal.subset_span (Set.mem_range_self i))

/-- The local-étale statement for an étale homomorphism `g : A[T] → D` and a localization
`B ≅ D_q`. -/
private theorem exists_isEtaleLocalHom_of_etale {A : Type u} {B : Type v} [CommRing A]
    [CommRing B] [Algebra A B] [IsNoetherianRing A] [IsNoetherianRing B] [IsLocalRing B]
    {n : ℕ} {D : Type u} [CommRing D] [Algebra A D]
    (g : MvPolynomial (Fin n) A →+* D) (hg : g.Etale) (hgA : g.comp C = algebraMap A D)
    (q : Ideal D) [q.IsPrime] (e : Localization.AtPrime q ≃ₐ[A] B) :
    ∃ (φ : Localization.AtPrime ((maximalIdeal B).comap
        (aeval fun i => e (algebraMap D _ (g (X i))) : MvPolynomial (Fin n) A →ₐ[A] B).toRingHom)
          →+* B) (_ : IsLocalHom φ),
      φ.comp (algebraMap (MvPolynomial (Fin n) A) _) =
          (aeval fun i => e (algebraMap D _ (g (X i))) :
            MvPolynomial (Fin n) A →ₐ[A] B).toRingHom ∧
        φ.IsEtaleLocalHom := by
  set ψ₀ : MvPolynomial (Fin n) A →+* B :=
    (e.toRingEquiv : Localization.AtPrime q →+* B).comp ((algebraMap D _).comp g) with hψ₀
  have hψ : (aeval fun i => e (algebraMap D _ (g (X i))) :
      MvPolynomial (Fin n) A →ₐ[A] B).toRingHom = ψ₀ := by
    apply MvPolynomial.ringHom_ext
    · intro a
      have h1 : g (C a) = algebraMap A D a := by rw [← hgA]; rfl
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, aeval_C, hψ₀, RingHom.coe_comp,
        Function.comp_apply, h1, AlgEquiv.coe_ringEquiv]
      rw [← IsScalarTower.algebraMap_apply, AlgEquiv.commutes]
    · intro i
      simp [hψ₀]
  rw [hψ]
  have hcomap : (maximalIdeal B).comap ψ₀ = q.comap g := by
    rw [hψ₀, ← Ideal.comap_comap, ← Ideal.comap_comap,
      maximalIdeal_comap]
    exact congrArg (Ideal.comap g) Localization.AtPrime.under_maximalIdeal
  let := g.toAlgebra
  have : Algebra.Etale (MvPolynomial (Fin n) A) D := hg
  have : q.LiesOver ((maximalIdeal B).comap ψ₀) := ⟨hcomap⟩
  have H := (Algebra.isEtaleAt_iff_isEtaleLocalHom ((maximalIdeal B).comap ψ₀) q).1
    inferInstance
  let φ₀ := Localization.localRingHom ((maximalIdeal B).comap ψ₀) q
    (algebraMap (MvPolynomial (Fin n) A) D) Ideal.LiesOver.over
  refine ⟨(e.toRingEquiv : Localization.AtPrime q →+* B).comp φ₀, inferInstance, ?_, ?_⟩
  · ext a
    · simp [φ₀, Localization.localRingHom_to_map, hψ₀, RingHom.algebraMap_toAlgebra]
    · simp [φ₀, Localization.localRingHom_to_map, hψ₀, RingHom.algebraMap_toAlgebra]
  · obtain ⟨h₁, h₂, h₃⟩ := H
    refine ⟨h₁.comp (RingHom.Flat.of_bijective e.bijective),
      h₂.comp (RingHom.FormallyUnramified.of_surjective e.surjective),
      h₃.comp (RingHom.FiniteType.of_surjective _ e.surjective).essFiniteType⟩

/-- Let `A → B` be a smooth local homomorphism of noetherian local rings whose residue field
extension `κ(A) → κ(B)` is trivial. Then there are `r` and `x₁, …, x_r ∈ 𝔪_B` such that, for
`ψ : A[T₁, …, T_r] → B`, `T_ν ↦ x_ν`, one has `ψ⁻¹(𝔪_B) = (𝔪_A, T₁, …, T_r)` and the induced
homomorphism `φ : A[T₁, …, T_r]_{ψ⁻¹(𝔪_B)} → B` is local-étale. -/
@[weil "lem_fk107_smooth_local_etale_over_polynomial_rational"]
theorem exists_mvPolynomial_isEtaleLocalHom_of_surjective_residueField
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    [IsNoetherianRing A] [IsNoetherianRing B] [IsLocalRing A] [IsLocalRing B]
    [IsLocalHom (algebraMap A B)] (h : Algebra.IsSmoothLocalization A B)
    (hk : Function.Surjective (algebraMap (ResidueField A) (ResidueField B))) :
    ∃ (r : ℕ) (x : Fin r → B), (∀ i, x i ∈ maximalIdeal B) ∧
      (maximalIdeal B).comap (aeval x : MvPolynomial (Fin r) A →ₐ[A] B).toRingHom =
        Ideal.span (Set.range X) ⊔ (maximalIdeal A).map C ∧
      ∃ (φ : Localization.AtPrime ((maximalIdeal B).comap
          (aeval x : MvPolynomial (Fin r) A →ₐ[A] B).toRingHom) →+* B) (_ : IsLocalHom φ),
        φ.comp (algebraMap (MvPolynomial (Fin r) A) _) =
          (aeval x : MvPolynomial (Fin r) A →ₐ[A] B).toRingHom ∧ φ.IsEtaleLocalHom := by
  obtain ⟨C', _, _, _, q, _, ⟨e⟩⟩ := h
  obtain ⟨f, hf, n, _, _, _⟩ :=
    Algebra.IsSmoothAt.exists_isStandardEtale_mvPolynomial (R := A) (p := q)
  -- `B` is the localization of `D = C'_f` at the prime `q'` above `q`.
  let D := Localization.Away f
  have hd : Disjoint (Submonoid.powers f : Set C') q := by
    rw [Set.disjoint_left]
    rintro _ ⟨k, rfl⟩ hk
    exact hf (‹q.IsPrime›.mem_of_pow_mem k hk)
  let q' : Ideal D := q.map (algebraMap C' D)
  have : q'.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f) D q ‹_› hd
  have hcomap : q'.comap (algebraMap C' D) = q :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f) D ‹_› hd
  have hloc : IsLocalization.AtPrime (Localization.AtPrime q') q := by
    have := IsLocalization.isLocalization_atPrime_localization_atPrime (Submonoid.powers f) q'
    have hM : (q'.comap (algebraMap C' D)).primeCompl = q.primeCompl := by
      ext x
      simp [Ideal.primeCompl, hcomap]
    change IsLocalization q.primeCompl _
    rw [← hM]
    exact this
  let f₀ : Localization.AtPrime q ≃ₐ[C'] Localization.AtPrime q' :=
    IsLocalization.algEquiv q.primeCompl _ _
  let e' : Localization.AtPrime q' ≃ₐ[A] B := (f₀.restrictScalars A).symm.trans e
  -- The étale map `g : A[T] → D` and the elements `x_ν`.
  let g : MvPolynomial (Fin n) A →+* D := algebraMap _ D
  have hg : g.Etale := RingHom.etale_algebraMap.mpr inferInstance
  have hgA : g.comp C = algebraMap A D := (IsScalarTower.algebraMap_eq _ _ _).symm
  let x : Fin n → B := fun i => e' (algebraMap D _ (g (X i)))
  have hres (i : Fin n) : ∃ a : A, x i - algebraMap A B a ∈ maximalIdeal B := by
    obtain ⟨b, hb⟩ := hk (residue B (x i))
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
    refine ⟨a, ?_⟩
    rw [← Ideal.Quotient.eq]
    exact hb.symm
  choose a ha using hres
  -- The translation `T_ν ↦ T_ν - a_ν`.
  let τ : MvPolynomial (Fin n) A →ₐ[A] MvPolynomial (Fin n) A := aeval fun i => X i - C (a i)
  let τ' : MvPolynomial (Fin n) A →ₐ[A] MvPolynomial (Fin n) A := aeval fun i => X i + C (a i)
  have hττ' : τ.comp τ' = AlgHom.id A _ := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [τ, τ']
  have hτ'τ : τ'.comp τ = AlgHom.id A _ := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [τ, τ']
  have hτ : Function.Bijective τ :=
    ⟨Function.LeftInverse.injective (g := τ') fun F => by
        simpa using congrArg (fun φ => φ F) hτ'τ,
      Function.RightInverse.surjective (g := τ') fun F => by
        simpa using congrArg (fun φ => φ F) hττ'⟩
  let g' : MvPolynomial (Fin n) A →+* D := g.comp τ.toRingHom
  have hg' : g'.Etale := RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective hτ) hg
  have hgA' : g'.comp C = algebraMap A D := by
    rw [← hgA]
    ext a
    simp [g']
  obtain ⟨φ, hφ, hφψ, hφe⟩ := exists_isEtaleLocalHom_of_etale g' hg' hgA' q' e'
  let x' : Fin n → B := fun i => e' (algebraMap D _ (g' (X i)))
  have hx'x (i : Fin n) : x' i = x i - algebraMap A B (a i) := by
    have h1 : g (C (a i)) = algebraMap A D (a i) := by rw [← hgA]; rfl
    simp only [x', g', RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
      RingHom.coe_coe, τ, aeval_X, map_sub, h1, x]
    congr 1
    exact (congrArg e' (IsScalarTower.algebraMap_apply A D _ (a i)).symm).trans (e'.commutes _)
  have hmem (i : Fin n) : x' i ∈ maximalIdeal B := hx'x i ▸ ha i
  have hspan : Ideal.span (Set.range X) ≤
      (maximalIdeal B).comap (aeval x' : MvPolynomial (Fin n) A →ₐ[A] B).toRingHom := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    simpa using hmem i
  have hC (c : A) : (aeval x' : MvPolynomial (Fin n) A →ₐ[A] B).toRingHom (C c) ∈
      maximalIdeal B ↔ c ∈ maximalIdeal A := by
    rw [← maximalIdeal_comap (algebraMap A B), Ideal.mem_comap]
    simp
  refine ⟨n, x', hmem, le_antisymm ?_ (sup_le hspan ?_), φ, hφ, hφψ, hφe⟩
  · intro F hF
    have h1 := sub_C_constantCoeff_mem_span_range_X F
    have h2 : C (constantCoeff F) ∈ (maximalIdeal B).comap
        (aeval x' : MvPolynomial (Fin n) A →ₐ[A] B).toRingHom := by
      have := Ideal.sub_mem _ hF (hspan h1)
      rwa [sub_sub_cancel] at this
    rw [Ideal.mem_comap, hC] at h2
    rw [← sub_add_cancel F (C (constantCoeff F))]
    exact Ideal.add_mem _ (Ideal.mem_sup_left h1)
      (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ h2))
  · rw [Ideal.map_le_iff_le_comap]
    intro c hc
    rw [Ideal.mem_comap, Ideal.mem_comap]
    exact (hC c).2 hc

end Algebra.IsSmoothLocalization
