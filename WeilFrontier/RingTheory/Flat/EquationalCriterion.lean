module

public import Weil.Attr
public import Mathlib.RingTheory.Flat.EquationalCriterion
public import Mathlib.Algebra.Module.Torsion.Basic
public import Mathlib.Data.ZMod.Basic
public import StacksFrontier.Algebra.Module.Injective.ZModPrimePower

/-!
# Torsion of flat modules over `ℤ/lⁿ⁺¹ℤ`

Let `l ≠ 0` and `Λₙ = ℤ/lⁿ⁺¹ℤ`. In `Λₙ` the annihilator of `lᵏ` is the ideal generated by
`lⁿ⁺¹⁻ᵏ` for `k ≤ n + 1`. Flatness of a `Λₙ`-module `P` makes every relation in `P` trivial, so
the elements of `P` killed by `lᵏ` are exactly the multiples of `lⁿ⁺¹⁻ᵏ`:
`P[lᵏ] = lⁿ⁺¹⁻ᵏ P`.

## Main results

* `ZMod.exists_eq_pow_mul_of_pow_mul_eq_zero`: in `ℤ/lⁿ⁺¹ℤ`, `lᵏ y = 0` implies
  `y ∈ lⁿ⁺¹⁻ᵏ (ℤ/lⁿ⁺¹ℤ)`.
* `Module.Flat.torsionBy_pow_eq_pow_smul_top`: for a flat `ℤ/lⁿ⁺¹ℤ`-module `P` and `k ≤ n + 1`,
  `P[lᵏ] = lⁿ⁺¹⁻ᵏ P`.
* `Module.Flat.isPowExact_zmod`: the same statement in the form
  `Stacks.ZModPrimePower.IsPowExact`.

## Implementation notes

The source proves the identity by computing `Tor₁(P, Λₙ/lᵏ)` from a periodic free resolution;
here the equational criterion for flatness is used instead, applied to the single relation
`lᵏ • x = 0`. The prime `l` of the source is generalised to any nonzero natural number.

## References

* [FK] E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, I.12.
-/

@[expose] public section

open scoped Pointwise

/-- In `ℤ/lⁿ⁺¹ℤ`, an element killed by `lᵏ` (with `k ≤ n + 1`) is a multiple of `lⁿ⁺¹⁻ᵏ`. -/
theorem ZMod.exists_eq_pow_mul_of_pow_mul_eq_zero {l n k : ℕ} (hl : l ≠ 0) (hk : k ≤ n + 1)
    {y : ZMod (l ^ (n + 1))} (hy : (l : ZMod (l ^ (n + 1))) ^ k * y = 0) :
    ∃ c : ZMod (l ^ (n + 1)), y = (l : ZMod (l ^ (n + 1))) ^ (n + 1 - k) * c := by
  have : NeZero (l ^ (n + 1)) := ⟨pow_ne_zero _ hl⟩
  have hsplit : l ^ (n + 1) = l ^ k * l ^ (n + 1 - k) := by
    rw [← pow_add, Nat.add_sub_cancel' hk]
  have hdvd : l ^ k * l ^ (n + 1 - k) ∣ l ^ k * y.val := by
    rw [← hsplit]
    refine (ZMod.natCast_eq_zero_iff _ _).1 ?_
    push_cast
    simpa [ZMod.natCast_zmod_val] using hy
  obtain ⟨c, hc⟩ := Nat.dvd_of_mul_dvd_mul_left (pow_pos (Nat.pos_of_ne_zero hl) k) hdvd
  refine ⟨c, ?_⟩
  rw [← ZMod.natCast_zmod_val y, hc]
  push_cast
  rfl

namespace Module.Flat

variable {l n k : ℕ} {P : Type*} [AddCommGroup P] [Module (ZMod (l ^ (n + 1))) P]

/-- **Torsion of a flat `ℤ/lⁿ⁺¹ℤ`-module.** For a flat `ℤ/lⁿ⁺¹ℤ`-module `P` and `k ≤ n + 1`,
the `lᵏ`-torsion of `P` is `lⁿ⁺¹⁻ᵏ P`. -/
@[weil "lem_fk112_flat_lambda_torsion_identity"]
theorem torsionBy_pow_eq_pow_smul_top [Module.Flat (ZMod (l ^ (n + 1))) P] (hl : l ≠ 0)
    (hk : k ≤ n + 1) :
    Submodule.torsionBy (ZMod (l ^ (n + 1))) P ((l : ZMod (l ^ (n + 1))) ^ k) =
      ((l : ZMod (l ^ (n + 1))) ^ (n + 1 - k)) • (⊤ : Submodule (ZMod (l ^ (n + 1))) P) := by
  set R := ZMod (l ^ (n + 1))
  apply le_antisymm
  · intro x hx
    rw [Submodule.mem_torsionBy_iff] at hx
    obtain ⟨m, a, y, hxy, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
      (ι := Fin 1) (f := fun _ => (l : R) ^ k) (x := fun _ => x) (by simpa using hx)
    have hc : ∀ j, ∃ c : R, a 0 j = (l : R) ^ (n + 1 - k) * c := fun j =>
      ZMod.exists_eq_pow_mul_of_pow_mul_eq_zero hl hk (by simpa using ha j)
    choose c hc using hc
    have hx' : x = (l : R) ^ (n + 1 - k) • ∑ j, c j • y j := by
      refine (hxy 0).trans ?_
      rw [Finset.smul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [hc j, mul_smul]
    rw [hx']
    exact Submodule.smul_mem_pointwise_smul _ _ _ Submodule.mem_top
  · rintro x hx
    obtain ⟨z, -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 hx
    rw [Submodule.mem_torsionBy_iff, ← mul_smul, ← pow_add, Nat.add_sub_cancel' hk]
    have : ((l : R) ^ (n + 1)) = 0 := by
      rw [← Nat.cast_pow, ZMod.natCast_self]
    rw [this, zero_smul]

/-- A flat `ℤ/lⁿ⁺¹ℤ`-module has the exactness property `Stacks.ZModPrimePower.IsPowExact`. -/
theorem isPowExact_zmod [Module.Flat (ZMod (l ^ (n + 1))) P] (hl : l ≠ 0) :
    Stacks.ZModPrimePower.IsPowExact l (n + 1) P := by
  intro a ha x hx
  have hx' : x ∈ Submodule.torsionBy (ZMod (l ^ (n + 1))) P ((l : ZMod (l ^ (n + 1))) ^ a) := by
    rw [Submodule.mem_torsionBy_iff, ← Nat.cast_pow, Nat.cast_smul_eq_nsmul]
    exact hx
  rw [torsionBy_pow_eq_pow_smul_top hl ha] at hx'
  obtain ⟨y, -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 hx'
  exact ⟨y, by rw [← Nat.cast_pow, Nat.cast_smul_eq_nsmul]⟩

end Module.Flat
