module

public import Weil.Attr
public import WeilFrontier.Defs.RingTheory.Henselian.Henselization.HenselianPolynomialRing
public import WeilFrontier.Defs.RingTheory.Henselian.Henselization.SmoothStrictlyHenselianAlgebra
public import WeilFrontier.RingTheory.Flat.FiniteFreeResidueExtension
public import WeilFrontier.RingTheory.Henselian.Henselization.SmoothStrictlyHenselianAlgebra
public import WeilFrontier.RingTheory.Unramified.SmoothLocalEtaleOverPolynomialRational
public import WeilFrontier.RingTheory.Henselian.Henselization.LocalEtaleOverPolynomialStrictHenselization

/-!
# Structure of sh-smooth algebras with algebraic residue extension

Let `A → B` be a local homomorphism of local rings, with `A` noetherian and strictly Henselian,
such that `B` is sh-smooth over `A` and the residue field `κ(B)` is algebraic over `κ(A)`. Then
there are `n ≥ 0` and a local `A`-algebra `A₁`, finite and free as an `A`-module, with `A → A₁`
local and `κ(A₁)` purely inseparable over `κ(A)`, such that `A₁ ⊗[A] B` is `A₁`-isomorphic to the
Henselization `A₁{T₁, …, T_n}` of the polynomial ring `A₁[T]` at the origin.

The field `κ(B)` is finite and purely inseparable over `κ(A)`, and `A₁` is chosen with
`κ(A₁) ≅ κ(B)` over `κ(A)`. The ring `B₁ = A₁ ⊗[A] B` is strictly Henselian, local over `A₁` and
sh-smooth over `A₁`. Its residue field is generated by the images of `κ(A₁)` and `κ(B)`, and these
two images agree: two `κ(A)`-embeddings of a purely inseparable extension into a field coincide.
So `κ(A₁) → κ(B₁)` is an isomorphism. Writing `B₁` as the Henselization of a local, essentially
smooth `A₁`-algebra `C` along a map to a separably closed field, the residue extension of
`A₁ → C` is trivial, so `C` is local-étale over `A₁[T]_{𝔭₀}`, `𝔭₀ = (𝔪(A₁), T)`; the
Henselization of `C` is then one of `A₁[T]_{𝔭₀}`, and since `κ(𝔭₀) = κ(A₁)` is separably closed it
is `A₁{T}`.

## Main results

* `Algebra.IsShSmooth.exists_tensorProduct_algEquiv_isHenselianPolynomialRing`: the statement
  above.

## Implementation notes

The tensor product is written `A₁ ⊗[A] B`, so that its `A₁`-algebra structure is the standard
one; it is isomorphic to the source's `B ⊗[A] A₁`. The ring `A₁{T}` is given as a local
`A₁[T]_{𝔭₀}`-algebra `H` satisfying `MvPolynomial.IsHenselianPolynomialRing`, which determines it
up to unique isomorphism. The ring `B` is only assumed local (the source assumes it strictly
Henselian). The ring `A` is assumed noetherian, the standing hypothesis of the source.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FK88], I.7
-/

/- The two intermediate lemmas
(finite base change residue, same residue field) are proved here as private helpers. -/

@[expose] public section

open IsLocalRing TensorProduct

universe u v

namespace Algebra.IsShSmooth

/-- Let `A → B` be local, `A₁` a local `A`-algebra finite over `A` with `κ(A₁)` purely
inseparable over `κ(A)` and `κ(A₁) ≅ κ(B)` over `κ(A)`. If `A₁ ⊗[A] B` is local, the map
`κ(A₁) → κ(A₁ ⊗[A] B)` is surjective. -/
private theorem surjective_residueField_tensorProduct {A A₁ : Type u} {B : Type v} [CommRing A]
    [IsLocalRing A] [CommRing A₁] [IsLocalRing A₁] [Algebra A A₁] [IsLocalHom (algebraMap A A₁)]
    [Module.Finite A A₁] [CommRing B] [IsLocalRing B] [Algebra A B]
    [IsLocalHom (algebraMap A B)] [IsPurelyInseparable (ResidueField A) (ResidueField A₁)]
    [IsLocalRing (A₁ ⊗[A] B)] [IsLocalHom (algebraMap A₁ (A₁ ⊗[A] B))]
    (σ : ResidueField A₁ ≃ₐ[ResidueField A] ResidueField B) :
    Function.Surjective (algebraMap (ResidueField A₁) (ResidueField (A₁ ⊗[A] B))) := by
  have : IsLocalHom (Algebra.TensorProduct.includeRight : B →ₐ[A] A₁ ⊗[A] B).toRingHom :=
    Algebra.TensorProduct.isLocalHom_includeRight_of_isPurelyInseparable
  let ι₁ := algebraMap (ResidueField A₁) (ResidueField (A₁ ⊗[A] B))
  let ι₂ := ResidueField.map (Algebra.TensorProduct.includeRight : B →ₐ[A] A₁ ⊗[A] B).toRingHom
  have hι₂ (b : B) : ι₂ (residue B b) = residue _ ((1 : A₁) ⊗ₜ b) :=
    ResidueField.map_residue _ b
  have hcompat (c : ResidueField A) :
      ι₁ (algebraMap _ (ResidueField A₁) c) = ι₂ (algebraMap _ (ResidueField B) c) := by
    obtain ⟨a, rfl⟩ := residue_surjective c
    have ht : (algebraMap A A₁ a) ⊗ₜ[A] (1 : B) = (1 : A₁) ⊗ₜ algebraMap A B a := by
      rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
    rw [ResidueField.algebraMap_residue, ResidueField.algebraMap_residue,
      ResidueField.algebraMap_residue, hι₂, Algebra.TensorProduct.algebraMap_apply,
      Algebra.algebraMap_self, RingHom.id_apply, ht]
  obtain ⟨q, _⟩ := ExpChar.exists (ResidueField A)
  have : ExpChar (ResidueField (A₁ ⊗[A] B)) q :=
    expChar_of_injective_ringHom (f := ι₁.comp (algebraMap (ResidueField A) (ResidueField A₁)))
      (RingHom.injective _) q
  have key (y : ResidueField A₁) : ι₂ (σ y) = ι₁ y := by
    obtain ⟨n, c, hc⟩ := IsPurelyInseparable.pow_mem (ResidueField A) q y
    have h1 : ι₁ y ^ q ^ n = ι₂ (σ y) ^ q ^ n := by
      rw [← map_pow, ← map_pow, ← map_pow, ← hc, AlgEquiv.commutes, hcompat]
    rw [← sub_eq_zero, ← pow_eq_zero_iff (pow_pos (expChar_pos (ResidueField A) q) n).ne',
      sub_pow_expChar_pow, h1, sub_self]
  intro z
  obtain ⟨w, rfl⟩ := residue_surjective z
  induction w using TensorProduct.induction_on with
  | zero => exact ⟨0, by simp⟩
  | tmul t b =>
    refine ⟨residue A₁ t * σ.symm (residue B b), ?_⟩
    rw [map_mul, ← key (σ.symm (residue B b)), AlgEquiv.apply_symm_apply, hι₂,
      ResidueField.algebraMap_residue, ← map_mul, Algebra.TensorProduct.algebraMap_apply,
      Algebra.TensorProduct.tmul_mul_tmul,
      Algebra.algebraMap_self, RingHom.id_apply, mul_one, one_mul]
  | add w₁ w₂ h₁ h₂ =>
    obtain ⟨y₁, hy₁⟩ := h₁
    obtain ⟨y₂, hy₂⟩ := h₂
    exact ⟨y₁ + y₂, by rw [map_add, hy₁, hy₂, map_add]⟩

/-- The residue field of `A[T]_{𝔭₀}` is separably closed when that of `A` is. -/
private theorem isSepClosed_residueField_localizationAtOrigin (R : Type u) [CommRing R]
    [IsLocalRing R] [IsSepClosed (ResidueField R)] (σ : Type) :
    IsSepClosed (ResidueField (MvPolynomial.LocalizationAtOrigin R σ)) := by
  let f := ResidueField.lift (MvPolynomial.originResidue R σ)
  have hf : Function.Bijective f := ⟨f.injective, fun y => by
    obtain ⟨a, ha⟩ := MvPolynomial.originResidue_surjective R σ y
    exact ⟨residue _ a, (ResidueField.lift_residue_apply _ a).trans ha⟩⟩
  exact IsSepClosed.of_ringEquiv (RingEquiv.ofBijective f hf)

/-- A strict Henselization of `A[T]_I` for an ideal `I = 𝔭₀` is `A{T}`. -/
private theorem exists_isHenselianPolynomialRing_of_eq {R : Type u} [CommRing R] [IsLocalRing R]
    [IsSepClosed (ResidueField R)] {n : ℕ} (I : Ideal (MvPolynomial (Fin n) R)) [I.IsPrime]
    (hI : I = MvPolynomial.originIdeal R (Fin n)) (H : Type u) [CommRing H] [IsLocalRing H]
    [Algebra (Localization.AtPrime I) H] [Algebra R H] [IsScalarTower R (Localization.AtPrime I) H]
    (hH : IsHenselization (Localization.AtPrime I)
      (SeparableClosure (ResidueField (Localization.AtPrime I))) H) :
    ∃ (_ : Algebra (MvPolynomial.LocalizationAtOrigin R (Fin n)) H)
      (_ : IsScalarTower R (MvPolynomial.LocalizationAtOrigin R (Fin n)) H),
      MvPolynomial.IsHenselianPolynomialRing R (Fin n) H := by
  subst hI
  refine ⟨‹_›, ‹_›, ?_⟩
  have := isSepClosed_residueField_localizationAtOrigin R (Fin n)
  have :=
    IsSepClosure.self_of_isSepClosed (ResidueField (MvPolynomial.LocalizationAtOrigin R (Fin n)))
  exact IsHenselization.of_residueAlgEquiv
    (IsSepClosure.equiv (ResidueField (MvPolynomial.LocalizationAtOrigin R (Fin n)))
      (SeparableClosure (ResidueField (MvPolynomial.LocalizationAtOrigin R (Fin n))))
      (ResidueField (MvPolynomial.LocalizationAtOrigin R (Fin n))))

/-- An sh-smooth local algebra `D` over a noetherian strictly Henselian local ring `R`, with
trivial residue field extension, is `R`-isomorphic to `R{T₁, …, T_n}` for some `n`. -/
private theorem exists_algEquiv_isHenselianPolynomialRing_of_surjective {R : Type u} {D : Type v}
    [CommRing R] [IsNoetherianRing R] [StrictlyHenselianLocalRing R] [CommRing D]
    [IsLocalRing D] [Algebra R D] [IsLocalHom (algebraMap R D)] (h : IsShSmooth R D)
    (hk : Function.Surjective (algebraMap (ResidueField R) (ResidueField D))) :
    ∃ (n : ℕ) (H : Type u) (_ : CommRing H) (_ : IsLocalRing H)
      (_ : Algebra (MvPolynomial.LocalizationAtOrigin R (Fin n)) H) (_ : Algebra R H)
      (_ : IsScalarTower R (MvPolynomial.LocalizationAtOrigin R (Fin n)) H),
      MvPolynomial.IsHenselianPolynomialRing R (Fin n) H ∧ Nonempty (D ≃ₐ[R] H) := by
  obtain ⟨C, _, _, _, hC, hCl, k, _, _, φ, _, Csh, _, _, _, _, _, ψ, hψ, ⟨e⟩⟩ := h
  have : IsNoetherianRing C := by
    obtain ⟨C₀, _, _, _, q, _, ⟨f⟩⟩ := hC
    have : IsNoetherianRing C₀ := Algebra.FiniteType.isNoetherianRing R C₀
    exact isNoetherianRing_of_ringEquiv _ f.toRingEquiv
  have := hψ.isLocalHom_algebraMap
  have : IsLocalHom (algebraMap R Csh) := by
    rw [IsScalarTower.algebraMap_eq R C Csh]
    infer_instance
  -- the residue extension of `R → C` is trivial
  have hsurj : Function.Surjective (algebraMap (ResidueField R) (ResidueField C)) := by
    let e' : ResidueField D ≃ₐ[ResidueField R] ResidueField Csh := ResidueField.mapAlgEquiv' e
    have htower (c : ResidueField R) : algebraMap (ResidueField R) (ResidueField Csh) c =
        algebraMap (ResidueField C) (ResidueField Csh) (algebraMap _ (ResidueField C) c) := by
      obtain ⟨a, rfl⟩ := residue_surjective c
      rw [ResidueField.algebraMap_residue, ResidueField.algebraMap_residue,
        ResidueField.algebraMap_residue, IsScalarTower.algebraMap_apply R C Csh]
    intro c
    obtain ⟨a, ha⟩ := hk (e'.symm (algebraMap _ (ResidueField Csh) c))
    refine ⟨a, (algebraMap (ResidueField C) (ResidueField Csh)).injective ?_⟩
    rw [← htower, ← e'.commutes, ha, AlgEquiv.apply_symm_apply]
  obtain ⟨r, x, -, hcomap, g, hgl, hg, hét⟩ :=
    hC.exists_mvPolynomial_isEtaleLocalHom_of_surjective_residueField hsurj
  set I := (maximalIdeal C).comap (MvPolynomial.aeval x :
    MvPolynomial (Fin r) R →ₐ[R] C).toRingHom with hIdef
  let P := Localization.AtPrime I
  let : Algebra P C := g.toAlgebra
  have : IsLocalHom (algebraMap P C) := hgl
  let : Algebra P Csh := ((algebraMap C Csh).comp g).toAlgebra
  have : IsScalarTower P C Csh := .of_algebraMap_eq fun _ => rfl
  have : IsScalarTower R P Csh := .of_algebraMap_eq fun a => by
    have h1 : algebraMap R P a = algebraMap (MvPolynomial (Fin r) R) P (MvPolynomial.C a) :=
      IsScalarTower.algebraMap_apply R (MvPolynomial (Fin r) R) P a
    have h2 : g (algebraMap (MvPolynomial (Fin r) R) P (MvPolynomial.C a)) = algebraMap R C a := by
      rw [← RingHom.comp_apply, hg]
      simp
    change _ = algebraMap C Csh (g (algebraMap R P a))
    rw [h1, h2, ← IsScalarTower.algebraMap_apply]
  have h1 : IsLocalRing.IsHenselizationAlong (φ.comp (algebraMap P C)) Csh ψ :=
    hψ.of_isEtaleLocalHom (B := P) hét
  have h2 := h1.isHenselization_separableClosure
  have hI : I = MvPolynomial.originIdeal R (Fin r) := by
    rw [hcomap, MvPolynomial.originIdeal_eq, sup_comm]
  obtain ⟨_, _, hH⟩ := exists_isHenselianPolynomialRing_of_eq I hI Csh h2
  exact ⟨r, Csh, _, ‹_›, _, _, ‹_›, hH, ⟨e⟩⟩

/-- **Structure of sh-smooth algebras with algebraic residue extension.** Let `A → B` be a local
homomorphism of local rings, `A` noetherian and strictly Henselian, such that `B` is sh-smooth
over `A` and `κ(B)` is algebraic over `κ(A)`. Then there are `n ≥ 0` and a local `A`-algebra `A₁`
with `A → A₁` local, such that (a) `A₁` is a finitely generated free `A`-module, (b) `κ(A₁)` is
purely inseparable over `κ(A)`, and (c) `A₁ ⊗[A] B` is `A₁`-isomorphic to `A₁{T₁, …, T_n}`,
given as a local `A₁[T]_{𝔭₀}`-algebra `H` with `MvPolynomial.IsHenselianPolynomialRing`. -/
@[weil "lem_fk107_smooth_algebraic_residue_extension_structure"]
theorem exists_tensorProduct_algEquiv_isHenselianPolynomialRing {A : Type u} {B : Type v}
    [CommRing A] [IsNoetherianRing A] [StrictlyHenselianLocalRing A] [CommRing B]
    [IsLocalRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] (h : IsShSmooth A B)
    [Algebra.IsAlgebraic (ResidueField A) (ResidueField B)] :
    ∃ (n : ℕ) (A₁ : Type u) (_ : CommRing A₁) (_ : IsLocalRing A₁) (_ : Algebra A A₁)
      (_ : IsLocalHom (algebraMap A A₁)),
      (Module.Free A A₁ ∧ Module.Finite A A₁) ∧
      IsPurelyInseparable (ResidueField A) (ResidueField A₁) ∧
      ∃ (H : Type u) (_ : CommRing H) (_ : IsLocalRing H)
        (_ : Algebra (MvPolynomial.LocalizationAtOrigin A₁ (Fin n)) H) (_ : Algebra A₁ H)
        (_ : IsScalarTower A₁ (MvPolynomial.LocalizationAtOrigin A₁ (Fin n)) H),
        MvPolynomial.IsHenselianPolynomialRing A₁ (Fin n) H ∧
          Nonempty (A₁ ⊗[A] B ≃ₐ[A₁] H) := by
  obtain ⟨hfin, -⟩ := h.finite_isPurelyInseparable_residueField
  obtain ⟨A₁, _, _, _, hfree, hfinA, hloc, ⟨σ⟩⟩ :=
    IsLocalRing.exists_finite_free_isLocalHom_residueField_algEquiv A (ResidueField B)
  have : IsPurelyInseparable (ResidueField A) (ResidueField A₁) := σ.symm.isPurelyInseparable
  obtain ⟨hA₁, hB₁, hl₁, hsh₁⟩ := h.tensorProduct_of_module_finite (A₁ := A₁)
  have : IsNoetherianRing A₁ := Algebra.FiniteType.isNoetherianRing A A₁
  have hk := surjective_residueField_tensorProduct σ
  obtain ⟨n, H, _, _, _, _, _, hH, ⟨e⟩⟩ :=
    exists_algEquiv_isHenselianPolynomialRing_of_surjective hsh₁ hk
  exact ⟨n, A₁, _, ‹_›, _, hloc, ⟨hfree, hfinA⟩, ‹_›, H, _, ‹_›, _, _, ‹_›, hH, ⟨e⟩⟩

end Algebra.IsShSmooth

end
