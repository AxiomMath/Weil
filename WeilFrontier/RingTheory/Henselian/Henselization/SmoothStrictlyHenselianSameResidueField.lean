module

public import Weil.Attr
public import WeilFrontier.Defs.RingTheory.Henselian.Henselization.SmoothStrictlyHenselianAlgebra
public import WeilFrontier.RingTheory.Henselian.Henselization.Defs
public import WeilFrontier.RingTheory.Henselian.Henselization.LocalEtaleOverPolynomialStrictHenselization
public import WeilFrontier.RingTheory.Unramified.SmoothLocalEtaleOverPolynomialRational

/-!
# Sh-smooth algebras with trivial residue field extension

Let `A → B` be a local homomorphism of local rings, with `A` noetherian, such that `B` is
sh-smooth over `A` (`Algebra.IsShSmooth`) and the residue field extension `κ(A) → κ(B)` is an
isomorphism. Then `B` is, as an `A`-algebra, the Henselization of a localized polynomial ring
`A[T₁, …, T_n]_{𝔭₀}`, `𝔭₀ = (𝔪(A), T₁, …, T_n)`, with respect to a local homomorphism
`A[T]_{𝔭₀} → k` to a separably closed field.

## Main results

* `MvPolynomial.span_range_X_sup_map_maximalIdeal_eq_comap`: the ideal `(𝔪(A), T₁, …, T_n)` is
  the preimage of `𝔪(A)` under the constant coefficient, hence a maximal ideal.
* `Algebra.IsShSmooth.exists_isHenselizationAlong_mvPolynomial`: the structure statement above.

## Implementation notes

The source states the result for strictly Henselian local rings `A` and `B`; the proof does not
use that either ring is Henselian, and these hypotheses are dropped. Noetherianity of `A`, which is
a standing hypothesis of the source, is kept: it is used to see that the intermediate smooth local
`A`-algebra is noetherian. The hypothesis on residue fields is surjectivity of `κ(A) → κ(B)`,
which is the same as bijectivity since a homomorphism of fields is injective.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FK88], I.7
-/

@[expose] public section

open IsLocalRing MvPolynomial

universe u v

namespace MvPolynomial

variable {σ : Type*} {A : Type u} [CommRing A] [IsLocalRing A]

/-- A polynomial minus its constant term lies in the ideal generated by the variables. -/
private theorem sub_C_constantCoeff_mem_span_range_X' {R : Type*} [CommRing R]
    (F : MvPolynomial σ R) :
    F - C (constantCoeff F) ∈ Ideal.span (Set.range (X : σ → MvPolynomial σ R)) := by
  induction F using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
    have := add_mem hp hq
    rwa [map_add, map_add, add_sub_add_comm]
  | mul_X p i _ =>
    simpa using Ideal.mul_mem_left _ p (Ideal.subset_span (Set.mem_range_self i))

/-- The ideal `(𝔪(A), T₁, …, T_n)` of `A[T₁, …, T_n]` is the preimage of `𝔪(A)` under the constant
coefficient. -/
theorem span_range_X_sup_map_maximalIdeal_eq_comap :
    Ideal.span (Set.range (X : σ → MvPolynomial σ A)) ⊔ (maximalIdeal A).map C =
      (maximalIdeal A).comap constantCoeff := by
  apply le_antisymm
  · refine sup_le ?_ ?_
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      simp
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      simpa using ha
  · intro F hF
    have h := sub_C_constantCoeff_mem_span_range_X' F
    have : F = (F - C (constantCoeff F)) + C (constantCoeff F) := by ring
    rw [this]
    exact add_mem (Ideal.mem_sup_left h) (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hF))

instance isMaximal_span_range_X_sup_map_maximalIdeal :
    (Ideal.span (Set.range (X : σ → MvPolynomial σ A)) ⊔ (maximalIdeal A).map C).IsMaximal := by
  rw [span_range_X_sup_map_maximalIdeal_eq_comap]
  exact Ideal.comap_isMaximal_of_surjective _
    (fun a => ⟨C a, constantCoeff_C σ a⟩)

end MvPolynomial

namespace Algebra.IsShSmooth

variable {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]

private theorem map_mem_maximalIdeal_iff' {R S : Type*} [CommRing R] [CommRing S] [IsLocalRing R]
    [IsLocalRing S] (f : R →+* S) [IsLocalHom f] {x : R} :
    f x ∈ maximalIdeal S ↔ x ∈ maximalIdeal R := by
  simp only [mem_maximalIdeal, mem_nonunits_iff, isUnit_map_iff]

/-- If `A → C → C̃` with `C → C̃` local and `C̃ ≃ₐ[A] B`, and `κ(A) → κ(B)` is surjective, then
`κ(A) → κ(C)` is surjective. -/
private theorem surjective_residueField_of_algEquiv [IsLocalRing A] [IsLocalRing B]
    [IsLocalHom (algebraMap A B)]
    {C : Type*} [CommRing C] [IsLocalRing C] [Algebra A C] [IsLocalHom (algebraMap A C)]
    {Csh : Type*} [CommRing Csh] [IsLocalRing Csh] [Algebra C Csh] [Algebra A Csh]
    [IsScalarTower A C Csh] [IsLocalHom (algebraMap C Csh)] (eB : B ≃ₐ[A] Csh)
    (hk : Function.Surjective (algebraMap (ResidueField A) (ResidueField B))) :
    Function.Surjective (algebraMap (ResidueField A) (ResidueField C)) := by
  intro y
  obtain ⟨c, rfl⟩ := residue_surjective y
  obtain ⟨a', ha'⟩ := hk (residue B (eB.symm (algebraMap C Csh c)))
  obtain ⟨a, rfl⟩ := residue_surjective a'
  refine ⟨residue A a, ?_⟩
  have h1 : eB.symm (algebraMap C Csh c) - algebraMap A B a ∈ maximalIdeal B := by
    rw [← residue_eq_zero_iff, map_sub, ← ha', sub_eq_zero]
    rfl
  have h2 : algebraMap C Csh (c - algebraMap A C a) ∈ maximalIdeal Csh := by
    have := (map_mem_maximalIdeal_iff' (eB : B →+* Csh)).2 h1
    simpa [map_sub, ← IsScalarTower.algebraMap_apply] using this
  have h3 : c - algebraMap A C a ∈ maximalIdeal C :=
    (map_mem_maximalIdeal_iff' (algebraMap C Csh)).1 h2
  rw [← residue_eq_zero_iff, map_sub, sub_eq_zero] at h3
  rw [h3]
  rfl

/-- **Sh-smooth algebras with trivial residue field extension.** Let `A → B` be a local
homomorphism of local rings, `A` noetherian, such that `B` is sh-smooth over `A` and
`κ(A) → κ(B)` is surjective (equivalently, an isomorphism). Then there are `n ≥ 0`, a separably
closed field `k` with a local homomorphism `φ : A[T₁, …, T_n]_{𝔭₀} → k`,
`𝔭₀ = (𝔪(A), T₁, …, T_n)`, a Henselization `(B̃, χ)` of `A[T]_{𝔭₀}` with respect to `φ`, and an
isomorphism of `A`-algebras `B ≃ₐ[A] B̃`. -/
@[weil "lem_fk107_smooth_strictly_henselian_same_residue_field"]
theorem exists_isHenselizationAlong_mvPolynomial [IsNoetherianRing A] [IsLocalRing A]
    [IsLocalRing B] [IsLocalHom (algebraMap A B)] (h : IsShSmooth A B)
    (hk : Function.Surjective (algebraMap (ResidueField A) (ResidueField B))) :
    ∃ (n : ℕ) (k : Type u) (_ : Field k) (_ : IsSepClosed k)
      (φ : Localization.AtPrime
        (Ideal.span (Set.range (X : Fin n → MvPolynomial (Fin n) A)) ⊔ (maximalIdeal A).map C)
          →+* k) (_ : IsLocalHom φ)
      (Bh : Type u) (_ : CommRing Bh) (_ : IsLocalRing Bh)
      (_ : Algebra (Localization.AtPrime
        (Ideal.span (Set.range (X : Fin n → MvPolynomial (Fin n) A)) ⊔ (maximalIdeal A).map C))
          Bh)
      (_ : Algebra A Bh) (_ : IsScalarTower A (Localization.AtPrime
        (Ideal.span (Set.range (X : Fin n → MvPolynomial (Fin n) A)) ⊔ (maximalIdeal A).map C))
          Bh)
      (χ : Bh →+* k), IsHenselizationAlong φ Bh χ ∧ Nonempty (B ≃ₐ[A] Bh) := by
  obtain ⟨C', _, _, _, hC, hl, k, _, _, φ, _, Csh, _, _, _, _, _, ψ, hψ, ⟨eB⟩⟩ := h
  have hC' := hC
  obtain ⟨C₀, _, _, _, q, _, ⟨e₀⟩⟩ := hC'
  have : IsNoetherianRing C₀ := Algebra.FiniteType.isNoetherianRing A C₀
  have : IsNoetherianRing C' := isNoetherianRing_of_ringEquiv _ e₀.toRingEquiv
  have : IsLocalHom (algebraMap C' Csh) := hψ.isLocalHom_algebraMap
  have hkC := surjective_residueField_of_algEquiv (C := C') eB hk
  obtain ⟨r, x, -, hcomap, g, _, hg, hét⟩ :=
    hC.exists_mvPolynomial_isEtaleLocalHom_of_surjective_residueField hkC
  -- Transport along the equality of the prime `ψ⁻¹(𝔪_C)` with `𝔭₀`.
  suffices key : ∀ (P : Ideal (MvPolynomial (Fin r) A)) [P.IsPrime],
      P = Ideal.span (Set.range X) ⊔ (maximalIdeal A).map C →
      ∀ (g : Localization.AtPrime P →+* C') [IsLocalHom g],
        g.comp (algebraMap (MvPolynomial (Fin r) A) _) =
          (aeval x : MvPolynomial (Fin r) A →ₐ[A] C').toRingHom → g.IsEtaleLocalHom →
      ∃ (φ : Localization.AtPrime
          (Ideal.span (Set.range (X : Fin r → MvPolynomial (Fin r) A)) ⊔ (maximalIdeal A).map C)
            →+* k) (_ : IsLocalHom φ)
        (_ : Algebra (Localization.AtPrime
          (Ideal.span (Set.range (X : Fin r → MvPolynomial (Fin r) A)) ⊔ (maximalIdeal A).map C))
            Csh)
        (_ : IsScalarTower A (Localization.AtPrime
          (Ideal.span (Set.range (X : Fin r → MvPolynomial (Fin r) A)) ⊔ (maximalIdeal A).map C))
            Csh), IsHenselizationAlong φ Csh ψ by
    obtain ⟨φ', _, _, _, hφ'⟩ := key _ hcomap g hg hét
    exact ⟨r, k, _, ‹_›, φ', ‹_›, Csh, _, ‹_›, _, _, ‹_›, ψ, hφ', ⟨eB⟩⟩
  intro P _ hP g _ hg hét
  subst hP
  let L := Localization.AtPrime (Ideal.span (Set.range (X : Fin r → MvPolynomial (Fin r) A)) ⊔
    (maximalIdeal A).map C)
  let : Algebra L C' := g.toAlgebra
  let : Algebra L Csh := ((algebraMap C' Csh).comp g).toAlgebra
  have : IsScalarTower L C' Csh := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsLocalHom (algebraMap L C') := ‹IsLocalHom g›
  have hgA : ∀ a : A, g (algebraMap A L a) = algebraMap A C' a := by
    intro a
    have := RingHom.congr_fun hg (MvPolynomial.C a)
    simpa [IsScalarTower.algebraMap_apply A (MvPolynomial (Fin r) A) L] using this
  have : IsScalarTower A L Csh := IsScalarTower.of_algebraMap_eq fun a => by
    change algebraMap A Csh a = algebraMap C' Csh (g (algebraMap A L a))
    rw [hgA, ← IsScalarTower.algebraMap_apply]
  exact ⟨φ.comp g, inferInstance, _, ‹_›, hψ.of_isEtaleLocalHom (B := L) hét⟩

end Algebra.IsShSmooth
