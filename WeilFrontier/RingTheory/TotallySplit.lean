module

public import Weil.Attr
public import Mathlib.RingTheory.TotallySplit
public import Mathlib.FieldTheory.SeparableClosure
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Finite étale algebras over a field split after a finite separable extension

Let `k` be a field and `B` a finite étale (that is, finite separable) `k`-algebra of dimension
`m`. Then there is a finite separable field extension `L / k` such that `L ⊗[k] B` is
isomorphic, as an `L`-algebra, to the product `L^m` of `m` copies of `L`.

The proof does not go through the Chinese remainder theorem. Instead we use a splitting
criterion: if `B` is finite étale over `k`, generated as a `k`-algebra by a set `S`, and every
`s ∈ S` is a root of a nonzero polynomial over `k` which splits over a field `L`, then
`L ⊗[k] B` is totally split over `L`. Indeed, `L ⊗[k] B` is finite étale over `L`, hence a
finite product of its residue fields; each residue field `Q` is generated over `L` by the images
of the elements of `S`, and these are roots in `Q` of polynomials splitting over `L`, so they lie
in `L`, whence `Q = L`.

Writing `B ≅ ∏ᵢ Kᵢ` with `Kᵢ / k` finite separable field extensions, every element `x` of `B` is
a root of `∏ᵢ minpoly k (xᵢ)`, a product of separable polynomials. Taking for `L` the subfield of
a separable closure of `k` generated by the roots of these polynomials for `x` running through a
basis of `B` gives the required finite separable extension.

## Main results

* `Algebra.IsFiniteSplit.tensorProduct_of_splits`: the splitting criterion above.
* `Algebra.Etale.exists_finiteDimensional_isSeparable_tensorProduct_algEquiv_pi`: a finite étale
  algebra `B` over a field `k` becomes isomorphic to `Fin (finrank k B) → L` after base change to
  some finite separable field extension `L / k`.

## Implementation notes

A finite separable `k`-algebra in the sense of a finite product of finite separable field
extensions of `k` is Mathlib's `Algebra.Etale k B`
(`Algebra.Etale.iff_exists_algEquiv_prod`); the empty product `B = 0` is included, in which case
`m = 0` and `L = k` would do.

## References

* [FK] E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, Chapter I.
-/

@[expose] public section

open Polynomial TensorProduct

namespace Algebra.IsFiniteSplit

/-- Splitting criterion: let `B` be a finite étale algebra over a field `k`, generated as a
`k`-algebra by `S`, and let `L / k` be a field extension such that every `s ∈ S` is a root of a
nonzero polynomial over `k` splitting over `L`. Then `L ⊗[k] B` is totally split over `L`. -/
theorem tensorProduct_of_splits {k L B : Type*} [Field k] [Field L] [Algebra k L] [CommRing B]
    [Algebra k B] [Algebra.Etale k B] {S : Set B} (hS : Algebra.adjoin k S = ⊤)
    (h : ∀ s ∈ S, ∃ f : k[X], f ≠ 0 ∧ aeval s f = 0 ∧ (f.map (algebraMap k L)).Splits) :
    Algebra.IsFiniteSplit L (L ⊗[k] B) := by
  have : Module.Finite L (L ⊗[k] B) := Algebra.FormallyUnramified.finite_of_free L _
  have : IsReduced (L ⊗[k] B) := Algebra.FormallyUnramified.isReduced_of_field L _
  have : IsArtinianRing (L ⊗[k] B) := isArtinian_of_tower L inferInstance
  let _ (m : MaximalSpectrum (L ⊗[k] B)) : Field ((L ⊗[k] B) ⧸ m.asIdeal) :=
    Ideal.Quotient.field m.asIdeal
  have key (m : MaximalSpectrum (L ⊗[k] B)) :
      Function.Bijective (algebraMap L ((L ⊗[k] B) ⧸ m.asIdeal)) := by
    set Q := (L ⊗[k] B) ⧸ m.asIdeal
    refine ⟨(algebraMap L Q).injective, ?_⟩
    let ψ : B →ₐ[k] Q := (Ideal.Quotient.mkₐ k m.asIdeal).comp
      Algebra.TensorProduct.includeRight
    let R : Subalgebra k Q := (Algebra.ofId L Q).range.restrictScalars k
    have hψ : ∀ b, ψ b ∈ R := by
      intro b
      have hle : Algebra.adjoin k S ≤ R.comap ψ := by
        refine Algebra.adjoin_le fun s hs => ?_
        obtain ⟨f, hf0, hfs, hsplit⟩ := h s hs
        have hroot : ((f.map (algebraMap k L)).map (algebraMap L Q)).IsRoot (ψ s) := by
          rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq, IsRoot,
            ← eval₂_eq_eval_map, ← aeval_def, aeval_algHom_apply, hfs, map_zero]
        obtain ⟨l, hl⟩ := hsplit.mem_range_of_isRoot (Polynomial.map_ne_zero hf0) hroot
        exact ⟨l, hl⟩
      exact hle (hS ▸ Algebra.mem_top)
    intro q
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective q
    induction a using TensorProduct.induction_on with
    | zero => exact ⟨0, by simp⟩
    | tmul l b =>
      obtain ⟨l', hl'⟩ := hψ b
      refine ⟨l * l', ?_⟩
      have hl'' : algebraMap L Q l' = ψ b := hl'
      rw [map_mul, hl'']
      simp only [ψ, AlgHom.coe_comp, Function.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
        Algebra.TensorProduct.includeRight_apply, Q]
      rw [IsScalarTower.algebraMap_apply L (L ⊗[k] B), Ideal.Quotient.algebraMap_eq, ← map_mul,
        Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul,
        mul_one, one_mul, Algebra.algebraMap_self, RingHom.id_apply]
    | add x y hx hy =>
      obtain ⟨u, hu⟩ := hx
      obtain ⟨v, hv⟩ := hy
      exact ⟨u + v, by rw [map_add, hu, hv, map_add]⟩
  let e₁ : (L ⊗[k] B) ≃ₐ[L] ∀ m : MaximalSpectrum (L ⊗[k] B), (L ⊗[k] B) ⧸ m.asIdeal :=
    (IsArtinianRing.equivPi _).restrictScalars L
  let e₂ : (∀ m : MaximalSpectrum (L ⊗[k] B), (L ⊗[k] B) ⧸ m.asIdeal) ≃ₐ[L]
      (MaximalSpectrum (L ⊗[k] B) → L) :=
    AlgEquiv.piCongrRight fun m => (AlgEquiv.ofBijective (Algebra.ofId L _) (key m)).symm
  exact .of_algEquiv (e₁.trans e₂).symm

end Algebra.IsFiniteSplit

namespace Algebra.Etale

universe u v

/-- A finite étale (finite separable) algebra `B` of dimension `m` over a field `k` splits after a
finite separable field extension: there is a finite separable extension `L / k` with an
isomorphism of `L`-algebras `L ⊗[k] B ≃ Lᵐ`. -/
@[weil "lem_fk104_split_after_finite_separable_extension"]
theorem exists_finiteDimensional_isSeparable_tensorProduct_algEquiv_pi (k : Type u) (B : Type v)
    [Field k] [CommRing B] [Algebra k B] [Algebra.Etale k B] :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra k L), FiniteDimensional k L ∧
      Algebra.IsSeparable k L ∧
      Nonempty (L ⊗[k] B ≃ₐ[L] (Fin (Module.finrank k B) → L)) := by
  classical
  obtain ⟨I, _, K, _, _, e, hK⟩ := (Algebra.Etale.iff_exists_algEquiv_prod k B).mp inferInstance
  cases nonempty_fintype I
  have : Module.Finite k B := Algebra.FormallyUnramified.finite_of_free k B
  have hKfin : ∀ i, Module.Finite k (K i) := fun i => (hK i).1
  have hKsep : ∀ i, Algebra.IsSeparable k (K i) := fun i => (hK i).2
  let b := Module.finBasis k B
  let Ω := SeparableClosure k
  let T : Set Ω := ⋃ j, ⋃ i, (minpoly k (e (b j) i)).rootSet Ω
  have hT : T.Finite :=
    Set.finite_iUnion fun j => Set.finite_iUnion fun i => rootSet_finite _ _
  have : Finite T := hT.to_subtype
  let L : IntermediateField k Ω := IntermediateField.adjoin k T
  have hLfin : FiniteDimensional k L :=
    IntermediateField.finiteDimensional_adjoin fun x _ =>
      (Algebra.IsSeparable.isSeparable k x).isIntegral
  have hLsep : Algebra.IsSeparable k L :=
    Algebra.IsSeparable.of_algHom k Ω (IsScalarTower.toAlgHom k L Ω)
  -- every `minpoly k (e (b j) i)` splits over `L`
  have hsplit : ∀ j i, ((minpoly k (e (b j) i)).map (algebraMap k L)).Splits := by
    intro j i
    have hsep : (minpoly k (e (b j) i)).Separable :=
      Algebra.IsSeparable.isSeparable k (e (b j) i)
    refine Splits.of_splits_map (algebraMap L Ω) ?_ ?_
    · rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq]
      exact IsSepClosed.splits_codomain _ hsep
    · intro a ha
      rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq] at ha
      have haT : a ∈ T := by
        simp only [T, Set.mem_iUnion]
        refine ⟨j, i, ?_⟩
        obtain ⟨hne, hroot⟩ := mem_roots'.mp ha
        refine mem_rootSet'.mpr ⟨hne, ?_⟩
        rw [aeval_def, eval₂_eq_eval_map]
        exact hroot
      exact ⟨⟨a, IntermediateField.subset_adjoin k T haT⟩, rfl⟩
  have hS : Algebra.adjoin k (Set.range b) = ⊤ := by
    have := Algebra.span_le_adjoin k (Set.range b)
    rw [b.span_eq] at this
    rw [← Algebra.toSubmodule_eq_top]
    exact top_unique this
  have hFS : Algebra.IsFiniteSplit L (L ⊗[k] B) := by
    refine Algebra.IsFiniteSplit.tensorProduct_of_splits hS ?_
    rintro _ ⟨j, rfl⟩
    refine ⟨∏ i, minpoly k (e (b j) i), ?_, ?_, ?_⟩
    · exact Finset.prod_ne_zero_iff.mpr fun i _ =>
        minpoly.ne_zero (Algebra.IsIntegral.isIntegral _)
    · apply e.injective
      rw [map_zero]
      change e.toAlgHom _ = 0
      rw [← aeval_algHom_apply]
      funext i
      rw [Pi.zero_apply, show (aeval (e.toAlgHom (b j)) (∏ i, minpoly k (e (b j) i))) i =
        Pi.evalAlgHom k K i (aeval (e.toAlgHom (b j)) (∏ i, minpoly k (e (b j) i))) from rfl,
        ← aeval_algHom_apply, map_prod]
      exact Finset.prod_eq_zero (Finset.mem_univ i) (minpoly.aeval k _)
    · rw [Polynomial.map_prod]
      exact Splits.prod fun i _ => hsplit j i
  obtain ⟨n, ⟨φ⟩⟩ := hFS.1
  have hn : n = Module.finrank k B := by
    have h1 := φ.toLinearEquiv.finrank_eq
    have h2 : Module.finrank L (L ⊗[k] B) = Module.finrank k B := Module.finrank_baseChange
    rw [Module.finrank_fin_fun] at h1
    exact h1.symm.trans h2
  subst hn
  refine ⟨L, inferInstance, inferInstance, hLfin, hLsep, ?_⟩
  exact ⟨φ⟩

end Algebra.Etale
