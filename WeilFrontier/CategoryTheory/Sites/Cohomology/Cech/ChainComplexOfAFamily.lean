/-!
# Exactness of the augmented Čech complex of free sheaves

Let `X` be a scheme, `Λ` a ring, `U` an object of the small étale site of `X` and
`𝔛 = (U_ν ⟶ U)` an étale covering. The augmented Čech complex of free sheaves of `Λ`-modules
`⋯ ⟶ K_1(𝔛, Λ) ⟶ K_0(𝔛, Λ) ⟶ (Ũ)^Λ ⟶ 0`, with `K_p = ⨁_{ν ∈ I^{p+1}} (Ũ_ν)^Λ`, is exact.

The proof runs at the level of presheaves and then sheafifies. Evaluated at an object `W`,
the presheaf-level complex is the augmented Čech complex of the functor
`V ↦ Λ^(Hom(W, V))`. A basis element of its degree-`p` term is a `(p+1)`-tuple of morphisms
`W ⟶ U_{ν_a}` with a common composite `t : W ⟶ U`; prepending a lift of `t`, chosen once for
each `t` that has one, is a contracting homotopy in every degree `p ≥ 0`, so this complex is
exact at each `K_p`. Sheafification is exact and commutes with the formation of the complex,
which gives exactness at each `K_p` of the sheaf complex. At `(Ũ)^Λ` the presheaf
augmentation is only locally surjective, because a morphism `W ⟶ U` lifts to the covering
only locally on `W`; the sheafified augmentation is then an epimorphism.

## Main definitions

* `CategoryTheory.PreZeroHypercover.augmentedCechChainComplexMapIso`: for `α : G ⋙ L ≅ G'`
  with `L` additive and preserving coproducts, the augmented Čech chain complex of `G'` is
  the image under `L` of that of `G`.
* `CategoryTheory.PreZeroHypercover.cechHomotopy`,
  `CategoryTheory.PreZeroHypercover.cechHomotopyAug`: the contracting homotopy of the
  augmented Čech complex of `V ↦ Λ^(Hom(W, V))`.

## Main results

* `CategoryTheory.PreZeroHypercover.augmentedCechChainComplex_freeCoyoneda_exactAt`: the
  augmented Čech complex of `V ↦ Λ^(Hom(W, V))` is exact at every `K_p`, for any family.
* `CategoryTheory.PreZeroHypercover.augmentedCechChainComplex_freeYoneda_exactAt`: the same
  for the free presheaves `Λ^(Hom(-, V))`.
* `CategoryTheory.PreZeroHypercover.isLocallySurjective_cechChainComplexAugmentation_freeYoneda`:
  for a covering family the presheaf augmentation is locally surjective.
* `AlgebraicGeometry.SmallEtale.acyclic_augment_cechFreeComplex`: the augmented complex
  `K_•(𝔛, Λ) ⟶ (Ũ)^Λ` is exact for an étale covering `𝔛`, and
  `AlgebraicGeometry.SmallEtale.acyclic_augment_cechFreeComplex_of_jointlySurjective` for a
  jointly surjective family of étale morphisms.

## Implementation notes

The source argues on stalks at geometric points, where the stalk of the complex splits as a
direct sum, over the points `t` of the stalk of `Ũ`, of contractible complexes. The argument
here replaces the stalks by the values of the presheaf-level complex at the objects `W` of the
site and the points `t` by the morphisms `W ⟶ U`; the contracting homotopy is the same. Those
`t` that do not lift to the covering are the reason the presheaf complex is not exact at the
augmentation, and local surjectivity there is the input from the topology. The covering
hypothesis is membership of the sieve generated by the family in the étale topology of the
small étale site; a jointly surjective family of étale morphisms is such a covering.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, I.4][FreitagKiehl1988]
* [Stacks Project, Tag 03AT](https://stacks.math.columbia.edu/tag/03AT)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe w v u v' u' v'' u''

namespace CategoryTheory.PreZeroHypercover

variable {C : Type u} [Category.{v} C] {X : C} (E : PreZeroHypercover.{w} X)
  [∀ (n : ℕ) (i : Fin (n + 1) → E.I₀), HasProduct (fun a ↦ Over.mk (E.f (i a)))]
  {A : Type u'} [Category.{v'} A] [Preadditive A] [HasCoproducts.{w} A]
  {B : Type u''} [Category.{v''} B] [Preadditive B] [HasCoproducts.{w} B]

/-- The comparison isomorphism `⨁_ν G'(U_ν) ≅ L(⨁_ν G(U_ν))` in degree `p` of the Čech chain
complex, for `α : G ⋙ L ≅ G'` with `L` preserving coproducts. -/
noncomputable def cechChainXMapIso (G : C ⥤ A) (L : A ⥤ B)
    [∀ J : Type w, PreservesColimitsOfShape (Discrete J) L] (G' : C ⥤ B) (α : G ⋙ L ≅ G')
    (p : ℕ) : ∐ E.cechChainFactor G' p ≅ L.obj (∐ E.cechChainFactor G p) :=
  Sigma.mapIso (fun _ ↦ (α.app _).symm) ≪≫
    (PreservesCoproduct.iso L (E.cechChainFactor G p)).symm

omit [Preadditive A] [Preadditive B] in
/-- On the summand of `ν`, the comparison isomorphism is `α⁻¹` followed by `L` of the inclusion. -/
@[reassoc]
lemma ι_cechChainXMapIso_hom (G : C ⥤ A) (L : A ⥤ B)
    [∀ J : Type w, PreservesColimitsOfShape (Discrete J) L] (G' : C ⥤ B) (α : G ⋙ L ≅ G')
    (p : ℕ) (ν : Fin (p + 1) → E.I₀) :
    Sigma.ι (E.cechChainFactor G' p) ν ≫ (E.cechChainXMapIso G L G' α p).hom =
      α.inv.app _ ≫ L.map (Sigma.ι (E.cechChainFactor G p) ν) := by
  change Sigma.ι _ ν ≫ Limits.Sigma.map (fun ν ↦ α.inv.app _) ≫ sigmaComparison L _ = _
  rw [Sigma.ι_map_assoc]
  exact congrArg _ (ι_comp_sigmaComparison L _ ν)

/-- The degreewise comparison isomorphisms between the augmented Čech chain complex of `G'`
and the image under `L` of that of `G`, for `α : G ⋙ L ≅ G'`. -/
noncomputable def augmentedCechChainComplexMapXIso (G : C ⥤ A) (L : A ⥤ B) [L.Additive]
    [∀ J : Type w, PreservesColimitsOfShape (Discrete J) L] (G' : C ⥤ B) (α : G ⋙ L ≅ G') :
    ∀ n : ℕ, (E.augmentedCechChainComplex G').X n ≅
      ((L.mapHomologicalComplex _).obj (E.augmentedCechChainComplex G)).X n
  | 0 => (α.app X).symm
  | p + 1 => E.cechChainXMapIso G L G' α p

set_option backward.isDefEq.respectTransparency false in
/-- **The augmented Čech chain complex commutes with additive coproduct-preserving functors.**
For `α : G ⋙ L ≅ G'` with `L` additive and preserving coproducts, the augmented Čech chain
complex of `G'` is isomorphic to the image under `L` of that of `G`. -/
noncomputable def augmentedCechChainComplexMapIso (G : C ⥤ A) (L : A ⥤ B) [L.Additive]
    [∀ J : Type w, PreservesColimitsOfShape (Discrete J) L] (G' : C ⥤ B) (α : G ⋙ L ≅ G') :
    E.augmentedCechChainComplex G' ≅
      (L.mapHomologicalComplex _).obj (E.augmentedCechChainComplex G) :=
  HomologicalComplex.Hom.isoOfComponents (E.augmentedCechChainComplexMapXIso G L G' α) (by
    rintro _ j rfl
    rcases j with _ | p
    · change (E.cechChainXMapIso G L G' α 0).hom ≫ L.map (E.cechChainComplexAugmentation G) =
        E.cechChainComplexAugmentation G' ≫ α.inv.app X
      refine Sigma.hom_ext _ _ fun (ν : Fin 1 → E.I₀) ↦ ?_
      refine (ι_cechChainXMapIso_hom_assoc E G L G' α 0 ν _).trans (Eq.trans ?_
        ((Category.assoc _ _ _).symm.trans
          (congrArg (· ≫ α.inv.app X) (ι_cechChainComplexAugmentation E G' ν))).symm)
      refine (congrArg (α.inv.app _ ≫ ·) ((L.map_comp _ _).symm.trans
        (congrArg L.map (ι_cechChainComplexAugmentation E G ν)))).trans ?_
      exact (α.inv.naturality _).symm
    · change (E.cechChainXMapIso G L G' α (p + 1)).hom ≫
          L.map ((E.cechChainComplex G).d (p + 1) p) =
        (E.cechChainComplex G').d (p + 1) p ≫ (E.cechChainXMapIso G L G' α p).hom
      refine Sigma.hom_ext _ _ fun (ν : Fin (p + 2) → E.I₀) ↦ ?_
      rw [ι_cechChainXMapIso_hom_assoc, ← L.map_comp, ι_cechChainComplex_d,
        ← Category.assoc, ι_cechChainComplex_d, L.map_sum, Preadditive.comp_sum,
        Preadditive.sum_comp]
      refine Finset.sum_congr rfl fun j _ ↦ ?_
      rw [L.map_zsmul, Preadditive.comp_zsmul, Preadditive.zsmul_comp, Category.assoc,
        ι_cechChainXMapIso_hom, L.map_comp, ← Category.assoc, ← Category.assoc]
      congr 2
      exact (α.inv.naturality _).symm)


/-! ### The contracting homotopy at an object -/

section Contraction

variable {C : Type u} [Category.{v} C] {X : C} (E : PreZeroHypercover.{w} X)
  [∀ (n : ℕ) (i : Fin (n + 1) → E.I₀), HasProduct (fun a ↦ Over.mk (E.f (i a)))]
  (W : C)

/-- The morphism `W ⟶ U_{ν₀} ×_X ⋯ ×_X U_{ν_m}` with components `x a : W ⟶ U_{ν_a}`, all lying
over `t : W ⟶ X`. -/
noncomputable def tupleHom (t : W ⟶ X) {m : ℕ} (x : Fin (m + 1) → Σ i : E.I₀, (W ⟶ E.X i))
    (hx : ∀ a, (x a).2 ≫ E.f (x a).1 = t) :
    W ⟶ (∏ᶜ fun a ↦ Over.mk (E.f (x a).1) : Over X).left :=
  (Pi.lift fun a ↦ (Over.homMk (x a).2 (hx a) :
    Over.mk t ⟶ Over.mk (E.f (x a).1))).left

/-- The `a`-th component of `tupleHom` is `x a`. -/
@[reassoc (attr := simp)]
lemma tupleHom_π (t : W ⟶ X) {m : ℕ} (x : Fin (m + 1) → Σ i : E.I₀, (W ⟶ E.X i))
    (hx : ∀ a, (x a).2 ≫ E.f (x a).1 = t) (a : Fin (m + 1)) :
    E.tupleHom W t x hx ≫ (Pi.π (fun a ↦ Over.mk (E.f (x a).1)) a).left = (x a).2 := by
  rw [tupleHom, ← Over.comp_left, Pi.lift_π]
  rfl

/-- `tupleHom` lies over `t`. -/
@[reassoc (attr := simp)]
lemma tupleHom_hom (t : W ⟶ X) {m : ℕ} (x : Fin (m + 1) → Σ i : E.I₀, (W ⟶ E.X i))
    (hx : ∀ a, (x a).2 ≫ E.f (x a).1 = t) :
    E.tupleHom W t x hx ≫ (∏ᶜ fun a ↦ Over.mk (E.f (x a).1) : Over X).hom = t :=
  Over.w (Pi.lift fun a ↦ (Over.homMk (x a).2 (hx a) : Over.mk t ⟶ Over.mk (E.f (x a).1)))

/-- Morphisms into an iterated fibre product agree when their components agree. -/
lemma hom_ext_of_comp_π_left {m : ℕ} {ν : Fin (m + 1) → E.I₀}
    {g₁ g₂ : W ⟶ (∏ᶜ fun a ↦ Over.mk (E.f (ν a)) : Over X).left}
    (h : ∀ a, g₁ ≫ (Pi.π (fun a ↦ Over.mk (E.f (ν a))) a).left =
      g₂ ≫ (Pi.π (fun a ↦ Over.mk (E.f (ν a))) a).left) : g₁ = g₂ := by
  have hw : g₁ ≫ (∏ᶜ fun a ↦ Over.mk (E.f (ν a)) : Over X).hom =
      g₂ ≫ (∏ᶜ fun a ↦ Over.mk (E.f (ν a)) : Over X).hom := by
    rw [← Over.w (Pi.π (fun a ↦ Over.mk (E.f (ν a))) 0), ← Category.assoc, h 0,
      Category.assoc]
  have := Pi.hom_ext (f := fun a ↦ Over.mk (E.f (ν a)))
    (Over.homMk g₁ rfl : Over.mk (g₁ ≫ (∏ᶜ fun a ↦ Over.mk (E.f (ν a)) : Over X).hom) ⟶ _)
    (Over.homMk g₂ hw.symm) fun a ↦ by
      ext
      simpa using h a
  exact congrArg CommaMorphism.left this

/-- The components of a morphism into an iterated fibre product. -/
noncomputable def tupleOf {m : ℕ} {ν : Fin (m + 1) → E.I₀}
    (g : W ⟶ (∏ᶜ fun a ↦ Over.mk (E.f (ν a)) : Over X).left) :
    Fin (m + 1) → Σ i : E.I₀, (W ⟶ E.X i) :=
  fun a ↦ ⟨ν a, g ≫ (Pi.π (fun a ↦ Over.mk (E.f (ν a))) a).left⟩

/-- The components of a morphism into an iterated fibre product have a common image in `X`. -/
lemma tupleOf_spec {m : ℕ} {ν : Fin (m + 1) → E.I₀}
    (g : W ⟶ (∏ᶜ fun a ↦ Over.mk (E.f (ν a)) : Over X).left) (a : Fin (m + 1)) :
    (E.tupleOf W g a).2 ≫ E.f (E.tupleOf W g a).1 =
      g ≫ (∏ᶜ fun a ↦ Over.mk (E.f (ν a)) : Over X).hom := by
  simp only [tupleOf, Category.assoc]
  exact congrArg (g ≫ ·) (Over.w (Pi.π (fun a ↦ Over.mk (E.f (ν a))) a))

/-- A morphism into an iterated fibre product is the `tupleHom` of its components. -/
lemma tupleHom_tupleOf {m : ℕ} {ν : Fin (m + 1) → E.I₀}
    (g : W ⟶ (∏ᶜ fun a ↦ Over.mk (E.f (ν a)) : Over X).left) :
    E.tupleHom W _ (E.tupleOf W g) (E.tupleOf_spec W g) = g :=
  E.hom_ext_of_comp_π_left W fun a ↦ by rw [tupleHom_π]; rfl

/-- The components of `tupleHom t x` are `x`. -/
lemma tupleOf_tupleHom (t : W ⟶ X) {m : ℕ} (x : Fin (m + 1) → Σ i : E.I₀, (W ⟶ E.X i))
    (hx : ∀ a, (x a).2 ≫ E.f (x a).1 = t) :
    E.tupleOf W (E.tupleHom W t x hx) = x :=
  funext fun a ↦ Sigma.ext rfl (heq_of_eq (E.tupleHom_π W t x hx a))

/-- The face map omitting the `j`-th factor, on tuples of components. -/
lemma tupleHom_faceProjection (t : W ⟶ X) {m : ℕ}
    (x : Fin (m + 2) → Σ i : E.I₀, (W ⟶ E.X i)) (hx : ∀ a, (x a).2 ≫ E.f (x a).1 = t)
    (j : Fin (m + 2)) :
    E.tupleHom W t x hx ≫ (Stacks.CechSite.faceProjection E (fun a ↦ (x a).1) j).left =
      E.tupleHom W t (x ∘ j.succAbove) (fun _ ↦ hx _) :=
  E.hom_ext_of_comp_π_left W fun a ↦ by
    rw [Category.assoc, ← Over.comp_left, Stacks.CechSite.faceProjection, Pi.lift_π,
      tupleHom_π]
    exact (E.tupleHom_π W t (x ∘ j.succAbove) _ a).symm

variable (Λ : Type v) [Ring Λ] [HasCoproducts.{w} (ModuleCat.{v} Λ)]

/-- The functor `V ↦ Λ^(Hom(W, V))`. -/
noncomputable abbrev freeCoyoneda : C ⥤ ModuleCat.{v} Λ :=
  coyoneda.obj (op W) ⋙ ModuleCat.free Λ

/-- The basis element of `K_m(W) = ⨁_ν Λ^(Hom(W, U_ν))` given by a tuple of components. -/
noncomputable def cechBasis (t : W ⟶ X) {m : ℕ} (x : Fin (m + 1) → Σ i : E.I₀, (W ⟶ E.X i))
    (hx : ∀ a, (x a).2 ≫ E.f (x a).1 = t) :
    (∐ E.cechChainFactor (freeCoyoneda W Λ) m : ModuleCat.{v} Λ) :=
  Sigma.ι (E.cechChainFactor (freeCoyoneda W Λ) m) (fun a ↦ (x a).1)
    (ModuleCat.freeMk (E.tupleHom W t x hx))

/-- Equal tuples over equal morphisms give equal basis elements. -/
lemma cechBasis_congr {t t' : W ⟶ X} {m : ℕ} {x x' : Fin (m + 1) → Σ i : E.I₀, (W ⟶ E.X i)}
    (hx : ∀ a, (x a).2 ≫ E.f (x a).1 = t) (hx' : ∀ a, (x' a).2 ≫ E.f (x' a).1 = t')
    (ht : t = t') (h : x = x') : E.cechBasis W Λ t x hx = E.cechBasis W Λ t' x' hx' := by
  subst ht h
  rfl

/-- The generator of the summand of `ν` attached to `g` is the basis element of its components. -/
lemma ι_freeMk_eq_cechBasis {m : ℕ} {ν : Fin (m + 1) → E.I₀}
    (g : W ⟶ (∏ᶜ fun a ↦ Over.mk (E.f (ν a)) : Over X).left) :
    Sigma.ι (E.cechChainFactor (freeCoyoneda W Λ) m) ν (ModuleCat.freeMk g) =
      E.cechBasis W Λ _ (E.tupleOf W g) (E.tupleOf_spec W g) := by
  rw [cechBasis, tupleHom_tupleOf]
  rfl

/-- Two linear maps out of `K_m(W)` agree when they agree on the basis elements. -/
lemma cechBasis_hom_ext {m : ℕ} {M : ModuleCat.{v} Λ}
    {φ ψ : ∐ E.cechChainFactor (freeCoyoneda W Λ) m ⟶ M}
    (h : ∀ (t : W ⟶ X) (x : Fin (m + 1) → Σ i : E.I₀, (W ⟶ E.X i))
      (hx : ∀ a, (x a).2 ≫ E.f (x a).1 = t),
      φ (E.cechBasis W Λ t x hx) = ψ (E.cechBasis W Λ t x hx)) : φ = ψ := by
  refine Sigma.hom_ext _ _ fun (ν : Fin (m + 1) → E.I₀) ↦ ModuleCat.free_hom_ext fun g ↦ ?_
  change φ (Sigma.ι (E.cechChainFactor (freeCoyoneda W Λ) m) ν (ModuleCat.freeMk g)) =
    ψ (Sigma.ι (E.cechChainFactor (freeCoyoneda W Λ) m) ν (ModuleCat.freeMk g))
  rw [ι_freeMk_eq_cechBasis]
  exact h _ _ _

omit [HasCoproducts.{w} (ModuleCat.{v} Λ)] in
private lemma moduleCat_sum_zsmul_apply {M N : ModuleCat.{v} Λ} {ι : Type*} (s : Finset ι)
    (n : ι → ℤ) (φ : ι → (M ⟶ N)) (y : M) :
    (∑ j ∈ s, n j • φ j) y = ∑ j ∈ s, n j • φ j y := by
  change (∑ j ∈ s, n j • φ j).hom y = _
  rw [ModuleCat.hom_sum, LinearMap.sum_apply]
  rfl

omit [HasCoproducts.{w} (ModuleCat.{v} Λ)] in
private lemma moduleCat_add_apply {M N : ModuleCat.{v} Λ} (φ ψ : M ⟶ N) (y : M) :
    (φ + ψ) y = φ y + ψ y :=
  rfl

set_option backward.isDefEq.respectTransparency false in
/-- The Čech differential on a basis element is the alternating sum of its faces. -/
lemma cechChainComplex_d_cechBasis (t : W ⟶ X) {m : ℕ}
    (x : Fin (m + 2) → Σ i : E.I₀, (W ⟶ E.X i)) (hx : ∀ a, (x a).2 ≫ E.f (x a).1 = t) :
    (E.cechChainComplex (freeCoyoneda W Λ)).d (m + 1) m (E.cechBasis W Λ t x hx) =
      ∑ j : Fin (m + 2), (-1 : ℤ) ^ (j : ℕ) •
        E.cechBasis W Λ t (x ∘ j.succAbove) (fun _ ↦ hx _) := by
  change (Sigma.ι (E.cechChainFactor (freeCoyoneda W Λ) (m + 1)) (fun a ↦ (x a).1) ≫
    (E.cechChainComplex (freeCoyoneda W Λ)).d (m + 1) m) (ModuleCat.freeMk _) = _
  rw [ι_cechChainComplex_d, moduleCat_sum_zsmul_apply]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  congr 1
  rw [ConcreteCategory.comp_apply]
  erw [ModuleCat.free_map_apply]
  rw [cechBasis]
  congr 2
  exact E.tupleHom_faceProjection W t x hx j

set_option backward.isDefEq.respectTransparency false in
/-- The augmentation sends a basis element over `t` to the generator `t`. -/
lemma cechChainComplexAugmentation_cechBasis (t : W ⟶ X)
    (x : Fin 1 → Σ i : E.I₀, (W ⟶ E.X i)) (hx : ∀ a, (x a).2 ≫ E.f (x a).1 = t) :
    E.cechChainComplexAugmentation (freeCoyoneda W Λ) (E.cechBasis W Λ t x hx) =
      ModuleCat.freeMk t := by
  change (Sigma.ι (E.cechChainFactor (freeCoyoneda W Λ) 0) (fun a ↦ (x a).1) ≫
    E.cechChainComplexAugmentation (freeCoyoneda W Λ)) (ModuleCat.freeMk _) = _
  rw [ι_cechChainComplexAugmentation]
  erw [ModuleCat.free_map_apply]
  exact congrArg _ (E.tupleHom_hom W t x hx)

/-- A chosen lift of `t : W ⟶ X` to a member of the family, when one exists. -/
noncomputable def chosenLift (t : W ⟶ X)
    (h : ∃ l : Σ i : E.I₀, (W ⟶ E.X i), l.2 ≫ E.f l.1 = t) : Σ i : E.I₀, (W ⟶ E.X i) :=
  h.choose

omit [∀ (n : ℕ) (i : Fin (n + 1) → E.I₀), HasProduct (fun a ↦ Over.mk (E.f (i a)))] in
/-- The chosen lift lifts `t`. -/
lemma chosenLift_spec (t : W ⟶ X)
    (h : ∃ l : Σ i : E.I₀, (W ⟶ E.X i), l.2 ≫ E.f l.1 = t) :
    (E.chosenLift W t h).2 ≫ E.f (E.chosenLift W t h).1 = t :=
  h.choose_spec

omit [∀ (n : ℕ) (i : Fin (n + 1) → E.I₀), HasProduct (fun a ↦ Over.mk (E.f (i a)))] in
/-- The chosen lift depends only on the morphism lifted. -/
lemma chosenLift_congr {t t' : W ⟶ X}
    (h : ∃ l : Σ i : E.I₀, (W ⟶ E.X i), l.2 ≫ E.f l.1 = t)
    (h' : ∃ l : Σ i : E.I₀, (W ⟶ E.X i), l.2 ≫ E.f l.1 = t') (ht : t = t') :
    E.chosenLift W t h = E.chosenLift W t' h' := by
  subst ht
  rfl

omit [∀ (n : ℕ) (i : Fin (n + 1) → E.I₀), HasProduct (fun a ↦ Over.mk (E.f (i a)))] in
/-- Prepending a lift of `t` to a tuple over `t` gives a tuple over `t`. -/
lemma cons_comp_f_eq {t : W ⟶ X} {m : ℕ} (s : Σ i : E.I₀, (W ⟶ E.X i)) (hs : s.2 ≫ E.f s.1 = t)
    (x : Fin (m + 1) → Σ i : E.I₀, (W ⟶ E.X i)) (hx : ∀ a, (x a).2 ≫ E.f (x a).1 = t) :
    ∀ a, ((Fin.cons s x : Fin (m + 2) → Σ i : E.I₀, (W ⟶ E.X i)) a).2 ≫
      E.f ((Fin.cons s x : Fin (m + 2) → Σ i : E.I₀, (W ⟶ E.X i)) a).1 = t := by
  intro a
  induction a using Fin.cases with
  | zero => exact hs
  | succ b => exact hx b

/-- The contracting homotopy `K_m(W) ⟶ K_{m+1}(W)`, prepending a chosen lift of the common
image in `Hom(W, X)`. -/
noncomputable def cechHomotopy (m : ℕ) :
    ∐ E.cechChainFactor (freeCoyoneda W Λ) m ⟶ ∐ E.cechChainFactor (freeCoyoneda W Λ) (m + 1) :=
  Sigma.desc fun (ν : Fin (m + 1) → E.I₀) ↦ ModuleCat.freeDesc (TypeCat.ofHom
    fun (g : W ⟶ (∏ᶜ fun a ↦ Over.mk (E.f (ν a)) : Over X).left) ↦
    E.cechBasis W Λ _ (Fin.cons (E.chosenLift W _ ⟨E.tupleOf W g 0, E.tupleOf_spec W g 0⟩)
      (E.tupleOf W g)) (E.cons_comp_f_eq W _ (E.chosenLift_spec W _ _) _ (E.tupleOf_spec W g)))

open scoped Classical in
/-- The contracting homotopy `Λ^(Hom(W, X)) ⟶ K_0(W)` in degree `-1`, defined on the morphisms
`W ⟶ X` which lift to a member of the family. -/
noncomputable def cechHomotopyAug :
    (freeCoyoneda W Λ).obj X ⟶ ∐ E.cechChainFactor (freeCoyoneda W Λ) 0 :=
  ModuleCat.freeDesc (TypeCat.ofHom fun (t : W ⟶ X) ↦
    if h : ∃ l : Σ i : E.I₀, (W ⟶ E.X i), l.2 ≫ E.f l.1 = t then
      E.cechBasis W Λ t (fun _ ↦ E.chosenLift W t h) (fun _ ↦ E.chosenLift_spec W t h)
    else 0)

/-- The homotopy prepends the chosen lift of the common image `t`. -/
lemma cechHomotopy_cechBasis (t : W ⟶ X) {m : ℕ}
    (x : Fin (m + 1) → Σ i : E.I₀, (W ⟶ E.X i)) (hx : ∀ a, (x a).2 ≫ E.f (x a).1 = t) :
    E.cechHomotopy W Λ m (E.cechBasis W Λ t x hx) =
      E.cechBasis W Λ t (Fin.cons (E.chosenLift W t ⟨x 0, hx 0⟩) x)
        (E.cons_comp_f_eq W _ (E.chosenLift_spec W t _) x hx) := by
  change (Sigma.ι (E.cechChainFactor (freeCoyoneda W Λ) m) (fun a ↦ (x a).1) ≫
    E.cechHomotopy W Λ m) (ModuleCat.freeMk _) = _
  rw [cechHomotopy, Sigma.ι_desc]
  erw [ModuleCat.freeDesc_apply]
  have ht := E.tupleHom_hom W t x hx
  refine E.cechBasis_congr W Λ _ _ ht ?_
  rw [E.tupleOf_tupleHom W t x hx, E.chosenLift_congr W _ ⟨x 0, hx 0⟩ ht]

open scoped Classical in
/-- On a morphism `t` that lifts, the homotopy in degree `-1` is the chosen lift of `t`. -/
lemma cechHomotopyAug_freeMk (t : W ⟶ X) (s : Σ i : E.I₀, (W ⟶ E.X i))
    (hs : s.2 ≫ E.f s.1 = t) :
    E.cechHomotopyAug W Λ (ModuleCat.freeMk t) =
      E.cechBasis W Λ t (fun _ ↦ E.chosenLift W t ⟨s, hs⟩)
        (fun _ ↦ E.chosenLift_spec W t ⟨s, hs⟩) := by
  rw [cechHomotopyAug]
  erw [ModuleCat.freeDesc_apply]
  change dite (∃ l : Σ i : E.I₀, (W ⟶ E.X i), l.2 ≫ E.f l.1 = t) _ (fun _ ↦ 0) = _
  split_ifs with h
  · rfl
  · exact absurd ⟨s, hs⟩ h

set_option backward.isDefEq.respectTransparency false in
/-- The contraction identity in degree `0`: `ε ≫ h₋₁ + h₀ ≫ d₁ = 𝟙` on `K₀(W)`. -/
lemma cechHomotopy_comp_zero :
    (E.cechChainComplexAugmentation (freeCoyoneda W Λ) ≫ E.cechHomotopyAug W Λ :
        ∐ E.cechChainFactor (freeCoyoneda W Λ) 0 ⟶ ∐ E.cechChainFactor (freeCoyoneda W Λ) 0) +
      (E.cechHomotopy W Λ 0 ≫ (E.cechChainComplex (freeCoyoneda W Λ)).d 1 0 :
        ∐ E.cechChainFactor (freeCoyoneda W Λ) 0 ⟶ ∐ E.cechChainFactor (freeCoyoneda W Λ) 0) =
      𝟙 _ := by
  refine E.cechBasis_hom_ext W Λ fun t x hx ↦ ?_
  rw [moduleCat_add_apply, ConcreteCategory.comp_apply, ConcreteCategory.comp_apply,
    ConcreteCategory.id_apply]
  erw [cechChainComplexAugmentation_cechBasis]
  rw [E.cechHomotopyAug_freeMk W Λ t (x 0) (hx 0), cechHomotopy_cechBasis]
  erw [cechChainComplex_d_cechBasis]
  rw [Fin.sum_univ_two]
  have h0 : E.cechBasis W Λ t ((Fin.cons (E.chosenLift W t ⟨x 0, hx 0⟩) x :
      Fin 2 → Σ i : E.I₀, (W ⟶ E.X i)) ∘ (0 : Fin 2).succAbove) (fun _ ↦ E.cons_comp_f_eq W _
        (E.chosenLift_spec W t _) x hx _) = E.cechBasis W Λ t x hx :=
    E.cechBasis_congr W Λ _ _ rfl (funext fun _ ↦ by simp)
  have h1 : E.cechBasis W Λ t ((Fin.cons (E.chosenLift W t ⟨x 0, hx 0⟩) x :
      Fin 2 → Σ i : E.I₀, (W ⟶ E.X i)) ∘ (1 : Fin 2).succAbove) (fun _ ↦ E.cons_comp_f_eq W _
        (E.chosenLift_spec W t _) x hx _) =
      E.cechBasis W Λ t (fun _ ↦ E.chosenLift W t ⟨x 0, hx 0⟩)
        (fun _ ↦ E.chosenLift_spec W t ⟨x 0, hx 0⟩) :=
    E.cechBasis_congr W Λ _ _ rfl (funext fun a ↦ by
      rw [Fin.fin_one_eq_zero a]
      rfl)
  rw [h0, h1]
  simp only [Fin.val_zero, Fin.val_one, pow_zero, pow_one, one_smul, neg_smul]
  abel

set_option backward.isDefEq.respectTransparency false in
/-- The contraction identity in degree `p + 1`: `d ≫ h + h ≫ d = 𝟙` on `K_{p+1}(W)`. -/
lemma cechHomotopy_comp_succ (p : ℕ) :
    ((E.cechChainComplex (freeCoyoneda W Λ)).d (p + 1) p ≫ E.cechHomotopy W Λ p :
        ∐ E.cechChainFactor (freeCoyoneda W Λ) (p + 1) ⟶
          ∐ E.cechChainFactor (freeCoyoneda W Λ) (p + 1)) +
      (E.cechHomotopy W Λ (p + 1) ≫ (E.cechChainComplex (freeCoyoneda W Λ)).d (p + 2) (p + 1) :
        ∐ E.cechChainFactor (freeCoyoneda W Λ) (p + 1) ⟶
          ∐ E.cechChainFactor (freeCoyoneda W Λ) (p + 1)) = 𝟙 _ := by
  refine E.cechBasis_hom_ext W Λ fun t x hx ↦ ?_
  have h0 : E.cechBasis W Λ t ((Fin.cons (E.chosenLift W t ⟨x 0, hx 0⟩) x :
      Fin (p + 3) → Σ i : E.I₀, (W ⟶ E.X i)) ∘ (0 : Fin (p + 3)).succAbove)
        (fun _ ↦ E.cons_comp_f_eq W _ (E.chosenLift_spec W t _) x hx _) = E.cechBasis W Λ t x hx :=
    E.cechBasis_congr W Λ _ _ rfl (funext fun _ ↦ by simp)
  have h1 : ∀ j : Fin (p + 2), E.cechBasis W Λ t ((Fin.cons (E.chosenLift W t ⟨x 0, hx 0⟩) x :
      Fin (p + 3) → Σ i : E.I₀, (W ⟶ E.X i)) ∘ j.succ.succAbove)
        (fun _ ↦ E.cons_comp_f_eq W _ (E.chosenLift_spec W t _) x hx _) =
      E.cechBasis W Λ t (Fin.cons (E.chosenLift W t ⟨x 0, hx 0⟩) (x ∘ j.succAbove))
        (E.cons_comp_f_eq W _ (E.chosenLift_spec W t _) _ (fun _ ↦ hx _)) := fun j ↦
    E.cechBasis_congr W Λ _ _ rfl (Fin.cons_comp_succ_succAbove _ _ _)
  have h2 : ∀ j : Fin (p + 2), E.cechHomotopy W Λ p
      ((-1 : ℤ) ^ (j : ℕ) • E.cechBasis W Λ t (x ∘ j.succAbove) (fun _ ↦ hx _)) =
      (-1 : ℤ) ^ (j : ℕ) • E.cechBasis W Λ t (Fin.cons (E.chosenLift W t ⟨x 0, hx 0⟩)
        (x ∘ j.succAbove)) (E.cons_comp_f_eq W _ (E.chosenLift_spec W t _) _ (fun _ ↦ hx _)) :=
    fun j ↦ by rw [map_zsmul, cechHomotopy_cechBasis]
  rw [moduleCat_add_apply, ConcreteCategory.comp_apply, ConcreteCategory.comp_apply,
    ConcreteCategory.id_apply]
  erw [cechChainComplex_d_cechBasis]
  rw [map_sum]
  erw [Finset.sum_congr rfl fun j _ ↦ h2 j]
  rw [cechHomotopy_cechBasis]
  erw [cechChainComplex_d_cechBasis]
  rw [Fin.sum_univ_succ (n := p + 2)]
  rw [h0]
  simp only [h1, Fin.val_succ, pow_succ, mul_neg_one, neg_smul, Finset.sum_neg_distrib,
    Fin.val_zero, pow_zero, one_smul]
  abel

/-- **The augmented Čech complex of `V ↦ Λ^(Hom(W, V))` is exact in positive degrees**: for any
family `E = (U_i ⟶ X)` and any object `W`, the complex
`⋯ ⟶ ⨁_ν Λ^(Hom(W, U_ν)) ⟶ ⋯ ⟶ ⨁_i Λ^(Hom(W, U_i)) ⟶ Λ^(Hom(W, X))` is exact at every term
`K_p`, `p ≥ 0`. -/
theorem augmentedCechChainComplex_freeCoyoneda_exactAt (q : ℕ) :
    (E.augmentedCechChainComplex (freeCoyoneda W Λ)).ExactAt (q + 1) := by
  rw [HomologicalComplex.exactAt_iff' _ (q + 2) (q + 1) q (by simp) (by simp)]
  rcases q with _ | p
  · exact Stacks.CategoryTheory.ShortComplex.exact_of_contraction _ (E.cechHomotopyAug W Λ)
      (E.cechHomotopy W Λ 0) (E.cechHomotopy_comp_zero W Λ)
  · exact Stacks.CategoryTheory.ShortComplex.exact_of_contraction _ (E.cechHomotopy W Λ p)
      (E.cechHomotopy W Λ (p + 1)) (E.cechHomotopy_comp_succ W Λ p)

end Contraction

/-! ### Free presheaves on representables -/

section Presheaf

variable {C : Type u} [Category.{v} C] {X : C} (E : PreZeroHypercover.{w} X)
  [∀ (n : ℕ) (i : Fin (n + 1) → E.I₀), HasProduct (fun a ↦ Over.mk (E.f (i a)))]
  (Λ : Type v) [Ring Λ] [HasCoproducts.{w} (ModuleCat.{v} Λ)]

/-- The functor `V ↦ Λ^(Hom(-, V))` to presheaves of `Λ`-modules. -/
noncomputable abbrev freeYoneda : C ⥤ (Cᵒᵖ ⥤ ModuleCat.{v} Λ) :=
  yoneda ⋙ (Functor.whiskeringRight Cᵒᵖ (Type v) (ModuleCat.{v} Λ)).obj (ModuleCat.free Λ)

/-- The augmented Čech complex of free presheaves of `Λ`-modules on representables is exact in
positive degrees, objectwise by `augmentedCechChainComplex_freeCoyoneda_exactAt`. -/
theorem augmentedCechChainComplex_freeYoneda_exactAt (q : ℕ) :
    (E.augmentedCechChainComplex (freeYoneda Λ)).ExactAt (q + 1) := by
  rw [HomologicalComplex.exactAt_iff]
  refine ShortComplex.exact_of_forall_exact_map_evaluation _ fun W ↦ ?_
  have := ((E.augmentedCechChainComplex_freeCoyoneda_exactAt W.unop Λ q).of_iso
    (E.augmentedCechChainComplexMapIso (freeYoneda Λ)
      ((evaluation Cᵒᵖ (ModuleCat.{v} Λ)).obj W) (freeCoyoneda W.unop Λ) (Iso.refl _)))
  rw [HomologicalComplex.exactAt_iff] at this
  exact this

set_option backward.isDefEq.respectTransparency false in
/-- For a covering family `E`, the augmentation `⨁_i Λ^(Hom(-, U_i)) ⟶ Λ^(Hom(-, X))` of free
presheaves is locally surjective: a morphism `W ⟶ X` lifts to some `U_i` on a covering of
`W`. -/
theorem isLocallySurjective_cechChainComplexAugmentation_freeYoneda
    (J : GrothendieckTopology C) (hE : E.sieve₀ ∈ J X) :
    Presheaf.IsLocallySurjective J (E.cechChainComplexAugmentation (freeYoneda Λ)) := by
  constructor
  intro V s
  let f := E.cechChainComplexAugmentation (freeYoneda Λ)
  have hsingle : ∀ t : V ⟶ X,
      Presheaf.imageSieve f (ModuleCat.freeMk (R := Λ) t) ∈ J V := by
    intro t
    refine J.superset_covering ?_ (J.pullback_stable t hE)
    intro W g hg
    obtain ⟨i, e, he⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hg
    have hx : ∀ a : Fin 1, ((fun _ ↦ (⟨i, e⟩ : Σ i : E.I₀, (W ⟶ E.X i))) a).2 ≫
        E.f ((fun _ ↦ (⟨i, e⟩ : Σ i : E.I₀, (W ⟶ E.X i))) a).1 = g ≫ t := fun _ ↦ he.symm
    refine ⟨(Sigma.ι (E.cechChainFactor (freeYoneda Λ) 0) (fun _ ↦ i)).app (op W)
      (ModuleCat.freeMk (E.tupleHom W (g ≫ t) _ hx)), ?_⟩
    change (Sigma.ι (E.cechChainFactor (freeYoneda Λ) 0) (fun _ ↦ i) ≫
      E.cechChainComplexAugmentation (freeYoneda Λ)).app (op W) (ModuleCat.freeMk _) = _
    rw [ι_cechChainComplexAugmentation]
    erw [ModuleCat.free_map_apply, ModuleCat.free_map_apply]
    exact congrArg _ (E.tupleHom_hom W (g ≫ t) _ hx)
  induction s using Finsupp.induction_linear with
  | zero =>
    refine J.superset_covering (fun W g _ ↦ ⟨0, ?_⟩) (J.top_mem _)
    rw [map_zero, map_zero]
  | add a b ha hb =>
    refine J.superset_covering (fun W g hg ↦ ?_) (J.intersection_covering ha hb)
    obtain ⟨⟨y, hy⟩, ⟨y', hy'⟩⟩ := hg
    exact ⟨y + y', by rw [map_add, map_add, hy, hy']⟩
  | single t c =>
    refine J.superset_covering (fun W g hg ↦ ?_) (hsingle t)
    obtain ⟨y, hy⟩ := hg
    refine ⟨c • y, ?_⟩
    have : (Finsupp.single t c : (V ⟶ X) →₀ Λ) = c • ModuleCat.freeMk (R := Λ) t := by
      exact (Finsupp.smul_single_one t c).symm
    rw [map_smul, hy, this, map_smul]

end Presheaf

end CategoryTheory.PreZeroHypercover

namespace AlgebraicGeometry.SmallEtale

variable {B : BigEtaleSite.{u}} {X : Scheme.{u}} {hX : B.Contains X} {Λ : Type u} [Ring Λ]
  {U : SmallEtale B X hX} (𝔛 : PreZeroHypercover.{w} U) [UnivLE.{w, u}]

/-- **The augmented Čech complex of free sheaves of a covering is exact.** For an étale
covering `𝔛 = (U_ν ⟶ U)` of an object `U` of the small étale site of `X`, the augmented complex
`⋯ ⟶ K_1(𝔛, Λ) ⟶ K_0(𝔛, Λ) ⟶ (Ũ)^Λ ⟶ 0` of sheaves of `Λ`-modules is exact. -/
@[weil "lem_fk104_cech_free_complex_exact"]
theorem acyclic_augment_cechFreeComplex (h𝔛 : 𝔛.sieve₀ ∈ topology B X hX U) :
    ((cechFreeComplex (Λ := Λ) 𝔛).augment (cechFreeComplexAugmentation 𝔛)
      (𝔛.cechChainComplex_d_comp_augmentation _)).Acyclic := by
  let L := presheafToSheaf (topology B X hX) (ModuleCat.{u} Λ)
  let e := 𝔛.augmentedCechChainComplexMapIso (PreZeroHypercover.freeYoneda Λ) L
    (freeRepresentedSheaf B X hX Λ) (Iso.refl _)
  intro n
  refine HomologicalComplex.ExactAt.of_iso ?_ e.symm
  rcases n with _ | q
  · rw [HomologicalComplex.exactAt_iff' _ 1 0 0 (by simp) (by simp)]
    refine (ShortComplex.exact_iff_epi _ ?_).2 ?_
    · exact L.map_zero _ _ ▸ congrArg L.map ((𝔛.augmentedCechChainComplex
        (PreZeroHypercover.freeYoneda Λ)).shape 0 0 (by simp))
    · have := 𝔛.isLocallySurjective_cechChainComplexAugmentation_freeYoneda Λ
        (topology B X hX) h𝔛
      have : Sheaf.IsLocallySurjective
          (L.map (𝔛.cechChainComplexAugmentation (PreZeroHypercover.freeYoneda Λ))) :=
        (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ _).2 this
      change Epi (L.map (𝔛.cechChainComplexAugmentation (PreZeroHypercover.freeYoneda Λ)))
      exact Sheaf.epi_of_isLocallySurjective _
  · rw [HomologicalComplex.exactAt_iff]
    exact ((HomologicalComplex.exactAt_iff _ _).1
      (𝔛.augmentedCechChainComplex_freeYoneda_exactAt Λ q)).map L

/-- The augmented Čech complex of free sheaves of a jointly surjective family of étale
morphisms `U_ν ⟶ U` is exact. -/
@[weil "lem_fk104_cech_free_complex_exact"]
theorem acyclic_augment_cechFreeComplex_of_jointlySurjective
    (h𝔛 : ∀ x : (toScheme B X hX).obj U, ∃ i, x ∈ Set.range ((toScheme B X hX).map (𝔛.f i))) :
    ((cechFreeComplex (Λ := Λ) 𝔛).augment (cechFreeComplexAugmentation 𝔛)
      (𝔛.cechChainComplex_d_comp_augmentation _)).Acyclic :=
  acyclic_augment_cechFreeComplex 𝔛 (mem_topology_of_jointlySurjective fun x ↦
    let ⟨i, hi⟩ := h𝔛 x
    ⟨_, 𝔛.f i, 𝔛.sieve₀_f i, hi⟩)

end AlgebraicGeometry.SmallEtale
