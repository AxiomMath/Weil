/-!
# Representatives of Čech cohomology classes of an object of `Et(S)`

Let `U` be an object of the étale category `Et(S)` of noetherian separated étale `S`-schemes and
`F` a presheaf of abelian groups on `Et(S)`. The Čech cohomology group `Ȟ^i(U, F)` is generated by
the classes `[z]_𝔘` of cocycles `z ∈ Z^i(𝔘, F)` of the coverings `𝔘 ∈ Cov(U)`. Since any two
coverings have a common refinement, namely the covering by the pairwise fibre products of their
members, and refinement does not change classes, every element of `Ȟ^i(U, F)` is a single class
`[z]_𝔘`. Moreover `[z]_𝔘 + [w]_𝔘 = [z + w]_𝔘`.

## Main definitions

* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.CechCovering.single`: the covering `(id_U)`
  of `U` by itself.
* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.CechCovering.inter`: the covering
  `(U_ν ×_U V_μ ⟶ U)_{ν, μ}` of two coverings `𝔘` and `𝔙`, with its refinement maps
  `interFst : 𝔘 ⊓ 𝔙 ⟶ 𝔘` and `interSnd : 𝔘 ⊓ 𝔙 ⟶ 𝔙`.

## Main results

* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.exists_cechClass_eq`: every element of
  `Ȟ^i(U, F)` is `[z]_𝔘` for some covering `𝔘` and cocycle `z ∈ Z^i(𝔘, F)`.
* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.cechClass_add`:
  `[z]_𝔘 + [w]_𝔘 = [z + w]_𝔘`.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, I.2][FreitagKiehl]
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe a u

namespace AlgebraicGeometry

namespace SmallNoetherianSeparatedEtale

variable {B : BigEtaleSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

namespace CechCovering

variable {U : SmallNoetherianSeparatedEtale B S hS}

variable (U) in
/-- The covering `(id_U)` of `U` by itself. -/
def single : CechCovering U where
  n := 1
  pos := Nat.one_pos
  X _ := U
  f _ := 𝟙 U
  iUnion_range := by
    refine Set.eq_univ_of_forall fun x ↦ Set.mem_iUnion.mpr ⟨0, x, ?_⟩
    simp

/-- **The common refinement of two coverings.** For coverings `𝔘 = (U_ν ⟶ U)_ν` and
`𝔙 = (V_μ ⟶ U)_μ`, the covering `(U_ν ×_U V_μ ⟶ U)_{(ν, μ)}`, indexed by `Fin (n * m)` through
`finProdFinEquiv`. -/
noncomputable def inter (𝔘 𝔙 : CechCovering U) : CechCovering U where
  n := 𝔘.n * 𝔙.n
  pos := Nat.mul_pos 𝔘.pos 𝔙.pos
  X k := pullbackObj (𝔘.f (finProdFinEquiv.symm k).1) (𝔙.f (finProdFinEquiv.symm k).2)
  f k := pullbackFst _ _ ≫ 𝔘.f (finProdFinEquiv.symm k).1
  iUnion_range := by
    refine Set.eq_univ_of_forall fun x ↦ ?_
    obtain ⟨ν, hν⟩ := Set.mem_iUnion.mp (𝔘.iUnion_range.symm ▸ Set.mem_univ x)
    obtain ⟨μ, hμ⟩ := Set.mem_iUnion.mp (𝔙.iUnion_range.symm ▸ Set.mem_univ x)
    obtain ⟨p, hp⟩ := hν
    obtain ⟨q, hq⟩ := hμ
    obtain ⟨z, hz, -⟩ := exists_pullbackObj_point (𝔘.f ν) (𝔙.f μ) p q (hp.trans hq.symm)
    obtain ⟨k, hk⟩ := finProdFinEquiv.symm.surjective (ν, μ)
    have key : ∀ pr : Fin 𝔘.n × Fin 𝔙.n, pr = (ν, μ) →
        x ∈ Set.range ((toScheme B S hS).map (pullbackFst (𝔘.f pr.1) (𝔙.f pr.2) ≫ 𝔘.f pr.1)) := by
      rintro _ rfl
      refine ⟨z, ?_⟩
      rw [Functor.map_comp, Scheme.Hom.comp_apply, hz, hp]
    exact Set.mem_iUnion.mpr ⟨k, key _ hk⟩

/-- The refinement map `𝔘 ⊓ 𝔙 ⟶ 𝔘`. -/
noncomputable def interFst (𝔘 𝔙 : CechCovering U) :
    (𝔘.inter 𝔙).toPreZeroHypercover ⟶ 𝔘.toPreZeroHypercover where
  s₀ k := (finProdFinEquiv.symm k).1
  h₀ _ := pullbackFst _ _
  w₀ _ := rfl

/-- The refinement map `𝔘 ⊓ 𝔙 ⟶ 𝔙`. -/
noncomputable def interSnd (𝔘 𝔙 : CechCovering U) :
    (𝔘.inter 𝔙).toPreZeroHypercover ⟶ 𝔙.toPreZeroHypercover where
  s₀ k := (finProdFinEquiv.symm k).2
  h₀ _ := pullbackSnd _ _
  w₀ _ := ((isPullback_pullbackFst_pullbackSnd _ _).w).symm

end CechCovering

variable {U : SmallNoetherianSeparatedEtale B S hS} (F : EtalePresheaf B S hS AddCommGrpCat.{a})
  (i : ℕ)

/-- **Additivity of the class map**: `[z]_𝔘 + [w]_𝔘 = [z + w]_𝔘`. -/
@[weil "lem_fk102_cech_class_representative"]
lemma cechClass_add (𝔘 : CechCovering U) (z w : cechCycles 𝔘.toPreZeroHypercover F i) :
    cechClass F i 𝔘 z + cechClass F i 𝔘 w = cechClass F i 𝔘 (z + w) :=
  (map_add (cechClass F i 𝔘) z w).symm

/-- **Every Čech class has a representative on one covering**: every element of `Ȟ^i(U, F)` is
`[z]_𝔘` for some covering `𝔘 ∈ Cov(U)` and some cocycle `z ∈ Z^i(𝔘, F)`. -/
@[weil "lem_fk102_cech_class_representative"]
theorem exists_cechClass_eq (x : cechCohomologyOfObject U F i) :
    ∃ (𝔘 : CechCovering U) (z : cechCycles 𝔘.toPreZeroHypercover F i),
      cechClass F i 𝔘 z = x := by
  induction x using cechCohomologyOfObject_induction_on F i with
  | zero => exact ⟨CechCovering.single U, 0, map_zero _⟩
  | cechClass 𝔘 z => exact ⟨𝔘, z, rfl⟩
  | add x y hx hy =>
    obtain ⟨𝔘, z, rfl⟩ := hx
    obtain ⟨𝔙, w, rfl⟩ := hy
    refine ⟨𝔘.inter 𝔙, cechCyclesMap F i (𝔘.interFst 𝔙) z +
      cechCyclesMap F i (𝔘.interSnd 𝔙) w, ?_⟩
    rw [← cechClass_add, cechClass_cechCyclesMap, cechClass_cechCyclesMap]

end SmallNoetherianSeparatedEtale

end AlgebraicGeometry

end

/-! ### Equality of classes in the Čech cohomology of an object -/

/-!
# Equality of classes in the Čech cohomology of an object

Let `Et(S)` be the étale category of noetherian separated étale `S`-schemes, `U` an object of
`Et(S)` and `F` a presheaf of abelian groups on `Et(S)`. The Čech cohomology group `Ȟ^i(U, F)` is
the quotient of `⨁_{𝔘 ∈ Cov(U)} Z^i(𝔘, F)` by the subgroup `N` generated by the differences
`e_𝔘 z - e_𝔘' z'` of equivalent cocycles `(𝔘, z) ∼ (𝔘', z')`. We show that two classes
`[z]_𝔘` and `[z']_𝔘'` agree if and only if `(𝔘, z) ∼ (𝔘', z')`.

Any two coverings `𝔘`, `𝔘'` of `U` have the common refinement `𝔘 ×_U 𝔘'` by the fibre products
`U_ν ×_U U'_μ`. Ordering the coverings by refinement, the groups `Ȟ^i(𝔘, F) = Z^i/B^i` form a
directed system: a refinement `φ : 𝔚 ⟶ 𝔘` induces `Ȟ^i(𝔘, F) → Ȟ^i(𝔚, F)`, which does not
depend on `φ` since two refinements induce homotopic cochain maps. The direct limit of this
system is an abelian group in which equality of elements is tested on a common refinement. The
family `z ↦ [z]` into it respects `∼`, hence factors through `Ȟ^i(U, F)`, and equality of the
images of `[z]_𝔘` and `[z']_𝔘'` there is exactly `(𝔘, z) ∼ (𝔘', z')`.

## Main definitions

* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.CechCovering.self`: the covering of `U` by
  its identity.
* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.CechCovering.inf`: the common refinement
  `𝔘 ×_U 𝔘'` of two coverings, with its refinement maps `CechCovering.infFst` and
  `CechCovering.infSnd`.

## Main results

* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.cechClass_eq_cechClass_iff`:
  `[z]_𝔘 = [z']_𝔘'` in `Ȟ^i(U, F)` if and only if `(𝔘, z) ∼ (𝔘', z')`.

## Implementation notes

The source proves the converse by putting an abelian group structure on the set of equivalence
classes of pairs `(𝔘, z)`. Here the group is Mathlib's direct limit `DirectLimit` of the groups
`Ȟ^i(𝔘, F)` over the coverings preordered by refinement, which carries the group structure and
the description of equality of its elements; the group of pairs modulo `∼` is identified with
it, since `(𝔘, z) ∼ (𝔘', z')` says that the images of the classes of `z` and `z'` in a common
refinement agree.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, I.2][FreitagKiehl]
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe a u

namespace AlgebraicGeometry

namespace SmallNoetherianSeparatedEtale

variable {B : BigEtaleSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

namespace CechCovering

variable (U : SmallNoetherianSeparatedEtale B S hS)

/-- The covering of `U` by the single member `𝟙 U`. -/
def self : CechCovering U where
  n := 1
  pos := Nat.one_pos
  X _ := U
  f _ := 𝟙 U
  iUnion_range := by
    refine Set.eq_univ_of_forall fun x ↦ Set.mem_iUnion.mpr ⟨0, x, ?_⟩
    rw [CategoryTheory.Functor.map_id]
    rfl

instance : Nonempty (CechCovering U) := ⟨self U⟩

variable {U}

/-- The common refinement `𝔘 ×_U 𝔘'` of two coverings: the covering by the fibre products
`U_ν ×_U U'_μ`, indexed by `Fin (n * n')` through `finProdFinEquiv`. -/
noncomputable def inf (𝔘 𝔘' : CechCovering U) : CechCovering U where
  n := 𝔘.n * 𝔘'.n
  pos := Nat.mul_pos 𝔘.pos 𝔘'.pos
  X p := pullbackObj (𝔘.f (finProdFinEquiv.symm p).1) (𝔘'.f (finProdFinEquiv.symm p).2)
  f p := pullbackFst _ _ ≫ 𝔘.f (finProdFinEquiv.symm p).1
  iUnion_range := by
    refine Set.eq_univ_of_forall fun x ↦ ?_
    obtain ⟨ν, a, ha⟩ := Set.mem_iUnion.mp (𝔘.iUnion_range ▸ Set.mem_univ x)
    obtain ⟨μ, b, hb⟩ := Set.mem_iUnion.mp (𝔘'.iUnion_range ▸ Set.mem_univ x)
    refine Set.mem_iUnion.mpr ⟨finProdFinEquiv (ν, μ), ?_⟩
    generalize hq : finProdFinEquiv.symm (finProdFinEquiv (ν, μ)) = q
    obtain rfl : q = (ν, μ) := by rw [← hq, Equiv.symm_apply_apply]
    obtain ⟨w, hw, -⟩ := Scheme.Pullback.exists_preimage_pullback a b (ha.trans hb.symm)
    refine ⟨w, ?_⟩
    rw [CategoryTheory.Functor.map_comp, toScheme_map_pullbackFst]
    exact (Scheme.Hom.comp_apply _ _ w).trans ((congrArg _ hw).trans ha)

/-- The refinement map `𝔘 ×_U 𝔘' ⟶ 𝔘`, by the first projections. -/
noncomputable def infFst (𝔘 𝔘' : CechCovering U) :
    (inf 𝔘 𝔘').toPreZeroHypercover ⟶ 𝔘.toPreZeroHypercover where
  s₀ p := (finProdFinEquiv.symm p).1
  h₀ _ := pullbackFst _ _
  w₀ _ := rfl

/-- The refinement map `𝔘 ×_U 𝔘' ⟶ 𝔘'`, by the second projections. -/
noncomputable def infSnd (𝔘 𝔘' : CechCovering U) :
    (inf 𝔘 𝔘').toPreZeroHypercover ⟶ 𝔘'.toPreZeroHypercover where
  s₀ p := (finProdFinEquiv.symm p).2
  h₀ _ := pullbackSnd _ _
  w₀ _ := (isPullback_pullbackFst_pullbackSnd _ _).w.symm

/-- **Common refinement.** Any two coverings of `U` have a common refinement. -/
lemma exists_common_refinement (𝔘 𝔘' : CechCovering U) :
    ∃ 𝔚 : CechCovering U, Nonempty (𝔚.toPreZeroHypercover ⟶ 𝔘.toPreZeroHypercover) ∧
      Nonempty (𝔚.toPreZeroHypercover ⟶ 𝔘'.toPreZeroHypercover) :=
  ⟨inf 𝔘 𝔘', ⟨infFst 𝔘 𝔘'⟩, ⟨infSnd 𝔘 𝔘'⟩⟩

end CechCovering

section DirectLimit

variable {U : SmallNoetherianSeparatedEtale B S hS} (F : EtalePresheaf B S hS AddCommGrpCat.{a})
  (i : ℕ)

/-- The coverings of `U`, preordered by refinement: `𝔘 ≤ 𝔚` when there is a refinement map
`𝔚 ⟶ 𝔘`. -/
def CechCoveringRefinement (U : SmallNoetherianSeparatedEtale B S hS) : Type (u + 1) :=
  CechCovering U

namespace CechCoveringRefinement

/-- A covering as an element of the refinement preorder. -/
abbrev of {U : SmallNoetherianSeparatedEtale B S hS} (𝔘 : CechCovering U) :
    CechCoveringRefinement U :=
  𝔘

/-- The covering underlying an element of the refinement preorder. -/
abbrev toCechCovering {U : SmallNoetherianSeparatedEtale B S hS} (𝔘 : CechCoveringRefinement U) :
    CechCovering U :=
  𝔘

instance : Preorder (CechCoveringRefinement U) where
  le 𝔘 𝔚 := Nonempty (𝔚.toCechCovering.toPreZeroHypercover ⟶ 𝔘.toCechCovering.toPreZeroHypercover)
  le_refl _ := ⟨𝟙 _⟩
  le_trans _ _ _ := fun ⟨φ⟩ ⟨ψ⟩ ↦ ⟨ψ ≫ φ⟩

instance : IsDirectedOrder (CechCoveringRefinement U) :=
  ⟨fun 𝔘 𝔘' ↦ ⟨of (CechCovering.inf 𝔘.toCechCovering 𝔘'.toCechCovering),
    ⟨CechCovering.infFst _ _⟩, ⟨CechCovering.infSnd _ _⟩⟩⟩

instance : Nonempty (CechCoveringRefinement U) := ⟨of (CechCovering.self U)⟩

end CechCoveringRefinement

open CechCoveringRefinement

/-- The group `Ȟ^i(𝔘, F) = Z^i(𝔘, F) / im d^{i-1}` of a covering. -/
abbrev cechCohomologyQuotient (𝔘 : CechCoveringRefinement U) : Type a :=
  cechCycles 𝔘.toCechCovering.toPreZeroHypercover F i ⧸
    ((cechComplex 𝔘.toCechCovering.toPreZeroHypercover F).d (i - 1) i).hom.range.addSubgroupOf
      (cechCycles 𝔘.toCechCovering.toPreZeroHypercover F i)

/-- `(ψ ≫ φ)^* = ψ^* ∘ φ^*` on cocycles. -/
lemma cechCyclesMap_comp {E G H : PreZeroHypercover.{0} U} (ψ : E ⟶ G) (φ : G ⟶ H)
    (z : cechCycles H F i) :
    cechCyclesMap F i (ψ ≫ φ) z = cechCyclesMap F i ψ (cechCyclesMap F i φ z) := by
  ext
  have h : refinementCochainMap (ψ ≫ φ) F = refinementCochainMap φ F ≫ refinementCochainMap ψ F :=
    (Stacks.CechSite.cechComplexMap_comp E G H
      ((PreZeroHypercover.homOverIdEquivHom E G).symm ψ)
      ((PreZeroHypercover.homOverIdEquivHom G H).symm φ) (Category.comp_id (𝟙 U)) F).symm
  rw [coe_cechCyclesMap, coe_cechCyclesMap, coe_cechCyclesMap, h, HomologicalComplex.comp_f,
    ConcreteCategory.comp_apply]

/-- Two refinements `φ, ψ : 𝔚 ⟶ 𝔘` induce the same map on `Ȟ^i`. -/
lemma mk_cechCyclesMap_eq {𝔚 𝔘 : CechCoveringRefinement U}
    (φ ψ : 𝔚.toCechCovering.toPreZeroHypercover ⟶ 𝔘.toCechCovering.toPreZeroHypercover)
    (z : cechCycles 𝔘.toCechCovering.toPreZeroHypercover F i) :
    (QuotientAddGroup.mk (cechCyclesMap F i φ z) : cechCohomologyQuotient F i 𝔚) =
      QuotientAddGroup.mk (cechCyclesMap F i ψ z) := by
  rw [QuotientAddGroup.eq, AddSubgroup.mem_addSubgroupOf, AddSubgroup.coe_add,
    AddSubgroup.coe_neg, neg_add_eq_sub, coe_cechCyclesMap, coe_cechCyclesMap]
  exact refinementCochainMap_sub_mem_range ψ φ F z.2

/-- The map `Ȟ^i(𝔘, F) → Ȟ^i(𝔚, F)` of a refinement, for `𝔘 ≤ 𝔚`. -/
noncomputable def cechCohomologyQuotientMap (𝔘 𝔚 : CechCoveringRefinement U) (h : 𝔘 ≤ 𝔚) :
    cechCohomologyQuotient F i 𝔘 →+ cechCohomologyQuotient F i 𝔚 :=
  QuotientAddGroup.map _ _ (cechCyclesMap F i h.some) (by
    intro z hz
    rw [AddSubgroup.mem_comap, AddSubgroup.mem_addSubgroupOf]
    rw [AddSubgroup.mem_addSubgroupOf] at hz
    obtain ⟨y, hy⟩ := hz
    refine ⟨(refinementCochainMap h.some F).f (i - 1) y, ?_⟩
    have e := ConcreteCategory.congr_hom ((refinementCochainMap h.some F).comm (i - 1) i) y
    simp only [ConcreteCategory.comp_apply] at e
    rw [coe_cechCyclesMap, ← hy]
    exact e)

lemma cechCohomologyQuotientMap_mk {𝔘 𝔚 : CechCoveringRefinement U} (h : 𝔘 ≤ 𝔚)
    (φ : 𝔚.toCechCovering.toPreZeroHypercover ⟶ 𝔘.toCechCovering.toPreZeroHypercover)
    (z : cechCycles 𝔘.toCechCovering.toPreZeroHypercover F i) :
    cechCohomologyQuotientMap F i 𝔘 𝔚 h (QuotientAddGroup.mk z) =
      QuotientAddGroup.mk (cechCyclesMap F i φ z) :=
  (QuotientAddGroup.map_mk _ _ _ _ z).trans (mk_cechCyclesMap_eq F i _ _ z)

instance : DirectedSystem (cechCohomologyQuotient F i (U := U))
    (fun 𝔘 𝔚 h ↦ cechCohomologyQuotientMap F i 𝔘 𝔚 h) where
  map_self 𝔘 x := by
    induction x using QuotientAddGroup.induction_on with
    | H z => rw [cechCohomologyQuotientMap_mk F i _ (𝟙 _), cechCyclesMap_id]
  map_map 𝔚 𝔙 𝔘 h₁ h₂ x := by
    induction x using QuotientAddGroup.induction_on with
    | H z =>
      rw [cechCohomologyQuotientMap_mk F i _ h₁.some, cechCohomologyQuotientMap_mk F i _ h₂.some,
        cechCohomologyQuotientMap_mk F i _ (h₂.some ≫ h₁.some), cechCyclesMap_comp]

/-- The direct limit of the groups `Ȟ^i(𝔘, F)` over the coverings of `U`. -/
abbrev cechCohomologyDirectLimit : Type (max (u + 1) a) :=
  DirectLimit (cechCohomologyQuotient F i (U := U)) (cechCohomologyQuotientMap F i)

/-- The map `Z^i(𝔘, F) → lim Ȟ^i(𝔚, F)`, `z ↦` the image of the class of `z`. -/
noncomputable def toCechCohomologyDirectLimit (𝔘 : CechCovering U) :
    cechCycles 𝔘.toPreZeroHypercover F i →+ cechCohomologyDirectLimit F i (U := U) where
  toFun z := ⟦⟨of 𝔘, QuotientAddGroup.mk z⟩⟧
  map_zero' := (DirectLimit.zero_def (of 𝔘)).symm
  map_add' z z' := by
    rw [QuotientAddGroup.mk_add]
    exact (DirectLimit.add_def (of 𝔘) _ _).symm

lemma toCechCohomologyDirectLimit_eq_iff {𝔘 𝔘' : CechCovering U}
    (z : cechCycles 𝔘.toPreZeroHypercover F i) (z' : cechCycles 𝔘'.toPreZeroHypercover F i) :
    toCechCohomologyDirectLimit F i 𝔘 z = toCechCohomologyDirectLimit F i 𝔘' z' ↔
      CechCycleRel F i z z' := by
  constructor
  · intro h
    obtain ⟨𝔚, h₁, h₂, e⟩ :=
      Quotient.exact (s := DirectLimit.setoid (cechCohomologyQuotientMap F i (U := U))) h
    refine ⟨𝔚.toCechCovering, h₁.some, h₂.some, ?_⟩
    change cechCohomologyQuotientMap F i (of 𝔘) 𝔚 h₁ (QuotientAddGroup.mk z) =
      cechCohomologyQuotientMap F i (of 𝔘') 𝔚 h₂ (QuotientAddGroup.mk z') at e
    rw [cechCohomologyQuotientMap_mk F i h₁ h₁.some, cechCohomologyQuotientMap_mk F i h₂ h₂.some,
      QuotientAddGroup.eq, AddSubgroup.mem_addSubgroupOf, AddSubgroup.coe_add,
      AddSubgroup.coe_neg, coe_cechCyclesMap, coe_cechCyclesMap] at e
    have e' := neg_mem e
    rwa [neg_add, neg_neg, ← sub_eq_add_neg] at e'
  · rintro ⟨𝔚, φ, φ', hr⟩
    refine Quotient.sound (s := DirectLimit.setoid (cechCohomologyQuotientMap F i (U := U)))
      ⟨of 𝔚, ⟨φ⟩, ⟨φ'⟩, ?_⟩
    change cechCohomologyQuotientMap F i (of 𝔘) (of 𝔚) ⟨φ⟩ (QuotientAddGroup.mk z) =
      cechCohomologyQuotientMap F i (of 𝔘') (of 𝔚) ⟨φ'⟩ (QuotientAddGroup.mk z')
    rw [cechCohomologyQuotientMap_mk F i _ φ, cechCohomologyQuotientMap_mk F i _ φ',
      QuotientAddGroup.eq, AddSubgroup.mem_addSubgroupOf, AddSubgroup.coe_add,
      AddSubgroup.coe_neg, coe_cechCyclesMap, coe_cechCyclesMap]
    have hr' := neg_mem hr
    rwa [neg_sub, sub_eq_neg_add] at hr'

end DirectLimit

variable {U : SmallNoetherianSeparatedEtale B S hS} (F : EtalePresheaf B S hS AddCommGrpCat.{a})
  (i : ℕ)

/-- **Equality of Čech classes.** For cocycles `z ∈ Z^i(𝔘, F)` and `z' ∈ Z^i(𝔘', F)`,
`[z]_𝔘 = [z']_𝔘'` in `Ȟ^i(U, F)` if and only if `(𝔘, z) ∼ (𝔘', z')`. -/
@[weil "lem_fk102_cech_class_equality"]
theorem cechClass_eq_cechClass_iff {𝔘 𝔘' : CechCovering U}
    (z : cechCycles 𝔘.toPreZeroHypercover F i) (z' : cechCycles 𝔘'.toPreZeroHypercover F i) :
    cechClass F i 𝔘 z = cechClass F i 𝔘' z' ↔ CechCycleRel F i z z' := by
  refine ⟨fun h ↦ ?_, cechClass_eq_cechClass F i⟩
  have := congrArg (cechCohomologyOfObjectDesc F i (toCechCohomologyDirectLimit F i)
    fun _ _ z z' hr ↦ (toCechCohomologyDirectLimit_eq_iff F i z z').mpr hr) h
  rw [cechCohomologyOfObjectDesc_cechClass, cechCohomologyOfObjectDesc_cechClass] at this
  exact (toCechCohomologyDirectLimit_eq_iff F i z z').mp this

end SmallNoetherianSeparatedEtale

end AlgebraicGeometry

