module

public import Weil.Attr
public import WeilFrontier.CategoryTheory.Sites.SheafificationIsSheaf
public import Mathlib.Algebra.Homology.ShortComplex.ShortExact
public import Mathlib.CategoryTheory.Sites.LeftExact

/-!
# Sheafification is exact

Let `J` be a Grothendieck topology on a category `C` and `D` a concrete abelian category in
which the plus construction can be formed (for instance abelian groups). The functor
`F ↦ F̂ = F̃̃`, `α ↦ α̂`, sending a presheaf to the sheaf it generates, is exact: it carries a
short exact sequence `0 → F₁ → F₂ → F₃ → 0` of presheaves to a short exact sequence
`0 → F̂₁ → F̂₂ → F̂₃ → 0` in the abelian category of sheaves. Indeed, it is left adjoint to the
inclusion of sheaves into presheaves, so it preserves finite colimits, and the plus construction
commutes with finite limits, so it preserves finite limits as well.

## Main results

- `CategoryTheory.GrothendieckTopology.shortExact_map_plusPlusSheaf`: over an arbitrary site,
  sheafification `plusPlusSheaf J D` carries short exact sequences of presheaves to short exact
  sequences of sheaves.
- `AlgebraicGeometry.EtaleCategory.shortExact_map_plusPlusSheaf`: the case of presheaves of abelian
  groups on the étale category `Et(A)` of a commutative ring `A`.

## Implementation notes

The sheaf generated by a presheaf `P` is Mathlib's `CategoryTheory.GrothendieckTopology.sheafify`,
`J.sheafify P = plusObj (plusObj P)`, and the morphism of sheaves induced by `α : P ⟶ Q` is
`J.sheafifyMap α = plusMap (plusMap α)`; both are packaged in the functor
`CategoryTheory.plusPlusSheaf J D` to sheaves (`plusPlusSheaf_obj_val`, `plusPlusSheaf_map_hom`).
The image of a short complex `S` of presheaves under it is `S.map (plusPlusSheaf J D)`.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FreitagKiehl1988], I.1
-/

@[expose] public section

universe t w' w v u

open CategoryTheory Limits

namespace CategoryTheory.GrothendieckTopology

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  {D : Type w} [Category.{t} D] [Abelian D]
  {FD : D → D → Type*} {CD : D → Type t} [∀ X Y, FunLike (FD X Y) (CD X) (CD Y)]
  [ConcreteCategory.{t} D FD]
  [∀ {X : C} (S : J.Cover X), PreservesLimitsOfShape (WalkingMulticospan S.shape) (forget D)]
  [∀ (P : Cᵒᵖ ⥤ D) (X : C) (S : J.Cover X), HasMultiequalizer (S.index P)]
  [∀ X : C, HasColimitsOfShape (J.Cover X)ᵒᵖ D]
  [∀ X : C, PreservesColimitsOfShape (J.Cover X)ᵒᵖ (forget D)] [(forget D).ReflectsIsomorphisms]
  [PreservesLimits (forget D)] [∀ X : C, Small.{t, max u v} (J.Cover X)ᵒᵖ]

/-- **Sheafification is exact.** The functor sending a presheaf `P` to the sheaf
`J.sheafify P = P⁺⁺` it generates carries every short exact sequence of presheaves
`0 → F₁ → F₂ → F₃ → 0` to a short exact sequence of sheaves. -/
theorem shortExact_map_plusPlusSheaf {S : ShortComplex (Cᵒᵖ ⥤ D)} (hS : S.ShortExact) :
    (S.map (plusPlusSheaf J D)).ShortExact := by
  have : (plusPlusSheaf J D).IsLeftAdjoint := (plusPlusAdjunction J D).isLeftAdjoint
  exact hS.map_of_exact (plusPlusSheaf J D)

end CategoryTheory.GrothendieckTopology

namespace AlgebraicGeometry.EtaleCategory

variable {A : CommRingCat.{u}}

/-- The forgetful functor from abelian groups preserves the filtered colimits indexed by covering
sieves of `Et(A)`, which are colimits of size `u + 1`. It is a local instance only: as a global
instance its universe levels do not unify with those of unrelated goals. -/
theorem preservesFilteredColimitsOfSize_forget_addCommGrpCat_succ :
    PreservesFilteredColimitsOfSize.{u + 1, u + 1} (forget AddCommGrpCat.{max (u + 1) w}) :=
  preservesFilteredColimitsOfSize_shrink.{u + 1, w, u + 1, w} _

attribute [local instance] preservesFilteredColimitsOfSize_forget_addCommGrpCat_succ

/-- **Sheafification on `Et(A)` is exact.** For every short exact sequence
`0 → F₁ → F₂ → F₃ → 0` of presheaves of abelian groups on the étale category `Et(A)`, the
sequence `0 → F̂₁ → F̂₂ → F̂₃ → 0` of the sheaves they generate, with the induced morphisms
`α̂ = J.sheafifyMap α`, is short exact in the category of sheaves of abelian groups. -/
@[weil "lem_fk101_sheafification_exact"]
theorem shortExact_map_plusPlusSheaf
    {S : ShortComplex (Presheaf A AddCommGrpCat.{max (u + 1) w})} (hS : S.ShortExact) :
    (S.map (plusPlusSheaf (Scheme.AffineEtale.topology (Spec A))
      AddCommGrpCat.{max (u + 1) w})).ShortExact :=
  GrothendieckTopology.shortExact_map_plusPlusSheaf (Scheme.AffineEtale.topology (Spec A))
    (S := S) hS

end AlgebraicGeometry.EtaleCategory
