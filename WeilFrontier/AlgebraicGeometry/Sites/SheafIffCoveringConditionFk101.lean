module

public import Weil.Attr
public import WeilFrontier.AlgebraicGeometry.Sites.EtaleSheaf
public import WeilFrontier.Defs.CategoryTheory.Sites.CoveringRestriction

/-!
# Sheaves on the étale category via the restriction maps of coverings

Let `A` be a commutative ring and `F` a presheaf of sets on the étale category `Et(A)`. Then `F`
is a sheaf if and only if, for every object `B` of `Et(A)` and every étale covering
`𝔅 = (gᵢ : B ⟶ Cᵢ)ᵢ` of `B`, the restriction map `ρ_𝔅 : F(B) → F(𝔅)` to the compatible
families over `𝔅` is bijective.

## Main results

- `AlgebraicGeometry.EtaleCategory.isSheaf_iff_forall_bijective_coveringRestriction`: a
  presheaf of sets on `Et(A)` is a sheaf for the étale topology
  `Scheme.AffineEtale.topology (Spec A)` if and only if `ρ_𝔅` is bijective for every covering.
- `AlgebraicGeometry.EtaleCategory.isSheafAxioms_iff_forall_bijective_coveringRestriction`:
  the same with the sheaf axioms `IsSheafAxioms` (finite products and faithfully flat descent)
  in place of the sheaf condition for the topology.

## Implementation notes

The index type of a covering lives in an arbitrary universe. The proof goes through the
comparison `isSheaf_iff_isSheafAxioms` of the sheaf axioms with the sheaf condition for the
étale topology, which is generated by the finite coverings (`finiteCoverage_toGrothendieck`),
and through `bijective_coveringRestriction_iff_isSheafFor`, which identifies bijectivity of
`ρ_𝔅` with the sheaf condition for the presieve generated by `𝔅`.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FreitagKiehl1988], I.1
-/

@[expose] public noncomputable section

universe u w t

open CategoryTheory Opposite

namespace AlgebraicGeometry

namespace EtaleCategory

variable {A : CommRingCat.{u}}

/-- A presheaf of sets `F` on `Et(A)` is a sheaf for the étale topology if and only if for every
object `B` and every covering `𝔅 = (gᵢ : B ⟶ Cᵢ)ᵢ` of `B` the restriction map
`ρ_𝔅 : F(B) → F(𝔅)` is bijective. -/
@[weil "lem_fk101_sheaf_iff_covering_condition"]
theorem isSheaf_iff_forall_bijective_coveringRestriction (F : EtaleCategory A ⥤ Type w) :
    Presheaf.IsSheaf (Scheme.AffineEtale.topology (Spec A)) F ↔
      ∀ (B : EtaleCategory A) (ι : Type t) (C : ι → EtaleCategory A) (g : ∀ i, B ⟶ C i),
        IsCovering g → Function.Bijective (coveringRestriction F g) := by
  rw [isSheaf_iff_isSheaf_of_type]
  constructor
  · intro hF B ι C g hg
    rw [bijective_coveringRestriction_iff_isSheafFor, Presieve.isSheafFor_iff_generate]
    exact hF _ hg.mem_topology
  · intro h
    rw [← finiteCoverage_toGrothendieck, Presieve.isSheaf_coverage]
    rintro X R ⟨ι, _, Y, g, rfl, hg⟩
    have hcov : IsCovering (B := op X) (C := fun i : ULift.{t} ι ↦ op (Y i.down))
        (fun i ↦ (g i.down).op) := by
      refine ⟨inferInstance, fun p ↦ ?_⟩
      obtain ⟨i, q, hq⟩ := ((isCovering_iff_mem_topology (B := op X) (C := fun i ↦ op (Y i))
        (fun i ↦ (g i).op)).2 ⟨inferInstance, hg⟩).exists_comap_eq p
      exact ⟨⟨i⟩, q, hq⟩
    have hS : Presieve.IsSheafFor F
        (Presieve.ofArrows (fun i : ULift.{t} ι ↦ Y i.down) (fun i ↦ g i.down)) :=
      (bijective_coveringRestriction_iff_isSheafFor F _).1 (h _ _ _ _ hcov)
    rwa [show Presieve.ofArrows (fun i : ULift.{t} ι ↦ Y i.down) (fun i ↦ g i.down) =
        Presieve.ofArrows Y g from
      Presieve.ofArrows_comp_eq_of_surjective g ULift.down_surjective] at hS

/-- **The sheaf condition via coverings** [FK, I.1]. A presheaf of sets `F` on `Et(A)` satisfies
the sheaf axioms if and only if for every object `B` and every covering `𝔅 = (gᵢ : B ⟶ Cᵢ)ᵢ`
of `B` the restriction map `ρ_𝔅 : F(B) → F(𝔅)` is bijective. -/
@[weil "lem_fk101_sheaf_iff_covering_condition"]
theorem isSheafAxioms_iff_forall_bijective_coveringRestriction (F : EtaleCategory A ⥤ Type w) :
    IsSheafAxioms F ↔
      ∀ (B : EtaleCategory A) (ι : Type t) (C : ι → EtaleCategory A) (g : ∀ i, B ⟶ C i),
        IsCovering g → Function.Bijective (coveringRestriction F g) := by
  rw [← isSheaf_iff_isSheafAxioms, isSheaf_iff_forall_bijective_coveringRestriction]

end EtaleCategory

end AlgebraicGeometry
