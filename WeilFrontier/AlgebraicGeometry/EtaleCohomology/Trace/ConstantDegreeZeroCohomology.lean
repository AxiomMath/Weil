module

public import Weil.Attr
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Duality.LAdicFrobeniusLevel
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Duality.UnitSheafEndomorphism
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Duality.LAdicTowerTrace

/-!
# `H⁰` of the constant ℓ-adic sheaf on a geometrically connected proper scheme

Let `X` be a proper scheme over a finite field `k`, `k̄` an extension field of `k` such that
`X_k̄ = X ×_k k̄` is connected, and `ℓ` a prime. Then `H⁰(X_k̄, ℚ_ℓ)` is one-dimensional, the
geometric Frobenius acts on it as the identity, and so
`P₀(t) = det(1 - t F₀ | H⁰(X_k̄, ℚ_ℓ)) = 1 - t`.

The proof works level by level. On a connected scheme `Y`, every endomorphism of the constant
sheaf `ℤ/N` of `ℤ/N`-modules is multiplication by an integer, and `m • 𝟙 = m' • 𝟙` exactly when
`m ≡ m' (mod N)`; so `H⁰(Y, ℤ/N) = Ext⁰(ℤ/N, ℤ/N) ≅ ℤ/N`, generated by the identity, which every
restriction along `Y ⟶ Y` fixes. The levels of `H⁰(X_k̄, ℤ_ℓ)` are therefore cyclic of order
`ℓⁿ⁺¹`, the transitions are onto with kernel `ℓⁿ⁺¹`, and the limit is free of rank one.

## Main results

* `Weil.LAdicSheaf.finrank_rationalGeometricCompactlySupportedCohomology_constant_zero`:
  `dim H⁰(X_k̄, ℚ_ℓ) = 1`.
* `Weil.LAdicSheaf.rationalGeometricCompactlySupportedFrobenius_constant_zero_of_connected`:
  the Frobenius on `H⁰(X_k̄, ℚ_ℓ)` is the identity.
* `Weil.LAdicSheaf.charpoly_reverse_rationalGeometricCompactlySupportedFrobenius_constant_zero`:
  `P₀(t) = 1 - t`.

## Implementation notes

No smoothness, curve or invertibility hypothesis on `ℓ` is needed: the argument only uses that
`X_k̄` is connected. The field `k̄` is arbitrary.

## References

* [Freitag–Kiehl, *Étale Cohomology and the Weil Conjecture*, IV.1][FK]
* [Stacks Project, Tag 03V8](https://stacks.math.columbia.edu/tag/03V8)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Abelian Opposite
open AlgebraicGeometry AlgebraicGeometry.Scheme Stacks.Frobenius Stacks.EtaleCohomology

universe u v

namespace Weil

/-- On a one-dimensional space, `det(1 - t · id) = 1 - t`. -/
theorem charpoly_id_reverse_eq_one_sub_X {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    [Module.Finite K V] (h : Module.finrank K V = 1) :
    (LinearMap.id : V →ₗ[K] V).charpoly.reverse = 1 - Polynomial.X := by
  have hX : Polynomial.reverse (Polynomial.X : Polynomial K) = 1 := by
    have := Polynomial.reverse_mul_X (1 : Polynomial K)
    rwa [one_mul, ← Polynomial.C_1, Polynomial.reverse_C, Polynomial.C_1] at this
  rw [← Module.End.one_eq_id, LinearMap.charpoly_one, h, pow_one, sub_eq_add_neg,
    ← Polynomial.C_1, ← Polynomial.C_neg, Polynomial.reverse_add_C, Polynomial.natDegree_X,
    pow_one, hX]
  simp [sub_eq_add_neg]

section Endomorphisms

open Stacks.EtaleCohomology.ExtensionTorsor Stacks.EtaleCohomology.KummerFlag

variable {Y : Scheme.{u}} {N : ℕ}

/-- On a nonempty scheme, `m • 𝟙 = m' • 𝟙` on the constant sheaf `ℤ/N` iff `m ≡ m' (mod N)`. -/
theorem unitSheaf_nsmul_id_eq_nsmul_id_iff [Nonempty Y] (m m' : ℕ) :
    m • 𝟙 (unitSheaf (X := Y) N) = m' • 𝟙 _ ↔ (m : ZMod N) = m' := by
  have key : ∀ (m : ℕ) (x : Y),
      unitSheafEndEquiv N (m • 𝟙 (unitSheaf (X := Y) N)) x = ULift.up (m : ZMod N) := by
    intro m x
    rw [unitSheafEndEquiv_nsmul, LocallyConstant.smul_apply, unitSheafEndEquiv_id]
    apply ULift.ext
    change m • (1 : ZMod N) = _
    rw [nsmul_eq_mul, mul_one]
  constructor
  · intro h
    obtain ⟨x⟩ := ‹Nonempty Y›
    have := congrArg (fun w => unitSheafEndEquiv N w x) h
    simp only [key] at this
    exact congrArg ULift.down this
  · intro h
    apply (unitSheafEndEquiv N).injective
    ext x
    rw [key, key, h]

/-- On a preconnected scheme every endomorphism of the constant sheaf `ℤ/N` is `m • 𝟙`. -/
theorem exists_unitSheaf_eq_nsmul_id [NeZero N] [PreconnectedSpace Y]
    (w : unitSheaf (X := Y) N ⟶ unitSheaf N) : ∃ m : ℕ, w = m • 𝟙 _ := by
  obtain ⟨c, rfl⟩ := exists_eq_smul_id w
  exact ⟨c.val, by rw [← Nat.cast_smul_eq_nsmul (ZMod N), ZMod.natCast_zmod_val]⟩

theorem ext_mk₀_nsmul {C : Type*} [Category C] [Abelian C] [HasExt.{v} C] {A A' : C}
    (m : ℕ) (g : A ⟶ A') : Ext.mk₀ (m • g) = m • Ext.mk₀ g := by
  induction m with
  | zero => rw [zero_smul, zero_smul, Ext.mk₀_zero]
  | succ m ih => rw [succ_nsmul, succ_nsmul, Ext.mk₀_add, ih]

/-- On a preconnected scheme every class of `Ext⁰(ℤ/N, ℤ/N)` is `m • 1`. -/
theorem exists_ext_zero_unitSheaf_eq_mk₀_nsmul [NeZero N] [PreconnectedSpace Y]
    (y : Ext (unitSheaf (X := Y) N) (unitSheaf N) 0) :
    ∃ m : ℕ, y = Ext.mk₀ (m • 𝟙 _) := by
  obtain ⟨m, hm⟩ := exists_unitSheaf_eq_nsmul_id (Ext.homEquiv₀ y)
  exact ⟨m, by rw [← hm, Ext.mk₀_homEquiv₀_apply]⟩

/-- **Restriction is the identity on `H⁰(Y, ℤ/N)` of a preconnected scheme**, along every
`g : Y ⟶ Y`. -/
theorem constantExtRestriction_zero_eq_self [NeZero N] [PreconnectedSpace Y] (g : Y ⟶ Y)
    (y : Ext (Stacks.Cohomology.GlobalSections.constantModuleSheaf (ZMod N) Y.smallEtaleTopology)
      (Stacks.Cohomology.GlobalSections.constantModuleSheaf (ZMod N) Y.smallEtaleTopology) 0) :
    constantExtRestriction (ZMod N) g 0 y = y := by
  obtain ⟨m, rfl⟩ := exists_ext_zero_unitSheaf_eq_mk₀_nsmul (N := N) y
  rw [ext_mk₀_nsmul, map_nsmul, constantExtRestriction_apply, Ext.mapExactFunctor_mk₀,
    CategoryTheory.Functor.map_id, Ext.mk₀_comp_mk₀, Ext.mk₀_comp_mk₀, Category.comp_id,
    Iso.hom_inv_id]

/-- An automorphism of the constant sheaf `ℤ/N` of a connected scheme is `a • 𝟙` with inverse
`b • 𝟙`, `ab ≡ 1 (mod N)`. -/
theorem exists_iso_unitSheaf_eq_nsmul_id [NeZero N] [ConnectedSpace Y]
    (ψ : unitSheaf (X := Y) N ≅ unitSheaf N) :
    ∃ a b : ℕ, ψ.hom = a • 𝟙 _ ∧ ψ.inv = b • 𝟙 _ ∧ (a : ZMod N) * b = 1 := by
  obtain ⟨a, ha⟩ := exists_unitSheaf_eq_nsmul_id ψ.hom
  obtain ⟨b, hb⟩ := exists_unitSheaf_eq_nsmul_id ψ.inv
  have e := ψ.hom_inv_id
  rw [ha, hb, Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, smul_smul,
    ← one_smul ℕ (𝟙 (unitSheaf (X := Y) N)), smul_smul, mul_one,
    unitSheaf_nsmul_id_eq_nsmul_id_iff] at e
  exact ⟨a, b, ha, hb, by exact_mod_cast e⟩

end Endomorphisms

section Tower

open Stacks.EtaleCohomology.ExtensionTorsor Stacks.EtaleCohomology.LevelChange

variable {Y : Scheme.{u}} [ConnectedSpace Y] {ℓ : ℕ} [Fact ℓ.Prime]
  {F : ℕᵒᵖ ⥤ ModuleCat.{v} ℤ_[ℓ]}
  (Φ : ∀ n, F.obj (op n) ≃+ Ext (unitSheaf (X := Y) (ℓ ^ (n + 1))) (unitSheaf (ℓ ^ (n + 1))) 0)
  (h : ∀ n, ℓ ^ (n + 1) ∣ ℓ ^ (n + 1 + 1))
  (ψ : ∀ n, unitSheaf (X := Y) (ℓ ^ (n + 1)) ≅ unitSheaf (ℓ ^ (n + 1)))
  (hsq : ∀ n (x : F.obj (op (n + 1))),
    extMap Y (h n) (unitSheaf (ℓ ^ (n + 1))) 0
        (Φ n ((F.map (homOfLE (Nat.le_succ n)).op).hom x)) =
      (Φ (n + 1) x).comp (Ext.mk₀ (reduction Y (h n) ≫ (restrict Y (h n)).map (ψ n).hom))
        (add_zero 0))

omit [Fact ℓ.Prime] in
theorem neZero_pow_prime (n : ℕ) [Fact ℓ.Prime] : NeZero (ℓ ^ n) :=
  ⟨pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero⟩

attribute [local instance] neZero_pow_prime

/-- The `ℤ_ℓ`-action by `ℓᵐ` is the `ℕ`-action. -/
theorem padic_pow_smul_eq_nsmul {M : Type*} [AddCommGroup M] [Module ℤ_[ℓ] M] (m : ℕ) (x : M) :
    (ℓ : ℤ_[ℓ]) ^ m • x = ℓ ^ m • x := by
  rw [← Nat.cast_smul_eq_nsmul ℤ_[ℓ], Nat.cast_pow]

omit [ConnectedSpace Y] [Fact ℓ.Prime] in
/-- `c • π = π ≫ R(c • 𝟙)` for the reduction `π : ℤ/N_Y ⟶ R(ℤ/d_Y)`. -/
theorem nsmul_reduction_eq {N d : ℕ} (hd : d ∣ N) (c : ℕ) :
    c • reduction Y hd = reduction Y hd ≫ (restrict Y hd).map (c • 𝟙 (unitSheaf d)) := by
  rw [Functor.map_nsmul, CategoryTheory.Functor.map_id, Preadditive.comp_nsmul, Category.comp_id]

omit [ConnectedSpace Y] in
/-- `c • π = c' • π` iff `c ≡ c' (mod d)`, on a nonempty scheme. -/
theorem nsmul_reduction_eq_iff [Nonempty Y] {N d : ℕ} [NeZero N] (hd : d ∣ N) (c c' : ℕ) :
    c • reduction Y hd = c' • reduction Y hd ↔ (c : ZMod d) = c' := by
  rw [nsmul_reduction_eq, nsmul_reduction_eq, ← unitSheaf_nsmul_id_eq_nsmul_id_iff (Y := Y)]
  exact (bijective_reduction_comp_map Y hd (unitSheaf d)).1.eq_iff

omit [ConnectedSpace Y] in
/-- The change of level sends `mk₀ (m • 𝟙)` to `mk₀ (m • π)`. -/
theorem extMap_mk₀_nsmul_id {N d : ℕ} (hd : d ∣ N) (m : ℕ) :
    extMap Y hd (unitSheaf d) 0 (Ext.mk₀ (m • 𝟙 (unitSheaf (X := Y) d))) =
      Ext.mk₀ (m • reduction Y hd) := by
  rw [extMap_apply, Ext.mapExactFunctor_mk₀, Ext.mk₀_comp_mk₀, nsmul_reduction_eq]

include hsq in
omit [ConnectedSpace Y] in
/-- The square of the hypothesis on a class `mk₀ (m • 𝟙)`. -/
theorem extMap_tr_eq (n : ℕ) (x : F.obj (op (n + 1))) (m : ℕ)
    (hm : Φ (n + 1) x = Ext.mk₀ (m • 𝟙 _)) (a : ℕ) (ha : (ψ n).hom = a • 𝟙 _) :
    extMap Y (h n) (unitSheaf (ℓ ^ (n + 1))) 0
        (Φ n ((F.map (homOfLE (Nat.le_succ n)).op).hom x)) =
      Ext.mk₀ ((m * a) • reduction Y (h n)) := by
  rw [hsq, hm, Ext.mk₀_comp_mk₀, ha, ← nsmul_reduction_eq, Preadditive.nsmul_comp,
    Category.id_comp, smul_smul, mul_comm]

include hsq in
/-- **The transitions are onto.** -/
theorem surjective_tr_of_ext_zero (n : ℕ) :
    Function.Surjective (F.map (homOfLE (Nat.le_succ n)).op).hom := by
  intro z
  obtain ⟨a, b, ha, -, hab⟩ := exists_iso_unitSheaf_eq_nsmul_id (ψ n)
  obtain ⟨m', hm'⟩ := exists_ext_zero_unitSheaf_eq_mk₀_nsmul (Φ n z)
  refine ⟨(Φ (n + 1)).symm (Ext.mk₀ ((m' * b) • 𝟙 _)), (Φ n).injective
    ((extMap_bijective Y (h n) _ 0).1 ?_)⟩
  rw [extMap_tr_eq Φ h ψ hsq n _ _ (AddEquiv.apply_symm_apply _ _) a ha, hm',
    extMap_mk₀_nsmul_id, Ext.mk₀_bijective _ _ |>.1.eq_iff, nsmul_reduction_eq_iff]
  push_cast
  linear_combination (m' : ZMod (ℓ ^ (n + 1))) * hab

include hsq in
/-- **The kernel of `H(n+1) → H(n)` is `ℓⁿ⁺¹ H(n+1)`.** -/
theorem exists_eq_smul_of_tr_eq_zero_of_ext_zero (n : ℕ) (x : F.obj (op (n + 1)))
    (hx : (F.map (homOfLE (Nat.le_succ n)).op).hom x = 0) :
    ∃ y, x = (ℓ : ℤ_[ℓ]) ^ (n + 1) • y := by
  obtain ⟨a, b, ha, -, hab⟩ := exists_iso_unitSheaf_eq_nsmul_id (ψ n)
  obtain ⟨m, hm⟩ := exists_ext_zero_unitSheaf_eq_mk₀_nsmul (Φ (n + 1) x)
  have h0 := extMap_tr_eq Φ h ψ hsq n x m hm a ha
  rw [hx, map_zero, map_zero, eq_comm, Ext.mk₀_eq_zero_iff, ← zero_smul ℕ (reduction Y (h n)),
    nsmul_reduction_eq_iff] at h0
  have hm0 : (m : ZMod (ℓ ^ (n + 1))) = 0 := by
    have := congrArg (· * (b : ZMod (ℓ ^ (n + 1)))) h0
    push_cast at this
    rwa [zero_mul, mul_assoc, hab, mul_one] at this
  obtain ⟨t, rfl⟩ := (ZMod.natCast_eq_zero_iff _ _).1 hm0
  refine ⟨(Φ (n + 1)).symm (Ext.mk₀ (t • 𝟙 _)), (Φ (n + 1)).injective ?_⟩
  rw [padic_pow_smul_eq_nsmul, map_nsmul, AddEquiv.apply_symm_apply, hm, ← ext_mk₀_nsmul,
    smul_smul]

include Φ in
/-- **The levels are killed by `ℓⁿ⁺¹`.** -/
theorem pow_smul_eq_zero_of_ext_zero (n : ℕ) (x : F.obj (op n)) :
    (ℓ : ℤ_[ℓ]) ^ (n + 1) • x = 0 := by
  obtain ⟨m, hm⟩ := exists_ext_zero_unitSheaf_eq_mk₀_nsmul (Φ n x)
  apply (Φ n).injective
  rw [padic_pow_smul_eq_nsmul, map_nsmul, map_zero, hm, ← ext_mk₀_nsmul, smul_smul,
    ← Ext.mk₀_zero, ← zero_smul ℕ (𝟙 (unitSheaf (X := Y) (ℓ ^ (n + 1))))]
  congr 1
  rw [unitSheaf_nsmul_id_eq_nsmul_id_iff]
  push_cast
  rw [← Nat.cast_pow, ZMod.natCast_self, zero_mul]

include Φ in
/-- **The `ℓᵏ⁺¹`-torsion of `H(n+k+1)` is divisible by `ℓⁿ⁺¹`.** -/
theorem exists_eq_smul_of_smul_eq_zero_of_ext_zero (n k' : ℕ) (x : F.obj (op (n + k' + 1)))
    (hx : (ℓ : ℤ_[ℓ]) ^ (k' + 1) • x = 0) : ∃ y, x = (ℓ : ℤ_[ℓ]) ^ (n + 1) • y := by
  obtain ⟨m, hm⟩ := exists_ext_zero_unitSheaf_eq_mk₀_nsmul (Φ (n + k' + 1) x)
  have h0 : ((ℓ ^ (k' + 1) * m : ℕ) : ZMod (ℓ ^ (n + k' + 1 + 1))) = ((0 : ℕ) : ZMod _) := by
    rw [← unitSheaf_nsmul_id_eq_nsmul_id_iff (Y := Y), ← (Ext.mk₀_bijective _ _).1.eq_iff,
      ← smul_smul, ext_mk₀_nsmul, ← hm, zero_smul, Ext.mk₀_zero, ← map_nsmul,
      ← padic_pow_smul_eq_nsmul, hx, map_zero]
  rw [Nat.cast_zero, ZMod.natCast_eq_zero_iff,
    show n + k' + 1 + 1 = (k' + 1) + (n + 1) by omega, pow_add] at h0
  obtain ⟨t, rfl⟩ := Nat.dvd_of_mul_dvd_mul_left (pow_pos (Fact.out : ℓ.Prime).pos _) h0
  refine ⟨(Φ (n + k' + 1)).symm (Ext.mk₀ (t • 𝟙 _)), (Φ (n + k' + 1)).injective ?_⟩
  rw [padic_pow_smul_eq_nsmul, map_nsmul, AddEquiv.apply_symm_apply, hm, ← ext_mk₀_nsmul,
    smul_smul]

include Φ in
/-- **The level `n` has `ℓⁿ⁺¹` elements.** -/
theorem natCard_obj_of_ext_zero (n : ℕ) : Nat.card (F.obj (op n)) = ℓ ^ (n + 1) := by
  let e : ZMod (ℓ ^ (n + 1)) → F.obj (op n) := fun c => (Φ n).symm (Ext.mk₀ (c.val • 𝟙 _))
  have he : Function.Bijective e := by
    refine ⟨fun c c' hcc => ?_, fun x => ?_⟩
    · have := (Φ n).symm.injective hcc
      rw [(Ext.mk₀_bijective _ _).1.eq_iff, unitSheaf_nsmul_id_eq_nsmul_id_iff,
        ZMod.natCast_zmod_val, ZMod.natCast_zmod_val] at this
      exact this
    · obtain ⟨m, hm⟩ := exists_ext_zero_unitSheaf_eq_mk₀_nsmul (Φ n x)
      refine ⟨(m : ZMod _), (Φ n).injective ?_⟩
      simp only [e, AddEquiv.apply_symm_apply, hm]
      congr 1
      rw [unitSheaf_nsmul_id_eq_nsmul_id_iff, ZMod.natCast_zmod_val]
  rw [← Nat.card_eq_of_bijective e he, Nat.card_zmod]

include Φ in
theorem finite_obj_of_ext_zero (n : ℕ) : Finite (F.obj (op n)) :=
  Nat.finite_of_card_ne_zero (by
    rw [natCard_obj_of_ext_zero Φ]; exact pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero)

end Tower

section Cohomology

attribute [local instance] HasDerivedCategory.standard moduleCat_hasLimitsOfSize

variable (B : BigEtaleSite.{u}) (X : B.Scheme) (ℓ : ℕ)
  [∀ (n : ℕ) (S T : B.Scheme) (g : T ⟶ S),
    ((AlgebraicGeometry.smallEtaleBaseChange B g).sheafPushforwardContinuous
      (ModuleCat.{u + 1} (ZMod (ℓ ^ (n + 1))))
      (SmallEtale.topology B S.1 S.property)
      (SmallEtale.topology B T.1 T.property)).IsRightAdjoint]
  [∀ (n : ℕ) (T : B.Scheme) (V : SmallEtale B T.1 T.property),
    HasWeakSheafify ((SmallEtale.topology B T.1 T.property).over V)
      (ModuleCat.{u + 1} (ZMod (ℓ ^ (n + 1))))]
  [∀ n : ℕ, HasWeakSheafify (SmallEtale.topology B X.1 X.property)
    (ModuleCat.{u + 1} (ZMod (ℓ ^ (n + 1))))]
  [IsNoetherian X.1] [Fact ℓ.Prime]
  {k : Type u} [Field k] [Finite k] (f : X.1 ⟶ Spec (.of k))
  [IsProper f]
  (kbar : Type u) [Field kbar] [Algebra k kbar]
  [ConnectedSpace ↥(pullback (Over.mk f).hom (specAlgebraMap k kbar))]

local instance : QuasiSeparatedSpace X.obj :=
  @AlgebraicGeometry.IsLocallyNoetherian.quasiSeparatedSpace X.1
    (inferInstance : AlgebraicGeometry.IsNoetherian X.1).toIsLocallyNoetherian

section Frobenius

omit [Finite k]

variable [Fintype k] (p q : ℕ) [Fact p.Prime] [CharP k p] (hcard : Fintype.card k = p ^ q)

include hcard in
/-- **`π_X^*` on the levels of `H⁰(X_k̄, ℤ_ℓ)` is the identity** when `X_k̄` is connected. -/
theorem LAdicSheaf.canonicalFrobenius_constantLevel_zero_of_connected (n : ℕ)
    (x : (geometricCompactSupportPadicCohomology B X ℓ f (CompactificationOf.ofProper f) kbar
      ((0 : ℕ) : ℤ)).obj (LAdicSheaf.padicLevel B X ℓ (LAdicSheaf.constantSystem B X ℓ) n)) :
    (canonicalCompactSupportFrobeniusGroup.{u, 0} ℤ_[ℓ] f (CompactificationOf.ofProper f) kbar p q
      hcard ((padicCoefficientComplex B X ℓ).obj
        (LAdicSheaf.padicLevel B X ℓ (LAdicSheaf.constantSystem B X ℓ) n)) ((0 : ℕ) : ℤ)).hom x =
      x := by
  obtain ⟨Φ, hΦ⟩ := LAdicSheaf.exists_addEquiv_constantLevel_frobenius B X ℓ f kbar p q hcard 0 n
  have : NeZero (ℓ ^ (n + 1)) := ⟨pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero⟩
  apply Φ.injective
  refine (hΦ x).trans ?_
  exact constantExtRestriction_zero_eq_self
    (Y := pullback (Over.mk f).hom (specAlgebraMap k kbar)) _ (Φ x)

/-- **`π_X^*` on `H⁰(X_k̄, ℤ_ℓ)` is the identity** when `X_k̄` is connected. -/
theorem LAdicSheaf.geometricCompactlySupportedFrobenius_constant_zero_of_connected :
    LAdicSheaf.geometricCompactlySupportedFrobenius B X ℓ f (CompactificationOf.ofProper f) kbar
        p q hcard (LAdicSheaf.constantSystem B X ℓ) ((0 : ℕ) : ℤ) = 𝟙 _ := by
  refine limit.hom_ext fun n => ?_
  have h := LAdicSheaf.geometricCompactlySupportedFrobenius_π B X ℓ f
    (CompactificationOf.ofProper f) kbar p q hcard (LAdicSheaf.constantSystem B X ℓ)
    ((0 : ℕ) : ℤ) n.unop
  change _ ≫ LAdicSheaf.geometricCompactlySupportedCohomologyπ B X ℓ f _ kbar _ _ n.unop =
    _ ≫ LAdicSheaf.geometricCompactlySupportedCohomologyπ B X ℓ f _ kbar _ _ n.unop
  rw [h]
  ext x
  exact LAdicSheaf.canonicalFrobenius_constantLevel_zero_of_connected B X ℓ f kbar p q hcard
    n.unop _

/-- **`π_X^*` on `H⁰(X_k̄, ℚ_ℓ)` is the identity** when `X_k̄` is connected. -/
theorem LAdicSheaf.rationalGeometricCompactlySupportedFrobenius_constant_zero_of_connected :
    LAdicSheaf.rationalGeometricCompactlySupportedFrobenius B X ℓ f (CompactificationOf.ofProper f)
        kbar p q hcard (LAdicSheaf.constantSystem B X ℓ) ((0 : ℕ) : ℤ) = 𝟙 _ := by
  change (ModuleCat.extendScalars.{0, 0, u + 1} (algebraMap ℤ_[ℓ] ℚ_[ℓ])).map
    (LAdicSheaf.geometricCompactlySupportedFrobenius B X ℓ f (CompactificationOf.ofProper f) kbar
      p q hcard (LAdicSheaf.constantSystem B X ℓ) ((0 : ℕ) : ℤ)) = _
  rw [LAdicSheaf.geometricCompactlySupportedFrobenius_constant_zero_of_connected B X ℓ f kbar
    p q hcard, CategoryTheory.Functor.map_id]
  rfl

end Frobenius

section Rank

open Stacks.EtaleCohomology.ExtensionTorsor

/-- **The tower `n ↦ H⁰(X_k̄, ℤ/ℓⁿ⁺¹)` of a geometrically connected `X`**: its levels are killed
by `ℓⁿ⁺¹`, its transitions are onto with kernel `ℓⁿ⁺¹`, its `ℓᵏ⁺¹`-torsion is divisible by
`ℓⁿ⁺¹`, and its level `n` has `ℓⁿ⁺¹` elements. -/
theorem LAdicSheaf.towerFacts_constant_zero :
    let T := LAdicSheaf.geometricCompactlySupportedCohomologySystem B X ℓ f
      (CompactificationOf.ofProper f) kbar (LAdicSheaf.constantSystem B X ℓ) ((0 : ℕ) : ℤ)
    (∀ n (x : T.obj (op n)), (ℓ : ℤ_[ℓ]) ^ (n + 1) • x = 0) ∧
    (∀ n, Function.Surjective (TowerLimit.tr T (Nat.le_succ n))) ∧
    (∀ n (x : T.obj (op (n + 1))), TowerLimit.tr T (Nat.le_succ n) x = 0 →
      ∃ y, x = (ℓ : ℤ_[ℓ]) ^ (n + 1) • y) ∧
    (∀ n k' (x : T.obj (op (n + k' + 1))), (ℓ : ℤ_[ℓ]) ^ (k' + 1) • x = 0 →
      ∃ y, x = (ℓ : ℤ_[ℓ]) ^ (n + 1) • y) ∧
    (∀ n, Nat.card (T.obj (op n)) = ℓ ^ (n + 1)) := by
  intro T
  have := Fintype.ofFinite k
  have h : ∀ n, ℓ ^ (n + 1) ∣ ℓ ^ (n + 1 + 1) := fun n => pow_dvd_pow ℓ (by omega)
  choose ψ hψ using fun n => LAdicSheaf.exists_constantLevelCohomology_transition B X ℓ f kbar 0 n
  let Φ : ∀ n, T.obj (op n) ≃+ Ext (unitSheaf (X := pullback (Over.mk f).hom
      (specAlgebraMap k kbar)) (ℓ ^ (n + 1))) (unitSheaf (ℓ ^ (n + 1))) 0 :=
    fun n => LAdicSheaf.constantLevelCohomologyAddEquiv B X ℓ f kbar 0 n
  have hsq : ∀ n (x : T.obj (op (n + 1))),
      LevelChange.extMap _ (h n) (unitSheaf (ℓ ^ (n + 1))) 0
          (Φ n ((T.map (homOfLE (Nat.le_succ n)).op).hom x)) =
        (Φ (n + 1) x).comp (Ext.mk₀ (LevelChange.reduction _ (h n) ≫
          (LevelChange.restrict _ (h n)).map (ψ n).hom)) (add_zero 0) :=
    fun n x => by
      set_option maxRecDepth 20000 in
      exact hψ n x
  exact ⟨pow_smul_eq_zero_of_ext_zero Φ, surjective_tr_of_ext_zero Φ h ψ hsq,
    exists_eq_smul_of_tr_eq_zero_of_ext_zero Φ h ψ hsq,
    exists_eq_smul_of_smul_eq_zero_of_ext_zero Φ, natCard_obj_of_ext_zero Φ⟩

/-- **`H⁰(X_k̄, ℤ_ℓ)` is free of rank one** when `X_k̄` is connected. -/
theorem LAdicSheaf.free_finite_finrank_geometricCompactlySupportedCohomology_constant_zero :
    Module.Free ℤ_[ℓ] (LAdicSheaf.geometricCompactlySupportedCohomology B X ℓ f
        (CompactificationOf.ofProper f) kbar (LAdicSheaf.constantSystem B X ℓ) ((0 : ℕ) : ℤ)) ∧
      Module.Finite ℤ_[ℓ] (LAdicSheaf.geometricCompactlySupportedCohomology B X ℓ f
        (CompactificationOf.ofProper f) kbar (LAdicSheaf.constantSystem B X ℓ) ((0 : ℕ) : ℤ)) ∧
      Module.finrank ℤ_[ℓ] (LAdicSheaf.geometricCompactlySupportedCohomology B X ℓ f
        (CompactificationOf.ofProper f) kbar (LAdicSheaf.constantSystem B X ℓ) ((0 : ℕ) : ℤ)) =
        1 := by
  obtain ⟨hkill, hsurj, hker, htors, hcard⟩ := LAdicSheaf.towerFacts_constant_zero B X ℓ f kbar
  have hfin : ∀ n, Finite ((LAdicSheaf.geometricCompactlySupportedCohomologySystem B X ℓ f
      (CompactificationOf.ofProper f) kbar (LAdicSheaf.constantSystem B X ℓ)
        ((0 : ℕ) : ℤ)).obj (op n)) := fun n =>
    Nat.finite_of_card_ne_zero (by rw [hcard]; exact pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero)
  have h0 := TowerLimit.natCard_obj_zero hkill hsurj hker htors hfin
  rw [hcard, zero_add] at h0
  exact ⟨TowerLimit.free hkill hsurj hker htors hfin, TowerLimit.finite hkill hsurj hker htors hfin,
    (Nat.pow_right_injective (Fact.out : ℓ.Prime).two_le h0).symm⟩

/-- **`dim H⁰(X_k̄, ℚ_ℓ) = 1`** when `X_k̄` is connected. -/
theorem LAdicSheaf.finrank_rationalGeometricCompactlySupportedCohomology_constant_zero :
    Module.finrank ℚ_[ℓ] (LAdicSheaf.rationalGeometricCompactlySupportedCohomology B X ℓ f
        (CompactificationOf.ofProper f) kbar (LAdicSheaf.constantSystem B X ℓ) ((0 : ℕ) : ℤ)) =
      1 := by
  obtain ⟨h1, -, h3⟩ :=
    LAdicSheaf.free_finite_finrank_geometricCompactlySupportedCohomology_constant_zero B X ℓ f kbar
  change Module.finrank ℚ_[ℓ] (TensorProduct ℤ_[ℓ] ℚ_[ℓ] _) = _
  rw [Module.finrank_baseChange, h3]

/-- `H⁰(X_k̄, ℚ_ℓ)` is finite dimensional when `X_k̄` is connected. -/
instance LAdicSheaf.finite_rationalGeometricCompactlySupportedCohomology_constant_zero :
    Module.Finite ℚ_[ℓ] (LAdicSheaf.rationalGeometricCompactlySupportedCohomology B X ℓ f
        (CompactificationOf.ofProper f) kbar (LAdicSheaf.constantSystem B X ℓ) ((0 : ℕ) : ℤ)) :=
  Module.finite_of_finrank_eq_succ
    (LAdicSheaf.finrank_rationalGeometricCompactlySupportedCohomology_constant_zero B X ℓ f kbar)

variable [Fintype k] (p q : ℕ) [Fact p.Prime] [CharP k p] (hcard : Fintype.card k = p ^ q)

/-- **`P₀(t) = det(1 - t F₀ | H⁰(X_k̄, ℚ_ℓ)) = 1 - t`** for `X` proper over `k` with `X_k̄`
connected. -/
@[weil "lem_fk401_char_poly_degree_zero"]
theorem LAdicSheaf.charpoly_reverse_rationalGeometricCompactlySupportedFrobenius_constant_zero :
    (LAdicSheaf.rationalGeometricCompactlySupportedFrobenius B X ℓ f
        (CompactificationOf.ofProper f) kbar p q hcard (LAdicSheaf.constantSystem B X ℓ)
          ((0 : ℕ) : ℤ)).hom.charpoly.reverse = 1 - Polynomial.X := by
  rw [LAdicSheaf.rationalGeometricCompactlySupportedFrobenius_constant_zero_of_connected B X ℓ f
    kbar p q hcard, ModuleCat.hom_id]
  exact charpoly_id_reverse_eq_one_sub_X
    (LAdicSheaf.finrank_rationalGeometricCompactlySupportedCohomology_constant_zero B X ℓ f kbar)

end Rank

