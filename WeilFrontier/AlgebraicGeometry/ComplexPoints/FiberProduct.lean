/-!
# Complex points of fibre products

Let `f : X ⟶ S` and `g : Y ⟶ S` be morphisms of schemes over `ℂ`. A complex point of the fibre
product `X ×_S Y` is the same as a pair of complex points of `X` and `Y` with the same image in
`S`, by the universal property of the pullback. This file shows that for the analytic
topologies the bijection
`(X ×_S Y)(ℂ) → X(ℂ) ×_{S(ℂ)} Y(ℂ) ⊆ X(ℂ) × Y(ℂ)` is a homeomorphism. The fibre product
`X ×_S Y` is covered by the affine opens `U ×_T V`, for `T ⊆ S`, `U ⊆ f⁻¹ T` and `V ⊆ g⁻¹ T`
affine, and the ring of functions of `U ×_T V`, a pushout of rings, is generated by the
functions of `U` and of `V`; so on `(U ×_T V)(ℂ)` every regular function is a polynomial in the
values of the two projections, and the topology is the one induced from `U(ℂ) × V(ℂ)`.

Consequently the complex points of a fibre product of compact (resp. Hausdorff) spaces over a
Hausdorff space are compact (resp. Hausdorff); in particular the complex points of the fibre
powers `(ℙ¹_ℂ)^d` are compact and Hausdorff.

Finally, if `f : X ⟶ Y` is finite and `Y(ℂ)` is compact and Hausdorff, then `X(ℂ)` is compact:
over an affine open `V` of `Y`, every regular function on `f⁻¹ V` is integral over `Γ(Y, V)`,
so its values over a compact subset of `V(ℂ)` are bounded by Cauchy's bound on the roots of its
monic equation, and `(f⁻¹ V)(ℂ)` is a closed subspace of a product of copies of `ℂ`.

## Main definitions

* `AlgebraicGeometry.Scheme.ComplexPoints.pullbackPair`: the pair of projections
  `(X ×_S Y)(ℂ) → X(ℂ) × Y(ℂ)`.
* `AlgebraicGeometry.Scheme.ComplexPoints.fiberProductSet`: the fibre product
  `X(ℂ) ×_{S(ℂ)} Y(ℂ)`, as a subset of `X(ℂ) × Y(ℂ)`.
* `AlgebraicGeometry.Scheme.ComplexPoints.pullbackHomeomorph`: the homeomorphism
  `(X ×_S Y)(ℂ) ≃ₜ X(ℂ) ×_{S(ℂ)} Y(ℂ)`.

## Main results

* `AlgebraicGeometry.Scheme.ComplexPoints.isEmbedding_pullbackPair`: the pair of projections is
  an embedding, with range `fiberProductSet` (`range_pullbackPair`).
* `AlgebraicGeometry.Scheme.ComplexPoints.compactSpace_pullback`,
  `AlgebraicGeometry.Scheme.ComplexPoints.t2Space_pullback`: compactness and the Hausdorff
  property pass to fibre products.
* `AlgebraicGeometry.Scheme.ComplexPoints.compactSpace_linePower`,
  `AlgebraicGeometry.Scheme.ComplexPoints.t2Space_linePower`: `(ℙ¹_ℂ)^d(ℂ)` is compact and
  Hausdorff.
* `AlgebraicGeometry.Scheme.ComplexPoints.compactSpace_of_isFinite`: a scheme finite over a
  scheme with compact Hausdorff complex points has compact complex points.

## Implementation notes

The structure morphism of `X ×_S Y` to `Spec ℂ` is an arbitrary morphism `p` with
`pullback.fst f g ≫ x = p`, so that the results apply to iterated fibre powers, whose structure
morphism is the composite through the second factor.

## References

* [FK] E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, Chapter I, §11.
* [SGA1] A. Grothendieck, *Revêtements étales et groupe fondamental*, Exposé XII, §1.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Topology

namespace AlgebraicGeometry.Scheme.ComplexPoints

/-- A regular function on all of `Y` is continuous on `Y(ℂ)`. -/
theorem continuous_eval_top {Y : Scheme.{0}} {y : Y ⟶ Spec (.of ℂ)} (g : Γ(Y, ⊤)) :
    Continuous fun q : ComplexPoints y => eval g q (mem_top q) := by
  have h1 := continuous_eval_of_isOpen (y := y) ⊤ g
  have h2 : Continuous fun q : ComplexPoints y =>
      (⟨q, mem_top q⟩ : {p : ComplexPoints y // p.Mem ⊤}) :=
    continuous_id.subtype_mk _
  have h := h1.comp h2
  unfold Function.comp at h
  exact h

section Generated

variable {P X Y : Scheme.{0}} {p : P ⟶ Spec (.of ℂ)} {x : X ⟶ Spec (.of ℂ)}
  {y : Y ⟶ Spec (.of ℂ)}

/-- If `P` is affine and its ring of global sections is generated by the pullbacks of the global
sections along `a : P ⟶ X` and `b : P ⟶ Y`, then `z ↦ (a(z), b(z))` is inducing. -/
theorem isInducing_prodMk_map_of_closure_eq_top [IsAffine P] (a : P ⟶ X) (b : P ⟶ Y)
    (ha : a ≫ x = p) (hb : b ≫ y = p)
    (h : Subring.closure (Set.range a.appTop.hom ∪ Set.range b.appTop.hom) = ⊤) :
    IsInducing fun z : ComplexPoints p => (map a ha z, map b hb z) := by
  have key : ∀ g : Γ(P, ⊤), ∃ H : ComplexPoints x × ComplexPoints y → ℂ, Continuous H ∧
      ∀ z : ComplexPoints p, eval g z (mem_top z) = H (map a ha z, map b hb z) := by
    intro g
    have hg : g ∈ Subring.closure (Set.range a.appTop.hom ∪ Set.range b.appTop.hom) := by
      rw [h]; trivial
    induction hg using Subring.closure_induction with
    | mem g hg =>
      rcases hg with ⟨u, rfl⟩ | ⟨v, rfl⟩
      · refine ⟨(fun q => eval u q (mem_top q)) ∘ Prod.fst,
          (continuous_eval_top u).comp continuous_fst, fun z => ?_⟩
        exact (eval_map_point a ha u z (mem_top _)).symm
      · refine ⟨(fun q => eval v q (mem_top q)) ∘ Prod.snd,
          (continuous_eval_top v).comp continuous_snd, fun z => ?_⟩
        exact (eval_map_point b hb v z (mem_top _)).symm
    | zero => exact ⟨fun _ => 0, continuous_const, fun z => by
        rw [← evalHom_apply, map_zero]⟩
    | one => exact ⟨fun _ => 1, continuous_const, fun z => by
        rw [← evalHom_apply, map_one]⟩
    | add g g' _ _ ih ih' =>
      obtain ⟨H, hH, e⟩ := ih
      obtain ⟨H', hH', e'⟩ := ih'
      exact ⟨H + H', hH.add hH', fun z => by
        rw [← evalHom_apply, map_add, evalHom_apply, evalHom_apply, e, e']; rfl⟩
    | neg g _ ih =>
      obtain ⟨H, hH, e⟩ := ih
      exact ⟨-H, hH.neg, fun z => by
        rw [← evalHom_apply, map_neg, evalHom_apply, e]; rfl⟩
    | mul g g' _ _ ih ih' =>
      obtain ⟨H, hH, e⟩ := ih
      obtain ⟨H', hH', e'⟩ := ih'
      exact ⟨H * H', hH.mul hH', fun z => by
        rw [← evalHom_apply, map_mul, evalHom_apply, evalHom_apply, e, e']; rfl⟩
  choose H hH e using key
  have hind : IsInducing fun z : ComplexPoints p => evalMap (y := p) ⊤ ⟨z, mem_top z⟩ :=
    (isInducing_evalMap (isAffineOpen_top P)).comp
      ((IsInducing.subtypeVal.of_comp_iff).1 IsInducing.id)
  have hcomp : (fun z : ComplexPoints p => evalMap (y := p) ⊤ ⟨z, mem_top z⟩) =
      (fun q g => H g q) ∘ fun z => (map a ha z, map b hb z) := by
    funext z g
    exact e g z
  rw [hcomp] at hind
  exact hind.of_comp ((continuous_map a ha).prodMk (continuous_map b hb))
    (continuous_pi fun g => hH g)

end Generated

section FiberProduct

variable {X Y S : Scheme.{0}} {x : X ⟶ Spec (.of ℂ)} {y : Y ⟶ Spec (.of ℂ)}
  {s : S ⟶ Spec (.of ℂ)} {f : X ⟶ S} {g : Y ⟶ S} (hf : f ≫ s = x) (hg : g ≫ s = y)
  {p : pullback f g ⟶ Spec (.of ℂ)} (hp : pullback.fst f g ≫ x = p)

include hf hg in
/-- The structure morphism of `X ×_S Y` also factors through the second projection. -/
theorem pullback_snd_comp_eq (hp : pullback.fst f g ≫ x = p) : pullback.snd f g ≫ y = p := by
  rw [← hp, ← hf, ← hg, pullback.condition_assoc]

/-- The pair of projections `(X ×_S Y)(ℂ) → X(ℂ) × Y(ℂ)`. -/
noncomputable def pullbackPair (z : ComplexPoints p) : ComplexPoints x × ComplexPoints y :=
  (map (pullback.fst f g) hp z, map (pullback.snd f g) (pullback_snd_comp_eq hf hg hp) z)

/-- The fibre product `X(ℂ) ×_{S(ℂ)} Y(ℂ)` of the sets of complex points, as a subset of the
product `X(ℂ) × Y(ℂ)`. -/
def fiberProductSet : Set (ComplexPoints x × ComplexPoints y) :=
  {q | map f hf q.1 = map g hg q.2}

theorem continuous_pullbackPair : Continuous (pullbackPair hf hg hp) :=
  (continuous_map _ _).prodMk (continuous_map _ _)

theorem injective_pullbackPair : Function.Injective (pullbackPair hf hg hp) := by
  intro z z' h
  have h1 := congrArg (fun q => (Prod.fst q).hom) h
  have h2 := congrArg (fun q => (Prod.snd q).hom) h
  simp only [pullbackPair, map_hom] at h1 h2
  exact ext (pullback.hom_ext h1 h2)

/-- The complex point of `X ×_S Y` with given projections. -/
noncomputable def pullbackPoint (a : ComplexPoints x) (b : ComplexPoints y)
    (h : map f hf a = map g hg b) : ComplexPoints p :=
  ⟨pullback.lift a.hom b.hom (by simpa using congrArg ComplexPoints.hom h), by
    rw [← hp, pullback.lift_fst_assoc, a.hom_comp]⟩

theorem pullbackPair_pullbackPoint (a : ComplexPoints x) (b : ComplexPoints y)
    (h : map f hf a = map g hg b) :
    pullbackPair hf hg hp (pullbackPoint hf hg hp a b h) = (a, b) := by
  refine Prod.ext (ext ?_) (ext ?_)
  · exact pullback.lift_fst _ _ _
  · exact pullback.lift_snd _ _ _

theorem range_pullbackPair : Set.range (pullbackPair hf hg hp) = fiberProductSet hf hg := by
  ext ⟨a, b⟩
  constructor
  · rintro ⟨z, hz⟩
    rw [← hz]
    refine ext ?_
    simp only [pullbackPair, map_hom, Category.assoc, pullback.condition]
  · intro h
    exact ⟨pullbackPoint hf hg hp a b h, pullbackPair_pullbackPoint hf hg hp a b h⟩

include hf hg hp in
/-- For affine `X`, `Y`, `S` the pair of projections `(X ×_S Y)(ℂ) → X(ℂ) × Y(ℂ)` is an
embedding: the ring of functions of `X ×_S Y` is generated by those of `X` and `Y`. -/
theorem isEmbedding_pullbackPair_of_isAffine [IsAffine X] [IsAffine Y] [IsAffine S] :
    IsEmbedding (pullbackPair hf hg hp) := by
  refine ⟨isInducing_prodMk_map_of_closure_eq_top _ _ _ _ ?_, injective_pullbackPair hf hg hp⟩
  exact CommRingCat.closure_range_union_range_eq_top_of_isPushout
    (isPushout_appTop_of_isPullback (IsPullback.of_hasPullback f g))

/-- The index set of the affine charts of `X ×_S Y`: affine opens `T ⊆ S`, `U ⊆ f⁻¹ T`,
`V ⊆ g⁻¹ T`. -/
def PullbackChartIndex (f : X ⟶ S) (g : Y ⟶ S) : Type :=
  {t : S.affineOpens × X.affineOpens × Y.affineOpens //
    (t.2.1 : X.Opens) ≤ f ⁻¹ᵁ (t.1 : S.Opens) ∧ (t.2.2 : Y.Opens) ≤ g ⁻¹ᵁ (t.1 : S.Opens)}

namespace PullbackChartIndex

variable (i : PullbackChartIndex f g)

/-- The affine chart `U ×_T V` of `X ×_S Y`. -/
noncomputable abbrev chart : Scheme.{0} :=
  pullback (f.resLE i.1.1 i.1.2.1 i.2.1) (g.resLE i.1.1 i.1.2.2 i.2.2)

/-- The open immersion of the chart `U ×_T V` into `X ×_S Y`. -/
noncomputable def chartι : i.chart ⟶ pullback f g :=
  pullback.map _ _ _ _ (i.1.2.1 : X.Opens).ι (i.1.2.2 : Y.Opens).ι (i.1.1 : S.Opens).ι
    (Scheme.Hom.resLE_comp_ι _ _) (Scheme.Hom.resLE_comp_ι _ _)

@[reassoc (attr := simp)]
theorem chartι_fst : i.chartι ≫ pullback.fst f g = pullback.fst _ _ ≫ (i.1.2.1 : X.Opens).ι := by
  unfold chartι; exact pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
theorem chartι_snd : i.chartι ≫ pullback.snd f g = pullback.snd _ _ ≫ (i.1.2.2 : Y.Opens).ι := by
  unfold chartι; exact pullback.lift_snd _ _ _

instance : IsOpenImmersion i.chartι := by
  unfold chartι; infer_instance

end PullbackChartIndex

include hf hg hp in
/-- **The complex points of a fibre product embed into the product of the complex points.** -/
theorem isEmbedding_pullbackPair : IsEmbedding (pullbackPair hf hg hp) := by
  have hsnd := pullback_snd_comp_eq hf hg hp
  refine isEmbedding_of_iSup_eq_top_of_preimage_subset_range _ (continuous_pullbackPair hf hg hp)
    (ι := PullbackChartIndex f g)
    (fun i => ⟨Set.range (map (i.1.2.1 : X.Opens).ι (y' := x) rfl) ×ˢ
      Set.range (map (i.1.2.2 : Y.Opens).ι (y' := y) rfl),
      (isOpenEmbedding_map_of_isOpenImmersion _ rfl).isOpen_range.prod
        (isOpenEmbedding_map_of_isOpenImmersion _ rfl).isOpen_range⟩)
    ?_ (fun i => ComplexPoints (pullback.fst _ _ ≫ (i.1.2.1 : X.Opens).ι ≫ x : i.chart ⟶ _))
    (fun i => map i.chartι (by rw [← hp, i.chartι_fst_assoc])) (fun i => continuous_map _ _)
    ?_ ?_
  · rintro _ ⟨z, rfl⟩
    obtain ⟨pt⟩ : Nonempty (Spec (.of ℂ)) := inferInstance
    obtain ⟨T, hT, hzT, -⟩ := (Opens.isBasis_iff_nbhd.1 S.isBasis_affineOpens)
      (show (z.hom ≫ pullback.fst f g ≫ f).base pt ∈ (⊤ : S.Opens) from trivial)
    obtain ⟨U, hU, hzU, hUT⟩ := (Opens.isBasis_iff_nbhd.1 X.isBasis_affineOpens)
      (show (z.hom ≫ pullback.fst f g).base pt ∈ f ⁻¹ᵁ T from hzT)
    obtain ⟨V, hV, hzV, hVT⟩ := (Opens.isBasis_iff_nbhd.1 Y.isBasis_affineOpens)
      (show (z.hom ≫ pullback.snd f g).base pt ∈ g ⁻¹ᵁ T by
        rw [pullback.condition] at hzT; exact hzT)
    let i : PullbackChartIndex f g := ⟨(⟨T, hT⟩, ⟨U, hU⟩, ⟨V, hV⟩), hUT, hVT⟩
    simp only [Opens.coe_iSup, Set.mem_iUnion]
    refine ⟨i, ?_, ?_⟩
    · rw [range_map_of_isOpenImmersion, Scheme.Opens.opensRange_ι]
      exact (mem_iff pt).2 hzU
    · rw [range_map_of_isOpenImmersion, Scheme.Opens.opensRange_ι]
      exact (mem_iff pt).2 hzV
  · rintro i z ⟨⟨a, ha⟩, ⟨b, hb⟩⟩
    have hf' : f.resLE _ _ i.2.1 ≫ ((i.1.1 : S.Opens).ι ≫ s) = (i.1.2.1 : X.Opens).ι ≫ x := by
      rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc, hf]
    have hg' : g.resLE _ _ i.2.2 ≫ ((i.1.1 : S.Opens).ι ≫ s) = (i.1.2.2 : Y.Opens).ι ≫ y := by
      rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc, hg]
    have ha' := congrArg ComplexPoints.hom ha
    have hb' := congrArg ComplexPoints.hom hb
    simp only [pullbackPair, map_hom] at ha' hb'
    have hab : map _ hf' a = map _ hg' b := by
      refine ext ((cancel_mono (i.1.1 : S.Opens).ι).1 ?_)
      simp only [map_hom, Category.assoc, Scheme.Hom.resLE_comp_ι]
      rw [← Category.assoc, ha', ← Category.assoc, hb', Category.assoc, Category.assoc,
        pullback.condition]
    refine ⟨pullbackPoint hf' hg' rfl a b hab, ext (pullback.hom_ext ?_ ?_)⟩
    · rw [map_hom, Category.assoc, PullbackChartIndex.chartι_fst, ← ha']
      exact pullback.lift_fst_assoc _ _ _ _
    · rw [map_hom, Category.assoc, PullbackChartIndex.chartι_snd, ← hb']
      exact pullback.lift_snd_assoc _ _ _ _
  · intro i
    have : IsAffine (i.1.2.1 : X.Opens).toScheme := i.1.2.1.2
    have : IsAffine (i.1.2.2 : Y.Opens).toScheme := i.1.2.2.2
    have : IsAffine (i.1.1 : S.Opens).toScheme := i.1.1.2
    have hf' : f.resLE _ _ i.2.1 ≫ ((i.1.1 : S.Opens).ι ≫ s) = (i.1.2.1 : X.Opens).ι ≫ x := by
      rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc, hf]
    have hg' : g.resLE _ _ i.2.2 ≫ ((i.1.1 : S.Opens).ι ≫ s) = (i.1.2.2 : Y.Opens).ι ≫ y := by
      rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc, hg]
    have hemb := isEmbedding_pullbackPair_of_isAffine hf' hg' rfl
    have heq : pullbackPair hf hg hp ∘ map i.chartι
        (by rw [← hp, PullbackChartIndex.chartι_fst_assoc]) =
        Prod.map (map (i.1.2.1 : X.Opens).ι rfl) (map (i.1.2.2 : Y.Opens).ι rfl) ∘
          pullbackPair hf' hg' rfl := by
      funext z
      refine Prod.ext (ext ?_) (ext ?_)
      · simp [pullbackPair, PullbackChartIndex.chartι_fst]
      · simp [pullbackPair, PullbackChartIndex.chartι_snd]
    rw [heq]
    exact ((isOpenEmbedding_map_of_isOpenImmersion _ rfl).prodMap
      (isOpenEmbedding_map_of_isOpenImmersion _ rfl)).isEmbedding.comp hemb

/-- **The complex points of a fibre product are the fibre product of the complex points**:
`(X ×_S Y)(ℂ) ≃ₜ X(ℂ) ×_{S(ℂ)} Y(ℂ)`, the latter with the subspace topology of
`X(ℂ) × Y(ℂ)`. -/
noncomputable def pullbackHomeomorph : ComplexPoints p ≃ₜ fiberProductSet hf hg :=
  (isEmbedding_pullbackPair hf hg hp).toHomeomorph.trans
    (Homeomorph.setCongr (range_pullbackPair hf hg hp))

@[simp]
theorem coe_pullbackHomeomorph_apply (z : ComplexPoints p) :
    (pullbackHomeomorph hf hg hp z : ComplexPoints x × ComplexPoints y) = pullbackPair hf hg hp z :=
  rfl

theorem isClosed_fiberProductSet [T2Space (ComplexPoints s)] :
    IsClosed (fiberProductSet hf hg) :=
  isClosed_eq ((continuous_map f hf).comp continuous_fst)
    ((continuous_map g hg).comp continuous_snd)

theorem isClosedEmbedding_pullbackPair [T2Space (ComplexPoints s)] :
    IsClosedEmbedding (pullbackPair hf hg hp) :=
  ⟨isEmbedding_pullbackPair hf hg hp, by
    rw [range_pullbackPair]; exact isClosed_fiberProductSet hf hg⟩

include hf hg hp in
/-- The complex points of a fibre product of compact spaces over a Hausdorff space are compact. -/
theorem compactSpace_pullback [CompactSpace (ComplexPoints x)] [CompactSpace (ComplexPoints y)]
    [T2Space (ComplexPoints s)] : CompactSpace (ComplexPoints p) :=
  (isClosedEmbedding_pullbackPair hf hg hp).compactSpace

include hf hg hp in
/-- The complex points of a fibre product of Hausdorff spaces are Hausdorff. -/
theorem t2Space_pullback [T2Space (ComplexPoints x)] [T2Space (ComplexPoints y)] :
    T2Space (ComplexPoints p) :=
  (isEmbedding_pullbackPair hf hg hp).t2Space

end FiberProduct

/-! ### Fibre powers -/

section FiberPower

open SymmetricProduct

/-- `Spec ℂ` has a single complex point. -/
instance subsingleton_id : Subsingleton (ComplexPoints (𝟙 (Spec (.of ℂ)))) :=
  ⟨fun a b => ext ((Category.comp_id a.hom).symm.trans (a.hom_comp.trans
    (b.hom_comp.symm.trans (Category.comp_id b.hom))))⟩

instance compactSpace_id : CompactSpace (ComplexPoints (𝟙 (Spec (.of ℂ)))) :=
  Finite.compactSpace

/-- The complex points of the fibre powers `X ×_ℂ ⋯ ×_ℂ X` of a scheme over `ℂ` with compact
complex points are compact. -/
theorem compactSpace_fiberPower (X : Over (Spec (.of ℂ))) [CompactSpace (ComplexPoints X.hom)]
    (d : ℕ) : CompactSpace (ComplexPoints (fiberPower X d).hom) := by
  induction d with
  | zero => exact compactSpace_id
  | succ d ih =>
    exact compactSpace_pullback (s := 𝟙 _) (Category.comp_id X.hom)
      (Category.comp_id (fiberPower X d).hom) (p := (fiberPower X (d + 1)).hom) pullback.condition

/-- The complex points of the fibre powers `X ×_ℂ ⋯ ×_ℂ X` of a scheme over `ℂ` with Hausdorff
complex points are Hausdorff. -/
theorem t2Space_fiberPower (X : Over (Spec (.of ℂ))) [T2Space (ComplexPoints X.hom)]
    (d : ℕ) : T2Space (ComplexPoints (fiberPower X d).hom) := by
  induction d with
  | zero => change T2Space (ComplexPoints (𝟙 (Spec (.of ℂ)))); infer_instance
  | succ d ih =>
    exact t2Space_pullback (s := 𝟙 _) (Category.comp_id X.hom)
      (Category.comp_id (fiberPower X d).hom) (p := (fiberPower X (d + 1)).hom) pullback.condition

/-- **The complex points of `(ℙ¹_ℂ)^d` form a compact space.** -/
instance compactSpace_linePower (d : ℕ) : CompactSpace (ComplexPoints (linePower ℂ d).hom) :=
  have : CompactSpace (ComplexPoints (lineOver ℂ).hom) := compactSpace_proj (n := 1)
  compactSpace_fiberPower _ d

/-- **The complex points of `(ℙ¹_ℂ)^d` form a Hausdorff space.** -/
instance t2Space_linePower (d : ℕ) : T2Space (ComplexPoints (linePower ℂ d).hom) :=
  t2Space_of_isSeparated

end FiberPower

/-! ### Finite morphisms -/

section Finite

/-- A root `c` of a monic complex polynomial `Q` satisfies `‖c‖ ≤ 1 + ∑_{j < deg Q} ‖Q_j‖`. -/
theorem norm_le_of_monic_of_isRoot {Q : Polynomial ℂ} (hQ : Q.Monic) {c : ℂ} (hc : Q.IsRoot c) :
    ‖c‖ ≤ 1 + ∑ j ∈ Finset.range Q.natDegree, ‖Q.coeff j‖ := by
  have h := (Polynomial.IsRoot.norm_lt_cauchyBound hQ.ne_zero hc).le
  have hsup : (Finset.range Q.natDegree).sup (fun j => ‖Q.coeff j‖₊) ≤
      ∑ j ∈ Finset.range Q.natDegree, ‖Q.coeff j‖₊ :=
    Finset.sup_le fun j hj => Finset.single_le_sum (f := fun j => ‖Q.coeff j‖₊)
      (fun _ _ => bot_le) hj
  have h' : ‖c‖₊ ≤ 1 + ∑ j ∈ Finset.range Q.natDegree, ‖Q.coeff j‖₊ := by
    refine h.trans ?_
    rw [Polynomial.cauchyBound, hQ.leadingCoeff, nnnorm_one, div_one, add_comm]
    gcongr
  have := NNReal.coe_le_coe.2 h'
  simpa using this

variable {X Y : Scheme.{0}} {x : X ⟶ Spec (.of ℂ)} {y : Y ⟶ Spec (.of ℂ)} (f : X ⟶ Y)

/-- Over a compact set of complex points of an affine open `V`, the complex points of
`X` under a finite morphism `f` form a compact set: on the affine open `f⁻¹ V` every regular
function is integral over `Γ(Y, V)`, hence bounded over a compact set by the coefficients of its
equation. -/
theorem isCompact_preimage_map_of_isFinite (hf : f ≫ y = x) [IsFinite f] [T2Space (ComplexPoints y)]
    {V : Y.Opens} (hV : IsAffineOpen V) {K : Set {v : ComplexPoints y // v.Mem V}}
    (hK : IsCompact K) : IsCompact (map f hf ⁻¹' (Subtype.val '' K)) := by
  have hW : IsAffineOpen (f ⁻¹ᵁ V) := hV.preimage f
  let ψ : {q : ComplexPoints x // q.Mem (f ⁻¹ᵁ V)} → {v : ComplexPoints y // v.Mem V} :=
    fun q => ⟨map f hf q.1, q.2⟩
  have hψ : Continuous ψ :=
    ((continuous_map f hf).comp continuous_subtype_val).subtype_mk _
  set A := ψ ⁻¹' K with hA_def
  have hA : IsClosed A := hK.isClosed.preimage hψ
  -- every regular function on `f⁻¹ V` is integral over `Γ(Y, V)`
  have hint := IsIntegralHom.isIntegral_app f V hV
  choose P hPm hP using hint
  -- the bound on each coordinate
  have hbound : ∀ a : Γ(X, f ⁻¹ᵁ V), ∃ R : ℝ, ∀ q ∈ A, ‖eval a q.1 q.2‖ ≤ R := by
    intro a
    let F : {v : ComplexPoints y // v.Mem V} → ℝ := fun v =>
      1 + ∑ j ∈ Finset.range (P a).natDegree, ‖eval ((P a).coeff j) v.1 v.2‖
    have hF : Continuous F :=
      continuous_const.add (continuous_finsetSum _ fun j _ =>
        (continuous_eval hV _).norm)
    obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hF.continuousOn
    refine ⟨C, fun q hq => ?_⟩
    have hv : (map f hf q.1).Mem V := q.2
    let Q := (P a).map (evalHom (map f hf q.1) hv)
    have hQ : Q.Monic := (hPm a).map _
    have hroot : Q.IsRoot (eval a q.1 q.2) := by
      have h0 := congrArg (evalHom q.1 q.2) (hP a)
      rw [map_zero, Polynomial.hom_eval₂] at h0
      rw [Polynomial.IsRoot.def, Polynomial.eval_map, ← evalHom_apply]
      convert h0 using 2
      ext b
      simp only [RingHom.coe_comp, Function.comp_apply, evalHom_apply]
      exact eval_map_point f hf b q.1 hv
    refine (norm_le_of_monic_of_isRoot hQ hroot).trans ?_
    have := hC (ψ q) hq
    rw [Real.norm_eq_abs] at this
    refine le_trans (le_of_eq ?_) ((le_abs_self _).trans this)
    simp only [F, Q, (hPm a).natDegree_map, Polynomial.coeff_map,
      evalHom_apply]
    rfl
  choose R hR using hbound
  have hce := isClosedEmbedding_evalMap (y := x) hW
  have hsub : evalMap (f ⁻¹ᵁ V) '' A ⊆ Set.univ.pi fun a => Metric.closedBall 0 (R a) := by
    rintro _ ⟨q, hq, rfl⟩ a -
    simpa [evalMap] using hR a q hq
  have hcpt : IsCompact (evalMap (y := x) (f ⁻¹ᵁ V) '' A) :=
    (isCompact_univ_pi fun a => isCompact_closedBall 0 (R a)).of_isClosed_subset
      (hce.isClosedMap A hA) hsub
  have hAc : IsCompact A := by
    have := hce.isCompact_preimage hcpt
    rwa [Set.preimage_image_eq _ hce.injective] at this
  convert hAc.image continuous_subtype_val using 1
  ext p
  constructor
  · rintro ⟨v, hv, hpv⟩
    have hp : p.Mem (f ⁻¹ᵁ V) := by
      change (map f hf p).Mem V
      rw [← hpv]; exact v.2
    refine ⟨⟨p, hp⟩, ?_, rfl⟩
    change ψ ⟨p, hp⟩ ∈ K
    convert hv
    exact Subtype.ext hpv.symm
  · rintro ⟨q, hq, rfl⟩
    exact ⟨ψ q, hq, rfl⟩

/-- **A finite morphism to a scheme with compact Hausdorff complex points has compact complex
points in the source.** -/
theorem compactSpace_of_isFinite (hf : f ≫ y = x) [IsFinite f] [CompactSpace (ComplexPoints y)]
    [T2Space (ComplexPoints y)] : CompactSpace (ComplexPoints x) := by
  have key : ∀ v₀ : ComplexPoints y, ∃ s ∈ 𝓝 v₀, IsCompact (map f hf ⁻¹' s) := by
    intro v₀
    obtain ⟨pt⟩ : Nonempty (Spec (.of ℂ)) := inferInstance
    obtain ⟨V, hV, hv₀V, -⟩ := (Opens.isBasis_iff_nbhd.1 Y.isBasis_affineOpens)
      (show v₀.hom.base pt ∈ (⊤ : Y.Opens) from trivial)
    have hN : {v : ComplexPoints y | v.Mem V} ∈ 𝓝 v₀ :=
      (isOpen_setOf_mem V).mem_nhds ((mem_iff pt).2 hv₀V)
    obtain ⟨s, hs, hsN, hsc⟩ := local_compact_nhds hN
    refine ⟨s, hs, ?_⟩
    have heq : Subtype.val '' (Subtype.val ⁻¹' s : Set {v : ComplexPoints y // v.Mem V}) = s :=
      Set.image_preimage_eq_of_subset fun v hv => ⟨⟨v, hsN hv⟩, rfl⟩
    have hK : IsCompact (Subtype.val ⁻¹' s : Set {v : ComplexPoints y // v.Mem V}) := by
      rw [Subtype.isCompact_iff, heq]
      exact hsc
    have := isCompact_preimage_map_of_isFinite f hf hV hK
    rwa [heq] at this
  choose s hs hsc using key
  obtain ⟨t, ht⟩ := isCompact_univ.elim_nhds_subcover s fun v _ => hs v
  refine ⟨?_⟩
  have : (Set.univ : Set (ComplexPoints x)) = ⋃ v ∈ t, map f hf ⁻¹' s v := by
    refine (Set.eq_univ_of_forall fun p => ?_).symm
    simpa using ht.2 (Set.mem_univ (map f hf p))
  rw [this]
  exact t.isCompact_biUnion fun v _ => hsc v

end Finite

end AlgebraicGeometry.Scheme.ComplexPoints
