module

public import Weil.Attr
public import StacksFrontier.Homology.Perfect.ZModPrimePowerReduction

/-!
# A flatness criterion over `ℤ/l^(n+1)ℤ`

Let `l` be a prime and `Λₙ = ℤ/l^(n+1)ℤ`. A `Λₙ`-module `P` whose `l`-torsion `P[l]` equals
`l^n P` is flat over `Λₙ`.

## Main results

* `ZModPrimePower.isPowExact_of_ker_eq_range`: from `P[l] = l^n P` one gets
  `P[l^a] = l^(n+1-a) P` for every `a ≤ n + 1`.
* `ZModPrimePower.flat_of_ker_smul_eq_range_pow_smul`: the flatness criterion.

## Implementation notes

The source argues with `Tor₁(P, -)` along a composition series of the finitely generated
`Λₙ`-modules and the ideal criterion for flatness. Here the hypothesis `P[l] = l^n P` is first
upgraded, by induction on `a`, to the exactness of `P --l^(n+1-a)--> P --l^a--> P` for every
`a ≤ n + 1`; flatness then follows from `Stacks.ZModPrimePower.flat_of_isPowExact`, which uses
that every ideal of `Λₙ` is generated by a power of `l`. The hypothesis `n ≥ 1` of the source is
not needed.

## References

* [FK] E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, Ch. I, §12.
-/

@[expose] public section

namespace ZModPrimePower

open Stacks.ZModPrimePower

variable {l : ℕ} {n : ℕ} {P : Type*} [AddCommGroup P]

/-- If every `l`-torsion element of `P` is divisible by `l^n`, and `l^(n+1)` kills `P`, then for
every `a ≤ n + 1` every `l^a`-torsion element is divisible by `l^(n+1-a)`. -/
theorem isPowExact_of_ker_eq_range
    (h : ∀ x : P, l • x = 0 → ∃ y : P, l ^ n • y = x) : IsPowExact l (n + 1) P := by
  intro a
  induction a with
  | zero => intro _ x hx; exact ⟨0, by simpa using hx.symm⟩
  | succ a ih =>
    intro ha x hx
    obtain ⟨y, hy⟩ := h (l ^ a • x) (by rw [smul_smul, ← pow_succ']; exact hx)
    have ha' : a ≤ n := by omega
    have hz : l ^ a • (x - l ^ (n - a) • y) = 0 := by
      rw [smul_sub, smul_smul, ← pow_add, Nat.add_sub_cancel' ha', hy, sub_self]
    obtain ⟨z, hz'⟩ := ih (by omega) _ hz
    refine ⟨y + l • z, ?_⟩
    have e1 : n + 1 - (a + 1) = n - a := by omega
    have e2 : n + 1 - a = n - a + 1 := by omega
    rw [e1, smul_add, smul_smul, ← pow_succ, ← e2, hz', add_sub_cancel]

/-- **Flatness criterion over `ℤ/l^(n+1)ℤ`.** A `ℤ/l^(n+1)ℤ`-module `P` with `P[l] = l^n P`
is flat. -/
@[weil "lem_fk112_lambda_module_flat_criterion"]
theorem flat_of_ker_smul_eq_range_pow_smul [Fact l.Prime] [Module (ZMod (l ^ (n + 1))) P]
    (h : LinearMap.ker ((l : ZMod (l ^ (n + 1))) • LinearMap.id : P →ₗ[ZMod (l ^ (n + 1))] P) =
      LinearMap.range ((l : ZMod (l ^ (n + 1))) ^ n • LinearMap.id :
        P →ₗ[ZMod (l ^ (n + 1))] P)) :
    Module.Flat (ZMod (l ^ (n + 1))) P := by
  refine flat_of_isPowExact (isPowExact_of_ker_eq_range fun x hx => ?_)
  have hx' : x ∈ LinearMap.ker ((l : ZMod (l ^ (n + 1))) • LinearMap.id :
      P →ₗ[ZMod (l ^ (n + 1))] P) := by
    simpa [← Nat.cast_smul_eq_nsmul (ZMod (l ^ (n + 1)))] using hx
  rw [h] at hx'
  obtain ⟨y, hy⟩ := hx'
  refine ⟨y, ?_⟩
  simpa [← Nat.cast_smul_eq_nsmul (ZMod (l ^ (n + 1)))] using hy

end ZModPrimePower
