module

public import Weil.Attr
public import WeilFrontier.Defs.AlgebraicGeometry.Sites.CoveringMorphism
public import WeilFrontier.Defs.AlgebraicGeometry.Sites.CoveringSectionsMap
public import Mathlib.CategoryTheory.Limits.Types.ColimitType
public import Mathlib.Algebra.Category.Grp.Colimits

/-!
# The plus construction of a presheaf on the étale category

Let `A` be a commutative ring, `F` a presheaf on the étale category `Et(A)` and `B` an object of
`Et(A)`. The sections `F(𝔅)` over the coverings `𝔅` of `B`, with the maps
`(σ, h)_* : F(𝔅) → F(𝔅')` induced by morphisms of coverings, form a functor on the category
`Cov(B)` of coverings of `B`. Its colimit is the group (or set) `F̃(B)`:

* for a presheaf of sets, the colimit in `Type`, i.e. the quotient of the set of pairs `(𝔅, s)`
  with `s ∈ F(𝔅)` by the equivalence relation generated by `(𝔅, s) ∼ (𝔅', (σ, h)_* s)`;
* for a presheaf of abelian groups, the colimit in abelian groups, i.e. the quotient of
  `⨁_𝔅 F(𝔅)` by the subgroup generated by the elements `s - (σ, h)_* s`.

In both cases `[𝔅, s]` denotes the class of `s ∈ F(𝔅)`.

## Main definitions

- `AlgebraicGeometry.EtaleCategory.Covering.sectionsFunctor F B`: the functor
  `𝔅 ↦ F(𝔅)`, `(σ, h) ↦ (σ, h)_*` on `Cov(B)`, for a presheaf of sets.
- `AlgebraicGeometry.EtaleCategory.Covering.sectionsAddFunctor F B`: the same functor, with
  values in abelian groups, for a presheaf of abelian groups.
- `AlgebraicGeometry.EtaleCategory.plusConstruction F B`: the set `F̃(B)`, the colimit
  `Functor.ColimitType` of `sectionsFunctor F B`.
- `AlgebraicGeometry.EtaleCategory.plusConstruction.mk 𝔅 s`: the class `[𝔅, s]`.
- `AlgebraicGeometry.EtaleCategory.addPlusConstruction F B`: the abelian group `F̃(B)`, the
  colimit `AddCommGrpCat.Colimits.Quot` of `sectionsAddFunctor F B`.
- `AlgebraicGeometry.EtaleCategory.addPlusConstruction.mk 𝔅`: the homomorphism
  `s ↦ [𝔅, s]`.
- `AlgebraicGeometry.EtaleCategory.addPlusConstruction.lift`: the universal property of the
  colimit, into an arbitrary abelian group.

## Main results

- `AlgebraicGeometry.EtaleCategory.plusConstruction.mk_sectionsMap`,
  `AlgebraicGeometry.EtaleCategory.addPlusConstruction.mk_sectionsAddMonoidHom`:
  `[𝔅', (σ, h)_* s] = [𝔅, s]`.
- `AlgebraicGeometry.EtaleCategory.plusConstruction.exists_mk`: every element of `F̃(B)` is a
  class `[𝔅, s]` (for presheaves of sets).
- `AlgebraicGeometry.EtaleCategory.plusConstruction.mk_eq_mk_iff`: `[𝔅, s] = [𝔅', s']` if and
  only if `(𝔅, s)` and `(𝔅', s')` are related by the equivalence relation generated by the maps
  `(σ, h)_*`.
- `AlgebraicGeometry.EtaleCategory.plusConstruction.isColimit`: `F̃(B)`, with the maps
  `s ↦ [𝔅, s]`, is a colimit of `sectionsFunctor F B`.

## Implementation notes

Both constructions are Mathlib's colimits of a functor on `Cov(B)` given by explicit quotients:
`Functor.ColimitType` for sets and `AddCommGrpCat.Colimits.Quot` for abelian groups. The
category `Cov(B)` is not small relative to the values of `F` (a covering carries an index type
and members in `Et(A)`), so the colimit lives in a larger universe than `F`; the explicit
quotients are universe-polymorphic, which is why they are used rather than `Limits.colimit`.

Mathlib's sieve-indexed plus construction `GrothendieckTopology.plusObj` for
`Scheme.AffineEtale.topology (Spec A)` is the analogous colimit over covering sieves; comparing
the two needs the cofinality of the functor `Covering.toCover` from coverings to covering
sieves.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FreitagKiehl1988], I.1
-/

@[expose] public noncomputable section

universe w u v

open CategoryTheory Opposite

namespace AlgebraicGeometry

namespace EtaleCategory

variable {A : CommRingCat.{u}}

namespace Covering

/-- The functor `𝔅 ↦ F(𝔅)`, `(σ, h) ↦ (σ, h)_*` on the category `Cov(B)` of coverings of `B`,
for a presheaf of sets `F` on `Et(A)`. -/
@[simps]
def sectionsFunctor (F : EtaleCategory A ⥤ Type v) (B : EtaleCategory A) :
    Covering.{w} B ⥤ Type (max v w) where
  obj 𝔅 := coveringSections F 𝔅.map
  map φ := ↾(HomOver.sectionsMap F φ)
  map_id 𝔅 := by ext s j; simp
  map_comp φ ψ := by ext s j; simp; rfl

/-- The functor `𝔅 ↦ F(𝔅)`, `(σ, h) ↦ (σ, h)_*` on the category `Cov(B)` of coverings of `B`,
with values in abelian groups, for a presheaf of abelian groups `F` on `Et(A)`. -/
@[simps]
def sectionsAddFunctor (F : EtaleCategory A ⥤ AddCommGrpCat.{v}) (B : EtaleCategory A) :
    Covering.{w} B ⥤ AddCommGrpCat.{max v w} where
  obj 𝔅 := AddCommGrpCat.of (coveringSectionsAddSubgroup F 𝔅.map)
  map φ := AddCommGrpCat.ofHom (HomOver.sectionsAddMonoidHom F φ)
  map_id 𝔅 := by
    ext s j
    simp [HomOver.sectionsAddMonoidHom]
    rfl
  map_comp φ ψ := by
    ext s j
    simp [HomOver.sectionsAddMonoidHom]
    rfl

end Covering

open Covering

/-- The plus construction `F̃(B) = colim_{𝔅 ∈ Cov(B)} F(𝔅)` of a presheaf of sets `F` on `Et(A)`
at an object `B`: the quotient of the set of pairs `(𝔅, s)`, `𝔅` a covering of `B` and
`s ∈ F(𝔅)`, by the equivalence relation generated by `(𝔅, s) ∼ (𝔅', (σ, h)_* s)` for all
morphisms of coverings `(σ, h) : 𝔅 ⟶ 𝔅'`. -/
@[weil "def_fk101_plus_construction"]
abbrev plusConstruction (F : EtaleCategory A ⥤ Type v) (B : EtaleCategory A) :=
  (sectionsFunctor.{w} F B).ColimitType

namespace plusConstruction

variable {F : EtaleCategory A ⥤ Type v} {B : EtaleCategory A}

/-- The class `[𝔅, s] ∈ F̃(B)` of a section `s ∈ F(𝔅)` over a covering `𝔅` of `B`. -/
@[weil "def_fk101_plus_construction"]
abbrev mk (𝔅 : Covering.{w} B) (s : coveringSections F 𝔅.map) : plusConstruction.{w} F B :=
  (sectionsFunctor.{w} F B).ιColimitType 𝔅 s

/-- `[𝔅', (σ, h)_* s] = [𝔅, s]` for a morphism of coverings `(σ, h) : 𝔅 ⟶ 𝔅'`. -/
@[simp]
lemma mk_sectionsMap {𝔅 𝔅' : Covering.{w} B} (φ : 𝔅 ⟶ 𝔅') (s : coveringSections F 𝔅.map) :
    mk 𝔅' (HomOver.sectionsMap F φ s) = mk 𝔅 s :=
  (sectionsFunctor.{w} F B).ιColimitType_map φ s

/-- Every element of `F̃(B)` is a class `[𝔅, s]`. -/
@[weil "lem_fk101_plus_construction_element_representative"]
lemma exists_mk (t : plusConstruction.{w} F B) :
    ∃ (𝔅 : Covering.{w} B) (s : coveringSections F 𝔅.map), mk 𝔅 s = t := by
  obtain ⟨𝔅, s, rfl⟩ := (sectionsFunctor.{w} F B).ιColimitType_jointly_surjective t
  exact ⟨𝔅, s, rfl⟩

/-- `[𝔅, s] = [𝔅', s']` if and only if `(𝔅, s)` and `(𝔅', s')` are related by the equivalence
relation generated by `(𝔅, s) ∼ (𝔅', (σ, h)_* s)`. -/
lemma mk_eq_mk_iff {𝔅 𝔅' : Covering.{w} B} (s : coveringSections F 𝔅.map)
    (s' : coveringSections F 𝔅'.map) :
    mk 𝔅 s = mk 𝔅' s' ↔
      Relation.EqvGen (sectionsFunctor.{w} F B).ColimitTypeRel ⟨𝔅, s⟩ ⟨𝔅', s'⟩ :=
  Quot.eq

/-- `F̃(B)`, with the maps `s ↦ [𝔅, s]`, is a colimit of the functor `𝔅 ↦ F(𝔅)` on `Cov(B)`. -/
lemma isColimit : (sectionsFunctor.{w} F B).coconeTypes.IsColimit :=
  (sectionsFunctor.{w} F B).isColimit_coconeTypes

/-- A map out of `F̃(B)` is determined by its values on the classes `[𝔅, s]`. -/
@[ext]
lemma hom_ext {X : Type*} {f g : plusConstruction.{w} F B → X}
    (h : ∀ (𝔅 : Covering.{w} B) (s : coveringSections F 𝔅.map), f (mk 𝔅 s) = g (mk 𝔅 s)) :
    f = g :=
  funext fun t ↦ by
    obtain ⟨𝔅, s, rfl⟩ := exists_mk t
    exact h 𝔅 s

end plusConstruction

/-- The plus construction `F̃(B) = colim_{𝔅 ∈ Cov(B)} F(𝔅)` of a presheaf of abelian groups `F`
on `Et(A)` at an object `B`, the colimit in abelian groups: the quotient of `⨁_𝔅 F(𝔅)` by the
subgroup generated by the elements `s - (σ, h)_* s` for all morphisms of coverings
`(σ, h) : 𝔅 ⟶ 𝔅'`. -/
@[weil "def_fk101_plus_construction"]
def addPlusConstruction (F : EtaleCategory A ⥤ AddCommGrpCat.{v}) (B : EtaleCategory A) :
    AddCommGrpCat :=
  letI := Classical.decEq (Covering.{w} B)
  AddCommGrpCat.of (AddCommGrpCat.Colimits.Quot (sectionsAddFunctor.{w} F B))

namespace addPlusConstruction

variable {F : EtaleCategory A ⥤ AddCommGrpCat.{v}} {B : EtaleCategory A}

/-- The homomorphism `F(𝔅) → F̃(B)`, `s ↦ [𝔅, s]`, for a covering `𝔅` of `B`. -/
@[weil "def_fk101_plus_construction"]
def mk (𝔅 : Covering.{w} B) :
    coveringSectionsAddSubgroup F 𝔅.map →+ addPlusConstruction.{w} F B :=
  letI := Classical.decEq (Covering.{w} B)
  AddCommGrpCat.Colimits.Quot.ι (sectionsAddFunctor.{w} F B) 𝔅

/-- `[𝔅', (σ, h)_* s] = [𝔅, s]` for a morphism of coverings `(σ, h) : 𝔅 ⟶ 𝔅'`. -/
@[simp]
lemma mk_sectionsAddMonoidHom {𝔅 𝔅' : Covering.{w} B} (φ : 𝔅 ⟶ 𝔅')
    (s : coveringSectionsAddSubgroup F 𝔅.map) :
    mk 𝔅' (HomOver.sectionsAddMonoidHom F φ s) = mk 𝔅 s :=
  letI := Classical.decEq (Covering.{w} B)
  AddCommGrpCat.Colimits.Quot.map_ι (sectionsAddFunctor.{w} F B) (f := φ) s

/-- Two homomorphisms out of `F̃(B)` agree if they agree on all classes `[𝔅, s]`. -/
@[ext]
lemma hom_ext {α : Type*} [AddMonoid α] {f g : addPlusConstruction.{w} F B →+ α}
    (h : ∀ (𝔅 : Covering.{w} B) (s : coveringSectionsAddSubgroup F 𝔅.map),
      f (mk 𝔅 s) = g (mk 𝔅 s)) :
    f = g :=
  letI := Classical.decEq (Covering.{w} B)
  AddCommGrpCat.Colimits.Quot.addMonoidHom_ext (sectionsAddFunctor.{w} F B) h

/-- The universal property of `F̃(B)`: a family of homomorphisms `f_𝔅 : F(𝔅) → M` into an
abelian group with `f_𝔅' ∘ (σ, h)_* = f_𝔅` for all morphisms of coverings `(σ, h) : 𝔅 ⟶ 𝔅'`
induces a homomorphism `F̃(B) → M`, `[𝔅, s] ↦ f_𝔅 s`. -/
def lift {M : Type*} [AddCommGroup M]
    (f : ∀ 𝔅 : Covering.{w} B, coveringSectionsAddSubgroup F 𝔅.map →+ M)
    (hf : ∀ {𝔅 𝔅' : Covering.{w} B} (φ : 𝔅 ⟶ 𝔅'),
      (f 𝔅').comp (HomOver.sectionsAddMonoidHom F φ) = f 𝔅) :
    addPlusConstruction.{w} F B →+ M :=
  letI := Classical.decEq (Covering.{w} B)
  QuotientAddGroup.lift _ (DFinsupp.sumAddHom fun 𝔅 ↦ f 𝔅) <| by
    rw [AddSubgroup.closure_le]
    rintro _ ⟨𝔅, 𝔅', φ, s, rfl⟩
    simp only [SetLike.mem_coe, AddMonoidHom.mem_ker, map_sub]
    erw [DFinsupp.sumAddHom_single, DFinsupp.sumAddHom_single]
    exact sub_eq_zero.2 (DFunLike.congr_fun (hf φ) s)

@[simp]
lemma lift_mk {M : Type*} [AddCommGroup M]
    (f : ∀ 𝔅 : Covering.{w} B, coveringSectionsAddSubgroup F 𝔅.map →+ M)
    (hf : ∀ {𝔅 𝔅' : Covering.{w} B} (φ : 𝔅 ⟶ 𝔅'),
      (f 𝔅').comp (HomOver.sectionsAddMonoidHom F φ) = f 𝔅)
    (𝔅 : Covering.{w} B) (s : coveringSectionsAddSubgroup F 𝔅.map) :
    lift f hf (mk 𝔅 s) = f 𝔅 s := by
  dsimp [lift, mk, AddCommGrpCat.Colimits.Quot.ι]
  classical
  erw [QuotientAddGroup.lift_mk', DFinsupp.sumAddHom_single]
  rfl

end addPlusConstruction

end EtaleCategory

end AlgebraicGeometry
