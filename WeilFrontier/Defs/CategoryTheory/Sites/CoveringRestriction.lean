module

public import Weil.Attr
public import WeilFrontier.Defs.CategoryTheory.Sites.IsSheafFor

/-!
# The restriction map to the sections over a covering

Let `A` be a commutative ring, `F` a presheaf on the étale category `Et(A)` and
`𝔅 = (gᵢ : B → Cᵢ)ᵢ` a family of morphisms of `Et(A)` with common source `B`. The
*restriction map* `ρ_𝔅 : F(B) → F(𝔅)` sends a section `s` to the family `(F(gᵢ)(s))ᵢ`. This
family is compatible: if `gᵢ ≫ u = gⱼ ≫ v` then
`F(u)(F(gᵢ)(s)) = F(gᵢ ≫ u)(s) = F(gⱼ ≫ v)(s) = F(v)(F(gⱼ)(s))`.

For a covering `g`, under the identification `coveringSectionsEquivMeq` of `F(𝔅)` with the
matching families on the generated covering sieve, `ρ_𝔅` is Mathlib's `Meq.mk`.

## Main definitions

- `AlgebraicGeometry.EtaleCategory.coveringRestriction F g`: the restriction map
  `F(B) → F(𝔅)` of a presheaf of sets.
- `AlgebraicGeometry.EtaleCategory.coveringRestrictionAddMonoidHom F g`: the restriction map
  of a presheaf of abelian groups, as a group homomorphism `F(B) →+ F(𝔅)`.

## Main results

- `AlgebraicGeometry.EtaleCategory.coveringRestriction_apply`: `ρ_𝔅(s)ᵢ = F(gᵢ)(s)`.
- `AlgebraicGeometry.EtaleCategory.coveringSectionsEquivMeq_coveringRestriction`: for a
  covering, `ρ_𝔅` corresponds to `Meq.mk`.
- `AlgebraicGeometry.EtaleCategory.injective_coveringRestriction_iff_isSeparatedFor`:
  `ρ_𝔅` is injective if and only if `F` is separated for the presieve generated by `g`.
- `AlgebraicGeometry.EtaleCategory.bijective_coveringRestriction_iff_isSheafFor`:
  `ρ_𝔅` is bijective if and only if `F` satisfies the sheaf condition for the presieve
  generated by `g`.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FreitagKiehl1988], I.1
-/

@[expose] public noncomputable section

universe u v w

open CategoryTheory Opposite

namespace AlgebraicGeometry

namespace EtaleCategory

variable {A : CommRingCat.{u}} {B : EtaleCategory A} {ι : Type w} {C : ι → EtaleCategory A}

lemma map_mem_coveringSections (F : EtaleCategory A ⥤ Type v) (g : ∀ i, B ⟶ C i)
    (s : F.obj B) : (fun i ↦ F.map (g i) s) ∈ coveringSections F g := by
  rw [mem_coveringSections_iff]
  intro i j D u v huv
  rw [← Functor.map_comp_apply, ← Functor.map_comp_apply, huv]

/-- The restriction map `ρ_𝔅 : F(B) → F(𝔅)`, `s ↦ (F(gᵢ)(s))ᵢ`, of a presheaf of sets `F` on
`Et(A)` to its sections over a family `𝔅 = (gᵢ : B ⟶ Cᵢ)ᵢ`. -/
@[weil "def_fk101_covering_restriction"]
def coveringRestriction (F : EtaleCategory A ⥤ Type v) (g : ∀ i, B ⟶ C i) :
    F.obj B → coveringSections F g :=
  fun s ↦ ⟨fun i ↦ F.map (g i) s, map_mem_coveringSections F g s⟩

variable (F : EtaleCategory A ⥤ Type v) (g : ∀ i, B ⟶ C i)

@[simp]
lemma coveringRestriction_apply (s : F.obj B) (i : ι) :
    (coveringRestriction F g s).1 i = F.map (g i) s :=
  rfl

/-- The restriction map is natural in the presheaf. -/
lemma coveringRestriction_naturality {G : EtaleCategory A ⥤ Type v} (φ : F ⟶ G)
    (s : F.obj B) (i : ι) :
    (coveringRestriction G g (φ.app B s)).1 i = φ.app (C i) ((coveringRestriction F g s).1 i) :=
  (NatTrans.naturality_apply φ (g i) s).symm

/-- For a covering `g`, under the identification of `F(𝔅)` with the matching families on the
generated covering sieve, the restriction map is `Meq.mk`. -/
lemma coveringSectionsEquivMeq_coveringRestriction {g : ∀ i, B ⟶ C i} (hg : IsCovering g)
    (s : F.obj B) :
    coveringSectionsEquivMeq F hg (coveringRestriction F g s) = Meq.mk hg.cover s := by
  ext ⟨Y, f, hf⟩
  obtain ⟨Z, h, k, ⟨i⟩, rfl⟩ := hf
  rw [Meq.mk_apply]
  change (coveringSectionsEquivCompatible F g _).1.sieveExtend _ _ = _
  have hc := (coveringSectionsEquivCompatible F g (coveringRestriction F g s)).2.sieveExtend
  refine (hc.to_sieveCompatible (g i).unop h
    (Sieve.ofArrows_mk _ _ i)).trans ?_
  rw [Presieve.extend_agrees (coveringSectionsEquivCompatible F g _).2
    (Presieve.ofArrows.mk i)]
  rw [show (coveringSectionsEquivCompatible F g (coveringRestriction F g s)).1 (g i).unop
      (Presieve.ofArrows.mk i) = F.map (g i) s from
    (coveringRestriction F g s).2.familyOfElements_ofArrows_mk i]
  change F.map h.op (F.map (g i) s) = F.map (h ≫ (g i).unop).op s
  rw [op_comp, Functor.map_comp_apply]
  rfl

/-- The restriction map `ρ_𝔅` is injective if and only if `F` is separated for the presieve
generated by the opposite family of `g`. -/
lemma injective_coveringRestriction_iff_isSeparatedFor :
    Function.Injective (coveringRestriction F g) ↔
      Presieve.IsSeparatedFor F
        (Presieve.ofArrows (fun i ↦ (C i).unop) (fun i ↦ (g i).unop)) := by
  constructor
  · intro h x t₁ t₂ h₁ h₂
    refine h (Subtype.ext (funext fun i ↦ ?_))
    exact (h₁ _ (Presieve.ofArrows.mk i)).trans (h₂ _ (Presieve.ofArrows.mk i)).symm
  · intro h s t hst
    refine h.ext fun Y f hf ↦ ?_
    obtain ⟨i⟩ := hf
    exact congrFun (congrArg Subtype.val hst) i

/-- The restriction map `ρ_𝔅` is bijective if and only if `F` satisfies the sheaf condition for
the presieve generated by the opposite family of `g`. -/
lemma bijective_coveringRestriction_iff_isSheafFor :
    Function.Bijective (coveringRestriction F g) ↔
      Presieve.IsSheafFor F
        (Presieve.ofArrows (fun i ↦ (C i).unop) (fun i ↦ (g i).unop)) := by
  rw [Presieve.isSheafFor_arrows_iff]
  constructor
  · rintro ⟨hinj, hsurj⟩ x hx
    obtain ⟨s, hs⟩ := hsurj ⟨x, hx⟩
    refine ⟨s, fun i ↦ congrFun (congrArg Subtype.val hs) i, fun t ht ↦ hinj ?_⟩
    rw [hs]
    exact Subtype.ext (funext ht)
  · intro h
    refine ⟨fun s t hst ↦ ?_, fun x ↦ ?_⟩
    · obtain ⟨r, -, hr⟩ := h _ (coveringRestriction F g s).2
      exact (hr s fun i ↦ rfl).trans
        (hr t fun i ↦ (congrFun (congrArg Subtype.val hst) i).symm).symm
    · obtain ⟨r, hr, -⟩ := h x.1 x.2
      exact ⟨r, Subtype.ext (funext hr)⟩

/-- The restriction map `ρ_𝔅 : F(B) →+ F(𝔅)` of a presheaf of abelian groups `F` on `Et(A)`,
`s ↦ (F(gᵢ)(s))ᵢ`, as a homomorphism to the subgroup `F(𝔅)` of `∏ᵢ F(Cᵢ)`. -/
@[weil "def_fk101_covering_restriction"]
def coveringRestrictionAddMonoidHom (F : EtaleCategory A ⥤ AddCommGrpCat.{v})
    (g : ∀ i, B ⟶ C i) : F.obj B →+ coveringSectionsAddSubgroup F g where
  toFun s := ⟨fun i ↦ F.map (g i) s, map_mem_coveringSections (F ⋙ forget AddCommGrpCat) g s⟩
  map_zero' := Subtype.ext <| funext fun i ↦ map_zero (F.map (g i)).hom
  map_add' s t := Subtype.ext <| funext fun i ↦ map_add (F.map (g i)).hom s t

@[simp]
lemma coveringRestrictionAddMonoidHom_apply (F : EtaleCategory A ⥤ AddCommGrpCat.{v})
    (g : ∀ i, B ⟶ C i) (s : F.obj B) (i : ι) :
    (coveringRestrictionAddMonoidHom F g s).1 i = F.map (g i) s :=
  rfl

/-- The group homomorphism `ρ_𝔅` has the restriction map of the underlying presheaf of sets as
underlying function. -/
lemma coe_coveringRestrictionAddMonoidHom (F : EtaleCategory A ⥤ AddCommGrpCat.{v})
    (g : ∀ i, B ⟶ C i) (s : F.obj B) :
    ((coveringRestrictionAddMonoidHom F g s : ∀ i, F.obj (C i))) =
      (coveringRestriction (F ⋙ forget AddCommGrpCat) g s).1 :=
  rfl

end EtaleCategory

end AlgebraicGeometry
