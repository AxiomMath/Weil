module

public import Weil.Attr
public import StacksFrontier.RingTheory.Henselian.Henselization.Basic
import all StacksFrontier.RingTheory.Henselian.StrictHenselization.Existence

/-!
# The Henselization of a local ring with respect to a map to a field

Let `A` be a local ring with residue field `κ`, let `k` be a field and let `φ : A → k` be a local
homomorphism, so that `φ` induces an embedding `κ → k`. The *Henselization of `A` with respect to
`φ`* is a local `A`-algebra `Ã` together with a homomorphism `ψ : Ã → k` extending `φ`, such that
`Ã` is henselian, is a filtered colimit of étale `A`-algebras, and has for residue field the
separable closure `κ_φ` of `κ` in `k`, embedded in `k` by `ψ`. For `k = κ` and `φ` the residue map
this is the Henselization `A^h`; for `k` separably closed `κ_φ` is a separable closure of `κ` and
`Ã` is a strict Henselization of `A`.

## Main definitions

* `IsLocalRing.residueSeparableClosure φ`: the separable closure `κ_φ` of the residue field of `A`
  in `k`, along the embedding `κ → k` induced by `φ`, as a subfield of `k` with its
  `κ`-algebra structure.
* `IsLocalRing.IsHenselizationAlong φ Ã ψ`: `(Ã, ψ)` is a Henselization of `A` with respect to `φ`.

## Main results

* `IsLocalRing.IsHenselizationAlong.isLocalHom_ψ`: the map `ψ : Ã → k` is local.
* `IsLocalRing.IsHenselizationAlong.isLocalHom_algebraMap`, `.faithfullyFlat`,
  `.map_maximalIdeal`: the structure map `A → Ã` is local and faithfully flat, and the maximal
  ideal of `Ã` is generated by that of `A`.
* `IsLocalRing.isHenselizationAlong_residue_iff`: for `φ` the residue map, this is the
  Henselization `A^h`, i.e. `IsLocalRing.IsHenselization A (ResidueField A) Ã`.
* `IsLocalRing.IsHenselizationAlong.isSepClosure`: for `k` separably closed, `κ_φ` is a separable
  closure of `κ`, so `Ã` is a strict Henselization of `A`.
* `IsLocalRing.exists_isHenselizationAlong`: every local homomorphism `φ` to a field has a
  Henselization.
* `IsLocalRing.IsHenselizationAlong.range_ψ`: `ψ` maps `Ã` onto `κ_φ`.

## Implementation notes

The source defines `Ã` as the colimit, in the category of commutative rings, of the local
`A`-algebras `(A[X₁, …, Xₙ]/I)_q` local-étale over `A` together with a local homomorphism to `k`
extending `φ`, and `ψ` as the map induced by these. Here the pair `(Ã, ψ)` is characterized by the
properties which determine it up to unique isomorphism (Stacks 08HT): `Ã` is a henselization of `A`
in the sense of `IsLocalRing.IsHenselization` with residue field `κ_φ`, which is the residue field
of the source's colimit, and `ψ` extends `φ`. The map `ψ` is then automatically local, and it
identifies the residue field of `Ã` with `κ_φ ⊆ k`. The colimit description is
`IsLocalRing.IsHenselization.isFiltered_augmentedEtale_and_isColimit` (Stacks 04GW), over étale
`A`-algebras augmented to `κ_φ`.

The source assumes `A` noetherian; the definition does not need it.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FK88], I.1
* [StacksProject 04GQ](https://stacks.math.columbia.edu/tag/04GQ)
-/

@[expose] public section

open IsLocalRing

universe u v w

namespace IsLocalRing

variable {A : Type u} [CommRing A] [IsLocalRing A] {k : Type v} [Field k] (φ : A →+* k)
  [IsLocalHom φ]

/-- The separable closure of the residue field `κ` of `A` in the field `k`, along the embedding
`κ → k` induced by the local homomorphism `φ : A → k`. -/
noncomputable def residueSeparableClosure : Subfield k :=
  letI := (ResidueField.lift φ).toAlgebra
  (separableClosure (ResidueField A) k).toSubfield

theorem mem_residueSeparableClosure {x : k} :
    x ∈ residueSeparableClosure φ ↔
      letI := (ResidueField.lift φ).toAlgebra
      IsSeparable (ResidueField A) x :=
  let := (ResidueField.lift φ).toAlgebra
  mem_separableClosure_iff

theorem lift_mem_residueSeparableClosure (x : ResidueField A) :
    ResidueField.lift φ x ∈ residueSeparableClosure φ :=
  let := (ResidueField.lift φ).toAlgebra
  (separableClosure (ResidueField A) k).algebraMap_mem x

noncomputable instance : Algebra (ResidueField A) (residueSeparableClosure φ) :=
  ((ResidueField.lift φ).codRestrict _ (lift_mem_residueSeparableClosure φ)).toAlgebra

@[simp]
theorem coe_algebraMap_residueSeparableClosure (x : ResidueField A) :
    (algebraMap (ResidueField A) (residueSeparableClosure φ) x : k) = ResidueField.lift φ x :=
  rfl

/-- `κ_φ` is the separable closure `separableClosure κ k` of `κ` in `k`, for the `κ`-algebra
structure on `k` induced by `φ`, by an isomorphism of `κ`-algebras which is the identity of `k`. -/
theorem residueSeparableClosure_algEquiv :
    letI := (ResidueField.lift φ).toAlgebra
    ∃ e : residueSeparableClosure φ ≃ₐ[ResidueField A] separableClosure (ResidueField A) k,
      ∀ x, (e x : k) = x := by
  let := (ResidueField.lift φ).toAlgebra
  exact ⟨{ RingEquiv.refl _ with commutes' := fun _ => rfl }, fun _ => rfl⟩

instance : Algebra.IsSeparable (ResidueField A) (residueSeparableClosure φ) := by
  let := (ResidueField.lift φ).toAlgebra
  obtain ⟨e, -⟩ := residueSeparableClosure_algEquiv φ
  exact AlgEquiv.Algebra.isSeparable e.symm

instance [IsSepClosed k] : IsSepClosure (ResidueField A) (residueSeparableClosure φ) := by
  let := (ResidueField.lift φ).toAlgebra
  obtain ⟨e, -⟩ := residueSeparableClosure_algEquiv φ
  have : IsSepClosed (separableClosure (ResidueField A) k) :=
    IsSepClosure.sep_closed (ResidueField A)
  exact ⟨Stacks.StrictHenselization.EtaleColimit.isSepClosed_of_ringEquiv e.symm.toRingEquiv,
    inferInstance⟩

/-- **The Henselization of a local ring with respect to a local homomorphism to a field.** Let
`φ : A → k` be a local homomorphism from a local ring to a field. The pair `(Ã, ψ)` of a local
`A`-algebra `Ã` and a homomorphism `ψ : Ã → k` is a Henselization of `A` with respect to `φ` if
`Ã` is a henselization of `A` (henselian, a filtered colimit of étale `A`-algebras) with residue
field the separable closure `κ_φ` of the residue field of `A` in `k`, and `ψ` extends `φ`.
For `φ` the residue map this is the Henselization `A^h`, and for `k` separably closed a strict
Henselization of `A`. -/
@[weil "def_fk101_henselization"]
structure IsHenselizationAlong (Ã : Type w) [CommRing Ã] [IsLocalRing Ã] [Algebra A Ã]
    (ψ : Ã →+* k) : Prop where
  /-- `Ã` is a henselization of `A` with residue field `κ_φ`. -/
  isHenselization : IsHenselization A (residueSeparableClosure φ) Ã
  /-- `ψ` extends `φ`. -/
  ψ_comp_algebraMap : ψ.comp (algebraMap A Ã) = φ

namespace IsHenselizationAlong

variable {φ} {Ã : Type w} [CommRing Ã] [IsLocalRing Ã] [Algebra A Ã] {ψ : Ã →+* k}

theorem ψ_algebraMap (h : IsHenselizationAlong φ Ã ψ) (a : A) : ψ (algebraMap A Ã a) = φ a :=
  RingHom.congr_fun h.ψ_comp_algebraMap a

theorem henselian (h : IsHenselizationAlong φ Ã ψ) : HenselianLocalRing Ã :=
  h.isHenselization.henselian

theorem isLocalHom_algebraMap (h : IsHenselizationAlong φ Ã ψ) :
    IsLocalHom (algebraMap A Ã) :=
  have := h.isHenselization
  IsHenselization.isLocalHom (L := residueSeparableClosure φ)

theorem faithfullyFlat (h : IsHenselizationAlong φ Ã ψ) : Module.FaithfullyFlat A Ã :=
  have := h.isHenselization
  IsHenselization.faithfullyFlat (L := residueSeparableClosure φ)

theorem map_maximalIdeal (h : IsHenselizationAlong φ Ã ψ) :
    (maximalIdeal A).map (algebraMap A Ã) = maximalIdeal Ã :=
  have := h.isHenselization
  IsHenselization.map_maximalIdeal (L := residueSeparableClosure φ)

/-- The map `ψ : Ã → k` kills the maximal ideal of `Ã`. -/
theorem maximalIdeal_le_ker (h : IsHenselizationAlong φ Ã ψ) :
    maximalIdeal Ã ≤ RingHom.ker ψ := by
  rw [← h.map_maximalIdeal, Ideal.map_le_iff_le_comap]
  intro a ha
  rw [Ideal.mem_comap, RingHom.mem_ker, h.ψ_algebraMap]
  by_contra hne
  exact (mem_maximalIdeal a).1 ha (isUnit_of_map_unit φ a (Ne.isUnit hne))

/-- The map `ψ : Ã → k` is a local homomorphism. -/
theorem isLocalHom_ψ (h : IsHenselizationAlong φ Ã ψ) : IsLocalHom ψ where
  map_nonunit x hx := by
    by_contra hnu
    have hx0 : ψ x = 0 := h.maximalIdeal_le_ker ((mem_maximalIdeal x).2 hnu)
    rw [hx0] at hx
    exact not_isUnit_zero hx

theorem ker_ψ (h : IsHenselizationAlong φ Ã ψ) : RingHom.ker ψ = maximalIdeal Ã :=
  le_antisymm (le_maximalIdeal (RingHom.ker_ne_top ψ)) h.maximalIdeal_le_ker
/-- The residue field of `Ã` is identified with `κ_φ ⊆ k` by `ψ`: the image of `ψ` is `κ_φ`. -/
theorem range_ψ (h : IsHenselizationAlong φ Ã ψ) :
    ψ.range = (residueSeparableClosure φ).toSubring := by
  have := h.isHenselization
  have := h.isLocalHom_ψ
  obtain ⟨e, he⟩ := IsHenselization.exists_residueFieldEquiv (R := A)
    (L := residueSeparableClosure φ) (Rh := Ã)
  let _ := (ResidueField.lift φ).toAlgebra
  -- the `κ`-algebra map `κ_φ ≃ κ(Ã) → k` induced by `ψ`
  let g : residueSeparableClosure φ →ₐ[ResidueField A] k :=
    { (ResidueField.lift ψ).comp e.toRingHom with
      commutes' := fun x => by
        obtain ⟨a, rfl⟩ := residue_surjective x
        change ResidueField.lift ψ (e (algebraMap _ _ (residue A a))) = ResidueField.lift φ _
        rw [he, ResidueField.lift_residue_apply, ResidueField.lift_residue_apply,
          h.ψ_algebraMap] }
  have hg : ∀ x, g x ∈ residueSeparableClosure φ := fun x =>
    (mem_residueSeparableClosure φ).2
      ((Algebra.IsSeparable.isSeparable (ResidueField A) x).map g g.toRingHom.injective)
  let g' : residueSeparableClosure φ →ₐ[ResidueField A] residueSeparableClosure φ :=
    { g.toRingHom.codRestrict _ hg with
      commutes' := fun x => Subtype.ext (g.commutes x) }
  have hbij := Algebra.IsAlgebraic.algHom_bijective g'
  ext y
  rw [Subfield.mem_toSubring]
  constructor
  · rintro ⟨x, rfl⟩
    have hx : ψ x = g (e.symm (residue Ã x)) := by
      change ψ x = ResidueField.lift ψ (e (e.symm (residue Ã x)))
      rw [RingEquiv.apply_symm_apply, ResidueField.lift_residue_apply]
    rw [hx]
    exact hg _
  · intro hy
    obtain ⟨z, hz⟩ := hbij.2 ⟨y, hy⟩
    obtain ⟨x, hx⟩ := residue_surjective (e z)
    refine ⟨x, ?_⟩
    have hgz : g z = y := congrArg Subtype.val hz
    rw [← hgz]
    change ψ x = ResidueField.lift ψ (e z)
    rw [← hx, ResidueField.lift_residue_apply]

end IsHenselizationAlong

/-- **Changing the prescribed residue extension along an isomorphism.** A henselization of `R`
with residue field `L` is one with residue field `L'` for every `κ`-isomorphism `L ≃ L'`. -/
theorem IsHenselization.of_residueAlgEquiv {R : Type u} [CommRing R] [IsLocalRing R]
    {L : Type v} [Field L] [Algebra (ResidueField R) L] {L' : Type*} [Field L']
    [Algebra (ResidueField R) L'] {Rh : Type w} [CommRing Rh] [IsLocalRing Rh] [Algebra R Rh]
    (e : L ≃ₐ[ResidueField R] L') [IsHenselization R L Rh] : IsHenselization R L' Rh := by
  obtain ⟨f, hf⟩ := IsHenselization.exists_residueFieldEquiv (R := R) (L := L) (Rh := Rh)
  refine ⟨IsHenselization.henselian (R := R) (L := L) (Rh := Rh),
    IsHenselization.ind_etale (R := R) (L := L) (Rh := Rh), e.symm.toRingEquiv.trans f,
    fun x => ?_⟩
  change f (e.symm (algebraMap (ResidueField R) L' (residue R x))) = _
  rw [AlgEquiv.commutes, hf]

/-- A henselization of `A` with residue field `κ_φ` carries a homomorphism `ψ` to `k` making it a
Henselization of `A` with respect to `φ`. -/
theorem IsHenselization.exists_isHenselizationAlong {Ã : Type w} [CommRing Ã] [IsLocalRing Ã]
    [Algebra A Ã] [IsHenselization A (residueSeparableClosure φ) Ã] :
    ∃ ψ : Ã →+* k, IsHenselizationAlong φ Ã ψ := by
  obtain ⟨e, he⟩ := IsHenselization.exists_residueFieldEquiv (R := A)
    (L := residueSeparableClosure φ) (Rh := Ã)
  refine ⟨(residueSeparableClosure φ).subtype.comp (e.symm.toRingHom.comp (residue Ã)),
    inferInstance, RingHom.ext fun a => ?_⟩
  change ((e.symm (residue Ã (algebraMap A Ã a)) : residueSeparableClosure φ) : k) = φ a
  rw [← he, RingEquiv.symm_apply_apply, coe_algebraMap_residueSeparableClosure,
    ResidueField.lift_residue_apply]

section Residue

variable (A)

/-- For `φ` the residue map `A → κ`, the separable closure of `κ` in `κ` is `κ`. -/
noncomputable def residueSeparableClosureResidueAlgEquiv :
    residueSeparableClosure (residue A) ≃ₐ[ResidueField A] ResidueField A :=
  have hlift : ∀ x, ResidueField.lift (residue A) x = x := fun x => by
    obtain ⟨a, rfl⟩ := residue_surjective x
    exact ResidueField.lift_residue_apply _ a
  AlgEquiv.ofBijective
    { (residueSeparableClosure (residue A)).subtype with
      commutes' := fun x => hlift x }
    ⟨Subtype.val_injective, fun x =>
      ⟨⟨x, hlift x ▸ lift_mem_residueSeparableClosure (residue A) x⟩, rfl⟩⟩

variable {A}

/-- **The Henselization `A^h`.** For `φ` the residue map, a Henselization of `A` with respect to
`φ` is a henselization of `A` with residue field `κ`, with `ψ` extending the residue map. -/
@[weil "def_fk101_henselization"]
theorem isHenselizationAlong_residue_iff {Ã : Type w} [CommRing Ã] [IsLocalRing Ã] [Algebra A Ã]
    {ψ : Ã →+* ResidueField A} :
    IsHenselizationAlong (residue A) Ã ψ ↔
      IsHenselization A (ResidueField A) Ã ∧ ψ.comp (algebraMap A Ã) = residue A := by
  refine ⟨fun h => ⟨?_, h.ψ_comp_algebraMap⟩, fun ⟨h, hψ⟩ => ⟨?_, hψ⟩⟩
  · have := h.isHenselization
    exact IsHenselization.of_residueAlgEquiv (residueSeparableClosureResidueAlgEquiv A)
  · exact IsHenselization.of_residueAlgEquiv (residueSeparableClosureResidueAlgEquiv A).symm

end Residue

section Strict

variable {φ} {Ã : Type w} [CommRing Ã] [IsLocalRing Ã] [Algebra A Ã] {ψ : Ã →+* k}

/-- **Strict Henselizations.** For `k` separably closed, a Henselization of `A` with respect to
`φ` is a strict henselization of `A`: a henselization with residue field a separable closure of
the residue field `κ` of `A`. -/
@[weil "def_fk101_henselization"]
theorem IsHenselizationAlong.isHenselization_separableClosure [IsSepClosed k]
    (h : IsHenselizationAlong φ Ã ψ) :
    IsHenselization A (SeparableClosure (ResidueField A)) Ã :=
  have := h.isHenselization
  IsHenselization.of_residueAlgEquiv
    (IsSepClosure.equiv (ResidueField A) (residueSeparableClosure φ) _)

/-- For `k` separably closed, the residue field of a Henselization of `A` with respect to `φ` is
separably closed. -/
theorem IsHenselizationAlong.isSepClosed_residueField [IsSepClosed k]
    (h : IsHenselizationAlong φ Ã ψ) : IsSepClosed (ResidueField Ã) := by
  have := h.isHenselization
  obtain ⟨e, -⟩ := IsHenselization.exists_residueFieldEquiv (R := A)
    (L := residueSeparableClosure φ) (Rh := Ã)
  have : IsSepClosed (residueSeparableClosure φ) := IsSepClosure.sep_closed (ResidueField A)
  exact Stacks.StrictHenselization.EtaleColimit.isSepClosed_of_ringEquiv e

end Strict

/- the construction below is the colimit `augColimit` of the
proof of Stacks 04GP in StacksFrontier, whose API is private there; it is reached through
`import all`. -/
open Stacks.StrictHenselization.EtaleColimit in
/-- **Existence of the Henselization with respect to `φ`.** Every local homomorphism `φ : A → k`
from a local ring to a field admits a Henselization `(Ã, ψ)`, with `Ã` in the universe of `A`.
The ring `Ã` is the colimit of the étale `A`-algebras augmented to the separable closure `κ_φ` of
the residue field of `A` in `k`. -/
@[weil "def_fk101_henselization"]
theorem exists_isHenselizationAlong :
    ∃ (Ã : Type u) (_ : CommRing Ã) (_ : IsLocalRing Ã) (_ : Algebra A Ã) (ψ : Ã →+* k),
      IsHenselizationAlong φ Ã ψ := by
  -- a copy `L₀` of `κ_φ` inside a separable closure of `κ`, in the universe of `A`
  let σ : residueSeparableClosure φ →ₐ[ResidueField A] SeparableClosure (ResidueField A) :=
    IsSepClosed.lift
  let L₀ := (⊤ : IntermediateField (ResidueField A) (residueSeparableClosure φ)).map σ
  let eL : residueSeparableClosure φ ≃ₐ[ResidueField A] L₀ :=
    IntermediateField.topEquiv.symm.trans (IntermediateField.equivMap ⊤ σ)
  have : Algebra.IsSeparable (ResidueField A) L₀ := AlgEquiv.Algebra.isSeparable eL
  let _ : Algebra A L₀ := ((algebraMap (ResidueField A) L₀).comp (residue A)).toAlgebra
  have : IsScalarTower A (ResidueField A) L₀ :=
    IsScalarTower.of_algebraMap_eq' (by rw [ResidueField.algebraMap_eq]; rfl)
  have := isLocalRing_augColimit A L₀
  have : IsHenselization A L₀ (augColimit A L₀ : Type u) :=
    IsHenselization.of_ind_etale (henselianLocalRing_augColimit A L₀) (ind_augColimit A L₀)
      ⟨residueFieldEquiv A L₀, residueFieldEquiv_algebraMap A L₀⟩
  have : IsHenselization A (residueSeparableClosure φ) (augColimit A L₀ : Type u) :=
    IsHenselization.of_residueAlgEquiv eL.symm
  obtain ⟨ψ, hψ⟩ :=
    IsHenselization.exists_isHenselizationAlong φ (Ã := (augColimit A L₀ : Type u))
  exact ⟨_, _, _, _, ψ, hψ⟩

end IsLocalRing
