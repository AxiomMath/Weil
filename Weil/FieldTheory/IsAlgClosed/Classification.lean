module

public import Weil.Attr
public import Mathlib.Analysis.Complex.Cardinality
public import Mathlib.Analysis.Complex.Polynomial.Basic
public import Mathlib.FieldTheory.IsAlgClosed.Classification
public import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
public import Mathlib.NumberTheory.Padics.PadicNumbers

/-!
# Extending complex embeddings to an algebraic closure of `ℚ_[p]`

Let `L` be a field of cardinality at most `𝔠` and `K → L` a countable subfield. Every field
embedding `K → ℂ` extends to a ring homomorphism `L → ℂ`: a transcendence basis of `L` over `K`
has cardinality at most `𝔠`, which is the cardinality of a transcendence basis of `ℂ` over the
countable field `K`, so an injection between the two bases gives an embedding of the
polynomial algebra generated by the first basis into `ℂ`, and since `L` is algebraic over this
polynomial algebra and `ℂ` is algebraically closed, it extends to `L`.

Applied to an algebraic closure of `ℚ_[p]` (which has cardinality `𝔠`) and a subfield algebraic
over `ℚ` (hence countable), this gives that every embedding of such a subfield into `ℂ`
extends to the whole algebraic closure.

## Main results

* `RingHom.exists_comp_algebraMap_eq_of_countable`: an embedding into `ℂ` of a countable field
  `K` extends along any field extension `L / K` with `#L ≤ 𝔠`.
* `Padic.cardinalMk_le_continuum`: `#ℚ_[p] ≤ 𝔠`.
* `IsAlgClosure.exists_ringHom_padic_complex_extending`: an embedding `K → ℂ` of a subfield `K`
  of an algebraic closure of `ℚ_[p]`, algebraic over `ℚ`, extends to the algebraic closure;
  `IsAlgClosure.exists_ringHom_padic_complex_extending_of_isAlgebraic_rat` is the same statement
  with the algebraicity hypothesis phrased over `ℚ`.

## Implementation notes

The argument extends the embedding along a transcendence basis followed by an algebraic
extension; it only needs an injection between the two transcendence bases, not an isomorphism
of the two fields, so no lower bound on `#L` is used.

The main statement assumes the subfield `K` algebraic over `ℤ`, which for a field of
characteristic zero is the same as algebraic over `ℚ` (`IsFractionRing.comap_isAlgebraic_iff`);
this avoids requiring a `ℚ`-algebra structure on `K` in the statement.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FK88], IV.4
-/

@[expose] public section

open Cardinal

universe u v

/-- An embedding into `ℂ` of a countable field `K` extends along any field extension `L / K`
of cardinality at most `𝔠`. -/
theorem RingHom.exists_comp_algebraMap_eq_of_countable {K : Type u} {L : Type v} [Field K]
    [Field L] [Algebra K L] [Countable K] (hL : #L ≤ 𝔠) (ι' : K →+* ℂ) :
    ∃ ι : L →+* ℂ, ι.comp (algebraMap K L) = ι' := by
  let _ : Algebra K ℂ := ι'.toAlgebra
  obtain ⟨s, hs⟩ := exists_isTranscendenceBasis K L
  obtain ⟨t, ht⟩ := exists_isTranscendenceBasis K ℂ
  have hK : #K ≤ ℵ₀ := Cardinal.mk_le_aleph0
  have htc : #t = 𝔠 := by
    have := IsAlgClosed.cardinal_eq_cardinal_transcendence_basis_of_aleph0_lt _ ht hK
      (by rw [Cardinal.mk_complex]; exact Cardinal.aleph0_lt_continuum)
    simpa [Cardinal.mk_complex] using this.symm
  have hst : Cardinal.lift.{0} #s ≤ Cardinal.lift.{v} #t := by
    rw [htc, Cardinal.lift_continuum]
    calc Cardinal.lift.{0} #s ≤ Cardinal.lift.{0} #L := Cardinal.lift_le.2 (Cardinal.mk_set_le s)
      _ ≤ Cardinal.lift.{0} 𝔠 := Cardinal.lift_le.2 hL
      _ = 𝔠 := Cardinal.lift_continuum
  obtain ⟨f⟩ := Cardinal.lift_mk_le'.1 hst
  let S := Algebra.adjoin K (Set.range ((↑) : s → L))
  let φ : S →ₐ[K] ℂ :=
    (MvPolynomial.aeval (fun i => ((f i : t) : ℂ))).comp hs.1.aevalEquiv.symm.toAlgHom
  have hφ : Function.Injective φ := by
    have hti : Function.Injective (MvPolynomial.aeval (fun i => ((f i : t) : ℂ)) :
        MvPolynomial s K →ₐ[K] ℂ) := AlgebraicIndependent.comp ht.1 f f.injective
    exact hti.comp hs.1.aevalEquiv.symm.injective
  let _ : Algebra S ℂ := φ.toRingHom.toAlgebra
  have : Module.IsTorsionFree S ℂ :=
    Module.isTorsionFree_iff_algebraMap_injective.2 hφ
  have : Algebra.IsAlgebraic S L := hs.isAlgebraic
  let g : L →ₐ[S] ℂ := IsAlgClosed.lift
  refine ⟨g.toRingHom, RingHom.ext fun k => ?_⟩
  have h1 : algebraMap K L k = algebraMap S L (algebraMap K S k) := rfl
  have h2 : g (algebraMap S L (algebraMap K S k)) = φ (algebraMap K S k) := g.commutes _
  simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
    RingHom.coe_coe, h1, h2, AlgHom.commutes]
  rfl

/-- The field `ℚ_[p]` of `p`-adic numbers has cardinality at most `𝔠`. -/
theorem Padic.cardinalMk_le_continuum (p : ℕ) [Fact p.Prime] : #ℚ_[p] ≤ 𝔠 := by
  calc #ℚ_[p] = #(CauSeq.Completion.Cauchy (padicNorm p)) := rfl
    _ ≤ #(CauSeq ℚ (padicNorm p)) := Cardinal.mk_quotient_le
    _ ≤ #(ℕ → ℚ) := Cardinal.mk_subtype_le _
    _ = 𝔠 := by simp [Cardinal.aleph0_power_aleph0]

/-- Let `L` be an algebraic closure of `ℚ_[p]` and `K ⊆ L` a subfield which is algebraic
over `ℚ` (equivalently, over `ℤ`). Every field embedding `ι' : K → ℂ` extends to a ring
homomorphism `L → ℂ`. -/
@[weil "lem_fk404_complex_embedding_extends_to_algebraic_closure"]
theorem IsAlgClosure.exists_ringHom_padic_complex_extending (p : ℕ) [Fact p.Prime]
    {L : Type u} [Field L] [Algebra ℚ_[p] L] [IsAlgClosure ℚ_[p] L] (K : Subfield L)
    [Algebra.IsAlgebraic ℤ K] (ι' : K →+* ℂ) :
    ∃ ι : L →+* ℂ, ι.comp K.subtype = ι' := by
  have : CharZero L := charZero_of_injective_algebraMap (algebraMap ℚ_[p] L).injective
  have : Countable K := by
    have h := Algebra.IsAlgebraic.lift_cardinalMk_le_max ℤ K
    simp only [Cardinal.mk_int, Cardinal.lift_aleph0, max_self, Cardinal.lift_le_aleph0] at h
    exact Cardinal.mk_le_aleph0_iff.1 h
  have hL : #L ≤ 𝔠 := by
    have : Algebra.IsAlgebraic ℚ_[p] L := IsAlgClosure.isAlgebraic
    have h := Algebra.IsAlgebraic.lift_cardinalMk_le_max ℚ_[p] L
    rw [← Cardinal.lift_le_continuum.{u, 0}]
    refine h.trans (max_le ?_ Cardinal.aleph0_le_continuum)
    exact Cardinal.lift_le_continuum.2 (Padic.cardinalMk_le_continuum p)
  let _ : Algebra K L := K.subtype.toAlgebra
  exact RingHom.exists_comp_algebraMap_eq_of_countable hL ι'

/-- The form of `IsAlgClosure.exists_ringHom_padic_complex_extending` with the subfield assumed
algebraic over `ℚ`. -/
theorem IsAlgClosure.exists_ringHom_padic_complex_extending_of_isAlgebraic_rat (p : ℕ)
    [Fact p.Prime] {L : Type u} [Field L] [CharZero L] [Algebra ℚ_[p] L]
    [IsAlgClosure ℚ_[p] L] (K : Subfield L) [Algebra.IsAlgebraic ℚ K] (ι' : K →+* ℂ) :
    ∃ ι : L →+* ℂ, ι.comp K.subtype = ι' := by
  have : Algebra.IsAlgebraic ℤ K := (IsFractionRing.comap_isAlgebraic_iff (K := ℚ)).2 ‹_›
  exact IsAlgClosure.exists_ringHom_padic_complex_extending p K ι'
