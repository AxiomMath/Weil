module

public import Weil.Attr
public import Weil.Defs.Geometry.RingedSpace.LocallyRingedSpace
public import Mathlib.Geometry.Manifold.Sheaf.LocallyRingedSpace
public import Mathlib.Topology.Sheaves.LocalPredicate
public import Mathlib.Analysis.Complex.Basic

/-!
# Local models of complex spaces

Let `D ⊆ ℂ^N` be open, `𝒪_D` its sheaf of holomorphic functions and `f₁, …, f_r` holomorphic
functions on `D`. The *local model* `V(D; f₁, …, f_r)` is the locally `ℂ`-ringed space whose
underlying space is the common zero set `V = {z ∈ D | f₁(z) = ⋯ = f_r(z) = 0}`, with the topology
induced from `D`, and whose structure sheaf is the restriction to `V` of
`𝒪_D / (f₁, …, f_r) 𝒪_D`. Its stalk at `z ∈ V` is `𝒪_{D,z} / (f₁, …, f_r)`, the quotient of the
local ring `𝒪_{D,z}` by an ideal contained in its maximal ideal. For `N = 0`, `D = ℂ⁰` and `r = 0`
it is the point `pt = ({*}, ℂ)`.

The construction is carried out for an arbitrary locally ringed space `X`, a family `f` of global
sections and a subset `V` on which every `f i` vanishes (its germ at each point of `V` lies in the
maximal ideal): the sections of `(𝒪_X / (f) 𝒪_X)|_V` over an open `U ⊆ V` are the families
`(s_x)_{x ∈ U}`, `s_x ∈ 𝒪_{X,x} / (f)`, that are locally the classes of the germs of a single
section of `𝒪_X`.

## Main definitions

- `AlgebraicGeometry.LocallyRingedSpace.quotientSubspace`: the locally ringed space
  `(V, (𝒪_X / (f) 𝒪_X)|_V)`.
- `AlgebraicGeometry.LocallyRingedSpace.quotientSubspaceι`: its inclusion into `X`.
- `AlgebraicGeometry.LocallyCRingedSpace.holomorphicSheaf`: the sheaf `𝒪_D` of holomorphic
  functions on an open subset `D ⊆ ℂ^N`.
- `AlgebraicGeometry.LocallyCRingedSpace.complexDomain`: `(D, 𝒪_D)` as a locally `ℂ`-ringed
  space.
- `AlgebraicGeometry.LocallyCRingedSpace.localModel`: the local model `V(D; f)`.
- `AlgebraicGeometry.LocallyCRingedSpace.pt`: the point `({*}, ℂ)`.

## Main results

- `AlgebraicGeometry.LocallyRingedSpace.stalkEquiv`: the stalk of `(𝒪_X / (f) 𝒪_X)|_V` at
  `x ∈ V` is `𝒪_{X,x} / (f)`.
- `AlgebraicGeometry.LocallyCRingedSpace.localModelStalkEquiv`: the stalk of `V(D; f)` at `z` is
  `𝒪_{D,z} / (f)`.
- `AlgebraicGeometry.LocallyCRingedSpace.ptStalkEquiv`: the stalk of `pt` is `ℂ`.

## Implementation notes

A holomorphic function on an open subset of `ℂ^N` is a complex-differentiable one; such a function
is automatically infinitely complex-differentiable, so `𝒪_D` is the sheaf `smoothSheafCommRing`
of `C^∞` functions for the model `𝓘(ℂ, Fin N → ℂ)` with values in `ℂ`. The family `f` is
allowed to be indexed by any type; the local models of the source are those indexed by
`Fin r`.

Rather than sheafifying the quotient presheaf `W ↦ 𝒪_D(W) / (f)` and then pulling it back to `V`,
the structure sheaf is described directly as a sheaf of locally representable families in the
fibres `𝒪_{D,z} / (f)`, in the manner of the structure sheaf of `Spec`; the two agree since a sheaf
is determined by its stalks and both have stalks `𝒪_{D,z} / (f)`.

## References

* [FK] E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, §I.11.
-/

@[expose] public noncomputable section

universe u

open CategoryTheory Opposite TopologicalSpace TopCat

namespace AlgebraicGeometry.LocallyRingedSpace

variable (X : LocallyRingedSpace.{u}) {ι : Type*} (f : ι → X.presheaf.obj (op ⊤))

/-- The ideal of the stalk `𝒪_{X,x}` generated by the germs at `x` of the sections `f i`. -/
def germIdeal (x : X) : Ideal (X.presheaf.stalk x) :=
  Ideal.span (Set.range fun i ↦ X.presheaf.germ ⊤ x trivial (f i))

variable (V : Set X)

/-- The fibre `𝒪_{X,x} / (f)` at a point `x` of `V`. -/
abbrev QuotientFiber (x : V) : Type u := X.presheaf.stalk x.1 ⧸ X.germIdeal f x.1

/-- A family of elements of the fibres `𝒪_{X,x} / (f)` over an open subset `U` of `V` is given by
a single section of `𝒪_X` if it is the family of classes of the germs of a section `g` of `𝒪_X`
over an open subset `W` of `X` containing `U`. -/
def isQuotientOfSection : @PrelocalPredicate (TopCat.of V) (X.QuotientFiber f V) where
  pred {U} s := ∃ (W : Opens X) (hW : ∀ x : U, (x.1 : X) ∈ W) (g : X.presheaf.obj (op W)),
    ∀ x : U, s x = Ideal.Quotient.mk _ (X.presheaf.germ W x.1.1 (hW x) g)
  res {U U'} i s := by
    rintro ⟨W, hW, g, hg⟩
    exact ⟨W, fun x ↦ hW ⟨x.1, i.le x.2⟩, g, fun x ↦ hg ⟨x.1, i.le x.2⟩⟩

/-- The local predicate: a family is *locally* the family of classes of germs of a section. -/
abbrev isLocallyQuotientOfSection : @LocalPredicate (TopCat.of V) (X.QuotientFiber f V) :=
  (X.isQuotientOfSection f V).sheafify

variable {X f V} in
theorem isQuotientOfSection_mk {U : Opens (TopCat.of V)} (W : Opens X)
    (hW : ∀ x : U, (x.1 : X) ∈ W) (g : X.presheaf.obj (op W)) :
    (X.isLocallyQuotientOfSection f V).pred
      (fun x : U ↦ Ideal.Quotient.mk _ (X.presheaf.germ W x.1.1 (hW x) g)) :=
  PrelocalPredicate.sheafifyOf ⟨W, hW, g, fun _ ↦ rfl⟩


/-- The sections over an open subset `U` of `V` of the restriction to `V` of `𝒪_X / (f) 𝒪_X`:
the families of elements of the fibres `𝒪_{X,x} / (f)` which are locally the classes of the germs
of a section of `𝒪_X`. -/
def sectionsSubring (U : Opens (TopCat.of V)) : Subring (∀ x : U, X.QuotientFiber f V x) where
  carrier := {s | (X.isLocallyQuotientOfSection f V).pred s}
  zero_mem' := by
    refine PrelocalPredicate.sheafifyOf ⟨⊤, fun _ ↦ trivial, 0, fun x ↦ ?_⟩
    simp
  one_mem' := by
    refine PrelocalPredicate.sheafifyOf ⟨⊤, fun _ ↦ trivial, 1, fun x ↦ ?_⟩
    simp
  add_mem' {a b} ha hb := by
    refine PrelocalPredicate.sheafify_inductionOn₂' _ _ _ (fun a b ↦ a + b) ?_ ha hb
    rintro U₁ U₂ a b ⟨W₁, h₁, g₁, e₁⟩ ⟨W₂, h₂, g₂, e₂⟩
    refine ⟨W₁ ⊓ W₂, fun x ↦ ⟨h₁ ⟨x.1, x.2.1⟩, h₂ ⟨x.1, x.2.2⟩⟩,
      X.presheaf.map (homOfLE inf_le_left).op g₁ + X.presheaf.map (homOfLE inf_le_right).op g₂,
      fun x ↦ ?_⟩
    simp only [e₁, e₂, map_add]
    exact congrArg₂ (· + ·) (congrArg _ (X.presheaf.germ_res_apply _ _ _ _).symm)
      (congrArg _ (X.presheaf.germ_res_apply _ _ _ _).symm)
  mul_mem' {a b} ha hb := by
    refine PrelocalPredicate.sheafify_inductionOn₂' _ _ _ (fun a b ↦ a * b) ?_ ha hb
    rintro U₁ U₂ a b ⟨W₁, h₁, g₁, e₁⟩ ⟨W₂, h₂, g₂, e₂⟩
    refine ⟨W₁ ⊓ W₂, fun x ↦ ⟨h₁ ⟨x.1, x.2.1⟩, h₂ ⟨x.1, x.2.2⟩⟩,
      X.presheaf.map (homOfLE inf_le_left).op g₁ * X.presheaf.map (homOfLE inf_le_right).op g₂,
      fun x ↦ ?_⟩
    simp only [e₁, e₂, map_mul]
    exact congrArg₂ (· * ·) (congrArg _ (X.presheaf.germ_res_apply _ _ _ _).symm)
      (congrArg _ (X.presheaf.germ_res_apply _ _ _ _).symm)
  neg_mem' {a} ha := by
    refine PrelocalPredicate.sheafify_inductionOn' _ (fun a ↦ -a) ?_ ha
    rintro U a ⟨W, h, g, e⟩
    exact ⟨W, h, -g, fun x ↦ by simp only [e, map_neg]⟩

/-- The restriction to `V` of the quotient `𝒪_X / (f) 𝒪_X`, as a presheaf of commutative rings
on `V`. -/
def quotientPresheaf : (TopCat.of V).Presheaf CommRingCat.{u} where
  obj U := CommRingCat.of (X.sectionsSubring f V U.unop)
  map {U U'} i := CommRingCat.ofHom
    { toFun s := ⟨fun x ↦ s.1 ⟨x.1, i.unop.le x.2⟩,
        (X.isLocallyQuotientOfSection f V).res i.unop _ s.2⟩
      map_one' := rfl
      map_mul' _ _ := rfl
      map_zero' := rfl
      map_add' _ _ := rfl }

/-- The presheaf `quotientPresheaf` followed by the forgetful functor is the presheaf of
families satisfying `isLocallyQuotientOfSection`. -/
def quotientPresheafCompForget :
    X.quotientPresheaf f V ⋙ forget CommRingCat ≅
      subpresheafToTypes (X.isLocallyQuotientOfSection f V).toPrelocalPredicate :=
  NatIso.ofComponents fun _ ↦ Iso.refl _

theorem isSheaf_quotientPresheaf : (X.quotientPresheaf f V).IsSheaf :=
  (TopCat.Presheaf.isSheaf_iff_isSheaf_comp _ _).mpr (TopCat.Presheaf.isSheaf_of_iso
    (X.quotientPresheafCompForget f V).symm (subpresheafToTypes.isSheaf _))


/-- The ideal of germs at `x` of sections `h` over a neighbourhood `W` of `x` whose germs at every
point `y` of `W` lie in the ideal generated by the germs of the `f i` at `y`. -/
def locallyGermIdeal (x : X) : Ideal (X.presheaf.stalk x) where
  carrier := {t | ∃ (W : Opens X) (hxW : x ∈ W) (h : X.presheaf.obj (op W)),
    X.presheaf.germ W x hxW h = t ∧ ∀ y (hy : y ∈ W), X.presheaf.germ W y hy h ∈ X.germIdeal f y}
  zero_mem' := ⟨⊤, trivial, 0, by simp, fun y _ ↦ by simp⟩
  add_mem' := by
    rintro _ _ ⟨W₁, hx₁, h₁, rfl, H₁⟩ ⟨W₂, hx₂, h₂, rfl, H₂⟩
    refine ⟨W₁ ⊓ W₂, ⟨hx₁, hx₂⟩,
      X.presheaf.map (homOfLE inf_le_left).op h₁ + X.presheaf.map (homOfLE inf_le_right).op h₂,
      ?_, fun y hy ↦ ?_⟩
    · rw [map_add]
      exact congrArg₂ (· + ·) (X.presheaf.germ_res_apply _ _ _ _)
        (X.presheaf.germ_res_apply _ _ _ _)
    · rw [map_add]
      exact add_mem ((X.presheaf.germ_res_apply _ _ _ _).symm ▸ H₁ y hy.1)
        ((X.presheaf.germ_res_apply _ _ _ _).symm ▸ H₂ y hy.2)
  smul_mem' := by
    rintro c _ ⟨W, hx, h, rfl, H⟩
    obtain ⟨W₀, hx₀, g₀, rfl⟩ := X.presheaf.exists_germ_eq c
    refine ⟨W₀ ⊓ W, ⟨hx₀, hx⟩,
      X.presheaf.map (homOfLE inf_le_left).op g₀ * X.presheaf.map (homOfLE inf_le_right).op h,
      ?_, fun y hy ↦ ?_⟩
    · rw [map_mul, smul_eq_mul]
      exact congrArg₂ (· * ·) (X.presheaf.germ_res_apply _ _ _ _)
        (X.presheaf.germ_res_apply _ _ _ _)
    · rw [map_mul]
      exact Ideal.mul_mem_left _ _ ((X.presheaf.germ_res_apply _ _ _ _).symm ▸ H y hy.2)

theorem germIdeal_le_locallyGermIdeal (x : X) : X.germIdeal f x ≤ X.locallyGermIdeal f x :=
  Ideal.span_le.mpr <| Set.range_subset_iff.mpr fun i ↦
    ⟨⊤, trivial, f i, rfl, fun _ _ ↦ Ideal.subset_span ⟨i, rfl⟩⟩

/-- An element of the ideal generated by the germs of the `f i` at `x` is the germ at `x` of a
section whose germs at all points of a neighbourhood of `x` lie in the corresponding ideals. -/
theorem exists_germ_eq_of_mem_germIdeal {x : X} {t : X.presheaf.stalk x}
    (ht : t ∈ X.germIdeal f x) :
    ∃ (W : Opens X) (hxW : x ∈ W) (h : X.presheaf.obj (op W)),
      X.presheaf.germ W x hxW h = t ∧
        ∀ y (hy : y ∈ W), X.presheaf.germ W y hy h ∈ X.germIdeal f y :=
  X.germIdeal_le_locallyGermIdeal f x ht

/-- The inclusion of the subspace `V` into `X`. -/
def subspaceInclusion : TopCat.of V ⟶ X.toTopCat :=
  TopCat.ofHom ⟨Subtype.val, continuous_subtype_val⟩

@[simp]
theorem subspaceInclusion_apply (x : V) : X.subspaceInclusion V x = x.1 :=
  rfl

/-- A section `g` of `𝒪_X` over `W` gives a section of the restriction of `𝒪_X / (f) 𝒪_X` over
`W ∩ V`: the family of the classes of the germs of `g`. -/
def toQuotientPresheaf (W : Opens X) :
    X.presheaf.obj (op W) ⟶
      (X.quotientPresheaf f V).obj (op ((Opens.map (X.subspaceInclusion V)).obj W)) :=
  CommRingCat.ofHom
    { toFun g := ⟨fun y ↦ Ideal.Quotient.mk _ (X.presheaf.germ W y.1.1 y.2 g),
        isQuotientOfSection_mk W (fun y ↦ y.2) g⟩
      map_one' := Subtype.ext <| funext fun y ↦ by simp
      map_mul' a b := Subtype.ext <| funext fun y ↦ by simp
      map_zero' := Subtype.ext <| funext fun y ↦ by simp
      map_add' a b := Subtype.ext <| funext fun y ↦ by simp }

theorem toQuotientPresheaf_apply_coe (W : Opens X) (g : X.presheaf.obj (op W))
    (y : (Opens.map (X.subspaceInclusion V)).obj W) :
    (X.toQuotientPresheaf f V W g).1 y = Ideal.Quotient.mk _ (X.presheaf.germ W y.1.1 y.2 g) :=
  rfl

/-- Evaluation at a point `x ∈ U` of the sections over `U`. -/
def evalSection (U : Opens (TopCat.of V)) (x : V) (hx : x ∈ U) :
    (X.quotientPresheaf f V).obj (op U) ⟶ CommRingCat.of (X.QuotientFiber f V x) :=
  CommRingCat.ofHom
    { toFun s := s.1 ⟨x, hx⟩
      map_one' := rfl
      map_mul' _ _ := rfl
      map_zero' := rfl
      map_add' _ _ := rfl }

/-- The cocone over the neighbourhoods of `x` given by evaluating sections at `x`. -/
def fiberCocone (x : V) :
    Limits.Cocone ((OpenNhds.inclusion (X := TopCat.of V) x).op ⋙ X.quotientPresheaf f V) where
  pt := CommRingCat.of (X.QuotientFiber f V x)
  ι :=
    { app U := X.evalSection f V U.unop.1 x U.unop.2
      naturality _ _ _ := rfl }

/-- Evaluation of germs: the map from the stalk at `x` to the fibre `𝒪_{X,x} / (f)`. -/
def stalkToFiber (x : V) :
    (X.quotientPresheaf f V).stalk x ⟶ CommRingCat.of (X.QuotientFiber f V x) :=
  Limits.colimit.desc _ (X.fiberCocone f V x)

theorem stalkToFiber_germ (U : Opens (TopCat.of V)) (x : V) (hx : x ∈ U)
    (s : (X.quotientPresheaf f V).obj (op U)) :
    X.stalkToFiber f V x ((X.quotientPresheaf f V).germ U x hx s) = s.1 ⟨x, hx⟩ :=
  ConcreteCategory.congr_hom (Limits.colimit.ι_desc (X.fiberCocone f V x) (op ⟨U, hx⟩)) s

theorem stalkToFiber_surjective (x : V) : Function.Surjective (X.stalkToFiber f V x) := by
  intro t
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective t
  obtain ⟨W, hxW, g, rfl⟩ := X.presheaf.exists_germ_eq r
  exact ⟨(X.quotientPresheaf f V).germ _ x hxW (X.toQuotientPresheaf f V W g),
    X.stalkToFiber_germ f V _ x hxW _⟩

theorem stalkToFiber_injective (x : V) : Function.Injective (X.stalkToFiber f V x) := by
  rw [injective_iff_map_eq_zero]
  intro t ht
  obtain ⟨U, hxU, s, rfl⟩ := (X.quotientPresheaf f V).exists_germ_eq t
  rw [stalkToFiber_germ] at ht
  obtain ⟨U', hxU', iU', W, hW, g, e⟩ := s.2 ⟨x, hxU⟩
  have hx0 := (e ⟨x, hxU'⟩).symm.trans ht
  rw [Ideal.Quotient.eq_zero_iff_mem] at hx0
  obtain ⟨W₂, hxW₂, h, hh, hgerm⟩ := X.exists_germ_eq_of_mem_germIdeal f hx0
  obtain ⟨W₃, hxW₃, i₂, i₁, heq⟩ := X.presheaf.germ_eq x.1 hxW₂ (hW ⟨x, hxU'⟩) h g hh
  let U'' : Opens (TopCat.of V) := U' ⊓ (Opens.map (X.subspaceInclusion V)).obj W₃
  have hU'' : U'' ≤ U := inf_le_left.trans iU'.le
  have hs : (X.quotientPresheaf f V).map (homOfLE hU'').op s = 0 := by
    refine Subtype.ext <| funext fun y ↦ ?_
    change s.1 _ = 0
    refine (e ⟨y.1, y.2.1⟩).trans ?_
    rw [Ideal.Quotient.eq_zero_iff_mem]
    have hy : y.1.1 ∈ W₃ := y.2.2
    have := congrArg (X.presheaf.germ W₃ y.1.1 hy) heq
    rw [X.presheaf.germ_res_apply, X.presheaf.germ_res_apply] at this
    rw [← this]
    exact hgerm _ _
  calc (X.quotientPresheaf f V).germ U x hxU s
      = (X.quotientPresheaf f V).germ U'' x ⟨hxU', hxW₃⟩
          ((X.quotientPresheaf f V).map (homOfLE hU'').op s) :=
        ((X.quotientPresheaf f V).germ_res_apply (homOfLE hU'') x ⟨hxU', hxW₃⟩ s).symm
    _ = 0 := by rw [hs, map_zero]

/-- The stalk at `x ∈ V` of the restriction to `V` of `𝒪_X / (f) 𝒪_X` is `𝒪_{X,x} / (f)`. -/
def stalkEquiv (x : V) : (X.quotientPresheaf f V).stalk x ≃+* X.QuotientFiber f V x :=
  RingEquiv.ofBijective (X.stalkToFiber f V x).hom
    ⟨X.stalkToFiber_injective f V x, X.stalkToFiber_surjective f V x⟩

theorem stalkEquiv_germ (U : Opens (TopCat.of V)) (x : V) (hx : x ∈ U)
    (s : (X.quotientPresheaf f V).obj (op U)) :
    X.stalkEquiv f V x ((X.quotientPresheaf f V).germ U x hx s) = s.1 ⟨x, hx⟩ :=
  X.stalkToFiber_germ f V U x hx s


variable {V}

/-- If every `f i` vanishes at the points of `V` (its germ lies in the maximal ideal), the ideal
generated by the germs of the `f i` at a point of `V` is a proper ideal. -/
theorem germIdeal_ne_top
    (hV : ∀ x ∈ V, ∀ i, X.presheaf.germ ⊤ x trivial (f i) ∈
      IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (x : V) :
    X.germIdeal f x.1 ≠ ⊤ :=
  ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal _).ne_top
    (Ideal.span_le.mpr (Set.range_subset_iff.mpr (hV x.1 x.2)))

/-- The locally ringed space `(V, (𝒪_X / (f) 𝒪_X)|_V)`: the subspace `V` of `X`, with the
restriction to `V` of the quotient of `𝒪_X` by the ideal sheaf generated by the global sections
`f i`, all of which vanish on `V`. -/
def quotientSubspace
    (hV : ∀ x ∈ V, ∀ i, X.presheaf.germ ⊤ x trivial (f i) ∈
      IsLocalRing.maximalIdeal (X.presheaf.stalk x)) : LocallyRingedSpace.{u} where
  carrier := TopCat.of V
  presheaf := X.quotientPresheaf f V
  IsSheaf := X.isSheaf_quotientPresheaf f V
  isLocalRing x := by
    have : Nontrivial (X.QuotientFiber f V x) :=
      Ideal.Quotient.nontrivial_iff.mpr (X.germIdeal_ne_top f hV x)
    have : IsLocalRing (X.QuotientFiber f V x) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    have : Nontrivial ((X.quotientPresheaf f V).stalk x) :=
      (X.stalkEquiv f V x).surjective.nontrivial
    exact IsLocalRing.of_surjective' (X.stalkEquiv f V x).symm.toRingHom
      (X.stalkEquiv f V x).symm.surjective

variable (hV : ∀ x ∈ V, ∀ i, X.presheaf.germ ⊤ x trivial (f i) ∈
  IsLocalRing.maximalIdeal (X.presheaf.stalk x))

@[simp]
theorem quotientSubspace_carrier : (X.quotientSubspace f hV).carrier = TopCat.of V :=
  rfl

@[simp]
theorem quotientSubspace_presheaf : (X.quotientSubspace f hV).presheaf = X.quotientPresheaf f V :=
  rfl

/-- The underlying morphism of presheafed spaces of `quotientSubspaceι`. -/
def quotientSubspaceHom :
    (X.quotientSubspace f hV).toPresheafedSpace ⟶ X.toPresheafedSpace where
  base := X.subspaceInclusion V
  c :=
    { app W := X.toQuotientPresheaf f V W.unop
      naturality W W' i := by
        ext g
        refine Subtype.ext (funext fun y ↦ ?_)
        exact congrArg (Ideal.Quotient.mk _) (X.presheaf.germ_res_apply' i y.1.1 y.2 g) }

theorem stalkEquiv_stalkMap (x : V) (t : X.presheaf.stalk x.1) :
    X.stalkEquiv f V x ((X.quotientSubspaceHom f hV).stalkMap x t) = Ideal.Quotient.mk _ t := by
  obtain ⟨W, hxW, g, rfl⟩ := X.presheaf.exists_germ_eq t
  have := PresheafedSpace.stalkMap_germ_apply (X.quotientSubspaceHom f hV) W x hxW g
  erw [this]
  exact X.stalkEquiv_germ f V _ x hxW _

/-- The inclusion `(V, (𝒪_X / (f) 𝒪_X)|_V) ⟶ (X, 𝒪_X)`, a morphism of locally ringed spaces whose
maps on stalks are the quotient maps `𝒪_{X,x} ⟶ 𝒪_{X,x} / (f)`. -/
def quotientSubspaceι : X.quotientSubspace f hV ⟶ X where
  toHom := X.quotientSubspaceHom f hV
  prop x := by
    have hsurj : Function.Surjective ((X.quotientSubspaceHom f hV).stalkMap x).hom := by
      intro s
      obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective (X.stalkEquiv f V x s)
      exact ⟨t, (X.stalkEquiv f V x).injective ((X.stalkEquiv_stalkMap f hV x t).trans ht)⟩
    exact IsLocalHom.of_surjective _ hsurj

@[simp]
theorem quotientSubspaceι_base_apply (x : V) : (X.quotientSubspaceι f hV).base x = x.1 :=
  rfl

end AlgebraicGeometry.LocallyRingedSpace

namespace AlgebraicGeometry.LocallyCRingedSpace

open scoped Manifold ContDiff

variable {N : ℕ}

/-- An open subset `D ⊆ ℂ^N` with its sheaf `𝒪_D` of holomorphic functions, as a locally ringed
space. -/
abbrev holomorphicLRS (D : Opens (Fin N → ℂ)) : LocallyRingedSpace.{0} :=
  ChartedSpace.locallyRingedSpace 𝓘(ℂ, Fin N → ℂ) D

/-- The sheaf `𝒪_D` of holomorphic functions on an open subset `D ⊆ ℂ^N`. -/
abbrev holomorphicSheaf (D : Opens (Fin N → ℂ)) : TopCat.Sheaf CommRingCat.{0} (TopCat.of D) :=
  smoothSheafCommRing 𝓘(ℂ, Fin N → ℂ) 𝓘(ℂ) D ℂ

/-- The constant functions `ℂ ⟶ Γ(D, 𝒪_D)`. -/
def constants (D : Opens (Fin N → ℂ)) :
    CommRingCat.of ℂ ⟶ (holomorphicLRS D).presheaf.obj (op ⊤) :=
  CommRingCat.ofHom ContMDiffMap.C

/-- An open subset `D ⊆ ℂ^N` with its sheaf of holomorphic functions, as a locally `ℂ`-ringed
space; the `ℂ`-structure is given by the constant functions. -/
def complexDomain (D : Opens (Fin N → ℂ)) : LocallyCRingedSpace :=
  Over.mk ((holomorphicLRS D).toΓSpec ≫ Spec.toLocallyRingedSpace.map (constants D).op)

/-- The common zero set `{z ∈ D | f₁(z) = ⋯ = f_r(z) = 0}` of a family of holomorphic functions
on `D`. -/
def zeroSet (D : Opens (Fin N → ℂ)) {ι : Type*} (f : ι → (holomorphicSheaf D).presheaf.obj (op ⊤)) :
    Set D :=
  {z | ∀ i, f i ⟨z, trivial⟩ = 0}

variable {D : Opens (Fin N → ℂ)} {ι : Type*} (f : ι → (holomorphicSheaf D).presheaf.obj (op ⊤))

/-- At a point of the zero set the germs of the `f i` lie in the maximal ideal of `𝒪_{D,z}`. -/
theorem germ_mem_maximalIdeal_of_mem_zeroSet :
    ∀ z ∈ zeroSet D f, ∀ i, (holomorphicLRS D).presheaf.germ ⊤ z trivial (f i) ∈
      IsLocalRing.maximalIdeal ((holomorphicLRS D).presheaf.stalk z) := by
  intro z hz i
  rw [IsLocalRing.mem_maximalIdeal]
  change _ ∈ nonunits ((holomorphicSheaf D).presheaf.stalk z)
  rw [smoothSheafCommRing.nonunits_stalk]
  exact (smoothSheafCommRing.eval_germ ⊤ z trivial (f i)).trans (hz i)

/-- The *local model* `V(D; f₁, …, f_r)`: the locally `ℂ`-ringed space whose underlying space is
the common zero set `V` of the holomorphic functions `f i` on the open subset `D ⊆ ℂ^N`, with the
topology induced from `D`, and whose structure sheaf is the restriction to `V` of
`𝒪_D / (f₁, …, f_r) 𝒪_D`. -/
@[weil "def_fk111_complex_model_space"]
def localModel (D : Opens (Fin N → ℂ)) {ι : Type*}
    (f : ι → (holomorphicSheaf D).presheaf.obj (op ⊤)) : LocallyCRingedSpace :=
  Over.mk ((holomorphicLRS D).quotientSubspaceι f (germ_mem_maximalIdeal_of_mem_zeroSet f) ≫
    (complexDomain D).hom)

theorem localModel_left :
    (localModel D f).left =
      (holomorphicLRS D).quotientSubspace f (germ_mem_maximalIdeal_of_mem_zeroSet f) :=
  rfl

/-- The underlying space of `V(D; f)` is the zero set of the `f i`, with the subspace topology. -/
@[weil "def_fk111_complex_model_space"]
theorem localModel_carrier : (localModel D f).left.carrier = TopCat.of (zeroSet D f) :=
  rfl

/-- The stalk of the structure sheaf of `V(D; f₁, …, f_r)` at `z` is `𝒪_{D,z} / (f₁, …, f_r)`. -/
@[weil "def_fk111_complex_model_space"]
def localModelStalkEquiv (z : zeroSet D f) :
    (localModel D f).left.presheaf.stalk z ≃+*
      (holomorphicLRS D).presheaf.stalk z.1 ⧸ (holomorphicLRS D).germIdeal f z.1 :=
  (holomorphicLRS D).stalkEquiv f (zeroSet D f) z

/-- The ideal `(f₁, …, f_r)` of `𝒪_{D,z}` lies in the maximal ideal for `z ∈ V`. -/
theorem germIdeal_le_maximalIdeal (z : zeroSet D f) :
    (holomorphicLRS D).germIdeal f z.1 ≤
      IsLocalRing.maximalIdeal ((holomorphicLRS D).presheaf.stalk z.1) :=
  Ideal.span_le.mpr (Set.range_subset_iff.mpr (germ_mem_maximalIdeal_of_mem_zeroSet f z.1 z.2))

/-- The inclusion `V(D; f) ⟶ D` of the local model into the domain, a morphism of locally
`ℂ`-ringed spaces. -/
def localModelι : localModel D f ⟶ complexDomain D :=
  Over.homMk ((holomorphicLRS D).quotientSubspaceι f (germ_mem_maximalIdeal_of_mem_zeroSet f))


/-- For a point `z` of a zero-dimensional domain `D ⊆ ℂ⁰`, evaluation at `z` identifies the stalk
`𝒪_{D,z}` with `ℂ`. -/
def stalkEquivOfDimZero (D : Opens (Fin 0 → ℂ)) (z : D) :
    (holomorphicSheaf D).presheaf.stalk z ≃+* ℂ :=
  RingEquiv.ofBijective (smoothSheafCommRing.eval 𝓘(ℂ, Fin 0 → ℂ) 𝓘(ℂ) D ℂ z) <| by
    refine ⟨?_, smoothSheafCommRing.eval_surjective _ _ _ _ z⟩
    rw [injective_iff_map_eq_zero]
    intro t ht
    obtain ⟨W, hzW, g, rfl⟩ := (holomorphicSheaf D).presheaf.exists_germ_eq t
    rw [smoothSheafCommRing.eval_germ] at ht
    have hg : g = 0 := by
      refine ContMDiffMap.ext fun y ↦ ?_
      have hy : y = ⟨z, hzW⟩ := Subtype.ext (Subtype.ext (Subsingleton.elim _ _))
      rw [hy]
      exact ht
    rw [hg, map_zero]

/-- The *point* `pt = ({*}, ℂ)`: the local model `V(ℂ⁰; )` for `N = 0`, `D = ℂ⁰` and `r = 0`. -/
@[weil "def_fk111_complex_model_space"]
def pt : LocallyCRingedSpace :=
  localModel (N := 0) ⊤ (Fin.elim0 : Fin 0 → (holomorphicSheaf (N := 0) ⊤).presheaf.obj (op ⊤))

/-- The underlying space of `pt` is a point. -/
instance : Unique pt.left where
  default := ⟨⟨0, trivial⟩, fun i ↦ i.elim0⟩
  uniq _ := Subtype.ext (Subtype.ext (Subsingleton.elim _ _))

/-- The stalk of the structure sheaf of `pt` is `ℂ`. -/
@[weil "def_fk111_complex_model_space"]
def ptStalkEquiv (z : pt.left) : pt.left.presheaf.stalk z ≃+* ℂ :=
  (localModelStalkEquiv _ z).trans <|
    (Ideal.quotEquivOfEq (by simp [LocallyRingedSpace.germIdeal])).trans <|
      (RingEquiv.quotientBot _).trans (stalkEquivOfDimZero ⊤ z.1)

end AlgebraicGeometry.LocallyCRingedSpace
