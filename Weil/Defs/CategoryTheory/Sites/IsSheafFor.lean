module

public import Weil.Attr
public import Weil.Defs.AlgebraicGeometry.Sites.EtaleCoveringFk101
public import Mathlib.CategoryTheory.Sites.IsSheafFor
public import Mathlib.CategoryTheory.Sites.ConcreteSheafification
public import Mathlib.Algebra.Category.Grp.Basic

/-!
# Sections of a presheaf over a covering

Let `A` be a commutative ring, `F` a presheaf on the étale category `Et(A)` (a covariant functor
`Et(A) ⥤ C`), and `𝔅 = (gᵢ : B → Bᵢ)ᵢ` a family of morphisms of `Et(A)` with common source `B`.
The *sections of `F` over `𝔅`*, written `F(𝔅)`, are the families `(sᵢ)ᵢ` with `sᵢ ∈ F(Bᵢ)` such
that `F(u)(sᵢ) = F(v)(sⱼ)` for all indices `i, j` (including `i = j`), every object `D` of `Et(A)`
and all morphisms `u : Bᵢ → D`, `v : Bⱼ → D` with `u ∘ gᵢ = v ∘ gⱼ`. For a presheaf of abelian
groups this is a subgroup of `∏ᵢ F(Bᵢ)`.

Since `Et(A)` is the opposite of `Scheme.AffineEtale (Spec A)`, a presheaf on `Et(A)` is a
presheaf on `Scheme.AffineEtale (Spec A)` in the sense of Mathlib, and `F(𝔅)` is the set of
compatible families `Presieve.Arrows.Compatible` for the opposite family `(gᵢ.unop)ᵢ`.

## Main definitions

- `AlgebraicGeometry.EtaleCategory.coveringSections F g`: the set `F(𝔅)` of compatible families
  of a presheaf of sets `F` over a family `g`.
- `AlgebraicGeometry.EtaleCategory.coveringSectionsAddSubgroup F g`: the subgroup `F(𝔅)` of
  `∏ᵢ F(Bᵢ)` for a presheaf of abelian groups `F`.
- `AlgebraicGeometry.EtaleCategory.coveringSectionsEquivCompatible`: `F(𝔅)` as the compatible
  families of elements of `F` for the presieve generated by `g`.
- `AlgebraicGeometry.EtaleCategory.IsCovering.cover`: the covering sieve of the affine étale
  topology generated by a covering.
- `AlgebraicGeometry.EtaleCategory.coveringSectionsEquivMeq`: for a covering `g`, the
  identification of `F(𝔅)` with the matching families `Meq F S` on the covering sieve `S` of the
  affine étale topology generated by `g`.

## Main results

- `AlgebraicGeometry.EtaleCategory.mem_coveringSections_iff`: the defining condition of `F(𝔅)`,
  stated in `Et(A)`.
- `AlgebraicGeometry.EtaleCategory.coe_coveringSectionsAddSubgroup`: the underlying set of the
  subgroup is the set of compatible families of the underlying presheaf of sets.

## Implementation notes

The definition makes sense for any family of morphisms with common source, not only for
coverings, and is stated in that generality; the coverings of `IsCovering` enter only in the
comparison `coveringSectionsEquivMeq` with Mathlib's matching families.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FreitagKiehl1988], I.1
-/

@[expose] public noncomputable section

universe u v w

open CategoryTheory Opposite

namespace AlgebraicGeometry

namespace EtaleCategory

variable {A : CommRingCat.{u}} {B : EtaleCategory A} {ι : Type w} {C : ι → EtaleCategory A}

/-- The sections `F(𝔅)` of a presheaf of sets `F` on `Et(A)` over a family
`𝔅 = (gᵢ : B ⟶ Cᵢ)ᵢ`: the families `(sᵢ)ᵢ ∈ ∏ᵢ F(Cᵢ)` that are compatible, i.e. Mathlib's
`Presieve.Arrows.Compatible` for the opposite family of morphisms of
`Scheme.AffineEtale (Spec A)`. See `mem_coveringSections_iff` for the condition in `Et(A)`. -/
@[weil "def_fk101_covering_sections"]
def coveringSections (F : EtaleCategory A ⥤ Type v) (g : ∀ i, B ⟶ C i) :
    Set (∀ i, F.obj (C i)) :=
  {s | Presieve.Arrows.Compatible F (fun i ↦ (g i).unop) s}

variable (F : EtaleCategory A ⥤ Type v) (g : ∀ i, B ⟶ C i)

lemma mem_coveringSections_iff_compatible (s : ∀ i, F.obj (C i)) :
    s ∈ coveringSections F g ↔ Presieve.Arrows.Compatible F (fun i ↦ (g i).unop) s :=
  Iff.rfl

/-- A family `(sᵢ)ᵢ` lies in `F(𝔅)` if and only if `F(u)(sᵢ) = F(v)(sⱼ)` for all `i, j`, every
object `D` and all morphisms `u : Cᵢ ⟶ D`, `v : Cⱼ ⟶ D` with `gᵢ ≫ u = gⱼ ≫ v`. -/
lemma mem_coveringSections_iff (s : ∀ i, F.obj (C i)) :
    s ∈ coveringSections F g ↔ ∀ (i j : ι) (D : EtaleCategory A) (u : C i ⟶ D) (v : C j ⟶ D),
      g i ≫ u = g j ≫ v → F.map u (s i) = F.map v (s j) := by
  refine ⟨fun h i j D u v huv ↦ h i j D.unop u.unop v.unop ?_, fun h i j Z u v huv ↦
    h i j (op Z) u.op v.op ?_⟩
  · simpa using congrArg Quiver.Hom.unop huv
  · simpa using congrArg Quiver.Hom.op huv

lemma map_eq_map_of_mem_coveringSections {s : ∀ i, F.obj (C i)} (hs : s ∈ coveringSections F g)
    {i j : ι} {D : EtaleCategory A} (u : C i ⟶ D) (v : C j ⟶ D) (huv : g i ≫ u = g j ≫ v) :
    F.map u (s i) = F.map v (s j) :=
  (mem_coveringSections_iff F g s).1 hs i j D u v huv

/-- The sections `F(𝔅)` of a presheaf of abelian groups `F` on `Et(A)` over a family
`𝔅 = (gᵢ : B ⟶ Cᵢ)ᵢ`: the subgroup of `∏ᵢ F(Cᵢ)` of compatible families. -/
@[weil "def_fk101_covering_sections"]
def coveringSectionsAddSubgroup (F : EtaleCategory A ⥤ AddCommGrpCat.{v}) (g : ∀ i, B ⟶ C i) :
    AddSubgroup (∀ i, F.obj (C i)) where
  carrier := coveringSections (F ⋙ forget AddCommGrpCat) g
  add_mem' {s t} hs ht := by
    rw [mem_coveringSections_iff] at hs ht ⊢
    intro i j D u v huv
    have h₁ : F.map u (s i) = F.map v (s j) := hs i j D u v huv
    have h₂ : F.map u (t i) = F.map v (t j) := ht i j D u v huv
    change F.map u (s i + t i) = F.map v (s j + t j)
    rw [map_add, map_add, h₁, h₂]
  zero_mem' := by
    rw [mem_coveringSections_iff]
    intro i j D u v huv
    change F.map u 0 = F.map v 0
    rw [map_zero, map_zero]
  neg_mem' {s} hs := by
    rw [mem_coveringSections_iff] at hs ⊢
    intro i j D u v huv
    have h₁ : F.map u (s i) = F.map v (s j) := hs i j D u v huv
    change F.map u (-s i) = F.map v (-s j)
    rw [map_neg, map_neg, h₁]

lemma coe_coveringSectionsAddSubgroup (F : EtaleCategory A ⥤ AddCommGrpCat.{v})
    (g : ∀ i, B ⟶ C i) :
    (coveringSectionsAddSubgroup F g : Set (∀ i, F.obj (C i))) =
      coveringSections (F ⋙ forget AddCommGrpCat) g :=
  rfl

/-- A family `(sᵢ)ᵢ` lies in the subgroup `F(𝔅)` of a presheaf of abelian groups if and only if
`F(u)(sᵢ) = F(v)(sⱼ)` for all `i, j`, every object `D` and all morphisms `u : Cᵢ ⟶ D`,
`v : Cⱼ ⟶ D` with `gᵢ ≫ u = gⱼ ≫ v`. -/
lemma mem_coveringSectionsAddSubgroup_iff (F : EtaleCategory A ⥤ AddCommGrpCat.{v})
    (g : ∀ i, B ⟶ C i) (s : ∀ i, F.obj (C i)) :
    s ∈ coveringSectionsAddSubgroup F g ↔
      ∀ (i j : ι) (D : EtaleCategory A) (u : C i ⟶ D) (v : C j ⟶ D),
        g i ≫ u = g j ≫ v → F.map u (s i) = F.map v (s j) :=
  mem_coveringSections_iff (F ⋙ forget AddCommGrpCat) g s

/-- The sections of `F` over a family `g` are the compatible families of elements, in Mathlib's
sense, for the presieve of `Scheme.AffineEtale (Spec A)` given by the opposite family. -/
def coveringSectionsEquivCompatible :
    coveringSections F g ≃ {x : Presieve.FamilyOfElements F
      (Presieve.ofArrows (fun i ↦ (C i).unop) (fun i ↦ (g i).unop)) // x.Compatible} where
  toFun s := ⟨s.2.familyOfElements, s.2.familyOfElements_compatible⟩
  invFun x := ⟨fun i ↦ x.1 _ (Presieve.ofArrows.mk i),
    fun _ _ _ _ _ h ↦ x.2 _ _ _ _ h⟩
  left_inv s := Subtype.ext <| funext fun i ↦ s.2.familyOfElements_ofArrows_mk i
  right_inv x := by
    refine Subtype.ext ?_
    funext Y f hf
    obtain ⟨i⟩ := hf
    exact Presieve.Arrows.Compatible.familyOfElements_ofArrows_mk
      (fun _ _ _ _ _ h ↦ x.2 _ _ _ _ h) i

/-- For a covering `g` of `B`, the sieve of `Scheme.AffineEtale (Spec A)` generated by the
opposite family, as a covering sieve of the affine étale topology. -/
def IsCovering.cover {g : ∀ i, B ⟶ C i} (hg : IsCovering g) :
    (Scheme.AffineEtale.topology (Spec A)).Cover B.unop :=
  ⟨Sieve.ofArrows (fun i ↦ (C i).unop) (fun i ↦ (g i).unop), hg.mem_topology⟩

@[simp]
lemma IsCovering.coe_cover {g : ∀ i, B ⟶ C i} (hg : IsCovering g) :
    (hg.cover : Sieve B.unop) = Sieve.ofArrows (fun i ↦ (C i).unop) (fun i ↦ (g i).unop) :=
  rfl

/-- For a covering `g`, the sections `F(𝔅)` are the matching families `Meq F S` of `F` on the
covering sieve `S` generated by `g`. -/
def coveringSectionsEquivMeq {g : ∀ i, B ⟶ C i} (hg : IsCovering g) :
    coveringSections F g ≃ Meq F hg.cover :=
  (coveringSectionsEquivCompatible F g).trans <|
    (Presieve.compatibleEquivGenerateSieveCompatible).trans
    { toFun x := ⟨fun I ↦ x.1 I.f I.hf, fun I ↦ x.2 I.r.g₁ I.r.g₂ I.fst.hf I.snd.hf I.r.w⟩
      invFun m := ⟨fun Y f hf ↦ m ⟨Y, f, hf⟩, fun _ _ Z g₁ g₂ _ _ h₁ h₂ w ↦
        m.condition (GrothendieckTopology.Cover.Relation.mk'
          (fst := ⟨_, _, h₁⟩) (snd := ⟨_, _, h₂⟩) ⟨Z, g₁, g₂, w⟩)⟩
      left_inv _ := rfl
      right_inv _ := rfl }

@[simp]
lemma coveringSectionsEquivMeq_apply {g : ∀ i, B ⟶ C i} (hg : IsCovering g)
    (s : coveringSections F g) (i : ι) :
    coveringSectionsEquivMeq F hg s ⟨_, (g i).unop, Sieve.ofArrows_mk _ _ i⟩ = s.1 i := by
  change (Presieve.FamilyOfElements.sieveExtend _) _ _ = _
  rw [Presieve.extend_agrees (coveringSectionsEquivCompatible F g s).2 (Presieve.ofArrows.mk i)]
  exact s.2.familyOfElements_ofArrows_mk i

end EtaleCategory

end AlgebraicGeometry
