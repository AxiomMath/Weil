module

public import Weil.Attr
public import Mathlib.Algebra.DirectSum.Basic
public import Weil.Defs.CategoryTheory.Sites.Cohomology.Cech.CechCohomologyCovering
public import Weil.Defs.CategoryTheory.Sites.Cohomology.Cech.ComplexMapOfARefinement
public import StacksFrontier.CategoryTheory.Sites.Cohomology.Cech.ComplexMapFunctoriality
public import Weil.CategoryTheory.Sites.Cohomology.Cech.ComplexMapFunctoriality

/-!
# Čech cohomology of an object of the étale category

Let `Et(S)` be the étale category of noetherian separated étale `S`-schemes, `U` an object of
`Et(S)` and `F` a presheaf of abelian groups on `Et(S)`. Let `Cov(U)` be the set of étale
coverings `𝔘 = (U_ν → U)_{ν ∈ {1, …, n}}`, `n ≥ 1`, of `U` by objects of `Et(S)`: finite
families whose images cover `U`. A refinement map `φ : 𝔚 → 𝔘` induces
`φ^* : Č^i(𝔘, F) → Č^i(𝔚, F)`, which maps cocycles to cocycles. Two cocycles
`z ∈ Z^i(𝔘, F)` and `z' ∈ Z^i(𝔘', F)` are *equivalent* if there are a covering `𝔚` and
refinement maps `φ : 𝔚 → 𝔘`, `φ' : 𝔚 → 𝔘'` with `φ^* z - φ'^* z' ∈ im d^{i-1}`. The *Čech
cohomology group* is
`Ȟ^i(U, F) = (⨁_{𝔘 ∈ Cov(U)} Z^i(𝔘, F)) / N`,
`N` the subgroup generated by the differences `e_𝔘 z - e_𝔘' z'` of equivalent cocycles, and
`[z]_𝔘` is the class of `e_𝔘 z`.

## Main definitions

* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.CechCovering`: the coverings `Cov(U)`.
* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.cechCyclesMap`: the map
  `φ^* : Z^i(𝔘, F) → Z^i(𝔚, F)` induced by a refinement `φ : 𝔚 → 𝔘`.
* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.CechCycleRel`: the equivalence
  `(𝔘, z) ∼ (𝔘', z')` of cocycles.
* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.cechCohomologyRelations`: the subgroup `N`.
* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.cechCohomologyOfObject`: `Ȟ^i(U, F)`.
* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.cechClass`: the class map
  `z ↦ [z]_𝔘`, `Z^i(𝔘, F) → Ȟ^i(U, F)`.
* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.cechCohomologyOfObjectDesc`: the
  homomorphism out of `Ȟ^i(U, F)` defined by a family of homomorphisms on the cocycles that
  agree on equivalent cocycles.
* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.ofCechCohomology`: the map
  `Ȟ^i(𝔘, F) → Ȟ^i(U, F)` of a single covering.

## Main results

* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.cechClass_eq_cechClass`: equivalent cocycles
  have the same class.
* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.cechClass_cechCyclesMap`:
  `[φ^* z]_𝔚 = [z]_𝔘` for a refinement `φ : 𝔚 → 𝔘`.
* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.cechClass_eq_zero_of_mem_range`: the class of
  a coboundary is zero.
* `AlgebraicGeometry.SmallNoetherianSeparatedEtale.cechCohomologyOfObject_induction_on`: every
  element of `Ȟ^i(U, F)` is a finite sum of classes `[z]_𝔘`, in the form of an induction
  principle; `cechCohomologyOfObject_hom_ext`: homomorphisms out of `Ȟ^i(U, F)` agreeing on all
  classes are equal.

## Implementation notes

The source takes the members of the coverings from a fixed set of representatives of the
isomorphism classes of objects of `Et(S)`, so that `Cov(U)` is a set. Here the members are
arbitrary objects of `Et(S)`, whose objects already form a type (of the universe above that of
the schemes); this does not change the group, since a covering is related, by a refinement map
which is an isomorphism, to the covering by the representatives of its members, and the classes
of corresponding cocycles are identified by `N`. Accordingly `Ȟ^i(U, F)` lies in the universe
`max (u + 1) a` when `S` is a `u`-scheme and `F` takes values in `AddCommGrpCat.{a}`.

A covering is indexed by `Fin n` with `0 < n`, as in the source; the covering condition is that
the images of the members cover the underlying scheme of `U`. Refinement maps are Mathlib's
morphisms of `CategoryTheory.PreZeroHypercover`, and `φ^*` is
`AlgebraicGeometry.SmallNoetherianSeparatedEtale.refinementCochainMap`. With natural-number
subtraction, `d (i - 1) i` is the incoming differential in every degree, and `d 0 0 = 0` encodes
`d^{-1} = 0`.

The definition is the source's presentation by generators and relations. The source remarks
that, once refinement maps are known to be compatible with `d` and homotopic, `Ȟ^i(U, F)` is the
colimit over the coverings of the groups `Ȟ^i(𝔘, F)`; that identification is not part of the
definition and is not made here. It is the colimit described by Stacks, Tag 03P0, over the
coverings `Cov(U)`.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, I.2][FreitagKiehl]
* [Stacks Project, Tag 03P0](https://stacks.math.columbia.edu/tag/03P0)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe a u

namespace AlgebraicGeometry

namespace SmallNoetherianSeparatedEtale

variable {B : BigEtaleSite.{u}} {S : Scheme.{u}} {hS : B.Contains S}

/-- **The étale coverings `Cov(U)`.** A finite family `(U_ν ⟶ U)_{ν ∈ Fin n}`, `n ≥ 1`, of
morphisms of `Et(S)` with target `U` whose images cover the underlying scheme of `U`. -/
@[weil "def_fk102_cech_cohomology"]
structure CechCovering (U : SmallNoetherianSeparatedEtale B S hS) where
  /-- The number of members. -/
  n : ℕ
  /-- A covering has at least one member. -/
  pos : 0 < n
  /-- The members `U_ν`. -/
  X : Fin n → SmallNoetherianSeparatedEtale B S hS
  /-- The morphisms `U_ν ⟶ U`. -/
  f : ∀ ν, X ν ⟶ U
  /-- The images of the members cover `U`. -/
  iUnion_range : ⋃ ν, Set.range ((toScheme B S hS).map (f ν)) = Set.univ

namespace CechCovering

variable {U : SmallNoetherianSeparatedEtale B S hS}

/-- A covering, as a family of morphisms with target `U`. -/
def toPreZeroHypercover (𝔘 : CechCovering U) : PreZeroHypercover.{0} U where
  I₀ := Fin 𝔘.n
  X := 𝔘.X
  f := 𝔘.f

@[simp]
lemma toPreZeroHypercover_I₀ (𝔘 : CechCovering U) : 𝔘.toPreZeroHypercover.I₀ = Fin 𝔘.n :=
  rfl

@[simp]
lemma toPreZeroHypercover_X (𝔘 : CechCovering U) (ν : Fin 𝔘.n) :
    𝔘.toPreZeroHypercover.X ν = 𝔘.X ν :=
  rfl

@[simp]
lemma toPreZeroHypercover_f (𝔘 : CechCovering U) (ν : Fin 𝔘.n) :
    𝔘.toPreZeroHypercover.f ν = 𝔘.f ν :=
  rfl

end CechCovering

section Cycles

variable {U : SmallNoetherianSeparatedEtale B S hS}
  {E G : PreZeroHypercover.{0} U} (F : EtalePresheaf B S hS AddCommGrpCat.{a}) (i : ℕ)

/-- **Refinement on cocycles.** A refinement `φ : 𝔘 ⟶ 𝔙` maps the cocycles `Z^i(𝔙, F)` to the
cocycles `Z^i(𝔘, F)`, by `z ↦ φ^* z`. -/
noncomputable def cechCyclesMap (φ : E.Hom G) : cechCycles G F i →+ cechCycles E F i where
  toFun z := ⟨(refinementCochainMap φ F).f i z, by
    rw [mem_cechCycles_iff]
    have h := ConcreteCategory.congr_hom ((refinementCochainMap φ F).comm i (i + 1)) z.1
    simp only [ConcreteCategory.comp_apply] at h
    rw [h, (mem_cechCycles_iff G F z.1).mp z.2, map_zero]⟩
  map_zero' := Subtype.ext (map_zero _)
  map_add' z z' := Subtype.ext (map_add _ _ _)

@[simp]
lemma coe_cechCyclesMap (φ : E.Hom G) (z : cechCycles G F i) :
    (cechCyclesMap F i φ z : (cechComplex E F).X i) = (refinementCochainMap φ F).f i z :=
  rfl

lemma cechCyclesMap_id (z : cechCycles E F i) : cechCyclesMap F i (𝟙 E) z = z := by
  ext
  rw [coe_cechCyclesMap, show refinementCochainMap (𝟙 E) F = 𝟙 _ from refinementCochainMap_id F]
  rfl

end Cycles

variable {U : SmallNoetherianSeparatedEtale B S hS} (F : EtalePresheaf B S hS AddCommGrpCat.{a})
  (i : ℕ)

/-- **Equivalence of cocycles.** `z ∈ Z^i(𝔘, F)` and `z' ∈ Z^i(𝔘', F)` are equivalent,
`(𝔘, z) ∼ (𝔘', z')`, if there are a covering `𝔚` and refinement maps `φ : 𝔚 ⟶ 𝔘`,
`φ' : 𝔚 ⟶ 𝔘'` with `φ^* z - φ'^* z' ∈ im d^{i-1} ⊆ Č^i(𝔚, F)`. -/
@[weil "def_fk102_cech_cohomology"]
def CechCycleRel {𝔘 𝔘' : CechCovering U} (z : cechCycles 𝔘.toPreZeroHypercover F i)
    (z' : cechCycles 𝔘'.toPreZeroHypercover F i) : Prop :=
  ∃ (𝔚 : CechCovering U) (φ : 𝔚.toPreZeroHypercover ⟶ 𝔘.toPreZeroHypercover)
    (φ' : 𝔚.toPreZeroHypercover ⟶ 𝔘'.toPreZeroHypercover),
    (refinementCochainMap φ F).f i z - (refinementCochainMap φ' F).f i z' ∈
      ((cechComplex 𝔚.toPreZeroHypercover F).d (i - 1) i).hom.range

open Classical in
/-- **The relation subgroup `N`.** The subgroup of `⨁_{𝔘 ∈ Cov(U)} Z^i(𝔘, F)` generated by the
differences `e_𝔘 z - e_𝔘' z'` of equivalent cocycles. -/
@[weil "def_fk102_cech_cohomology"]
noncomputable def cechCohomologyRelations :
    AddSubgroup (DirectSum (CechCovering U) fun 𝔘 ↦ cechCycles 𝔘.toPreZeroHypercover F i) :=
  AddSubgroup.closure {x | ∃ (𝔘 𝔘' : CechCovering U) (z : cechCycles 𝔘.toPreZeroHypercover F i)
    (z' : cechCycles 𝔘'.toPreZeroHypercover F i), CechCycleRel F i z z' ∧
      x = DirectSum.of (fun 𝔘 : CechCovering U ↦ cechCycles 𝔘.toPreZeroHypercover F i) 𝔘 z -
        DirectSum.of (fun 𝔘 : CechCovering U ↦ cechCycles 𝔘.toPreZeroHypercover F i) 𝔘' z'}

variable (U) in
/-- **The Čech cohomology group `Ȟ^i(U, F)`** of an object `U` of `Et(S)` with coefficients in a
presheaf of abelian groups `F`: the quotient of `⨁_{𝔘 ∈ Cov(U)} Z^i(𝔘, F)` by the subgroup `N`
generated by the differences of equivalent cocycles. -/
@[weil "def_fk102_cech_cohomology"]
noncomputable def cechCohomologyOfObject : AddCommGrpCat.{max (u + 1) a} :=
  AddCommGrpCat.of
    ((DirectSum (CechCovering U) fun 𝔘 ↦ cechCycles 𝔘.toPreZeroHypercover F i) ⧸
      cechCohomologyRelations F i)

/-- The quotient map `⨁_{𝔘 ∈ Cov(U)} Z^i(𝔘, F) → Ȟ^i(U, F)`. -/
noncomputable def cechCohomologyOfObjectMk :
    (DirectSum (CechCovering U) fun 𝔘 ↦ cechCycles 𝔘.toPreZeroHypercover F i) →+
      cechCohomologyOfObject U F i :=
  (AddCommGrpCat.ofHom (QuotientAddGroup.mk' (cechCohomologyRelations F i))).hom

lemma cechCohomologyOfObjectMk_surjective :
    Function.Surjective (cechCohomologyOfObjectMk (U := U) F i) :=
  fun x ↦ QuotientAddGroup.mk_surjective (s := cechCohomologyRelations F i) x

lemma cechCohomologyOfObjectMk_eq_zero_of_mem
    {x : DirectSum (CechCovering U) fun 𝔘 ↦ cechCycles 𝔘.toPreZeroHypercover F i}
    (hx : x ∈ cechCohomologyRelations F i) : cechCohomologyOfObjectMk F i x = 0 :=
  (QuotientAddGroup.eq_zero_iff (N := cechCohomologyRelations F i) x).mpr hx

open Classical in
/-- **The class `[z]_𝔘`.** The class in `Ȟ^i(U, F)` of the summand `e_𝔘 z` of a cocycle
`z ∈ Z^i(𝔘, F)`. -/
@[weil "def_fk102_cech_cohomology"]
noncomputable def cechClass (𝔘 : CechCovering U) :
    cechCycles 𝔘.toPreZeroHypercover F i →+ cechCohomologyOfObject U F i :=
  (cechCohomologyOfObjectMk F i).comp
    (DirectSum.of (fun 𝔘 : CechCovering U ↦ cechCycles 𝔘.toPreZeroHypercover F i) 𝔘)

open Classical in
lemma cechClass_apply (𝔘 : CechCovering U) (z : cechCycles 𝔘.toPreZeroHypercover F i) :
    cechClass F i 𝔘 z = cechCohomologyOfObjectMk F i
      (DirectSum.of (fun 𝔘 : CechCovering U ↦ cechCycles 𝔘.toPreZeroHypercover F i) 𝔘 z) :=
  rfl

/-- **Equivalent cocycles have the same class**: `(𝔘, z) ∼ (𝔘', z')` implies
`[z]_𝔘 = [z']_𝔘'`. -/
lemma cechClass_eq_cechClass {𝔘 𝔘' : CechCovering U} {z : cechCycles 𝔘.toPreZeroHypercover F i}
    {z' : cechCycles 𝔘'.toPreZeroHypercover F i} (h : CechCycleRel F i z z') :
    cechClass F i 𝔘 z = cechClass F i 𝔘' z' := by
  rw [← sub_eq_zero, cechClass_apply, cechClass_apply, ← map_sub]
  exact cechCohomologyOfObjectMk_eq_zero_of_mem F i
    (AddSubgroup.subset_closure ⟨𝔘, 𝔘', z, z', h, rfl⟩)

/-- **Refinement does not change the class**: `[φ^* z]_𝔚 = [z]_𝔘` for a refinement
`φ : 𝔚 ⟶ 𝔘` and a cocycle `z ∈ Z^i(𝔘, F)`. -/
lemma cechClass_cechCyclesMap {𝔚 𝔘 : CechCovering U}
    (φ : 𝔚.toPreZeroHypercover ⟶ 𝔘.toPreZeroHypercover)
    (z : cechCycles 𝔘.toPreZeroHypercover F i) :
    cechClass F i 𝔚 (cechCyclesMap F i φ z) = cechClass F i 𝔘 z := by
  refine cechClass_eq_cechClass F i ⟨𝔚, 𝟙 _, φ, ?_⟩
  rw [coe_cechCyclesMap,
    show refinementCochainMap (𝟙 𝔚.toPreZeroHypercover) F = 𝟙 _ from refinementCochainMap_id F,
    HomologicalComplex.id_f,
    ConcreteCategory.id_apply, sub_self]
  exact zero_mem _

/-- **The class of a coboundary is zero**: `[z]_𝔘 = 0` for `z ∈ im d^{i-1}`. -/
lemma cechClass_eq_zero_of_mem_range {𝔘 : CechCovering U}
    (z : cechCycles 𝔘.toPreZeroHypercover F i)
    (hz : (z : (cechComplex 𝔘.toPreZeroHypercover F).X i) ∈
      ((cechComplex 𝔘.toPreZeroHypercover F).d (i - 1) i).hom.range) :
    cechClass F i 𝔘 z = 0 := by
  rw [← map_zero (cechClass F i 𝔘)]
  refine cechClass_eq_cechClass F i ⟨𝔘, 𝟙 _, 𝟙 _, ?_⟩
  rw [show refinementCochainMap (𝟙 𝔘.toPreZeroHypercover) F = 𝟙 _ from refinementCochainMap_id F,
    HomologicalComplex.id_f, ConcreteCategory.id_apply,
    ConcreteCategory.id_apply, ZeroMemClass.coe_zero, sub_zero]
  exact hz

/-- The classes `[z]_𝔘 = [z']_𝔘` of two cocycles of one covering agree when `z - z'` is a
coboundary. -/
lemma cechClass_eq_of_sub_mem_range {𝔘 : CechCovering U}
    (z z' : cechCycles 𝔘.toPreZeroHypercover F i)
    (h : (z : (cechComplex 𝔘.toPreZeroHypercover F).X i) - z' ∈
      ((cechComplex 𝔘.toPreZeroHypercover F).d (i - 1) i).hom.range) :
    cechClass F i 𝔘 z = cechClass F i 𝔘 z' := by
  rw [← sub_eq_zero, ← map_sub]
  exact cechClass_eq_zero_of_mem_range F i _ h

/-- **Generation by classes.** Every element of `Ȟ^i(U, F)` is a finite sum of classes
`[z]_𝔘`, in the form of an induction principle. -/
@[elab_as_elim]
lemma cechCohomologyOfObject_induction_on {p : cechCohomologyOfObject U F i → Prop}
    (x : cechCohomologyOfObject U F i) (zero : p 0)
    (cechClass : ∀ (𝔘 : CechCovering U) (z : cechCycles 𝔘.toPreZeroHypercover F i),
      p (cechClass F i 𝔘 z))
    (add : ∀ x y, p x → p y → p (x + y)) : p x := by
  classical
  obtain ⟨x, rfl⟩ := cechCohomologyOfObjectMk_surjective F i x
  induction x using DirectSum.induction_on with
  | zero => rw [map_zero]; exact zero
  | of 𝔘 z =>
    convert cechClass 𝔘 z using 2
    rw [cechClass_apply]
  | add x y hx hy => rw [map_add]; exact add _ _ hx hy

/-- Homomorphisms out of `Ȟ^i(U, F)` which agree on all classes `[z]_𝔘` are equal. -/
lemma cechCohomologyOfObject_hom_ext {M : Type*} [AddCommGroup M]
    {g g' : cechCohomologyOfObject U F i →+ M}
    (h : ∀ (𝔘 : CechCovering U) (z : cechCycles 𝔘.toPreZeroHypercover F i),
      g (cechClass F i 𝔘 z) = g' (cechClass F i 𝔘 z)) : g = g' := by
  ext x
  induction x using cechCohomologyOfObject_induction_on F i with
  | zero => rw [map_zero, map_zero]
  | cechClass 𝔘 z => exact h 𝔘 z
  | add x y hx hy => rw [map_add, map_add, hx, hy]

open Classical in
/-- **The universal property.** A family of homomorphisms `g_𝔘 : Z^i(𝔘, F) → M` which agree on
equivalent cocycles defines a homomorphism `Ȟ^i(U, F) → M` with `[z]_𝔘 ↦ g_𝔘 z`. -/
noncomputable def cechCohomologyOfObjectDesc {M : Type*} [AddCommGroup M]
    (g : ∀ 𝔘 : CechCovering U, cechCycles 𝔘.toPreZeroHypercover F i →+ M)
    (hg : ∀ (𝔘 𝔘' : CechCovering U) (z : cechCycles 𝔘.toPreZeroHypercover F i)
      (z' : cechCycles 𝔘'.toPreZeroHypercover F i), CechCycleRel F i z z' → g 𝔘 z = g 𝔘' z') :
    cechCohomologyOfObject U F i →+ M :=
  QuotientAddGroup.lift (cechCohomologyRelations F i) (DirectSum.toAddMonoid g) (by
    refine (AddSubgroup.closure_le _).mpr ?_
    rintro _ ⟨𝔘, 𝔘', z, z', h, rfl⟩
    change DirectSum.toAddMonoid g _ = 0
    rw [map_sub, DirectSum.toAddMonoid_of, DirectSum.toAddMonoid_of, hg 𝔘 𝔘' z z' h, sub_self])

@[simp]
lemma cechCohomologyOfObjectDesc_cechClass {M : Type*} [AddCommGroup M]
    (g : ∀ 𝔘 : CechCovering U, cechCycles 𝔘.toPreZeroHypercover F i →+ M)
    (hg : ∀ (𝔘 𝔘' : CechCovering U) (z : cechCycles 𝔘.toPreZeroHypercover F i)
      (z' : cechCycles 𝔘'.toPreZeroHypercover F i), CechCycleRel F i z z' → g 𝔘 z = g 𝔘' z')
    (𝔘 : CechCovering U) (z : cechCycles 𝔘.toPreZeroHypercover F i) :
    cechCohomologyOfObjectDesc F i g hg (cechClass F i 𝔘 z) = g 𝔘 z := by
  classical
  exact DirectSum.toAddMonoid_of g 𝔘 z

/-- **The map of a single covering.** For a covering `𝔘`, the homomorphism
`Ȟ^i(𝔘, F) → Ȟ^i(U, F)` sending the class of a cocycle `z` to `[z]_𝔘`. -/
noncomputable def ofCechCohomology (𝔘 : CechCovering U) :
    (cechCohomology (A := AddCommGrpCat.{a}) 𝔘.toPreZeroHypercover F i : Type a) →+
      cechCohomologyOfObject U F i :=
  (QuotientAddGroup.lift _ (cechClass F i 𝔘) (by
    intro z hz
    rw [AddSubgroup.mem_addSubgroupOf, cechBoundaries_eq_range] at hz
    exact cechClass_eq_zero_of_mem_range F i z hz)).comp
    (cechCohomologyAddEquiv 𝔘.toPreZeroHypercover F i).toAddMonoidHom

lemma ofCechCohomology_symm_mk (𝔘 : CechCovering U) (z : cechCycles 𝔘.toPreZeroHypercover F i) :
    ofCechCohomology F i 𝔘 ((cechCohomologyAddEquiv 𝔘.toPreZeroHypercover F i).symm
      (QuotientAddGroup.mk z)) = cechClass F i 𝔘 z := by
  rw [ofCechCohomology, AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom,
    AddEquiv.apply_symm_apply]
  rfl

end SmallNoetherianSeparatedEtale

end AlgebraicGeometry

end
