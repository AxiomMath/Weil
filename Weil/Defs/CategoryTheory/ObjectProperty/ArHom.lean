module

public import Weil.Attr
public import Weil.Defs.CategoryTheory.ObjectProperty.ShiftNaturalMap

/-!
# Artin–Rees morphisms of projective systems

Let `F` and `G` be projective systems of `l`-power torsion `Λ`-modules. An *Artin–Rees
morphism* (A–R morphism) from `F` to `G` is represented by a pair `(r, f)` with `r ≥ 0` and
`f : F[r] ⟶ G` a morphism of projective systems. Two pairs `(r, f)` and `(s, g)` are related,
`(r, f) ≈ (s, g)`, if there is `t ≥ max r s` such that
`f_n ∘ ε^{t-r}_{F[r],n} = g_n ∘ ε^{t-s}_{F[s],n}` for all `n`, where `ε` is the natural map of a
shifted system and `F[r][t-r]` is identified with `F[t]`. The set `Hom_AR(F, G)` of A–R
morphisms is the set of classes of pairs for the equivalence relation generated by `≈`; it is
the colimit `colim_{r ≥ 0} Hom(F[r], G)`.

## Main definitions

* `CategoryTheory.ProjectiveSystem.shiftMap F h`: for `r ≤ t`, the map `F[t] ⟶ F[r]` with
  components the maps `F_{n+t} ⟶ F_{n+r}` of `F`; it is `ε^{t-r}_{F[r]}` once `F[r][t-r]` is
  identified with `F[t]` (`shiftMap_app_eq`).
* `CategoryTheory.ProjectiveSystem.ArHom.Rel F G`: the relation `≈` on pairs `(r, f)`.
* `CategoryTheory.ProjectiveSystem.ArHom F G`: the set `Hom_AR(F, G)` of A–R morphisms.
* `CategoryTheory.ProjectiveSystem.ArHom.mk r f`: the class `[r, f]` of a pair.

## Main results

* `CategoryTheory.ProjectiveSystem.ArHom.rel_iff`: the relation `≈` in the source's form,
  `f_n ∘ ε^{t-r}_{F[r],n} = g_n ∘ ε^{t-s}_{F[s],n}` for all `n`.
* `CategoryTheory.ProjectiveSystem.ArHom.mk_eq_mk_iff`: `[r, f] = [s, g]` if and only if the
  pairs are related by the equivalence relation generated by `≈`.
* `CategoryTheory.ProjectiveSystem.ArHom.mk_shiftMap_comp`: `[t, f ∘ ε] = [r, f]` for `t ≥ r`.
* `CategoryTheory.ProjectiveSystem.ArHom.mk_surjective`: every A–R morphism is a class `[r, f]`.

## Implementation notes

The relation compares `f` and `g` after precomposition with the maps `F[t] ⟶ F[r]` and
`F[t] ⟶ F[s]` of `F`, which are morphisms of projective systems with the same source `F[t]`.
The source states the comparison componentwise through `ε^{t-r}_{F[r]}`, whose source
`F[r][t-r]` has terms `F_{n+(t-r)+r}`, only propositionally equal to `F_{n+t}`; `rel_iff` is the
statement in that form, with the identification made by `eqToHom`. The quotient is `Quot`, whose
classes are exactly the classes of the equivalence relation generated by `≈`
(`mk_eq_mk_iff`).

The A–R category is also the Serre quotient of the category of projective systems by the null
systems; the identification of its morphisms with `ArHom` is a separate comparison.

## References

* [FK] E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, Chapter I, §12.
-/

@[expose] public section

universe v u

open Opposite

namespace CategoryTheory

namespace ProjectiveSystem

/-- For `r ≤ t`, the natural transformation `translate t ⟶ translate r` of `ℤᵒᵖ`, whose
component at `n` is the morphism `op (n + t) ⟶ op (n + r)` given by `n + r ≤ n + t`. -/
def translateLE {r t : ℕ} (h : r ≤ t) : translate (t : ℤ) ⟶ translate (r : ℤ) where
  app n := (homOfLE (by omega : n.unop + r ≤ n.unop + t)).op
  naturality _ _ _ := Subsingleton.elim _ _

variable {Λ : Type u} [CommRing Λ] {l : Λ}

/-- For `r ≤ t`, the map `F[t] ⟶ F[r]` whose component `F_{n+t} ⟶ F_{n+r}` is the map of `F`
along `n + r ≤ n + t`. It is the natural map `ε^{t-r}_{F[r]}` after identifying `F[r][t-r]` with
`F[t]` (`shiftMap_app_eq`). -/
def shiftMap (F : ProjectiveSystem.{v} Λ l) {r t : ℕ} (h : r ≤ t) :
    (shift (t : ℤ)).obj F ⟶ (shift (r : ℤ)).obj F :=
  ObjectProperty.homMk (Functor.whiskerRight (translateLE h) F.obj)

lemma shiftMap_app (F : ProjectiveSystem.{v} Λ l) {r t : ℕ} (h : r ≤ t) (n : ℤ) :
    app (shiftMap F h) n = F.obj.map (homOfLE (by omega : n + r ≤ n + t)).op := rfl

/-- The component of `shiftMap F h` at `n` is `ε^{t-r}_{F[r],n}`, up to the identification
`F_{n+t} = F_{n+(t-r)+r}`. -/
lemma shiftMap_app_eq (F : ProjectiveSystem.{v} Λ l) {r t : ℕ} (h : r ≤ t) (n : ℤ) :
    app (shiftMap F h) n =
      (eqToHom (congrArg F.term (by omega)) : F.term (n + t) ⟶ F.term (n + (t - r : ℕ) + r)) ≫
        app (natMap ((shift (r : ℤ)).obj F) (t - r)) n := by
  rw [shiftMap_app, natMap_app, ← eqToHom_map F.obj (congrArg op (by omega))]
  exact (congrArg F.obj.map (Subsingleton.elim _ _)).trans (F.obj.map_comp _ _)

@[simp]
lemma shiftMap_refl (F : ProjectiveSystem.{v} Λ l) (r : ℕ) :
    shiftMap F (le_refl r) = 𝟙 _ :=
  hom_ext fun _ => (congrArg F.obj.map (Subsingleton.elim _ _)).trans (F.obj.map_id _)

@[reassoc (attr := simp)]
lemma shiftMap_comp_shiftMap (F : ProjectiveSystem.{v} Λ l) {r s t : ℕ} (h₁ : r ≤ s)
    (h₂ : s ≤ t) : shiftMap F h₂ ≫ shiftMap F h₁ = shiftMap F (h₁.trans h₂) :=
  hom_ext fun _ => (F.obj.map_comp _ _).symm.trans (congrArg F.obj.map (Subsingleton.elim _ _))

/-- `ε^r_F ∘ (F[t] ⟶ F[r]) = ε^t_F`. -/
@[reassoc (attr := simp)]
lemma shiftMap_comp_natMap (F : ProjectiveSystem.{v} Λ l) {r t : ℕ} (h : r ≤ t) :
    shiftMap F h ≫ natMap F r = natMap F t :=
  hom_ext fun _ => (F.obj.map_comp _ _).symm.trans (congrArg F.obj.map (Subsingleton.elim _ _))

/-- The maps `F[t] ⟶ F[r]` are natural in `F`. -/
@[reassoc]
lemma shiftMap_naturality {F G : ProjectiveSystem.{v} Λ l} (f : F ⟶ G) {r t : ℕ} (h : r ≤ t) :
    (shift (t : ℤ)).map f ≫ shiftMap G h = shiftMap F h ≫ (shift (r : ℤ)).map f :=
  hom_ext fun _ => (f.hom.naturality _).symm

namespace ArHom

/-- The relation `≈` on pairs `(r, f)` with `f : F[r] ⟶ G`: `(r, f) ≈ (s, g)` if there is
`t ≥ max r s` such that `f` and `g` agree after precomposition with `F[t] ⟶ F[r]` and
`F[t] ⟶ F[s]`. See `rel_iff` for the componentwise form with the natural maps `ε`. -/
@[weil "def_fk112_ar_hom"]
def Rel (F G : ProjectiveSystem.{v} Λ l) :
    (Σ r : ℕ, (shift (r : ℤ)).obj F ⟶ G) → (Σ r : ℕ, (shift (r : ℤ)).obj F ⟶ G) → Prop
  | ⟨r, f⟩, ⟨s, g⟩ => ∃ (t : ℕ) (hr : r ≤ t) (hs : s ≤ t), shiftMap F hr ≫ f = shiftMap F hs ≫ g

end ArHom

/-- The set `Hom_AR(F, G)` of Artin–Rees morphisms from `F` to `G`: the classes `[r, f]` of
pairs `(r, f)`, with `r ≥ 0` and `f : F[r] ⟶ G`, for the equivalence relation generated by
`ArHom.Rel` (see `ArHom.mk_eq_mk_iff`). It is the colimit `colim_{r ≥ 0} Hom(F[r], G)`. -/
@[weil "def_fk112_ar_hom"]
def ArHom (F G : ProjectiveSystem.{v} Λ l) : Type _ :=
  Quot (ArHom.Rel F G)

namespace ArHom

variable {F G : ProjectiveSystem.{v} Λ l}

/-- The relation `≈` in the source's form: `(r, f) ≈ (s, g)` if and only if there is
`t ≥ max r s` with `f_n ∘ ε^{t-r}_{F[r],n} = g_n ∘ ε^{t-s}_{F[s],n}` for all `n`, where the
sources `F_{n+(t-r)+r}` and `F_{n+(t-s)+s}` are both identified with `F_{n+t}`. -/
@[weil "def_fk112_ar_hom"]
lemma rel_iff {r s : ℕ} (f : (shift (r : ℤ)).obj F ⟶ G) (g : (shift (s : ℤ)).obj F ⟶ G) :
    Rel F G ⟨r, f⟩ ⟨s, g⟩ ↔ ∃ (t : ℕ) (ht : max r s ≤ t), ∀ n : ℤ,
      (eqToHom (congrArg F.term (by have := le_of_max_le_left ht; omega)) :
            F.term (n + t) ⟶ F.term (n + (t - r : ℕ) + r)) ≫
          app (natMap ((shift (r : ℤ)).obj F) (t - r)) n ≫ app f n =
        (eqToHom (congrArg F.term (by have := le_of_max_le_right ht; omega)) :
            F.term (n + t) ⟶ F.term (n + (t - s : ℕ) + s)) ≫
          app (natMap ((shift (s : ℤ)).obj F) (t - s)) n ≫ app g n := by
  constructor
  · rintro ⟨t, hr, hs, h⟩
    refine ⟨t, max_le hr hs, fun n => ?_⟩
    have := congrArg (fun φ => app φ n) h
    simp only [comp_app, shiftMap_app_eq] at this
    exact this
  · rintro ⟨t, ht, h⟩
    refine ⟨t, le_of_max_le_left ht, le_of_max_le_right ht, hom_ext fun n => ?_⟩
    simp only [comp_app, shiftMap_app_eq]
    exact h n

/-- The class `[r, f]` of a pair `(r, f)` with `f : F[r] ⟶ G`. -/
def mk (r : ℕ) (f : (shift (r : ℤ)).obj F ⟶ G) : ArHom F G :=
  Quot.mk _ ⟨r, f⟩

lemma mk_surjective (φ : ArHom F G) : ∃ (r : ℕ) (f : (shift (r : ℤ)).obj F ⟶ G), mk r f = φ := by
  induction φ using Quot.ind with
  | mk p => exact ⟨p.1, p.2, rfl⟩

@[elab_as_elim]
lemma ind {motive : ArHom F G → Prop}
    (h : ∀ (r : ℕ) (f : (shift (r : ℤ)).obj F ⟶ G), motive (mk r f)) (φ : ArHom F G) :
    motive φ := by
  obtain ⟨r, f, rfl⟩ := mk_surjective φ
  exact h r f

lemma sound {r s : ℕ} {f : (shift (r : ℤ)).obj F ⟶ G} {g : (shift (s : ℤ)).obj F ⟶ G}
    (h : Rel F G ⟨r, f⟩ ⟨s, g⟩) : mk r f = mk s g :=
  Quot.sound h

/-- `[r, f] = [s, g]` if and only if `(r, f)` and `(s, g)` are related by the equivalence
relation generated by `≈`. -/
lemma mk_eq_mk_iff {r s : ℕ} (f : (shift (r : ℤ)).obj F ⟶ G) (g : (shift (s : ℤ)).obj F ⟶ G) :
    mk r f = mk s g ↔ Relation.EqvGen (Rel F G) ⟨r, f⟩ ⟨s, g⟩ :=
  ⟨Quot.eqvGen_exact, Quot.eqvGen_sound⟩

/-- `[t, f ∘ (F[t] ⟶ F[r])] = [r, f]` for `t ≥ r`. -/
lemma mk_shiftMap_comp {r t : ℕ} (h : r ≤ t) (f : (shift (r : ℤ)).obj F ⟶ G) :
    mk t (shiftMap F h ≫ f) = mk r f :=
  sound ⟨t, le_refl t, h, by simp⟩

/-- Two pairs agreeing after precomposition with `F[t] ⟶ F[r]` and `F[t] ⟶ F[s]` have the same
class. -/
lemma mk_eq_mk_of_comp_eq {r s t : ℕ} (hr : r ≤ t) (hs : s ≤ t)
    {f : (shift (r : ℤ)).obj F ⟶ G} {g : (shift (s : ℤ)).obj F ⟶ G}
    (h : shiftMap F hr ≫ f = shiftMap F hs ≫ g) : mk r f = mk s g :=
  sound ⟨t, hr, hs, h⟩

end ArHom

end ProjectiveSystem

end CategoryTheory
