module

public import Weil.Attr
public import Weil.Defs.RingTheory.Henselian.Henselization.Defs
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Localization.AtPrime.Basic

/-!
# Henselizations of polynomial rings over a local ring at the origin

Let `A` be a local ring with maximal ideal `𝔪` and residue field `κ`, and let `T = (T_i)_{i ∈ σ}`
be a family of indeterminates. The ideal `𝔭₀ = (𝔪, T)` of `A[T]` is the kernel of
`A[T] → A → κ`, evaluation at the origin followed by the residue map, so it is a maximal ideal
with residue field `κ`. The ring `A{T}` is the Henselization of the local ring `A[T]_{𝔭₀}` with
respect to its residue map `A[T]_{𝔭₀} → κ(𝔭₀) = κ`. When the residue field `κ` is separably
closed, for instance when `A` is strictly henselian, `A{T}` is a strict henselization of
`A[T]_{𝔭₀}`.

## Main definitions

* `MvPolynomial.originIdeal A σ`: the maximal ideal `𝔭₀ = (𝔪, T)` of `A[T]`, the preimage of `𝔪`
  under the constant coefficient map.
* `MvPolynomial.originResidue A σ`: the residue map `A[T]_{𝔭₀} → κ`, induced by evaluation at the
  origin followed by `A → κ`.
* `MvPolynomial.IsHenselianPolynomialRing A σ B`: the local `A[T]_{𝔭₀}`-algebra `B` is a
  henselization `A{T}` of `A[T]_{𝔭₀}`.

## Main results

* `MvPolynomial.originIdeal_eq`: `𝔭₀ = 𝔪 A[T] + (T_i)_{i ∈ σ}`.
* `MvPolynomial.isHenselianPolynomialRing_iff_exists_isHenselizationAlong`: `B` is `A{T}` if and
  only if it is a Henselization of `A[T]_{𝔭₀}` with respect to the residue map
  `originResidue A σ : A[T]_{𝔭₀} → κ`, in the sense of `IsLocalRing.IsHenselizationAlong`.
* `MvPolynomial.exists_isHenselianPolynomialRing`: `A{T}` exists.
* `MvPolynomial.IsHenselianPolynomialRing.isHenselization_separableClosure`: if `κ` is separably
  closed, `A{T}` is a strict henselization of `A[T]_{𝔭₀}`.

## Implementation notes

As for henselizations in general, `A{T}` is characterized by a predicate on a local
`A[T]_{𝔭₀}`-algebra rather than constructed; it is unique up to unique isomorphism (Stacks 08HT)
and exists by `MvPolynomial.exists_isHenselianPolynomialRing`. The source takes `A` noetherian and
finitely many indeterminates `T_1, …, T_n`; neither is needed for the definition, which allows any
local ring and any index type `σ` (`σ = Fin n`, and `Fin 1` for `A{t}`). The source asks `A` to be
strictly henselian for the last statement; only the separable closedness of `κ` is used.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FK88], I.7
* [StacksProject 04GQ](https://stacks.math.columbia.edu/tag/04GQ)
-/

@[expose] public section

open IsLocalRing

universe u v w

namespace MvPolynomial

variable (A : Type u) [CommRing A] [IsLocalRing A] (σ : Type v)

/-- The ideal `𝔭₀ = (𝔪, T)` of the polynomial ring `A[T]` over a local ring `(A, 𝔪)`: the
polynomials whose constant coefficient lies in `𝔪`. -/
noncomputable def originIdeal : Ideal (MvPolynomial σ A) :=
  (maximalIdeal A).comap (constantCoeff (σ := σ) (R := A))

variable {A σ} in
theorem mem_originIdeal {f : MvPolynomial σ A} :
    f ∈ originIdeal A σ ↔ constantCoeff f ∈ maximalIdeal A :=
  Iff.rfl

omit [IsLocalRing A] in
theorem constantCoeff_surjective : Function.Surjective (constantCoeff (σ := σ) (R := A)) :=
  fun a => ⟨C a, constantCoeff_C σ a⟩

instance originIdeal_isMaximal : (originIdeal A σ).IsMaximal :=
  Ideal.comap_isMaximal_of_surjective _ (constantCoeff_surjective A σ)

/-- `𝔭₀` is generated by the maximal ideal of `A` and the indeterminates: `𝔭₀ = 𝔪 A[T] + (T)`. -/
@[weil "not_fk107_henselian_polynomial_ring"]
theorem originIdeal_eq :
    originIdeal A σ = (maximalIdeal A).map (C : A →+* MvPolynomial σ A) ⊔ idealOfVars σ A := by
  refine le_antisymm (fun f hf => ?_) (sup_le ?_ ?_)
  · have hrest : f - C (constantCoeff f) ∈ idealOfVars σ A := by
      rw [← pow_one (idealOfVars σ A), mem_pow_idealOfVars_iff']
      intro x hx
      have hx0 : x = 0 := by
        rw [← Finsupp.degree_eq_zero_iff]
        omega
      subst hx0
      simp [← constantCoeff_eq]
    rw [← add_sub_cancel (C (constantCoeff f)) f]
    exact Submodule.add_mem_sup (Ideal.mem_map_of_mem _ hf) hrest
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    simpa [mem_originIdeal] using ha
  · rw [idealOfVars, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    simp [mem_originIdeal]

/-- The local ring `A[T]_{𝔭₀}`. -/
abbrev LocalizationAtOrigin : Type (max u v) :=
  Localization.AtPrime (originIdeal A σ)

/-- The residue map `A[T]_{𝔭₀} → κ(A)`: evaluation at the origin followed by the residue map of
`A`. -/
noncomputable def originResidue : LocalizationAtOrigin A σ →+* ResidueField A :=
  IsLocalization.lift (M := (originIdeal A σ).primeCompl)
    (g := (residue A).comp constantCoeff) fun y => by
      refine Ne.isUnit fun h => y.2 ?_
      rw [RingHom.comp_apply, residue_eq_zero_iff] at h
      exact h

@[simp]
theorem originResidue_algebraMap (f : MvPolynomial σ A) :
    originResidue A σ (algebraMap _ _ f) = residue A (constantCoeff f) :=
  IsLocalization.lift_eq _ _

theorem originResidue_surjective : Function.Surjective (originResidue A σ) := by
  intro x
  obtain ⟨a, rfl⟩ := residue_surjective x
  exact ⟨algebraMap _ _ (C a),
    (originResidue_algebraMap A σ (C a)).trans (by rw [constantCoeff_C])⟩

instance : IsLocalHom (originResidue A σ) :=
  (originResidue_surjective A σ).isLocalHom _

/-- For the surjective residue map `A[T]_{𝔭₀} → κ(A)`, the separable closure of the residue
field of `A[T]_{𝔭₀}` in `κ(A)` is the whole residue field of `A[T]_{𝔭₀}`. -/
noncomputable def residueSeparableClosureOriginResidueAlgEquiv :
    residueSeparableClosure (originResidue A σ) ≃ₐ[ResidueField (LocalizationAtOrigin A σ)]
      ResidueField (LocalizationAtOrigin A σ) :=
  (AlgEquiv.ofBijective (Algebra.ofId _ _)
    ⟨RingHom.injective _, fun y => by
      obtain ⟨a, ha⟩ := originResidue_surjective A σ (y : ResidueField A)
      refine ⟨residue _ a, Subtype.ext ?_⟩
      change ResidueField.lift (originResidue A σ) (residue _ a) = _
      rw [ResidueField.lift_residue_apply, ha]⟩).symm

/-- **The Henselization `A{T}` of the polynomial ring at the origin.** For a local ring `A` and a
family of indeterminates `T`, the local `A[T]_{𝔭₀}`-algebra `B` is `A{T}`: a henselization of
`A[T]_{𝔭₀}`, `𝔭₀ = (𝔪(A), T)`, with residue field that of `A[T]_{𝔭₀}`. -/
@[weil "not_fk107_henselian_polynomial_ring"]
abbrev IsHenselianPolynomialRing (B : Type w) [CommRing B] [IsLocalRing B]
    [Algebra (LocalizationAtOrigin A σ) B] : Prop :=
  IsHenselization (LocalizationAtOrigin A σ) (ResidueField (LocalizationAtOrigin A σ)) B

variable {A σ}

/-- `A{T}` is the Henselization of `A[T]_{𝔭₀}` with respect to its residue map
`A[T]_{𝔭₀} → κ(𝔭₀) = κ(A)`. -/
@[weil "not_fk107_henselian_polynomial_ring"]
theorem isHenselianPolynomialRing_iff_exists_isHenselizationAlong {B : Type w} [CommRing B]
    [IsLocalRing B] [Algebra (LocalizationAtOrigin A σ) B] :
    IsHenselianPolynomialRing A σ B ↔
      ∃ ψ : B →+* ResidueField A, IsHenselizationAlong (originResidue A σ) B ψ := by
  constructor
  · intro h
    have : IsHenselization (LocalizationAtOrigin A σ)
        (residueSeparableClosure (originResidue A σ)) B :=
      IsHenselization.of_residueAlgEquiv (residueSeparableClosureOriginResidueAlgEquiv A σ).symm
    exact IsHenselization.exists_isHenselizationAlong _
  · rintro ⟨ψ, h⟩
    have := h.isHenselization
    exact IsHenselization.of_residueAlgEquiv (residueSeparableClosureOriginResidueAlgEquiv A σ)

variable (A σ) in
/-- `A{T}` exists, in the universe of `A[T]`. -/
theorem exists_isHenselianPolynomialRing :
    ∃ (B : Type (max u v)) (_ : CommRing B) (_ : IsLocalRing B)
      (_ : Algebra (LocalizationAtOrigin A σ) B), IsHenselianPolynomialRing A σ B :=
  exists_isHenselization_residueField _

/-- **Strictness.** If the residue field of `A` is separably closed (for instance if `A` is
strictly henselian), then `A{T}` is a strict henselization of `A[T]_{𝔭₀}`. -/
@[weil "not_fk107_henselian_polynomial_ring"]
theorem IsHenselianPolynomialRing.isHenselization_separableClosure
    [IsSepClosed (ResidueField A)] {B : Type w} [CommRing B] [IsLocalRing B]
    [Algebra (LocalizationAtOrigin A σ) B] (h : IsHenselianPolynomialRing A σ B) :
    IsHenselization (LocalizationAtOrigin A σ)
      (SeparableClosure (ResidueField (LocalizationAtOrigin A σ))) B := by
  obtain ⟨ψ, hψ⟩ := isHenselianPolynomialRing_iff_exists_isHenselizationAlong.1 h
  exact hψ.isHenselization_separableClosure

/-- If the residue field of `A` is separably closed, so is the residue field of `A{T}`. -/
theorem IsHenselianPolynomialRing.isSepClosed_residueField
    [IsSepClosed (ResidueField A)] {B : Type w} [CommRing B] [IsLocalRing B]
    [Algebra (LocalizationAtOrigin A σ) B] (h : IsHenselianPolynomialRing A σ B) :
    IsSepClosed (ResidueField B) := by
  obtain ⟨ψ, hψ⟩ := isHenselianPolynomialRing_iff_exists_isHenselizationAlong.1 h
  exact hψ.isSepClosed_residueField

end MvPolynomial
