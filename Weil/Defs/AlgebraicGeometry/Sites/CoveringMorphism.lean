module

public import Weil.Attr
public import Weil.Defs.AlgebraicGeometry.Sites.EtaleCoveringFk101

/-!
# Morphisms of étale coverings and the category of coverings

Let `A` be a commutative ring and `f : B ⟶ B'` a morphism of the étale category `Et(A)`. For
coverings `𝔅 = (gᵢ : B ⟶ Bᵢ)_{i ∈ I}` of `B` and `𝔅' = (g'ⱼ : B' ⟶ B'ⱼ)_{j ∈ J}` of `B'`, a
morphism `𝔅 ⟶ 𝔅'` over `f` is a pair `(σ, h)` of a map `σ : J → I` and a family of morphisms
`hⱼ : B_{σ j} ⟶ B'ⱼ` with `hⱼ ∘ g_{σ j} = g'ⱼ ∘ f`. Such morphisms compose, and the morphisms over
the identity of `B` make the coverings of `B` into a category `Cov(B)`.

## Main definitions

- `AlgebraicGeometry.EtaleCategory.Covering B`: an étale covering of an object `B` of `Et(A)`,
  bundled with its index type.
- `AlgebraicGeometry.EtaleCategory.Covering.HomOver f 𝔅 𝔅'`: the morphisms `𝔅 ⟶ 𝔅'` over a
  morphism `f : B ⟶ B'`.
- `AlgebraicGeometry.EtaleCategory.Covering.HomOver.id`,
  `AlgebraicGeometry.EtaleCategory.Covering.HomOver.comp`: identities and composition.
- `AlgebraicGeometry.EtaleCategory.Covering.instCategory`: the category `Cov(B)` of coverings
  of `B`, whose morphisms are the morphisms over `𝟙 B`.
- `AlgebraicGeometry.EtaleCategory.Covering.toCover`: the functor from `Cov(B)` to the opposite
  of the poset of covering sieves of `B` for the affine étale topology, sending a covering to the
  sieve generated by the opposite family.

## Main results

- `AlgebraicGeometry.EtaleCategory.Covering.HomOver.sieve_le`: a morphism `𝔅 ⟶ 𝔅'` of
  coverings of `B` exhibits the sieve of `𝔅'` as a refinement of the sieve of `𝔅`.

## Implementation notes

A covering is bundled with its index type in a universe `w` that is a parameter. The identity
of a morphism of coverings is decided by `HomOver.ext`: equal index maps and componentwise equal
morphisms, up to the `eqToHom` that the equality of index maps requires.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FreitagKiehl1988], I.1
-/

@[expose] public noncomputable section

universe w u

open CategoryTheory Opposite

namespace AlgebraicGeometry

namespace EtaleCategory

variable {A : CommRingCat.{u}}

/-- An étale covering `(gᵢ : B ⟶ Bᵢ)_{i ∈ ι}` of an object `B` of the étale category `Et(A)`,
bundled with its index type `ι`. -/
structure Covering (B : EtaleCategory A) where
  /-- The index type of the covering. -/
  ι : Type w
  /-- The members `Bᵢ` of the covering. -/
  obj : ι → EtaleCategory A
  /-- The maps `gᵢ : B ⟶ Bᵢ` of the covering. -/
  map : ∀ i, B ⟶ obj i
  /-- The family `(gᵢ)ᵢ` is an étale covering. -/
  isCovering : IsCovering map

namespace Covering

variable {B B' B'' : EtaleCategory A}

/-- A morphism `𝔅 ⟶ 𝔅'` of coverings over a morphism `f : B ⟶ B'` of `Et(A)`: a map of index
sets `σ : J → I` together with morphisms `hⱼ : B_{σ j} ⟶ B'ⱼ` such that
`hⱼ ∘ g_{σ j} = g'ⱼ ∘ f` for all `j`. -/
@[weil "def_fk101_covering_morphism"]
structure HomOver (f : B ⟶ B') (𝔅 : Covering.{w} B) (𝔅' : Covering.{w} B') where
  /-- The map of index sets `σ : J → I`. -/
  σ : 𝔅'.ι → 𝔅.ι
  /-- The morphisms `hⱼ : B_{σ j} ⟶ B'ⱼ`. -/
  h : ∀ j, 𝔅.obj (σ j) ⟶ 𝔅'.obj j
  /-- The compatibility `hⱼ ∘ g_{σ j} = g'ⱼ ∘ f`. -/
  comm : ∀ j, 𝔅.map (σ j) ≫ h j = f ≫ 𝔅'.map j

attribute [reassoc] HomOver.comm

namespace HomOver

variable {f : B ⟶ B'} {f' : B' ⟶ B''} {𝔅 : Covering.{w} B} {𝔅' : Covering.{w} B'}
  {𝔅'' : Covering.{w} B''}

/-- Two morphisms of coverings over `f` are equal if their index maps are equal and their
components agree up to the resulting identification of the sources. -/
@[ext (iff := false)]
lemma ext {φ ψ : HomOver f 𝔅 𝔅'} (hσ : φ.σ = ψ.σ)
    (hh : ∀ j, φ.h j = eqToHom (by rw [hσ]) ≫ ψ.h j) : φ = ψ := by
  obtain ⟨σ, h, _⟩ := φ
  obtain ⟨σ', h', _⟩ := ψ
  obtain rfl : σ = σ' := hσ
  obtain rfl : h = h' := funext fun j ↦ by simpa using hh j
  rfl

/-- Two morphisms of coverings with the same index map are equal if their components agree. -/
lemma mk_eq_mk {σ : 𝔅'.ι → 𝔅.ι} {h h' : ∀ j, 𝔅.obj (σ j) ⟶ 𝔅'.obj j}
    {c : ∀ j, 𝔅.map (σ j) ≫ h j = f ≫ 𝔅'.map j} {c' : ∀ j, 𝔅.map (σ j) ≫ h' j = f ≫ 𝔅'.map j}
    (hh : ∀ j, h j = h' j) : HomOver.mk σ h c = HomOver.mk σ h' c' := by
  obtain rfl : h = h' := funext hh
  rfl

/-- The identity morphism `(id_I, (id_{Bᵢ})ᵢ)` of a covering, over `𝟙 B`. -/
@[simps]
protected def id (𝔅 : Covering.{w} B) : HomOver (𝟙 B) 𝔅 𝔅 where
  σ i := i
  h _ := 𝟙 _
  comm _ := by simp

/-- The composite `(σ ∘ σ', (h'ₗ ∘ h_{σ' l})ₗ)` of morphisms `(σ, h) : 𝔅 ⟶ 𝔅'` over `f` and
`(σ', h') : 𝔅' ⟶ 𝔅''` over `f'`, a morphism `𝔅 ⟶ 𝔅''` over `f ≫ f'`. -/
@[weil "def_fk101_covering_morphism", simps]
def comp (φ : HomOver f 𝔅 𝔅') (ψ : HomOver f' 𝔅' 𝔅'') : HomOver (f ≫ f') 𝔅 𝔅'' where
  σ l := φ.σ (ψ.σ l)
  h l := φ.h (ψ.σ l) ≫ ψ.h l
  comm l := by simp [φ.comm_assoc, ψ.comm]

/-- Transport of a morphism of coverings along an equality of the underlying morphisms. -/
@[simps]
def congrBase {f₁ f₂ : B ⟶ B'} (e : f₁ = f₂) (φ : HomOver f₁ 𝔅 𝔅') : HomOver f₂ 𝔅 𝔅' where
  σ := φ.σ
  h := φ.h
  comm j := e ▸ φ.comm j

@[simp]
lemma id_comp (φ : HomOver f 𝔅 𝔅') :
    (HomOver.id 𝔅).comp φ = φ.congrBase (Category.id_comp f).symm := by
  obtain ⟨⟩ := φ; exact mk_eq_mk fun _ ↦ Category.id_comp _

@[simp]
lemma comp_id (φ : HomOver f 𝔅 𝔅') :
    φ.comp (HomOver.id 𝔅') = φ.congrBase (Category.comp_id f).symm := by
  obtain ⟨⟩ := φ; exact mk_eq_mk fun _ ↦ Category.comp_id _

lemma comp_assoc {B''' : EtaleCategory A} {f'' : B'' ⟶ B'''} {𝔅''' : Covering.{w} B'''}
    (φ : HomOver f 𝔅 𝔅') (ψ : HomOver f' 𝔅' 𝔅'') (χ : HomOver f'' 𝔅'' 𝔅''') :
    (φ.comp ψ).comp χ = (φ.comp (ψ.comp χ)).congrBase (Category.assoc f f' f'').symm := by
  obtain ⟨⟩ := ψ; obtain ⟨⟩ := χ
  obtain ⟨⟩ := φ; exact mk_eq_mk fun _ ↦ Category.assoc _ _ _

end HomOver

/-- The category `Cov(B)` of coverings of `B`: a morphism `𝔅 ⟶ 𝔅'` is a morphism of coverings
over `𝟙 B`, with identities `(id_I, (id_{Bᵢ})ᵢ)` and the composition of `HomOver.comp`. -/
@[weil "def_fk101_covering_morphism"]
instance instCategory : Category (Covering.{w} B) where
  Hom 𝔅 𝔅' := HomOver (𝟙 B) 𝔅 𝔅'
  id 𝔅 := HomOver.id 𝔅
  comp φ ψ := (φ.comp ψ).congrBase (Category.comp_id _)
  id_comp φ := by obtain ⟨⟩ := φ; exact HomOver.mk_eq_mk fun _ ↦ Category.id_comp _
  comp_id φ := by obtain ⟨⟩ := φ; exact HomOver.mk_eq_mk fun _ ↦ Category.comp_id _
  assoc φ ψ χ := by
    obtain ⟨⟩ := φ; obtain ⟨⟩ := ψ; obtain ⟨⟩ := χ
    exact HomOver.mk_eq_mk fun _ ↦ Category.assoc _ _ _

variable {𝔅 𝔅' 𝔅'' : Covering.{w} B}

/-- A morphism of coverings of `B` is a morphism of coverings over `𝟙 B`. -/
abbrev Hom.toHomOver (φ : 𝔅 ⟶ 𝔅') : HomOver (𝟙 B) 𝔅 𝔅' := φ

/-- A morphism of coverings of `B` over `𝟙 B` is a morphism of `Cov(B)`. -/
abbrev HomOver.toHom (φ : HomOver (𝟙 B) 𝔅 𝔅') : 𝔅 ⟶ 𝔅' := φ

@[simp]
lemma id_σ : HomOver.σ (𝟙 𝔅 : 𝔅 ⟶ 𝔅) = _root_.id := rfl

@[simp]
lemma id_h (i : 𝔅.ι) : HomOver.h (𝟙 𝔅 : 𝔅 ⟶ 𝔅) i = 𝟙 _ := rfl

@[simp]
lemma comp_σ (φ : 𝔅 ⟶ 𝔅') (ψ : 𝔅' ⟶ 𝔅'') :
    HomOver.σ (φ ≫ ψ) = HomOver.σ φ ∘ HomOver.σ ψ := rfl

@[simp]
lemma comp_h (φ : 𝔅 ⟶ 𝔅') (ψ : 𝔅' ⟶ 𝔅'') (l : 𝔅''.ι) :
    HomOver.h (φ ≫ ψ) l = HomOver.h φ (HomOver.σ ψ l) ≫ HomOver.h ψ l := rfl

/-- In `Cov(B)`, the compatibility of a morphism `(σ, h) : 𝔅 ⟶ 𝔅'` reads
`hⱼ ∘ g_{σ j} = g'ⱼ`. -/
@[reassoc]
lemma Hom.comm (φ : 𝔅 ⟶ 𝔅') (j : 𝔅'.ι) :
    𝔅.map (HomOver.σ φ j) ≫ HomOver.h φ j = 𝔅'.map j := by
  simpa using HomOver.comm φ j

@[ext (iff := false)]
lemma Hom.ext {φ ψ : 𝔅 ⟶ 𝔅'} (hσ : HomOver.σ φ = HomOver.σ ψ)
    (hh : ∀ j, HomOver.h φ j = eqToHom (by rw [hσ]) ≫ HomOver.h ψ j) : φ = ψ :=
  HomOver.ext hσ hh

/-- The sieve on `B` (viewed in `Scheme.AffineEtale (Spec A)`) generated by the opposite of the
family of a covering. -/
abbrev sieve (𝔅 : Covering.{w} B) : Sieve B.unop :=
  Sieve.ofArrows (fun i ↦ (𝔅.obj i).unop) (fun i ↦ (𝔅.map i).unop)

lemma sieve_mem (𝔅 : Covering.{w} B) :
    𝔅.sieve ∈ Scheme.AffineEtale.topology (Spec A) B.unop :=
  𝔅.isCovering.mem_topology

/-- A morphism `𝔅 ⟶ 𝔅'` of coverings of `B` exhibits the sieve of `𝔅'` as a refinement of the
sieve of `𝔅`. -/
lemma HomOver.sieve_le (φ : 𝔅 ⟶ 𝔅') : 𝔅'.sieve ≤ 𝔅.sieve := by
  refine (Sieve.generate_le_iff _ _).2 ?_
  rintro _ _ ⟨j⟩
  rw [← Hom.comm φ j, unop_comp]
  exact Sieve.downward_closed _ (Sieve.ofArrows_mk _ _ _) _

/-- The covering sieve of the affine étale topology generated by a covering. -/
def toCoverObj (𝔅 : Covering.{w} B) : (Scheme.AffineEtale.topology (Spec A)).Cover B.unop :=
  ⟨𝔅.sieve, 𝔅.sieve_mem⟩

/-- The functor from `Cov(B)` to the opposite of the poset of covering sieves of `B` for the
affine étale topology, sending a covering to the sieve generated by its opposite family. -/
def toCover (B : EtaleCategory A) :
    Covering.{w} B ⥤ ((Scheme.AffineEtale.topology (Spec A)).Cover B.unop)ᵒᵖ where
  obj 𝔅 := op (toCoverObj 𝔅)
  map φ := (homOfLE (HomOver.sieve_le φ)).op

end Covering

end EtaleCategory

end AlgebraicGeometry
