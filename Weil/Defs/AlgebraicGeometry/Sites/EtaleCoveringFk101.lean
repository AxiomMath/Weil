module

public import Weil.Attr
public import Weil.Defs.AlgebraicGeometry.Sites.AffineEtale
public import Mathlib.AlgebraicGeometry.Sites.Etale

/-!
# Étale coverings in the étale category of a ring

Let `A` be a commutative ring and `B` an object of the étale category `Et(A)`. An étale
covering of `B` is a finite family `(gᵢ : B → Bᵢ)ᵢ` of morphisms of `Et(A)` such that every
prime ideal of `B` is the preimage under some `gᵢ` of a prime ideal of `Bᵢ`, i.e. the images
of the maps `Spec Bᵢ → Spec B` cover `Spec B`.

## Main definitions

- `AlgebraicGeometry.EtaleCategory.ringHom`: the ring homomorphism `B → C` underlying a
  morphism `B ⟶ C` of `EtaleCategory A`.
- `AlgebraicGeometry.EtaleCategory.IsCovering`: the property of a family of morphisms of
  `EtaleCategory A` with common source of being an étale covering.

## Main results

- `AlgebraicGeometry.EtaleCategory.isCovering_iff_iUnion_range`: a finite family is a covering
  if and only if the images of the induced maps of spectra cover the spectrum of the source.
- `AlgebraicGeometry.EtaleCategory.isCovering_iff_mem_topology`: a finite family is a covering
  if and only if the sieve generated by the opposite family is a covering sieve of the affine
  étale topology `Scheme.AffineEtale.topology (Spec A)`.

## Implementation notes

Since `EtaleCategory A` is the opposite of `Scheme.AffineEtale (Spec A)`, a family
`gᵢ : B ⟶ Bᵢ` of `EtaleCategory A` is a family `(gᵢ).unop : Bᵢ.unop ⟶ B.unop` of étale
schemes over `Spec A`; the Grothendieck topology of `Scheme.AffineEtale` admits families of
arbitrary size, and `isCovering_iff_mem_topology` identifies the finite ones with the coverings
defined here.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FreitagKiehl1988], I.1
-/

@[expose] public noncomputable section

universe u w

open CategoryTheory Opposite

namespace AlgebraicGeometry

namespace EtaleCategory

variable {A : CommRingCat.{u}}

/-- The ring underlying an object of the étale category. -/
abbrev ring (B : EtaleCategory A) : CommRingCat.{u} := B.unop.left.unop

/-- The ring homomorphism underlying a morphism of the étale category. -/
abbrev ringHom {B C : EtaleCategory A} (g : B ⟶ C) : B.ring ⟶ C.ring := g.unop.left.unop

/-- A family `(gᵢ : B ⟶ Cᵢ)ᵢ` of morphisms of the étale category `Et(A)` is an (étale)
covering of `B` if it is finite and every prime ideal of `B` is the preimage of a prime ideal
of some `Cᵢ` under `gᵢ`. -/
@[weil "def_fk101_etale_covering"]
structure IsCovering {B : EtaleCategory A} {ι : Type w} {C : ι → EtaleCategory A}
    (g : ∀ i, B ⟶ C i) : Prop where
  /-- The family is finite. -/
  finite : Finite ι
  /-- Every prime ideal of `B` is the preimage of a prime ideal of some `Cᵢ`. -/
  exists_comap_eq (p : PrimeSpectrum B.ring) :
    ∃ (i : ι) (q : PrimeSpectrum (C i).ring), PrimeSpectrum.comap (ringHom (g i)).hom q = p

variable {B : EtaleCategory A} {ι : Type w} {C : ι → EtaleCategory A} (g : ∀ i, B ⟶ C i)

lemma isCovering_iff :
    IsCovering g ↔ Finite ι ∧ ∀ p : PrimeSpectrum B.ring,
      ∃ (i : ι) (q : PrimeSpectrum (C i).ring), PrimeSpectrum.comap (ringHom (g i)).hom q = p :=
  ⟨fun h ↦ ⟨h.finite, h.exists_comap_eq⟩, fun h ↦ ⟨h.1, h.2⟩⟩

/-- A family of morphisms of `Et(A)` is a covering if and only if it is finite and the images of
the induced maps of spectra `Spec Cᵢ → Spec B` cover `Spec B`. -/
lemma isCovering_iff_iUnion_range :
    IsCovering g ↔ Finite ι ∧ ⋃ i, Set.range (Spec.map (ringHom (g i))) = Set.univ := by
  rw [isCovering_iff]
  refine and_congr_right fun _ ↦ ?_
  rw [Set.eq_univ_iff_forall]
  simp only [Set.mem_iUnion, Set.mem_range]
  rfl

lemma IsCovering.iUnion_range (hg : IsCovering g) :
    ⋃ i, Set.range (Spec.map (ringHom (g i))) = Set.univ :=
  ((isCovering_iff_iUnion_range g).1 hg).2

set_option backward.isDefEq.respectTransparency false in
/-- A finite family of morphisms of `Et(A)` is a covering if and only if the opposite family
generates a covering sieve of the affine étale topology on `Spec A`. -/
lemma isCovering_iff_mem_topology :
    IsCovering g ↔ Finite ι ∧
      Sieve.ofArrows (fun i ↦ (C i).unop) (fun i ↦ (g i).unop) ∈
        Scheme.AffineEtale.topology (Spec A) B.unop := by
  rw [isCovering_iff_iUnion_range]
  refine and_congr_right fun _ ↦ ?_
  rw [Scheme.AffineEtale.topology, Functor.mem_inducedTopology_iff_of_isCoverDense,
    Sieve.functorPushforward_ofArrows, Scheme.ofArrows_mem_smallEtaleTopology_iff]
  rfl

lemma IsCovering.mem_topology (hg : IsCovering g) :
    Sieve.ofArrows (fun i ↦ (C i).unop) (fun i ↦ (g i).unop) ∈
      Scheme.AffineEtale.topology (Spec A) B.unop :=
  ((isCovering_iff_mem_topology g).1 hg).2

end EtaleCategory

end AlgebraicGeometry
