module

public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.AlgebraicGeometry.Spec
public import Mathlib.Analysis.Complex.Basic
public import Weil.Attr
public import Weil.Definitions

/-!
# The analytic topology on the complex points of a scheme

Let `Y` be a scheme over `ℂ` with structure morphism `y : Y ⟶ Spec ℂ`. Its set of complex points
`Y(ℂ)` is the set of sections `p : Spec ℂ ⟶ Y` of `y`. For an open `U` of `Y`, a point `p` lies
in `U(ℂ)` when its image (a single point of `Y`) lies in `U`, and then a regular function
`g ∈ Γ(Y, U)` has a value `g(p) ∈ ℂ`, the image of `g` under `p^* : Γ(Y, U) → Γ(Spec ℂ, ⊤) ≅ ℂ`.

The *analytic topology* on `Y(ℂ)` is the coarsest topology for which every `U(ℂ)`, `U` an affine
open of `Y`, is open, and every regular function `g` on an affine open `U` is continuous as a
function `U(ℂ) → ℂ`. It is generated by the sets `{p ∈ U(ℂ) | g(p) ∈ V}` for `U` an affine
open, `g ∈ Γ(Y, U)` and `V ⊆ ℂ` open. This is the underlying topological space of the
analytification `Y_an` of a scheme locally of finite type over `ℂ`.

## Main definitions

The complex points `AlgebraicGeometry.Scheme.ComplexPoints`, the value
`AlgebraicGeometry.Scheme.ComplexPoints.eval` of a regular function at a complex point and the
analytic topology `AlgebraicGeometry.Scheme.ComplexPoints.instTopologicalSpace` are defined in
`Weil.Definitions`, which collects the definitions entering the statements of the Weil
conjectures.

## Main results

* `AlgebraicGeometry.Scheme.ComplexPoints.mem_iff`: `p ∈ U(ℂ)` iff the image of the point of
  `Spec ℂ` lies in `U`.
* `AlgebraicGeometry.Scheme.ComplexPoints.isOpen_setOf_mem`: `U(ℂ)` is open for every open `U`.
* `AlgebraicGeometry.Scheme.ComplexPoints.continuous_eval`: a regular function on an affine
  open `U` is continuous on `U(ℂ)`.
* `AlgebraicGeometry.Scheme.ComplexPoints.continuous_iff`: a map into `Y(ℂ)` is continuous iff
  the preimage of every generating set is open.

## Implementation notes

Only the topological space is defined here, not the analytification as a complex space (which
also carries the sheaf of holomorphic functions). The topology is defined for every scheme over
`ℂ`; for `Y` locally of finite type over `ℂ` it is the classical one.

## References

* [FK] E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, Chapter I, §11.
* [SGA1] A. Grothendieck, *Revêtements étales et groupe fondamental*, Exposé XII, §1.
-/

@[expose] public section

open CategoryTheory TopologicalSpace

namespace AlgebraicGeometry.Scheme

namespace ComplexPoints

variable {Y : Scheme.{0}} {y : Y ⟶ Spec (.of ℂ)}

@[ext]
theorem ext {p q : ComplexPoints y} (h : p.hom = q.hom) : p = q := Subtype.ext h

@[simp]
theorem hom_comp (p : ComplexPoints y) : p.hom ≫ y = 𝟙 _ := p.2

theorem isOpen_basicSet {U : Y.Opens} (hU : IsAffineOpen U) (g : Γ(Y, U)) {V : Set ℂ}
    (hV : IsOpen V) : IsOpen (basicSet (y := y) U g V) :=
  TopologicalSpace.GenerateOpen.basic _ ⟨U, hU, g, V, hV, rfl⟩

/-- A map into `Y(ℂ)` is continuous iff the preimage of every generating set
`{p ∈ U(ℂ) | g(p) ∈ V}` is open. -/
theorem continuous_iff {X : Type*} [TopologicalSpace X] {f : X → ComplexPoints y} :
    Continuous f ↔ ∀ (U : Y.Opens), IsAffineOpen U → ∀ (g : Γ(Y, U)) (V : Set ℂ), IsOpen V →
      IsOpen (f ⁻¹' basicSet U g V) := by
  rw [continuous_generateFrom_iff]
  constructor
  · intro h U hU g V hV
    exact h _ ⟨U, hU, g, V, hV, rfl⟩
  · rintro h _ ⟨U, hU, g, V, hV, rfl⟩
    exact h U hU g V hV

/-- A complex point lies in `U(ℂ)` iff the image of the unique point of `Spec ℂ` lies in `U`. -/
theorem mem_iff {p : ComplexPoints y} {U : Y.Opens} (x : Spec (.of ℂ)) :
    p.Mem U ↔ p.hom.base x ∈ U := by
  have : Subsingleton (Spec (.of ℂ)) := inferInstanceAs (Subsingleton (PrimeSpectrum ℂ))
  constructor
  · intro h
    have : x ∈ p.hom ⁻¹ᵁ U := by rw [h]; trivial
    exact this
  · intro h
    refine eq_top_iff.2 fun z _ => ?_
    rw [Subsingleton.elim z x]
    exact h

/-- With `V = ℂ`, the set `{p ∈ U(ℂ) | g(p) ∈ V}` is `U(ℂ)`. -/
theorem basicSet_univ (U : Y.Opens) (g : Γ(Y, U)) :
    basicSet (y := y) U g Set.univ = {p | p.Mem U} := by
  ext p; simp [basicSet]

/-- `U(ℂ)` is open for every affine open `U`. -/
theorem isOpen_setOf_mem_of_isAffineOpen {U : Y.Opens} (hU : IsAffineOpen U) :
    IsOpen {p : ComplexPoints y | p.Mem U} := by
  rw [← basicSet_univ U 0]
  exact isOpen_basicSet hU 0 isOpen_univ

/-- `U(ℂ)` is open for every open `U` of `Y`. -/
theorem isOpen_setOf_mem (U : Y.Opens) : IsOpen {p : ComplexPoints y | p.Mem U} := by
  have : {p : ComplexPoints y | p.Mem U} =
      ⋃ (V : Y.affineOpens) (_ : (V : Y.Opens) ≤ U), {p : ComplexPoints y | p.Mem V} := by
    ext p
    obtain ⟨x⟩ : Nonempty (Spec (.of ℂ)) := inferInstance
    simp only [Set.mem_ofPred_eq, Set.mem_iUnion, mem_iff x]
    constructor
    · intro h
      obtain ⟨V, hV, hxV, hVU⟩ :=
        (Opens.isBasis_iff_nbhd.1 Y.isBasis_affineOpens) h
      exact ⟨⟨V, hV⟩, hVU, hxV⟩
    · rintro ⟨V, hVU, h⟩
      exact hVU h
  rw [this]
  exact isOpen_iUnion fun V => isOpen_iUnion fun _ => isOpen_setOf_mem_of_isAffineOpen V.2

/-- A regular function `g` on an affine open `U` is continuous as a function `U(ℂ) → ℂ`. -/
theorem continuous_eval {U : Y.Opens} (hU : IsAffineOpen U) (g : Γ(Y, U)) :
    Continuous fun p : {p : ComplexPoints y // p.Mem U} => eval g p.1 p.2 := by
  rw [continuous_def]
  intro V hV
  convert (isOpen_basicSet (y := y) hU g hV).preimage continuous_subtype_val using 1
  ext p
  exact ⟨fun h => ⟨p.2, h⟩, fun ⟨_, h⟩ => h⟩

end ComplexPoints

end AlgebraicGeometry.Scheme
