module

public import Weil.Attr
public import StacksFrontier.Algebra.Homology.DerivedCategory.Ext.Basic

/-!
# Yoneda extension classes

Let `𝒜` be an abelian category, `B`, `A` objects of `𝒜` and `n : ℕ`. A Yoneda extension of `B`
by `A` of degree `n + 1` is an exact sequence `0 → A → Z_n → ⋯ → Z_0 → B → 0`
(`CategoryTheory.Abelian.YonedaExtension B A n`). A *dominance* `E' → E` between two of them is
a morphism of the middle terms which, together with the identities of `A` and `B`, forms a
commutative diagram. The set `YExt^{n+1}(B, A)` of *Yoneda extension classes* is the quotient
of the extensions by the equivalence relation generated by dominance.

The equivalence relation generated by dominance is the relation
`CategoryTheory.Abelian.YonedaExtension.Equivalent` of being dominated by a common extension:
the latter is an equivalence relation, because two extensions are related by it exactly when
they have the same class in `Ext^{n+1}(B, A)`. Consequently the class map induces a bijection
from `YExt^{n+1}(B, A)` onto `Ext^{n+1}(B, A)`.

## Main definitions

* `CategoryTheory.Abelian.YonedaExtension.Dominates E' E`: there is a dominance `E' → E`.
* `CategoryTheory.Abelian.YonedaExt B A n`: the Yoneda extension classes of degree `n + 1`.
* `CategoryTheory.Abelian.YonedaExt.extClass`: the class map `YExt^{n+1}(B, A) → Ext^{n+1}(B, A)`.

## Main results

* `CategoryTheory.Abelian.YonedaExtension.eqvGen_dominates_iff_equivalent`: the equivalence
  relation generated by dominance is `YonedaExtension.Equivalent`.
* `CategoryTheory.Abelian.YonedaExt.mk_eq_mk_iff`: two extensions have the same class in
  `YExt` if and only if they are equivalent.
* `CategoryTheory.Abelian.YonedaExt.extClass_bijective`: the class map is bijective.

## Implementation notes

The degree is written `n + 1` with `n : ℕ`, as for `YonedaExtension`, so that the degree `p ≥ 1`
of a `p`-extension is built into the indexing: `YExt^p(F, G)` is `YonedaExt F G (p - 1)`.
The argument order is that of `Ext`: `YonedaExt B A n` consists of extensions
`0 → A → ⋯ → B → 0`, whose classes live in `Ext B A (n + 1)`.

## References

* [FK] E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, I.4.
* [Stacks] Tag 06XT, Tag 06XU.
-/

@[expose] public section

universe w u v

namespace CategoryTheory

namespace Abelian

open ComposableArrows

variable {𝒜 : Type u} [Category.{v} 𝒜] [Abelian 𝒜] {B A : 𝒜} {n : ℕ}

namespace YonedaExtension

/-- A *dominance* `E' → E` between two Yoneda extensions of `B` by `A` is a morphism of their
middle terms compatible with the maps from `A` and the maps to `B`; `E'.Dominates E` says that
one exists. -/
def Dominates (E' E : YonedaExtension B A n) : Prop :=
  ∃ φ : E'.Z ⟶ E.Z, E'.f ≫ app' φ 0 = E.f ∧ app' φ n ≫ E.g = E'.g

lemma Dominates.refl (E : YonedaExtension B A n) : E.Dominates E :=
  ⟨𝟙 _, Category.comp_id _, Category.id_comp _⟩

lemma Dominates.trans {E E' E'' : YonedaExtension B A n} (h₁ : E.Dominates E')
    (h₂ : E'.Dominates E'') : E.Dominates E'' := by
  obtain ⟨φ, hφ₁, hφ₂⟩ := h₁
  obtain ⟨ψ, hψ₁, hψ₂⟩ := h₂
  refine ⟨φ ≫ ψ, ?_, ?_⟩
  · change E.f ≫ (app' φ 0 ≫ app' ψ 0) = _
    rw [← Category.assoc, hφ₁, hψ₁]
  · change (app' φ n ≫ app' ψ n) ≫ _ = _
    rw [Category.assoc, hψ₂, hφ₂]

lemma Dominates.equivalent {E' E : YonedaExtension B A n} (h : E'.Dominates E) :
    E'.Equivalent E := by
  obtain ⟨φ, hφ₁, hφ₂⟩ := h
  exact ⟨E', 𝟙 _, φ, Category.comp_id _, Category.id_comp _, hφ₁, hφ₂⟩

/-- `YonedaExtension.Equivalent` is an equivalence relation: two extensions are equivalent if
and only if they have the same class in `Ext`. -/
lemma equivalent_equivalence : _root_.Equivalence (@Equivalent 𝒜 _ _ B A n) := by
  have : HasExt.{max u v} 𝒜 := HasExt.standard 𝒜
  have key : ∀ E E' : YonedaExtension B A n,
      E.Equivalent E' ↔ extClassMap.{max u v} n E = extClassMap.{max u v} n E' := fun E E' =>
    ⟨extClassMap_eq_of_equivalent, equivalent_of_extClassMap_eq E E'⟩
  refine ⟨fun E => (key E E).2 rfl, fun h => ?_, fun h₁ h₂ => ?_⟩
  · rw [key] at h ⊢; exact h.symm
  · rw [key] at h₁ h₂ ⊢; exact h₁.trans h₂

/-- The equivalence relation generated by dominance is `YonedaExtension.Equivalent`, the
relation of being dominated by a common extension. -/
theorem eqvGen_dominates_iff_equivalent (E E' : YonedaExtension B A n) :
    Relation.EqvGen Dominates E E' ↔ E.Equivalent E' := by
  constructor
  · intro h
    induction h with
    | rel _ _ h => exact h.equivalent
    | refl E => exact equivalent_equivalence.refl E
    | symm _ _ _ ih => exact equivalent_equivalence.symm ih
    | trans _ _ _ _ _ ih₁ ih₂ => exact equivalent_equivalence.trans ih₁ ih₂
  · rintro ⟨E'', φ, ψ, hφ₁, hφ₂, hψ₁, hψ₂⟩
    exact Relation.EqvGen.trans _ _ _
      (Relation.EqvGen.symm _ _ (Relation.EqvGen.rel _ _ ⟨φ, hφ₁, hφ₂⟩))
      (Relation.EqvGen.rel _ _ ⟨ψ, hψ₁, hψ₂⟩)

/-- The setoid on Yoneda extensions of `B` by `A` of degree `n + 1` given by
`YonedaExtension.Equivalent`, the equivalence relation generated by dominance. -/
def setoid (B A : 𝒜) (n : ℕ) : Setoid (YonedaExtension B A n) :=
  ⟨Equivalent, equivalent_equivalence⟩

end YonedaExtension

variable (B A n) in
/-- The set `YExt^{n+1}(B, A)` of *Yoneda extension classes* of degree `n + 1` of `B` by `A`:
the Yoneda extensions `0 → A → Z_n → ⋯ → Z_0 → B → 0` modulo the equivalence relation
generated by dominance. -/
@[weil "def_fk104_yoneda_extension_classes"]
def YonedaExt : Type _ :=
  Quot (@YonedaExtension.Dominates 𝒜 _ _ B A n)

namespace YonedaExt

/-- The class of a Yoneda extension in `YExt`. -/
def mk (E : YonedaExtension B A n) : YonedaExt B A n := Quot.mk _ E

lemma mk_surjective : Function.Surjective (mk : YonedaExtension B A n → YonedaExt B A n) :=
  Quot.mk_surjective

/-- Two Yoneda extensions have the same class if and only if they are linked by a chain of
dominances. -/
lemma mk_eq_mk_iff_eqvGen {E E' : YonedaExtension B A n} :
    mk E = mk E' ↔ Relation.EqvGen YonedaExtension.Dominates E E' :=
  ⟨Quot.eqvGen_exact, Quot.eqvGen_sound⟩

/-- Two Yoneda extensions have the same class if and only if they are dominated by a common
extension. -/
theorem mk_eq_mk_iff {E E' : YonedaExtension B A n} : mk E = mk E' ↔ E.Equivalent E' :=
  mk_eq_mk_iff_eqvGen.trans (YonedaExtension.eqvGen_dominates_iff_equivalent E E')

lemma mk_eq_mk_of_dominates {E' E : YonedaExtension B A n} (h : E'.Dominates E) :
    mk E' = mk E :=
  Quot.sound h

/-- `YExt^{n+1}(B, A)` is the quotient by the setoid `YonedaExtension.setoid`. -/
def equivQuotient : YonedaExt B A n ≃ _root_.Quotient (YonedaExtension.setoid B A n) where
  toFun := Quot.lift (fun E => _root_.Quotient.mk _ E) fun _ _ h =>
    _root_.Quotient.sound h.equivalent
  invFun := _root_.Quotient.lift mk fun _ _ h => mk_eq_mk_iff.2 h
  left_inv x := by induction x using Quot.ind; rfl
  right_inv x := by induction x using _root_.Quotient.ind; rfl

@[simp]
lemma equivQuotient_mk (E : YonedaExtension B A n) :
    equivQuotient (mk E) = _root_.Quotient.mk _ E := rfl

variable [HasExt.{w} 𝒜]

/-- The class map `YExt^{n+1}(B, A) → Ext^{n+1}(B, A)` induced by `extClassMap`. -/
noncomputable def extClass : YonedaExt B A n → Ext.{w} B A (n + 1) :=
  Quot.lift (fun E => extClassMap.{w} n E) fun _ _ h => extClassMap_eq_of_equivalent h.equivalent

@[simp]
lemma extClass_mk (E : YonedaExtension B A n) : extClass.{w} (mk E) = extClassMap.{w} n E := rfl

lemma extClass_injective : Function.Injective (extClass.{w} : YonedaExt B A n → _) := by
  intro x y h
  obtain ⟨E, rfl⟩ := mk_surjective x
  obtain ⟨E', rfl⟩ := mk_surjective y
  exact mk_eq_mk_iff.2 (equivalent_of_extClassMap_eq E E' h)

lemma extClass_surjective : Function.Surjective (extClass.{w} : YonedaExt B A n → _) := by
  intro x
  obtain ⟨E, rfl⟩ := surjective_extClassMap.{w} B A n x
  exact ⟨mk E, rfl⟩

/-- The class map is a bijection `YExt^{n+1}(B, A) ≃ Ext^{n+1}(B, A)`. -/
theorem extClass_bijective : Function.Bijective (extClass.{w} : YonedaExt B A n → _) :=
  ⟨extClass_injective, extClass_surjective⟩

/-- The bijection `YExt^{n+1}(B, A) ≃ Ext^{n+1}(B, A)` given by the class map. -/
noncomputable def extClassEquiv : YonedaExt B A n ≃ Ext.{w} B A (n + 1) :=
  Equiv.ofBijective _ extClass_bijective

@[simp]
lemma extClassEquiv_apply (x : YonedaExt B A n) : extClassEquiv.{w} x = extClass.{w} x := rfl

end YonedaExt

end Abelian

end CategoryTheory
