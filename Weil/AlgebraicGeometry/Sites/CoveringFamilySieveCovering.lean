module

public import Weil.Attr
public import Weil.AlgebraicGeometry.Sites.Etale

/-!
# The sieve generated by an étale covering covers

Let `(φᵢ : Uᵢ ⟶ U)_{i ∈ I}` be a family of morphisms of the small étale site of `X` which is an
étale covering of `U` (a finite, jointly surjective family of étale morphisms). The class
`S_φ` of morphisms `g : W ⟶ U` of the site which factor as `g = g' ≫ φᵢ` for some `i` and some
`g' : W ⟶ Uᵢ` is the sieve `CategoryTheory.Sieve.ofArrows _ φ`, and it is a covering sieve
of `U` [FK, I.2].

## Main results

* `AlgebraicGeometry.Scheme.ofArrows_apply_iff_exists_eq_comp`: the arrows of
  `Sieve.ofArrows _ φ` are those factoring through some `φᵢ`.
* `AlgebraicGeometry.Scheme.IsEtaleCovering.ofArrows_mem_smallEtaleTopology`: the sieve
  generated by an étale covering covers in the small étale topology.

## Implementation notes

The étale site is Mathlib's `X.Etale` with `X.smallEtaleTopology`; FK's covering sieves are
its covering sieves by
`AlgebraicGeometry.Scheme.mem_smallEtaleTopology_iff_forall_exists_isEtaleCovering`.
FK's proof checks the defining condition through base change of the covering along every
`h : U' ⟶ U`; here the statement follows directly from the description of covering sieves of
`X.smallEtaleTopology` by jointly surjective families.

## References

* [FK] E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, I.2.
-/

@[expose] public section

universe u

open CategoryTheory

namespace AlgebraicGeometry.Scheme

variable {X : Scheme.{u}} {U : X.Etale} {ι : Type*} {V : ι → X.Etale}

/-- A morphism `g : W ⟶ U` lies in the sieve generated by the family `φ` if and only if
`g = g' ≫ φ i` for some `i` and some `g' : W ⟶ V i`. -/
lemma ofArrows_apply_iff_exists_eq_comp (φ : ∀ i, V i ⟶ U) {W : X.Etale} (g : W ⟶ U) :
    Sieve.ofArrows V φ g ↔ ∃ (i : ι) (g' : W ⟶ V i), g = g' ≫ φ i := by
  constructor
  · rintro ⟨Y, a, b, ⟨i⟩, rfl⟩
    exact ⟨i, a, rfl⟩
  · rintro ⟨i, g', rfl⟩
    exact Sieve.downward_closed _ (Sieve.ofArrows_mk V φ i) g'

/-- **The sieve of an étale covering covers** [FK, I.2]. If a family `(φᵢ : Vᵢ ⟶ U)ᵢ` of
morphisms of the small étale site of `X` is an étale covering of `U`, then the sieve
`S_φ = Sieve.ofArrows V φ` of morphisms `g = g' ≫ φᵢ` factoring through some `φᵢ` (see
`ofArrows_apply_iff_exists_eq_comp`) is a covering sieve of `U`. -/
@[weil "lem_fk102_covering_family_sieve_covering"]
theorem IsEtaleCovering.ofArrows_mem_smallEtaleTopology {φ : ∀ i, V i ⟶ U}
    (hφ : IsEtaleCovering fun i ↦ (φ i).left) :
    Sieve.ofArrows V φ ∈ X.smallEtaleTopology U :=
  have := hφ.finite
  (isEtaleCovering_left_iff_ofArrows_mem_smallEtaleTopology φ).1 hφ

end AlgebraicGeometry.Scheme

end
