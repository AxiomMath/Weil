module

public import Weil.Attr
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.SmoothBaseChange.LocalAcyclicity.StrictHenselizationCohomologyIso
public import StacksFrontier.AlgebraicGeometry.Topologies.Etale.Existence
public import Weil.AlgebraicGeometry.FunctionField

/-!
# Higher direct images along the generic point have zero generic stalk

Let `X` be an integral scheme with function field `K`, let `η : Spec K ⟶ X` be the canonical
morphism onto the generic point and `η̄ : Spec K^sep ⟶ X` the generic geometric point. For every
abelian sheaf `G` on the small étale site of `Spec K`,

`(R^q η_* G)_η̄ = 0` for every `q > 0`.

By Stacks 03Q9, `(R^q η_* G)_η̄ = H^q(Spec K ×_X Spec 𝒪^{sh}_{X,η̄}, G)`. The strict henselization
of the field `𝒪_{X,η} = K` is a field (its maximal ideal is generated by that of `K`) whose residue
field is a separable closure of `K`. Since `Spec 𝒪^{sh}_{X,η̄} ⟶ X` factors through the
monomorphism `η`, the fibre product is `Spec 𝒪^{sh}_{X,η̄}`, the spectrum of a separably closed
field, whose higher étale cohomology vanishes.

## Main results

* `AlgebraicGeometry.Scheme.isZero_stalk_rightDerived_genericPointInclusion`: the stalk at the
  generic geometric point `η̄` of `R^q η_* G` vanishes for `q > 0`.
* `AlgebraicGeometry.Scheme.isZero_stalk_rightDerived_genericPointInclusion_genericGeometricPoint`:
  the same at the algebraically closed generic geometric point `Spec K̄ ⟶ X`.

## Implementation notes

The statement is on Mathlib's small étale site `AlgebraicGeometry.Scheme.smallEtaleTopology`, with
coefficients in `AddCommGrpCat.{u + 1}`, where the higher direct images are the right derived
functors of `Stacks.EtaleCohomology.smallEtalePushforwardAb` and Stacks 03Q9 is available
(`Stacks.EtaleCohomology.stalkRightDerivedPushforwardIsoStrictHenselization`).

The source assumes `X` noetherian and separated and `G` torsion; none of this is needed. The source
computes the stalk as the colimit of `H^q(U_K, G)` over the étale neighbourhoods `U` of `η̄`, which
is `H^q(Spec K^sep, G)` because cohomology commutes with projective limits; here that colimit is
the content of Stacks 03Q9, and the limit `Spec K ×_X Spec 𝒪^{sh}_{X,η̄}` is identified directly.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][freitagkiehl1988], I.5
* [Stacks Project, Tag 03Q9](https://stacks.math.columbia.edu/tag/03Q9)
-/

/- FK's hypotheses (noetherian, separated, `G` torsion) are
dropped: the statement is stronger than FK's. Stated on Mathlib's site `Scheme.smallEtaleTopology`
because Stacks 03Q9 is available there; no SmallEtale bridge for higher direct images exists. -/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing
open Stacks.EtaleCohomology

universe u

namespace AlgebraicGeometry.Scheme

attribute [local instance] HasDerivedCategory.standard

variable (X : Scheme.{u}) [IsIntegral X]

/-- The local ring of an integral scheme at a point equal to the generic point is a field. -/
lemma isField_stalk_of_eq_genericPoint (x : X) (hx : x = genericPoint X) :
    IsField (X.presheaf.stalk x) := by
  subst hx
  exact Field.toIsField X.functionField

section StrictHenselization

variable (B : BigEtaleSite.{u}) (hS : B.Contains X) (s : GeometricPoint X)

/-- The strict henselization of an integral scheme at a geometric point over the generic point is
a field: its maximal ideal is generated by the maximal ideal of the function field, which is
zero. -/
lemma isField_etaleLocalRing_of_liesOver (hs : s.LiesOver (genericPoint X)) :
    IsField (etaleLocalRing B X hS s) := by
  set R := X.presheaf.stalk (s.hom (closedPoint s.residueField))
  have hR : IsField R := isField_stalk_of_eq_genericPoint X _ (by
    rw [← hs]; exact congrArg s.hom (Subsingleton.elim _ _))
  let T := geometricHenselizationTower X s
  have hT : maximalIdeal T.strictHenselization = ⊥ := by
    rw [← IsLocalRing.IsHenselization.map_maximalIdeal (R := R)
      (L := separableClosure (ResidueField R) s.residueField),
      (isField_iff_maximalIdeal_eq).mp hR, Ideal.map_bot]
  exact (etaleLocalRingEquivStrictHenselization B X hS s).symm.toMulEquiv.isField
    ((isField_iff_maximalIdeal_eq).mpr hT)

/-- The residue field of the strict henselization at a geometric point is separably closed. -/
instance isSepClosed_residueField_etaleLocalRing :
    IsSepClosed (ResidueField (etaleLocalRing B X hS s)) := by
  set R := X.presheaf.stalk (s.hom (closedPoint s.residueField))
  let T := geometricHenselizationTower X s
  let κsep := separableClosure (ResidueField R) s.residueField
  have : IsSepClosed κsep := IsSepClosure.sep_closed (ResidueField R)
  let e : κsep ≃+* ResidueField (etaleLocalRing B X hS s) :=
    T.strictHenselizationResidueEquiv.trans
      (ResidueField.mapEquiv (etaleLocalRingEquivStrictHenselization B X hS s))
  let _ : Algebra κsep (ResidueField (etaleLocalRing B X hS s)) := e.toRingHom.toAlgebra
  have : Algebra.IsAlgebraic κsep (ResidueField (etaleLocalRing B X hS s)) := ⟨fun x =>
    (show x = algebraMap κsep _ (e.symm x) by simp [RingHom.algebraMap_toAlgebra]) ▸
      isAlgebraic_algebraMap _⟩
  exact Algebra.IsAlgebraic.isSepClosed (F := κsep)

/-- A geometric point over the generic point lies, through its closed point, over the generic
point. -/
lemma specializes_genericPoint_of_liesOver (hs : s.LiesOver (genericPoint X)) :
    s.hom (closedPoint s.residueField) ⤳ genericPoint X := by
  have h : s.hom (closedPoint s.residueField) = genericPoint X := by
    rw [← hs]; exact congrArg s.hom (Subsingleton.elim _ _)
  rw [h]

/-- At a geometric point over the generic point, the canonical morphism
`Spec 𝒪^{sh}_{X,s} ⟶ X` factors through the inclusion of the generic point. -/
lemma strictHenselizationToBase_eq_comp_genericPointInclusion
    (hs : s.LiesOver (genericPoint X)) :
    strictHenselizationToBase B X hS s =
      (Spec.map (CommRingCat.ofHom (structureSheafStalkFromLocalRing B X hS s)) ≫
        Spec.map (X.presheaf.stalkSpecializes (specializes_genericPoint_of_liesOver X s hs))) ≫
        genericPointInclusion X := by
  rw [Category.assoc, genericPointInclusion, SpecMap_stalkSpecializes_fromSpecStalk]
  rfl

/-- At a geometric point over the generic point, the projection
`Spec K ×_X Spec 𝒪^{sh}_{X,s} ⟶ Spec 𝒪^{sh}_{X,s}` is an isomorphism: the second factor maps
through the monomorphism `Spec K ⟶ X`. -/
lemma isIso_strictHenselizationBaseChangeToStrictHenselization_genericPointInclusion
    (hs : s.LiesOver (genericPoint X)) :
    IsIso (strictHenselizationBaseChangeToStrictHenselization B hS
      (genericPointInclusion X) s) := by
  set t := Spec.map (CommRingCat.ofHom (structureSheafStalkFromLocalRing B X hS s)) ≫
    Spec.map (X.presheaf.stalkSpecializes (specializes_genericPoint_of_liesOver X s hs))
  have ht := strictHenselizationToBase_eq_comp_genericPointInclusion X B hS s hs
  refine ⟨⟨pullback.lift t (𝟙 _) (by rw [Category.id_comp, ← ht]), ?_, pullback.lift_snd _ _ _⟩⟩
  apply pullback.hom_ext
  · rw [Category.assoc, pullback.lift_fst, Category.id_comp]
    rw [← cancel_mono (genericPointInclusion X), Category.assoc, ← ht, pullback.condition]
  · rw [Category.assoc, pullback.lift_snd, Category.comp_id, Category.id_comp]

/-- At a geometric point over the generic point, `Spec K ×_X Spec 𝒪^{sh}_{X,s}` is the spectrum
of the residue field of the strict henselization, a separably closed field. -/
def strictHenselizationBaseChangeGenericPointInclusionIso (hs : s.LiesOver (genericPoint X)) :
    strictHenselizationBaseChange B hS (genericPointInclusion X) s ≅
      Spec (.of (ResidueField (etaleLocalRing B X hS s))) :=
  haveI :=
    isIso_strictHenselizationBaseChangeToStrictHenselization_genericPointInclusion X B hS s hs
  have hbij : Function.Bijective (IsLocalRing.residue (etaleLocalRing B X hS s)) := by
    refine ⟨(injective_iff_map_eq_zero _).mpr fun x hx => ?_, IsLocalRing.residue_surjective⟩
    rwa [IsLocalRing.residue_eq_zero_iff, (isField_iff_maximalIdeal_eq).mp
      (isField_etaleLocalRing_of_liesOver X B hS s hs), Ideal.mem_bot] at hx
  haveI : IsIso (CommRingCat.ofHom (IsLocalRing.residue (etaleLocalRing B X hS s))) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr hbij
  asIso (strictHenselizationBaseChangeToStrictHenselization B hS (genericPointInclusion X) s) ≪≫
    (asIso (Spec.map (CommRingCat.ofHom (IsLocalRing.residue (etaleLocalRing B X hS s))))).symm

end StrictHenselization

/-- **Stacks 03Q9 at a geometric point over the generic point.** For a geometric point `s` of an
integral scheme `X` lying over the generic point and an abelian sheaf `G` on the small étale site of
`Spec K`, `(R^q η_* G)_s = 0` for every `q > 0`, where `η : Spec K ⟶ X` is the inclusion of the
generic point. -/
theorem isZero_stalk_rightDerived_genericPointInclusion_of_liesOver (s : GeometricPoint X)
    (hs : s.LiesOver (genericPoint X))
    (G : Sheaf (smallEtaleTopology (Spec X.functionField)) AddCommGrpCat.{u + 1})
    (q : ℕ) (hq : 0 < q) :
    IsZero ((smallEtaleStalkAb s.hom).obj
      (((smallEtalePushforwardAb (genericPointInclusion X)).rightDerived q).obj G)) := by
  let B : BigEtaleSite.{u} := BigEtaleSite.ofSet {X}
  have hS : B.Contains X := BigEtaleSite.contains_ofSet _ (Set.mem_singleton X)
  let φ := strictHenselizationBaseChangeGenericPointInclusionIso X B hS s hs
  let a := strictHenselizationBaseChangeToSource B hS (genericPointInclusion X) s
  let a' := φ.inv ≫ a
  have hφ : φ.hom ≫ a' = a := φ.hom_inv_id_assoc a
  refine (isZero_homology_smallEtaleDerivedGlobalSections_single_of_isSepClosed
    (ResidueField (etaleLocalRing B X hS s)) ((smallEtalePullbackAb a').obj G) q hq).of_iso
      (stalkRightDerivedPushforwardIsoStrictHenselization B hS (genericPointInclusion X) s G q ≪≫
        homologyDerivedSectionsPullbackIsoOfIso φ hφ _ _ ≪≫ ?_)
  exact (DerivedCategory.homologyFunctor _ (q : ℤ)).mapIso
    ((smallEtaleDerivedGlobalSections _).mapIso
      (((smallEtalePullbackAb a').mapDerivedCategorySingleFunctor 0).app G))

/-- **The stalk at the generic geometric point of a higher direct image along the generic point
vanishes.** Let `X` be an integral scheme with function field `K`, `η : Spec K ⟶ X` the inclusion
of the generic point and `Spec K̄ ⟶ X` the generic geometric point, `K̄` an algebraic closure of
`K`. For every abelian sheaf `G` on the small étale site of `Spec K`, `(R^q η_* G)_η̄ = 0` for every
`q > 0`. -/
@[weil "lem_fk105_generic_point_direct_image_stalk"]
theorem isZero_stalk_rightDerived_genericPointInclusion_genericGeometricPoint
    (G : Sheaf (smallEtaleTopology (Spec X.functionField)) AddCommGrpCat.{u + 1})
    (q : ℕ) (hq : 0 < q) :
    IsZero ((smallEtaleStalkAb (genericGeometricPoint X).hom).obj
      (((smallEtalePushforwardAb (genericPointInclusion X)).rightDerived q).obj G)) :=
  isZero_stalk_rightDerived_genericPointInclusion_of_liesOver X _
    (genericGeometricPoint_liesOver X) G q hq

/-- **The stalk at the generic geometric point of a higher direct image along the generic point
vanishes.** Let `X` be an integral scheme with function field `K`, `η : Spec K ⟶ X` the inclusion
of the generic point and `η̄ : Spec K^sep ⟶ X` the generic geometric point. For every abelian sheaf
`G` on the small étale site of `Spec K`, `(R^q η_* G)_η̄ = 0` for every `q > 0`. -/
@[weil "lem_fk105_generic_point_direct_image_stalk"]
theorem isZero_stalk_rightDerived_genericPointInclusion
    (G : Sheaf (smallEtaleTopology (Spec X.functionField)) AddCommGrpCat.{u + 1})
    (q : ℕ) (hq : 0 < q) :
    IsZero ((smallEtaleStalkAb (genericSepClosedPoint X)).obj
      (((smallEtalePushforwardAb (genericPointInclusion X)).rightDerived q).obj G)) := by
  let e := pointSmallEtaleGenericIso X
  let F := ((smallEtalePushforwardAb (genericPointInclusion X)).rightDerived q).obj G
  refine (isZero_stalk_rightDerived_genericPointInclusion_genericGeometricPoint X G q hq).of_iso
    { hom := (GrothendieckTopology.Point.Hom.sheafFiber e.hom).app F
      inv := (GrothendieckTopology.Point.Hom.sheafFiber e.inv).app F
      hom_inv_id := ?_
      inv_hom_id := ?_ }
  · rw [← NatTrans.comp_app, ← GrothendieckTopology.Point.Hom.sheafFiber_comp, e.inv_hom_id,
      GrothendieckTopology.Point.Hom.sheafFiber_id, NatTrans.id_app]
  · rw [← NatTrans.comp_app, ← GrothendieckTopology.Point.Hom.sheafFiber_comp, e.hom_inv_id,
      GrothendieckTopology.Point.Hom.sheafFiber_id, NatTrans.id_app]

end AlgebraicGeometry.Scheme

