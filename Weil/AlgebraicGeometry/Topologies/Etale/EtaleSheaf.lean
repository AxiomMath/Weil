module

public import Weil.Attr
public import Weil.Defs.AlgebraicGeometry.Topologies.Etale.EtaleSheaf

/-!
# Filtered colimits of étale sheaves of sets

Let `S` be a locally noetherian scheme and `(𝒢_λ)_λ` a filtered system of étale sheaves of sets
on the étale category `Et(S)` of noetherian separated étale `S`-schemes. The presheaf
`P : U ↦ colim_λ 𝒢_λ(U)` is again a sheaf, and with the canonical maps `𝒢_λ ⟶ P` it is the
colimit of `(𝒢_λ)` in the category of étale sheaves of sets. In other words, taking sections
over an object of `Et(S)` commutes with filtered colimits of étale sheaves of sets.

The reason is that the sheaf condition on `Et(S)` only involves finite coverings: for a finite
family `πᵢ : Xᵢ ⟶ B` with pairwise fibre products, the sheaf condition for the presieve it
generates is a finite limit condition, and filtered colimits of sets commute with finite
limits.

## Main results

* `CategoryTheory.Presieve.isSheafFor_colimit_ofArrows`: a filtered colimit of presheaves of
  sets which are sheaves for the presieve generated by a finite family with pairwise fibre
  products is a sheaf for that presieve.
* `AlgebraicGeometry.EtaleSheaf.isSheaf_colimit_sheafToPresheaf`: the presheaf colimit of a
  filtered system of étale sheaves of sets on `Et(S)` is an étale sheaf.
* `AlgebraicGeometry.EtaleSheaf.filteredColimitCocone`,
  `AlgebraicGeometry.EtaleSheaf.isColimitFilteredColimitCocone`: that sheaf, with the canonical
  maps, is a colimit in the category of étale sheaves of sets.
* `AlgebraicGeometry.EtaleSheaf.preservesColimitsOfShape_sheafToPresheaf`: the forgetful functor
  from étale sheaves of sets to presheaves preserves filtered colimits.

## Implementation notes

The presheaf `P` is the colimit of the underlying presheaves in the functor category, whose
value at `U` is the colimit of the sections `𝒢_λ(U)`
(`CategoryTheory.Limits.colimitObjIsoColimitCompEvaluation`). Freitag–Kiehl assume the base
noetherian and separated; only local noetherianity is used, through the description of the
topology of `Et(S)` by finite coverings
(`AlgebraicGeometry.SmallNoetherianSeparatedEtale.topology_eq_toGrothendieck_finiteCoverage`).

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, I.4, p. 48][FreitagKiehl]
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe w w' v v₁ u₁ u

namespace CategoryTheory.Presieve

variable {C : Type u₁} [Category.{v₁} C] {J : Type w} [Category.{w'} J] [IsFiltered J]

/-- In a filtered category, finitely many objects admit morphisms to a common object. -/
lemma _root_.CategoryTheory.IsFiltered.exists_nonempty_hom_of_finite {ι : Type*} [Finite ι]
    (j : ι → J) : ∃ k, ∀ i, Nonempty (j i ⟶ k) := by
  classical
  cases nonempty_fintype ι
  obtain ⟨k, hk⟩ := IsFiltered.sup_objs_exists (Finset.univ.image j)
  exact ⟨k, fun i ↦ hk (Finset.mem_image_of_mem _ (Finset.mem_univ i))⟩

variable [HasColimitsOfShape J (Type v)] (G : J ⥤ Cᵒᵖ ⥤ Type v)

/-- Sections of the colimit presheaf at `U` form a colimit of the sections at `U`. -/
private def isColimitApp (U : Cᵒᵖ) :
    IsColimit (((evaluation Cᵒᵖ (Type v)).obj U).mapCocone (colimit.cocone G)) :=
  isColimitOfPreserves _ (colimit.isColimit G)

omit [IsFiltered J] in
private lemma colimit_map_ι_app {U V : Cᵒᵖ} (f : U ⟶ V) (j : J) (x : (G.obj j).obj U) :
    (colimit G).map f ((colimit.ι G j).app U x) = (colimit.ι G j).app V ((G.obj j).map f x) :=
  (NatTrans.naturality_apply (colimit.ι G j) f x).symm

omit [IsFiltered J] in
private lemma ι_app_map {j k : J} (g : j ⟶ k) (U : Cᵒᵖ) (x : (G.obj j).obj U) :
    (colimit.ι G k).app U ((G.map g).app U x) = (colimit.ι G j).app U x := by
  rw [← NatTrans.comp_app_apply, colimit.w]

/-- Every finite family of sections of the colimit presheaf comes from a single index. -/
private lemma exists_index_of_finite {ι : Type*} [Finite ι] (U : ι → Cᵒᵖ)
    (x : ∀ i, (colimit G).obj (U i)) :
    ∃ (k : J) (a : ∀ i, (G.obj k).obj (U i)), ∀ i, (colimit.ι G k).app (U i) (a i) = x i := by
  have h i := Types.jointly_surjective_of_isColimit (isColimitApp G (U i)) (x i)
  choose j a ha using h
  obtain ⟨k, hk⟩ := IsFiltered.exists_nonempty_hom_of_finite j
  refine ⟨k, fun i ↦ (G.map (hk i).some).app _ (a i), fun i ↦ ?_⟩
  rw [ι_app_map]
  exact ha i

/-- Two sections at index `k` of the colimit presheaf which agree in the colimit after finitely
many restrictions agree after those restrictions at a single later index. -/
private lemma exists_hom_of_finite {ι : Type*} [Finite ι] {k : J} (U : ι → Cᵒᵖ)
    (a b : ∀ i, (G.obj k).obj (U i))
    (h : ∀ i, (colimit.ι G k).app (U i) (a i) = (colimit.ι G k).app (U i) (b i)) :
    ∃ (m : J) (f : k ⟶ m), ∀ i, (G.map f).app (U i) (a i) = (G.map f).app (U i) (b i) := by
  have h' i := (Types.FilteredColimit.isColimit_eq_iff' (isColimitApp G (U i)) _ _).mp (h i)
  choose j g hg using h'
  obtain ⟨m, f, e, he⟩ := IsFiltered.wideSpan g
  refine ⟨m, f, fun i ↦ ?_⟩
  rw [← he i, Functor.map_comp, NatTrans.comp_app, types_comp_apply, types_comp_apply]
  exact congrArg _ (hg i)

variable {B : C} {ι : Type*} [Finite ι] {X : ι → C} (π : ∀ i, X i ⟶ B)
  [(ofArrows X π).HasPairwisePullbacks]

/-- **Sheaves for a finite presieve are stable under filtered colimits.** A filtered colimit of
presheaves of sets, each a sheaf for the presieve generated by a finite family with pairwise
fibre products, is a sheaf for that presieve: the sheaf condition is a finite limit
condition, and filtered colimits of sets commute with finite limits. -/
theorem isSheafFor_colimit_ofArrows (h : ∀ j, IsSheafFor (G.obj j) (ofArrows X π)) :
    IsSheafFor (colimit G) (ofArrows X π) := by
  rw [isSheafFor_ofArrows_iff_bijective_toPullbackCompatible]
  have hb j := (isSheafFor_ofArrows_iff_bijective_toPullbackCompatible (G.obj j) π).mp (h j)
  constructor
  · intro s t hst
    obtain ⟨k₀, ab, hab⟩ := exists_index_of_finite G (fun _ : Fin 2 ↦ op B) ![s, t]
    have hs : (colimit.ι G k₀).app _ (ab 0) = s := hab 0
    have ht : (colimit.ι G k₀).app _ (ab 1) = t := hab 1
    have hst' i : (colimit.ι G k₀).app _ ((G.obj k₀).map (π i).op (ab 0)) =
        (colimit.ι G k₀).app _ ((G.obj k₀).map (π i).op (ab 1)) := by
      rw [← colimit_map_ι_app, ← colimit_map_ι_app, hs, ht]
      exact congrFun (congrArg Subtype.val hst) i
    obtain ⟨m, f, hf⟩ := exists_hom_of_finite G (fun i ↦ op (X i)) _ _ hst'
    have hm : (G.map f).app _ (ab 0) = (G.map f).app _ (ab 1) := by
      apply (hb m).1
      ext i
      simp only [Arrows.toPullbackCompatible_coe]
      rw [← NatTrans.naturality_apply, ← NatTrans.naturality_apply]
      exact hf i
    rw [← hs, ← ht, ← ι_app_map G f, ← ι_app_map G f, hm]
  · rintro ⟨x, hx⟩
    obtain ⟨k, a, ha⟩ := exists_index_of_finite G (fun i ↦ op (X i)) x
    have hc (p : ι × ι) : (colimit.ι G k).app _
        ((G.obj k).map (pullback.fst (π p.1) (π p.2)).op (a p.1)) =
        (colimit.ι G k).app _ ((G.obj k).map (pullback.snd (π p.1) (π p.2)).op (a p.2)) := by
      rw [← colimit_map_ι_app, ← colimit_map_ι_app, ha, ha]
      exact hx p.1 p.2
    obtain ⟨m, f, hf⟩ := exists_hom_of_finite G
      (fun p : ι × ι ↦ op (Limits.pullback (π p.1) (π p.2))) _ _ hc
    have hcomp : Arrows.PullbackCompatible (G.obj m) π fun i ↦ (G.map f).app _ (a i) := by
      intro i j
      rw [← NatTrans.naturality_apply, ← NatTrans.naturality_apply]
      exact hf (i, j)
    obtain ⟨s, hs⟩ := (hb m).2 ⟨_, hcomp⟩
    refine ⟨(colimit.ι G m).app _ s, Subtype.ext (funext fun i ↦ ?_)⟩
    have := congrFun (congrArg Subtype.val hs) i
    simp only [Arrows.toPullbackCompatible_coe] at this ⊢
    rw [colimit_map_ι_app, this, ι_app_map, ha]

end CategoryTheory.Presieve

namespace AlgebraicGeometry.EtaleSheaf

open SmallNoetherianSeparatedEtale

variable {B : BigEtaleSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} [IsLocallyNoetherian S]
  {I : Type w} [Category.{w'} I] [IsFiltered I] [HasColimitsOfShape I (Type v)]
  (F : I ⥤ EtaleSheaf B S hS (Type v))

omit [IsFiltered I] [HasColimitsOfShape I (Type v)] in
private lemma isSheaf_topology_iff' (P : EtalePresheaf B S hS (Type v)) :
    Presieve.IsSheaf (topology B S hS) P ↔
      ∀ ⦃X⦄ (R : Presieve X), R ∈ finiteCoverage B S hS X → Presieve.IsSheafFor P R := by
  rw [topology_eq_toGrothendieck_finiteCoverage, Presieve.isSheaf_coverage]

/-- **A filtered colimit of étale sheaves of sets, computed sectionwise, is an étale sheaf**
(FK I.4, p. 48). For a filtered system `(𝒢_λ)` of étale sheaves of sets on `Et(S)`, the
presheaf `U ↦ colim_λ 𝒢_λ(U)` is a sheaf. -/
@[weil "lem_fk104_sections_commute_filtered_colimits_of_sets"]
theorem isSheaf_colimit_sheafToPresheaf :
    Presheaf.IsSheaf (topology B S hS) (colimit (F ⋙ sheafToPresheaf _ (Type v))) := by
  rw [isSheaf_iff_isSheaf_of_type, isSheaf_topology_iff']
  rintro U R ⟨ι, _, V, φ, rfl, hφ⟩
  refine Presieve.isSheafFor_colimit_ofArrows _ φ fun j ↦ ?_
  have h := (isSheaf_iff_isSheaf_of_type _ _).mp (F.obj j).property
  rw [isSheaf_topology_iff'] at h
  exact h _ ⟨ι, inferInstance, V, φ, rfl, hφ⟩

/-- The étale sheaf of sets `U ↦ colim_λ 𝒢_λ(U)` of a filtered system `(𝒢_λ)` of étale sheaves of
sets on `Et(S)`, with the canonical maps `𝒢_λ ⟶ colim_λ 𝒢_λ`, as a cocone over the system. -/
@[weil "lem_fk104_sections_commute_filtered_colimits_of_sets"]
def filteredColimitCocone : Cocone F where
  pt := ⟨colimit (F ⋙ sheafToPresheaf _ (Type v)), isSheaf_colimit_sheafToPresheaf F⟩
  ι :=
    { app j := ObjectProperty.homMk (colimit.ι (F ⋙ sheafToPresheaf _ (Type v)) j)
      naturality j k f := Sheaf.hom_ext (by
        simpa using colimit.w (F ⋙ sheafToPresheaf _ (Type v)) f) }

@[simp]
lemma filteredColimitCocone_pt_obj :
    (filteredColimitCocone F).pt.obj = colimit (F ⋙ sheafToPresheaf _ (Type v)) :=
  rfl

@[simp]
lemma filteredColimitCocone_ι_app_hom (j : I) :
    ((filteredColimitCocone F).ι.app j).hom = colimit.ι (F ⋙ sheafToPresheaf _ (Type v)) j :=
  rfl

/-- The image of `AlgebraicGeometry.EtaleSheaf.filteredColimitCocone` in presheaves is the
colimit cocone of the underlying presheaves. -/
def isColimitMapCoconeFilteredColimitCocone :
    IsColimit ((sheafToPresheaf _ (Type v)).mapCocone (filteredColimitCocone F)) :=
  (colimit.isColimit (F ⋙ sheafToPresheaf _ (Type v))).ofIsoColimit
    (Cocone.ext (Iso.refl _) fun _ ↦ by simp)

/-- **Filtered colimits of étale sheaves of sets are computed sectionwise** (FK I.4, p. 48).
The étale sheaf `U ↦ colim_λ 𝒢_λ(U)`, with the canonical maps `𝒢_λ ⟶ colim_λ 𝒢_λ`, is a colimit
of the filtered system `(𝒢_λ)` in the category of étale sheaves of sets. -/
@[weil "lem_fk104_sections_commute_filtered_colimits_of_sets"]
def isColimitFilteredColimitCocone : IsColimit (filteredColimitCocone F) :=
  isColimitOfReflects (sheafToPresheaf _ (Type v)) (isColimitMapCoconeFilteredColimitCocone F)

variable (B S hS I) in
/-- The forgetful functor from étale sheaves of sets on `Et(S)` to presheaves preserves filtered
colimits: sections of a filtered colimit of étale sheaves of sets are the colimit of the
sections. -/
instance preservesColimitsOfShape_sheafToPresheaf :
    PreservesColimitsOfShape I (sheafToPresheaf (topology B S hS) (Type v)) where
  preservesColimit {F} := preservesColimit_of_preserves_colimit_cocone
    (isColimitFilteredColimitCocone F) (isColimitMapCoconeFilteredColimitCocone F)

end AlgebraicGeometry.EtaleSheaf
