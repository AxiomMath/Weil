module

public import Weil.Attr
public import Weil.RingTheory.Henselian.Henselization.SmoothStrictlyHenselianAlgebra

/-!
# The residue field of a finite base change of an sh-smooth algebra

Let `A → B` be a local homomorphism of local rings and `A₁` a local `A`-algebra, finite as an
`A`-module, whose residue field `κ(A₁)` is purely inseparable over `κ(A)`, and suppose that
`A₁ ⊗[A] B` is local with `A₁ → A₁ ⊗[A] B` local. If `κ(A₁) ≅ κ(B)` as `κ(A)`-algebras, then the
map of residue fields `κ(A₁) → κ(A₁ ⊗[A] B)` is an isomorphism.

Indeed `κ(A₁ ⊗[A] B)` is generated by the images of `κ(A₁)` and `κ(B)`, and a purely inseparable
extension of `κ(A)` has at most one `κ(A)`-embedding into a field; so the image of `κ(B)`, being
the image of `κ(A₁)` under the composite with the isomorphism, is contained in the image of
`κ(A₁)`.

This applies when `A` is strictly Henselian, `B` is sh-smooth over `A` with `κ(B)` algebraic over
`κ(A)`, and `A₁` is a local `A`-algebra finite over `A`: then `κ(A₁)` is finite, hence purely
inseparable, over the separably closed field `κ(A)`, and `A₁ ⊗[A] B` is local with
`A₁ → A₁ ⊗[A] B` local by `Algebra.IsShSmooth.tensorProduct_of_module_finite`.

## Main results

* `Algebra.TensorProduct.bijective_residueField_map_algebraMap`: the map
  `κ(A₁) → κ(A₁ ⊗[A] B)` is bijective, in the general setting above.
* `Algebra.IsShSmooth.bijective_residueField_map_tensorProduct`: the same statement under the
  hypotheses of the source.

## Implementation notes

The source writes `B ⊗_A A₁`; the formalization uses `A₁ ⊗[A] B`, as does
`Algebra.IsShSmooth.tensorProduct_of_module_finite`. The source also assumes that `A₁` is free
over `A`, that `B` is strictly Henselian and that `κ(B)` is algebraic over `κ(A)`; none of these
is needed (`κ(B) ≅ κ(A₁)` is automatically finite over `κ(A)`). The general statement does not
use sh-smoothness: it only needs the locality of the tensor product and the pure inseparability
of `κ(A₁)` over `κ(A)`.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FK88], I.7
-/

@[expose] public section

open IsLocalRing TensorProduct

universe u v

namespace Algebra.TensorProduct

variable {A A₁ B : Type*} [CommRing A] [IsLocalRing A] [CommRing A₁] [IsLocalRing A₁]
  [CommRing B] [IsLocalRing B] [Algebra A A₁] [Algebra A B] [IsLocalHom (algebraMap A A₁)]
  [IsLocalHom (algebraMap A B)] [Module.Finite A A₁]
  [IsPurelyInseparable (ResidueField A) (ResidueField A₁)]
  [IsLocalRing (A₁ ⊗[A] B)] [IsLocalHom (algebraMap A₁ (A₁ ⊗[A] B))]

/-- **The residue field of `A₁ ⊗[A] B`.** Let `A → B` be a local homomorphism of local rings and
`A₁` a local `A`-algebra, finite over `A`, with `A → A₁` local and `κ(A₁)` purely inseparable over
`κ(A)`, such that `A₁ ⊗[A] B` is local and `A₁ → A₁ ⊗[A] B` is local. If `κ(A₁) ≅ κ(B)` as
`κ(A)`-algebras, then the induced map `κ(A₁) → κ(A₁ ⊗[A] B)` is bijective. -/
theorem bijective_residueField_map_algebraMap
    (e : ResidueField A₁ ≃ₐ[ResidueField A] ResidueField B) :
    Function.Bijective (ResidueField.map (algebraMap A₁ (A₁ ⊗[A] B))) := by
  have := isLocalHom_includeRight_of_isPurelyInseparable (R := A) (S := B) (T := A₁)
  set M := ResidueField (A₁ ⊗[A] B)
  let ι₁ : ResidueField A₁ →+* M := ResidueField.map (algebraMap A₁ (A₁ ⊗[A] B))
  let ιB : ResidueField B →+* M :=
    ResidueField.map (includeRight : B →ₐ[A] A₁ ⊗[A] B).toRingHom
  obtain ⟨q, _⟩ := ExpChar.exists (ResidueField A)
  have : ExpChar M q := expChar_of_injective_ringHom
    (f := ι₁.comp (algebraMap (ResidueField A) (ResidueField A₁))) (RingHom.injective _) q
  -- the two maps `κ(A) → M` through `κ(A₁)` and through `κ(B)` agree
  have hA : ∀ c : ResidueField A, ι₁ (algebraMap _ _ c) = ιB (algebraMap _ _ c) := by
    intro c
    obtain ⟨r, rfl⟩ := residue_surjective c
    simp only [ResidueField.algebraMap_residue, ι₁, ιB]
    rw [ResidueField.map_residue, ResidueField.map_residue]
    congr 1
    change algebraMap A₁ (A₁ ⊗[A] B) (algebraMap A A₁ r) = (1 : A₁) ⊗ₜ algebraMap A B r
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
      Algebra.algebraMap_eq_smul_one, smul_tmul, ← Algebra.algebraMap_eq_smul_one]
  -- uniqueness of embeddings of the purely inseparable extension `κ(A₁)`
  have hι : ∀ x : ResidueField A₁, ιB (e x) = ι₁ x := by
    intro x
    obtain ⟨n, c, hc⟩ := IsPurelyInseparable.pow_mem (ResidueField A) q x
    have h : (ιB (e x) - ι₁ x) ^ q ^ n = 0 := by
      rw [sub_pow_expChar_pow, ← map_pow, ← map_pow, ← map_pow, ← hc, AlgEquiv.commutes, hA,
        sub_self]
    exact sub_eq_zero.mp (pow_eq_zero_iff (pow_ne_zero n (expChar_ne_zero M q)) |>.mp h)
  refine ⟨RingHom.injective _, fun z => ?_⟩
  obtain ⟨x, rfl⟩ := residue_surjective z
  suffices residue (A₁ ⊗[A] B) x ∈ ι₁.range from this
  induction x using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy => simpa using add_mem hx hy
  | tmul a b =>
    have hab : a ⊗ₜ[A] b = algebraMap A₁ (A₁ ⊗[A] B) a * (1 : A₁) ⊗ₜ b := by
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    rw [hab, map_mul]
    refine mul_mem ⟨residue A₁ a, ResidueField.map_residue _ a⟩ ⟨e.symm (residue B b), ?_⟩
    rw [← hι, AlgEquiv.apply_symm_apply]
    exact ResidueField.map_residue _ b

end Algebra.TensorProduct

namespace Algebra.IsShSmooth

/-- **The residue field of a finite base change of an sh-smooth algebra.** Let `A` be a strictly
Henselian local ring, `A → B` a local homomorphism of local rings with `B` sh-smooth over `A`, and
`A₁` a local `A`-algebra, finite as an `A`-module, with `A → A₁` local and `κ(A₁) ≅ κ(B)` as
`κ(A)`-algebras. Then `A₁ ⊗[A] B` is local, `A₁ → A₁ ⊗[A] B` is local, and the induced map
`κ(A₁) → κ(A₁ ⊗[A] B)` is bijective. -/
@[weil "lem_fk107_smooth_strictly_henselian_finite_base_change_residue"]
theorem bijective_residueField_map_tensorProduct {A A₁ : Type u} {B : Type v} [CommRing A]
    [StrictlyHenselianLocalRing A] [CommRing A₁] [IsLocalRing A₁] [Algebra A A₁]
    [Module.Finite A A₁] [IsLocalHom (algebraMap A A₁)] [CommRing B] [IsLocalRing B] [Algebra A B]
    [IsLocalHom (algebraMap A B)] (h : IsShSmooth A B)
    (e : ResidueField A₁ ≃ₐ[ResidueField A] ResidueField B) :
    ∃ (_ : IsLocalRing (A₁ ⊗[A] B)) (_ : IsLocalHom (algebraMap A₁ (A₁ ⊗[A] B))),
      Function.Bijective (ResidueField.map (algebraMap A₁ (A₁ ⊗[A] B))) := by
  have : IsPurelyInseparable (ResidueField A) (ResidueField A₁) := inferInstance
  obtain ⟨-, hl, hloc, -⟩ := h.tensorProduct_of_module_finite (A₁ := A₁)
  have : IsLocalRing (A₁ ⊗[A] B) := hl.toIsLocalRing
  exact ⟨this, hloc, Algebra.TensorProduct.bijective_residueField_map_algebraMap e⟩

end Algebra.IsShSmooth

end
