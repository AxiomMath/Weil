module

public import Weil.Attr
public import Mathlib.RingTheory.RegularLocalRing.Polynomial
public import Mathlib.RingTheory.Unramified.LocalRing
public import StacksFrontier.RingTheory.Henselian.HenselizationMinimalPrimes
public import StacksFrontier.RingTheory.RegularLocalRing.FlatLocalHom
public import StacksFrontier.RingTheory.Serre.FlatAscent

/-!
# The regular locus of the henselian line

Let `A` be a Noetherian local ring, let `𝔫` be a prime of `A[X]` and let `R` be a henselization of
the local ring `A[X]_𝔫` (for `𝔫 = (𝔪_A, X)` and the residue field of `A[X]_𝔫` this is the
henselian line `A{t}`). For a prime `P` of `R` lying over the prime `𝔭` of `A`, the local ring
`R_P` is regular if and only if `A_𝔭` is regular. In other words, the regular locus of `Spec R` is
the preimage of the regular locus of `Spec A`.

The proof factors `A → R` as `A → A[X] → A[X]_𝔫 → R`.

* Regularity descends along every flat local homomorphism of Noetherian local rings (Stacks 00OF),
  and `A → R` is flat, which gives one implication.
* For a prime `Q` of `A[X]` over `𝔭`, if `A_𝔭` is regular then so is `A[X]_Q`.
* `R` is a filtered colimit of étale `A[X]_𝔫`-algebras, so for a prime `P` of `R` over the prime
  `𝔮` of `A[X]_𝔫` the maximal ideal of `R_P` is generated by `𝔮`. Hence the closed fibre of the
  flat local map `(A[X]_𝔫)_𝔮 → R_P` is a field, and regularity ascends (Stacks 031E).

## Main results

* `CommAlgCat.exists_mul_mem_map_comap_of_ind_etale`: for an ind-étale `R`-algebra `S` and a
  prime `P` of `S`, every element of `P` becomes, after multiplication by an element outside `P`,
  an element of the extension of `P ∩ R`.
* `CommAlgCat.map_comap_eq_maximalIdeal_localization_of_ind_etale`: in that situation
  `(P ∩ R) S_P` is the maximal ideal of `S_P`.
* `isRegularLocalRing_localization_iff_of_flat_of_map_eq`: along a flat map `A → B` of Noetherian
  rings with `(P ∩ A) B_P = P B_P`, the local rings `A_{P ∩ A}` and `B_P` are regular together.
* `Polynomial.isRegularLocalRing_localization_atPrime_of_comap`: `A[X]_Q` is regular when
  `A_{Q ∩ A}` is.
* `IsLocalRing.IsHenselization.mem_preimage_regularLocus_iff_of_polynomial`: the regular locus
  of a henselization of `A[X]_𝔫` is the preimage of the regular locus of `A`.

## Implementation notes

The statement is proved for an arbitrary prime `𝔫` of `A[X]` and an arbitrary residue extension of
the henselization, and without the hypotheses (excellent, normal, henselian, domain) of the source's
setting, none of which is used.

## References

* [FK] E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, I.7.
* [StacksProject 00OF], [StacksProject 031E]
-/

@[expose] public section

universe u v w

open IsLocalRing Polynomial

section IndEtale

variable {R : Type u} {S : Type w} [CommRing R] [CommRing S] [Algebra R S]

/-- Let `S` be a filtered colimit of étale `R`-algebras and `P` a prime of `S`. Every element of
`P` times some element outside `P` lies in the extension of `P ∩ R` to `S`. -/
theorem CommAlgCat.exists_mul_mem_map_comap_of_ind_etale
    (hind : (CommAlgCat.etale.{w} R).ind.{w} (CommAlgCat.of R S)) (P : Ideal S) [P.IsPrime]
    {x : S} (hx : x ∈ P) :
    ∃ g ∉ P, g * x ∈ (P.comap (algebraMap R S)).map (algebraMap R S) := by
  classical
  obtain ⟨J, _, _, pres, hpres⟩ := hind
  obtain ⟨j, y, hy⟩ := CommAlgCat.exists_app_eq pres.isColimit x
  let T := (pres.diag.obj j : Type w)
  let φ : T →ₐ[R] S := (pres.ι.app j).hom
  have : Algebra.Etale R T := hpres j
  let p := P.comap (algebraMap R S)
  let Q := P.comap φ.toRingHom
  have : Q.IsPrime := Ideal.IsPrime.comap _
  have : Q.LiesOver p := ⟨by
    ext r
    simp only [Ideal.under, Ideal.mem_comap, Q, p, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
      AlgHom.commutes]⟩
  let := Localization.AtPrime.algebraOfLiesOver p Q
  have hmap := ((Algebra.isUnramifiedAt_iff_map_eq R p Q).mp inferInstance).2
  have hyQ : algebraMap T (Localization.AtPrime Q) y ∈ maximalIdeal (Localization.AtPrime Q) :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff _ Q y).2 (by
      change φ y ∈ P
      rw [show φ y = x from hy]
      exact hx)
  rw [← hmap, IsScalarTower.algebraMap_eq R T (Localization.AtPrime Q), ← Ideal.map_map] at hyQ
  obtain ⟨m, hm, hmy⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff Q.primeCompl
    (Localization.AtPrime Q) _ _).1 hyQ
  refine ⟨φ m, hm, ?_⟩
  have h := Ideal.mem_map_of_mem φ.toRingHom hmy
  rw [Ideal.map_map, AlgHom.toRingHom_eq_coe, AlgHom.comp_algebraMap] at h
  simpa [show φ y = x from hy] using h

/-- Let `S` be a filtered colimit of étale `R`-algebras and `P` a prime of `S`. Then the maximal
ideal of `S_P` is generated by `P ∩ R`. -/
theorem CommAlgCat.map_comap_eq_maximalIdeal_localization_of_ind_etale
    (hind : (CommAlgCat.etale.{w} R).ind.{w} (CommAlgCat.of R S)) (P : Ideal S) [P.IsPrime] :
    (P.comap (algebraMap R S)).map (algebraMap R (Localization.AtPrime P)) =
      maximalIdeal (Localization.AtPrime P) := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro r hr
    rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply R S (Localization.AtPrime P)]
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff _ P _).2 hr
  · rw [← Localization.AtPrime.map_eq_maximalIdeal, IsScalarTower.algebraMap_eq R S
      (Localization.AtPrime P), ← Ideal.map_map, Ideal.map_le_iff_le_comap]
    intro x hx
    obtain ⟨g, hg, hgx⟩ := CommAlgCat.exists_mul_mem_map_comap_of_ind_etale hind P hx
    have hu : IsUnit (algebraMap S (Localization.AtPrime P) g) :=
      IsLocalization.map_units (Localization.AtPrime P) (⟨g, hg⟩ : P.primeCompl)
    have h := Ideal.mem_map_of_mem (algebraMap S (Localization.AtPrime P)) hgx
    rw [map_mul] at h
    rw [Ideal.mem_comap]
    obtain ⟨u, hu⟩ := hu
    have := Ideal.mul_mem_left _ (↑u⁻¹ : Localization.AtPrime P) h
    rwa [← hu, ← mul_assoc, Units.inv_mul, one_mul] at this

end IndEtale

section Flat

variable {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B] [Module.Flat A B]

/-- Regularity of local rings descends along a flat ring map: if `B_P` is regular, so is
`A_{P ∩ A}`. -/
theorem isRegularLocalRing_localization_comap_of_flat [IsNoetherianRing A] (P : Ideal B)
    [P.IsPrime] [IsRegularLocalRing (Localization.AtPrime P)] :
    IsRegularLocalRing (Localization.AtPrime (P.comap (algebraMap A B))) := by
  let p := P.comap (algebraMap A B)
  have : P.LiesOver p := ⟨rfl⟩
  let := Localization.AtPrime.algebraOfLiesOver p P
  have : IsLocalHom (algebraMap (Localization.AtPrime p) (Localization.AtPrime P)) :=
    Localization.isLocalHom_localRingHom _ _ _ _
  exact IsRegularLocalRing.of_flat_of_isLocalHom (Localization.AtPrime P)

/-- Along a flat map `A → B` of Noetherian rings, if the prime `P` of `B` satisfies
`(P ∩ A) B_P = P B_P`, then `A_{P ∩ A}` is regular if and only if `B_P` is. -/
theorem isRegularLocalRing_localization_iff_of_flat_of_map_eq [IsNoetherianRing A]
    [IsNoetherianRing B] (P : Ideal B) [P.IsPrime]
    (h : (P.comap (algebraMap A B)).map (algebraMap A (Localization.AtPrime P)) =
      maximalIdeal (Localization.AtPrime P)) :
    IsRegularLocalRing (Localization.AtPrime (P.comap (algebraMap A B))) ↔
      IsRegularLocalRing (Localization.AtPrime P) := by
  let p := P.comap (algebraMap A B)
  have : P.LiesOver p := ⟨rfl⟩
  let := Localization.AtPrime.algebraOfLiesOver p P
  have : IsLocalHom (algebraMap (Localization.AtPrime p) (Localization.AtPrime P)) :=
    Localization.isLocalHom_localRingHom _ _ _ _
  refine ⟨fun hA => ?_, fun _ => isRegularLocalRing_localization_comap_of_flat P⟩
  have hfib : (maximalIdeal (Localization.AtPrime p)).map
      (algebraMap (Localization.AtPrime p) (Localization.AtPrime P)) =
      maximalIdeal (Localization.AtPrime P) := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map, ← h]
    congr 1
    ext a
    rw [RingHom.comp_apply, IsScalarTower.algebraMap_apply A B (Localization.AtPrime P)]
    exact Localization.localRingHom_to_map _ _ _ _ a
  have : IsRegularLocalRing (ResidueField (Localization.AtPrime P)) := inferInstance
  exact isRegularLocalRing_of_flat_of_regular_closedFibre _ _ hA
    (IsRegularLocalRing.of_ringEquiv (R := ResidueField (Localization.AtPrime P))
      (Ideal.quotEquivOfEq hfib.symm))

end Flat

/-- Let `Q` be a prime of `A[X]`. If the local ring of `A` at `Q ∩ A` is regular, then so is the
local ring of `A[X]` at `Q`. -/
theorem Polynomial.isRegularLocalRing_localization_atPrime_of_comap {A : Type u} [CommRing A]
    (p : Ideal A[X]) [p.IsPrime] (𝔭 : Ideal A) [𝔭.IsPrime] (h : p.comap C = 𝔭)
    [IsRegularLocalRing (Localization.AtPrime 𝔭)] :
    IsRegularLocalRing (Localization.AtPrime p) := by
  subst h
  let q := p.comap C
  let S := (Localization.AtPrime q)[X]
  let pc := Submonoid.map Polynomial.C.toMonoidHom q.primeCompl
  let : Algebra A[X] S := algebra A (Localization.AtPrime q)
  have : IsLocalization pc S := Polynomial.isLocalization _ _
  let pS := p.map (algebraMap A[X] S)
  have disj : Disjoint (pc : Set A[X]) (p : Set A[X]) := by
    simpa [pc, q] using! Set.disjoint_image_left.mpr
      (Set.disjoint_compl_left_iff_subset.mpr (fun _ a ↦ a))
  have : pS.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint pc _ _ ‹_› disj
  have : IsLocalization.AtPrime (Localization.AtPrime pS) p := by
    convert IsLocalization.isLocalization_isLocalization_atPrime_isLocalization pc
      (Localization.AtPrime pS) pS
    exact (IsLocalization.under_map_of_isPrime_disjoint pc _ ‹_› disj).symm
  have eq : Ideal.comap C pS = maximalIdeal (Localization.AtPrime q) := by
    rw [← IsLocalization.map_under q.primeCompl _ (Ideal.comap C pS),
      ← IsLocalization.map_under q.primeCompl _ (maximalIdeal (Localization.AtPrime q))]
    simp only [Ideal.comap_comap, S, pS]
    rw [← Polynomial.algebraMap_eq (R := Localization.AtPrime q),
      ← IsScalarTower.algebraMap_eq A (Localization.AtPrime q) (Localization.AtPrime q)[X],
      IsScalarTower.algebraMap_eq A A[X] (Localization.AtPrime q)[X], ← Ideal.comap_comap,
      ← Ideal.under_def A[X], IsLocalization.under_map_of_isPrime_disjoint pc _ ‹_› disj]
    simp [q, IsLocalization.AtPrime.under_maximalIdeal (Localization.AtPrime q) q]
  have := isRegularLocalRing_localization_atPrime_of_comap_eq_maximalIdeal _ pS eq
  exact IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime pS)
    (IsLocalization.algEquiv p.primeCompl (Localization.AtPrime pS)
      (Localization.AtPrime p)).toRingEquiv

namespace IsLocalRing.IsHenselization

/-- **The regular locus of the henselian line.** Let `A` be a Noetherian local ring, `𝔫` a prime of
`A[X]`, and `R` a henselization of `A[X]_𝔫` (with any residue extension `L`); for
`𝔫 = (𝔪_A, X)` and `L` the residue field this is the henselian line `A{t}`. Let `V ⊆ Spec A` be
the regular locus and `U` its preimage in `Spec R`. A prime `P` of `R` lies in `U` if and only if
`R_P` is regular. -/
@[weil "lem_fk107_henselian_line_regular_locus"]
theorem mem_preimage_regularLocus_iff_of_polynomial {A : Type u} [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] (𝔫 : Ideal A[X]) [𝔫.IsPrime]
    (L : Type v) [Field L] [Algebra (ResidueField (Localization.AtPrime 𝔫)) L]
    (R : Type u) [CommRing R] [IsLocalRing R] [Algebra A R] [Algebra (Localization.AtPrime 𝔫) R]
    [IsScalarTower A (Localization.AtPrime 𝔫) R]
    [IsHenselization (Localization.AtPrime 𝔫) L R] (P : PrimeSpectrum R) :
    P ∈ PrimeSpectrum.comap (algebraMap A R) ⁻¹'
        {𝔭 | IsRegularLocalRing (Localization.AtPrime 𝔭.asIdeal)} ↔
      IsRegularLocalRing (Localization.AtPrime P.asIdeal) := by
  let A' := Localization.AtPrime 𝔫
  have : IsNoetherianRing R := isNoetherianRing_of_isHenselization (A := A') L
  have hflatR : Module.Flat A' R := flat (L := L)
  have : Module.Flat A R := Module.Flat.trans A A' R
  change IsRegularLocalRing (Localization.AtPrime (P.asIdeal.comap (algebraMap A R))) ↔ _
  refine ⟨fun hA => ?_, fun _ => isRegularLocalRing_localization_comap_of_flat P.asIdeal⟩
  let q := P.asIdeal.comap (algebraMap A' R)
  let q₀ := q.comap (algebraMap A[X] A')
  have hq₀ : q₀.comap C = P.asIdeal.comap (algebraMap A R) := by
    simp only [q₀, q, Ideal.comap_comap]
    congr 1
    rw [IsScalarTower.algebraMap_eq A A' R, IsScalarTower.algebraMap_eq A A[X] A']
    rfl
  have hq₀reg : IsRegularLocalRing (Localization.AtPrime q₀) :=
    Polynomial.isRegularLocalRing_localization_atPrime_of_comap q₀ _ hq₀
  have : IsLocalization.AtPrime (Localization.AtPrime q) q₀ :=
    IsLocalization.isLocalization_isLocalization_atPrime_isLocalization 𝔫.primeCompl
      (Localization.AtPrime q) q
  have hqreg : IsRegularLocalRing (Localization.AtPrime q) :=
    IsRegularLocalRing.of_ringEquiv (IsLocalization.algEquiv q₀.primeCompl
      (Localization.AtPrime q₀) (Localization.AtPrime q)).toRingEquiv
  have hind := ind_etale_of_universe_le (R := A') (Rh := R) L
  exact (isRegularLocalRing_localization_iff_of_flat_of_map_eq P.asIdeal
    (CommAlgCat.map_comap_eq_maximalIdeal_localization_of_ind_etale hind P.asIdeal)).1 hqreg

end IsLocalRing.IsHenselization
