/-!
# Localizing the henselian line at a regular prime of the base

Let `A` be a Noetherian local ring, `T = (T_i)_{i ∈ σ}` finitely many indeterminates and `A{T}`
the Henselization of `A[T]` at the origin `𝔭₀ = (𝔪, T)`. If `𝔭` is a prime of `A` such that `A_𝔭`
is regular, then `A{T} ⊗_A A_𝔭`, the localization of `A{T}` at the image of `A ∖ 𝔭`, is a regular
ring.

The local rings of `A{T} ⊗_A A_𝔭` are the `A{T}_P` for the primes `P` of `A{T}` with
`𝔮 = P ∩ A ⊆ 𝔭`. For such `P` the local ring `A_𝔮` is a localization of the regular local ring
`A_𝔭`, hence regular (Serre). Then `A[T]_{P ∩ A[T]}` is regular, being a localization of the
regular ring `A_𝔮[T]`. Since `A{T}` is a filtered colimit of étale `A[T]_{𝔭₀}`-algebras, the maximal
ideal of `A{T}_P` is generated by that of `A[T]_{P ∩ A[T]}`, and the flat local homomorphism
`A[T]_{P ∩ A[T]} → A{T}_P` has a field as closed fibre, so `A{T}_P` is regular.

## Main results

* `MvPolynomial.isRegularLocalRing_localization_atPrime_of_comap`: for finitely many
  indeterminates, `A[T]_Q` is regular when `A_{Q ∩ A}` is.
* `IsLocalRing.isRegularLocalRing_localization_of_le`: a localization `A_𝔮`, `𝔮 ⊆ 𝔭`, of a
  regular local ring `A_𝔭` is regular.
* `MvPolynomial.IsHenselianPolynomialRing.isRegularLocalRing_localization_atPrime`: `A{T}_P` is
  regular when `A_{P ∩ A}` is.
* `MvPolynomial.IsHenselianPolynomialRing.isRegularRing_of_isLocalization`: every localization of
  `A{T}` at the image of `A ∖ 𝔭`, `A_𝔭` regular, is a regular ring.
* `MvPolynomial.IsHenselianPolynomialRing.isRegularRing_tensorProduct_localization`:
  `A{T} ⊗_A A_𝔭` is a regular ring.

## Implementation notes

The source states the result for one indeterminate `t`; the proof works for any finite family.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FK88], I.7
-/

public section

open IsLocalRing

universe u v

section Serre

/-- A localization `A_𝔮` of a regular local ring `A_𝔭` at a smaller prime `𝔮 ⊆ 𝔭` is regular. -/
theorem IsLocalRing.isRegularLocalRing_localization_of_le {A : Type u} [CommRing A]
    [IsNoetherianRing A] {𝔮 𝔭 : Ideal A} [𝔮.IsPrime] [𝔭.IsPrime] (h : 𝔮 ≤ 𝔭)
    [IsRegularLocalRing (Localization.AtPrime 𝔭)] :
    IsRegularLocalRing (Localization.AtPrime 𝔮) := by
  let A𝔭 := Localization.AtPrime 𝔭
  have : IsRegularRing A𝔭 :=
    ((IsLocalRing.isRegularRing_tfae (R := A𝔭)).out 1 3 rfl rfl).1 inferInstance
  have hdisj : Disjoint (𝔭.primeCompl : Set A) 𝔮 := by
    rw [Set.disjoint_left]
    exact fun a ha h𝔮 => ha (h h𝔮)
  let I := 𝔮.map (algebraMap A A𝔭)
  have : I.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint 𝔭.primeCompl A𝔭 𝔮 ‹_› hdisj
  have : IsLocalization.AtPrime (Localization.AtPrime I) 𝔮 := by
    convert IsLocalization.isLocalization_atPrime_localization_atPrime 𝔭.primeCompl I
    exact (IsLocalization.under_map_of_isPrime_disjoint 𝔭.primeCompl A𝔭 ‹_› hdisj).symm
  exact IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime I)
    (IsLocalization.algEquiv 𝔮.primeCompl (Localization.AtPrime I)
      (Localization.AtPrime 𝔮)).toRingEquiv

end Serre

namespace MvPolynomial

attribute [local instance] algebraMvPolynomial in
/-- Let `σ` be finite and let `Q` be a prime of `A[T] = MvPolynomial σ A`, `A` Noetherian. If the
local ring of `A` at `Q ∩ A` is regular, then so is the local ring of `A[T]` at `Q`. -/
theorem isRegularLocalRing_localization_atPrime_of_comap {A : Type u} [CommRing A]
    [IsNoetherianRing A] {σ : Type v} [Finite σ] (Q : Ideal (MvPolynomial σ A)) [Q.IsPrime]
    (𝔮 : Ideal A) [𝔮.IsPrime] (h : Q.comap C = 𝔮)
    [IsRegularLocalRing (Localization.AtPrime 𝔮)] :
    IsRegularLocalRing (Localization.AtPrime Q) := by
  subst h
  let q := Q.comap (C : A →+* MvPolynomial σ A)
  let A𝔮 := Localization.AtPrime q
  have : IsRegularRing A𝔮 :=
    ((IsLocalRing.isRegularRing_tfae (R := A𝔮)).out 1 3 rfl rfl).1 inferInstance
  let S := MvPolynomial σ A𝔮
  let pc := q.primeCompl.map (C : A →+* MvPolynomial σ A)
  have : IsLocalization pc S := MvPolynomial.isLocalization q.primeCompl A𝔮
  have disj : Disjoint (pc : Set (MvPolynomial σ A)) (Q : Set (MvPolynomial σ A)) := by
    rw [Set.disjoint_left]
    rintro _ ⟨a, ha, rfl⟩ hQ
    exact ha hQ
  let QS := Q.map (algebraMap (MvPolynomial σ A) S)
  have : QS.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint pc _ _ ‹_› disj
  have : IsLocalization.AtPrime (Localization.AtPrime QS) Q := by
    convert IsLocalization.isLocalization_isLocalization_atPrime_isLocalization pc
      (Localization.AtPrime QS) QS
    exact (IsLocalization.under_map_of_isPrime_disjoint pc _ ‹_› disj).symm
  exact IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime QS)
    (IsLocalization.algEquiv Q.primeCompl (Localization.AtPrime QS)
      (Localization.AtPrime Q)).toRingEquiv

namespace IsHenselianPolynomialRing

variable {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A] {σ : Type v} [Finite σ]
  {B : Type (max u v)} [CommRing B] [IsLocalRing B] [Algebra (LocalizationAtOrigin A σ) B]
  [Algebra A B] [IsScalarTower A (LocalizationAtOrigin A σ) B]

/-- Let `A` be a Noetherian local ring and `A{T}` the Henselization of `A[T]` at the origin, for
finitely many indeterminates `T`. For a prime `P` of `A{T}`, if the local ring of `A` at `P ∩ A` is
regular, then so is the local ring `A{T}_P`. -/
theorem isRegularLocalRing_localization_atPrime (h : IsHenselianPolynomialRing A σ B)
    (P : Ideal B) [P.IsPrime]
    [IsRegularLocalRing (Localization.AtPrime (P.comap (algebraMap A B)))] :
    IsRegularLocalRing (Localization.AtPrime P) := by
  let A' := LocalizationAtOrigin A σ
  have : IsHenselization A' (ResidueField A') B := h
  have : IsNoetherianRing B := isNoetherianRing_of_isHenselization (A := A') (ResidueField A')
  let q := P.comap (algebraMap A' B)
  let q₀ := q.comap (algebraMap (MvPolynomial σ A) A')
  have hq₀ : q₀.comap C = P.comap (algebraMap A B) := by
    simp only [q₀, q, Ideal.comap_comap]
    congr 1
    rw [IsScalarTower.algebraMap_eq A A' B, IsScalarTower.algebraMap_eq A (MvPolynomial σ A) A']
    rfl
  have hq₀reg : IsRegularLocalRing (Localization.AtPrime q₀) :=
    isRegularLocalRing_localization_atPrime_of_comap q₀ _ hq₀
  have : IsLocalization.AtPrime (Localization.AtPrime q) q₀ :=
    IsLocalization.isLocalization_isLocalization_atPrime_isLocalization (originIdeal A σ).primeCompl
      (Localization.AtPrime q) q
  have hqreg : IsRegularLocalRing (Localization.AtPrime q) :=
    IsRegularLocalRing.of_ringEquiv (IsLocalization.algEquiv q₀.primeCompl
      (Localization.AtPrime q₀) (Localization.AtPrime q)).toRingEquiv
  have : Module.Flat A' B := IsHenselization.flat (L := ResidueField A')
  have hind := IsHenselization.ind_etale_of_universe_le.{max u v, _, max u v} (R := A') (Rh := B)
    (ResidueField A')
  exact (isRegularLocalRing_localization_iff_of_flat_of_map_eq (A := A') P
    (CommAlgCat.map_comap_eq_maximalIdeal_localization_of_ind_etale hind P)).1 hqreg

/-- Let `A` be a Noetherian local ring, `A{T}` the Henselization of `A[T]` at the origin for
finitely many indeterminates `T`, and `𝔭` a prime of `A` with `A_𝔭` regular. Every localization
`B'` of `A{T}` at the image of `A ∖ 𝔭` is a regular ring. -/
theorem isRegularRing_of_isLocalization (h : IsHenselianPolynomialRing A σ B) (𝔭 : Ideal A)
    [𝔭.IsPrime] [IsRegularLocalRing (Localization.AtPrime 𝔭)] (B' : Type*) [CommRing B']
    [Algebra B B'] [IsLocalization (Algebra.algebraMapSubmonoid B 𝔭.primeCompl) B'] :
    IsRegularRing B' := by
  let A' := LocalizationAtOrigin A σ
  have : IsHenselization A' (ResidueField A') B := h
  have : IsNoetherianRing B := isNoetherianRing_of_isHenselization (A := A') (ResidueField A')
  let M := Algebra.algebraMapSubmonoid B 𝔭.primeCompl
  have : IsNoetherianRing B' := IsLocalization.isNoetherianRing M B' inferInstance
  refine ⟨fun P' _ => ?_⟩
  let P := P'.comap (algebraMap B B')
  let 𝔮 := P.comap (algebraMap A B)
  have h𝔮 : 𝔮 ≤ 𝔭 := by
    intro a ha
    by_contra hna
    have hM : algebraMap A B a ∈ M := ⟨a, hna, rfl⟩
    have hu : IsUnit (algebraMap B B' (algebraMap A B a)) := IsLocalization.map_units B' ⟨_, hM⟩
    exact (Ideal.IsPrime.ne_top ‹P'.IsPrime›) (Ideal.eq_top_of_isUnit_mem _ ha hu)
  have : IsRegularLocalRing (Localization.AtPrime 𝔮) :=
    isRegularLocalRing_localization_of_le h𝔮
  have : IsRegularLocalRing (Localization.AtPrime P) := h.isRegularLocalRing_localization_atPrime P
  have : IsLocalization.AtPrime (Localization.AtPrime P') P :=
    IsLocalization.isLocalization_isLocalization_atPrime_isLocalization M
      (Localization.AtPrime P') P'
  exact IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime P)
    (IsLocalization.algEquiv P.primeCompl (Localization.AtPrime P)
      (Localization.AtPrime P')).toRingEquiv

/-- **Localizing the henselian line at a regular prime.** Let `A` be a Noetherian local ring,
`A{T}` the Henselization of the polynomial ring `A[T]` at the origin for finitely many
indeterminates `T` (for instance `A{t}`), and `𝔭` a prime of `A` such that `A_𝔭` is regular. Then
`A{T} ⊗_A A_𝔭` is a regular ring. -/
@[weil "lem_fk107_henselian_line_regular_localization"]
theorem isRegularRing_tensorProduct_localization (h : IsHenselianPolynomialRing A σ B)
    (𝔭 : Ideal A) [𝔭.IsPrime] [IsRegularLocalRing (Localization.AtPrime 𝔭)] :
    IsRegularRing (TensorProduct A B (Localization.AtPrime 𝔭)) :=
  h.isRegularRing_of_isLocalization 𝔭 _

end IsHenselianPolynomialRing

end MvPolynomial
