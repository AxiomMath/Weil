module

public import Weil.Attr
public import Weil.AlgebraicGeometry.Sites.EtaleSheaf
public import Weil.Defs.AlgebraicGeometry.Sites.EtalePresheafFk101
public import Mathlib.CategoryTheory.Sites.ConcreteSheafification
public import Mathlib.Algebra.Category.Grp.FilteredColimits

/-!
# The sheaf generated by a presheaf on `Et(A)` is a sheaf

Let `A` be a commutative ring and `F` a presheaf on the étale category `Et(A)`. The sheaf
generated by `F` is `F̂ = F̃̃`, the plus construction applied twice, together with the map
`η = ι_{F̃} ∘ ι_F : F → F̂`. Since the plus construction of any presheaf is separated, and the
plus construction of a separated presheaf is a sheaf, `F̂` is a sheaf for the étale topology.

## Main results

- `AlgebraicGeometry.EtaleCategory.isSheaf_sheafify`: for a presheaf `F` on `Et(A)` with values
  in a concrete category in which the plus construction can be formed (sets, abelian groups),
  the sheafification `F̂` is a sheaf for the étale topology `Scheme.AffineEtale.topology (Spec A)`.
- `AlgebraicGeometry.EtaleCategory.isSheaf_sheafify_type`,
  `AlgebraicGeometry.EtaleCategory.isSheaf_sheafify_addCommGrp`: the cases of presheaves of sets
  and of abelian groups.
- `AlgebraicGeometry.EtaleCategory.isSheafAxioms_sheafify_type`: for a presheaf of sets, `F̂`
  satisfies the sheaf axioms (a) and (b) of `AlgebraicGeometry.EtaleCategory.IsSheafAxioms`.

## Implementation notes

The sheaf generated by `F` is Mathlib's `CategoryTheory.GrothendieckTopology.sheafify`, which is
`plusObj (plusObj F)` with unit `toSheafify F = toPlus F ≫ plusMap (toPlus F)`, i.e. `ι_{F̃} ∘ ι_F`.
There the plus construction is the colimit over covering sieves; the result is Mathlib's
`CategoryTheory.GrothendieckTopology.sheafify_isSheaf`, proved as in the source, from
`CategoryTheory.GrothendieckTopology.Plus.sep` and
`CategoryTheory.GrothendieckTopology.Plus.isSheaf_of_sep`. Every object of `Et(A)` lives in
`Type (u + 1)` for `A : CommRingCat.{u}`, so the colimits over covering sieves exist for values
in `Type (max (u + 1) w)` and `AddCommGrpCat.{max (u + 1) w}`.

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FreitagKiehl1988], I.1
-/

@[expose] public section

universe t w' w u

open CategoryTheory Limits

namespace AlgebraicGeometry

namespace EtaleCategory

variable {A : CommRingCat.{u}}

section General

variable {D : Type w} [Category.{w'} D]
  {FD : D → D → Type*} {CD : D → Type t} [∀ X Y, FunLike (FD X Y) (CD X) (CD Y)]
  [instCC : ConcreteCategory.{t} D FD]
  [∀ {X : Scheme.AffineEtale (Spec A)} (S : (Scheme.AffineEtale.topology (Spec A)).Cover X),
    PreservesLimitsOfShape (WalkingMulticospan S.shape) (forget D)]
  [∀ (P : Presheaf A D) (X : Scheme.AffineEtale (Spec A))
    (S : (Scheme.AffineEtale.topology (Spec A)).Cover X), HasMultiequalizer (S.index P)]
  [∀ X : Scheme.AffineEtale (Spec A),
    HasColimitsOfShape ((Scheme.AffineEtale.topology (Spec A)).Cover X)ᵒᵖ D]
  [∀ X : Scheme.AffineEtale (Spec A),
    PreservesColimitsOfShape ((Scheme.AffineEtale.topology (Spec A)).Cover X)ᵒᵖ (forget D)]
  [(forget D).ReflectsIsomorphisms]

include instCC in
/-- **The sheaf generated by a presheaf is a sheaf.** For every presheaf `F` on `Et(A)`, the
sheaf `F̂ = F̃̃` generated by `F` is a sheaf for the étale topology. -/
@[weil "lem_fk101_sheafification_is_sheaf"]
theorem isSheaf_sheafify (F : Presheaf A D) :
    CategoryTheory.Presheaf.IsSheaf (Scheme.AffineEtale.topology (Spec A))
      ((Scheme.AffineEtale.topology (Spec A)).sheafify F) :=
  GrothendieckTopology.sheafify_isSheaf _ F

end General

/-- The sheaf generated by a presheaf of sets on `Et(A)` is a sheaf. -/
@[weil "lem_fk101_sheafification_is_sheaf"]
theorem isSheaf_sheafify_type (F : Presheaf A (Type (max (u + 1) w))) :
    CategoryTheory.Presheaf.IsSheaf (Scheme.AffineEtale.topology (Spec A))
      ((Scheme.AffineEtale.topology (Spec A)).sheafify F) :=
  isSheaf_sheafify F

/-- The sheaf generated by a presheaf of abelian groups on `Et(A)` is a sheaf. -/
@[weil "lem_fk101_sheafification_is_sheaf"]
theorem isSheaf_sheafify_addCommGrp (F : Presheaf A AddCommGrpCat.{max (u + 1) w}) :
    CategoryTheory.Presheaf.IsSheaf (Scheme.AffineEtale.topology (Spec A))
      ((Scheme.AffineEtale.topology (Spec A)).sheafify F) :=
  have : PreservesFilteredColimitsOfSize.{u + 1, u + 1} (forget AddCommGrpCat.{max (u + 1) w}) :=
    preservesFilteredColimitsOfSize_shrink.{u + 1, w, u + 1, w} _
  isSheaf_sheafify F

/-- The sheaf generated by a presheaf of sets on `Et(A)` satisfies the sheaf axioms. -/
@[weil "lem_fk101_sheafification_is_sheaf"]
theorem isSheafAxioms_sheafify_type (F : Presheaf A (Type (max (u + 1) w))) :
    IsSheafAxioms ((Scheme.AffineEtale.topology (Spec A)).sheafify F) :=
  (isSheaf_iff_isSheafAxioms _).1 (isSheaf_sheafify_type F)

end EtaleCategory

end AlgebraicGeometry
