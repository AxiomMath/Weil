module

public import Weil.Attr
public import Weil.CategoryTheory.Sites.SheafificationIsSheaf
public import Mathlib.CategoryTheory.Abelian.FunctorCategory
public import Mathlib.CategoryTheory.Sites.Sheaf

/-!
# The cokernel of a morphism of abelian sheaves is the sheafified presheaf cokernel

Let `α : F ⟶ G` be a morphism of sheaves of abelian groups on a site `(C, J)`, let `Q` be the
cokernel of `α` computed in presheaves (objectwise), with projection `π : G ⟶ Q`, and let
`η_Q : Q ⟶ Q̂` be the canonical map to the sheaf generated by `Q` (the plus construction applied
twice). Then `η_Q ∘ π : G ⟶ Q̂` is a cokernel of `α` in the category of sheaves of abelian groups.

The proof is the universal property: `Q̂` is a sheaf and `η_Q π α = 0`; a morphism `γ : G ⟶ H`
to a sheaf with `γ α = 0` factors uniquely through `π` (the cokernel in presheaves) and then
uniquely through `η_Q` (the universal property of sheafification).

## Main definitions

- `CategoryTheory.GrothendieckTopology.sheafifyCokernelπ α`: the morphism of sheaves
  `η_Q ∘ π : G ⟶ Q̂`.
- `CategoryTheory.GrothendieckTopology.isColimitSheafifyCokernelCofork α`: it is a cokernel of
  `α` in sheaves of abelian groups.
- `AlgebraicGeometry.EtaleCategory.isColimitSheafifyCokernelCofork α`: the case of the étale
  category `Et(A)` of a commutative ring `A`.

## Implementation notes

The sheaf generated by `Q` is Mathlib's concrete sheafification
`CategoryTheory.GrothendieckTopology.sheafify`, i.e. `plusObj (plusObj Q)` with unit
`toSheafify Q = ι_{Q̃} ∘ ι_Q`, rather than the abstract left adjoint `presheafToSheaf`; the
latter form of the statement is `Stacks.AbelianSheaves.cokernelSheafifyIso`. The presheaf
cokernel is the cokernel in the functor category `Cᵒᵖ ⥤ AddCommGrpCat`, which is computed
objectwise (`CategoryTheory.Abelian.functorCategoryAbelian`).

## References

* [E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*][FreitagKiehl1988], I.1
-/

@[expose] public noncomputable section

universe w v u

open CategoryTheory Limits

namespace CategoryTheory.GrothendieckTopology

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  [∀ {X : C} (S : J.Cover X),
    PreservesLimitsOfShape (WalkingMulticospan S.shape) (forget AddCommGrpCat.{w})]
  [∀ (P : Cᵒᵖ ⥤ AddCommGrpCat.{w}) (X : C) (S : J.Cover X), HasMultiequalizer (S.index P)]
  [∀ X : C, HasColimitsOfShape (J.Cover X)ᵒᵖ AddCommGrpCat.{w}]
  [∀ X : C, PreservesColimitsOfShape (J.Cover X)ᵒᵖ (forget AddCommGrpCat.{w})]
  {F G : Sheaf J AddCommGrpCat.{w}} (α : F ⟶ G)

/-- The sheaf `Q̂` generated by the presheaf cokernel `Q` of a morphism `α` of abelian sheaves. -/
abbrev sheafifyCokernel : Sheaf J AddCommGrpCat.{w} :=
  ⟨J.sheafify (cokernel α.hom), J.sheafify_isSheaf _⟩

/-- The morphism of sheaves `η_Q ∘ π : G ⟶ Q̂`, where `π : G ⟶ Q` is the projection onto the
presheaf cokernel `Q` of `α` and `η_Q : Q ⟶ Q̂` is the canonical map to the sheaf generated
by `Q`. -/
def sheafifyCokernelπ : G ⟶ J.sheafifyCokernel α :=
  ObjectProperty.homMk (cokernel.π α.hom ≫ J.toSheafify (cokernel α.hom))

@[simp]
lemma sheafifyCokernelπ_hom :
    (J.sheafifyCokernelπ α).hom = cokernel.π α.hom ≫ J.toSheafify (cokernel α.hom) := rfl

@[reassoc (attr := simp)]
lemma comp_sheafifyCokernelπ : α ≫ J.sheafifyCokernelπ α = 0 := by
  ext1
  rw [ObjectProperty.FullSubcategory.comp_hom, sheafifyCokernelπ_hom, cokernel.condition_assoc,
    zero_comp]
  rfl

/-- **The cokernel of a morphism of abelian sheaves is the sheafified presheaf cokernel.**
For a morphism `α : F ⟶ G` of sheaves of abelian groups with presheaf cokernel
`π : G ⟶ Q`, the morphism `η_Q ∘ π : G ⟶ Q̂` is a cokernel of `α` in the category of sheaves
of abelian groups. -/
def isColimitSheafifyCokernelCofork :
    IsColimit (CokernelCofork.ofπ (J.sheafifyCokernelπ α) (J.comp_sheafifyCokernelπ α)) :=
  CokernelCofork.IsColimit.ofπ _ _
    (fun {H} γ hγ => ObjectProperty.homMk
      (J.sheafifyLift (cokernel.desc α.hom γ.hom (by
        rw [← ObjectProperty.FullSubcategory.comp_hom, hγ]; rfl)) H.property))
    (fun {H} γ hγ => by
      ext1
      simp)
    (fun {H} γ hγ m hm => by
      ext1
      refine J.sheafifyLift_unique _ H.property _ ?_
      refine coequalizer.hom_ext ?_
      rw [cokernel.π_desc, ← Category.assoc, ← sheafifyCokernelπ_hom, ← hm]
      rfl)

end CategoryTheory.GrothendieckTopology

namespace AlgebraicGeometry.EtaleCategory

/-- The forgetful functor of `AddCommGrpCat.{max (u + 1) w}` preserves filtered colimits indexed
by categories in `Type (u + 1)`, such as the covering sieves of an object of `Et(A)`. -/
scoped instance preservesFilteredColimitsOfSize_forget_addCommGrpCat_succ :
    PreservesFilteredColimitsOfSize.{u + 1, u + 1} (forget AddCommGrpCat.{max (u + 1) w}) :=
  preservesFilteredColimitsOfSize_shrink.{u + 1, w, u + 1, w} _

variable {A : CommRingCat.{u}}
  {F G : Sheaf (Scheme.AffineEtale.topology (Spec A)) AddCommGrpCat.{max (u + 1) w}} (α : F ⟶ G)

/-- **The cokernel of a morphism of abelian sheaves on `Et(A)` is the sheafified presheaf
cokernel.** For a morphism `α : F ⟶ G` of sheaves of abelian groups on `Et(A)`, with objectwise
cokernel `π : G ⟶ Q`, the morphism `η_Q ∘ π : G ⟶ Q̂` to the sheaf generated by `Q` is a
cokernel of `α` in the category of sheaves of abelian groups. -/
@[weil "lem_fk101_sheaf_cokernel_sheafified"]
def isColimitSheafifyCokernelCofork :
    IsColimit (CokernelCofork.ofπ
      ((Scheme.AffineEtale.topology (Spec A)).sheafifyCokernelπ α)
      ((Scheme.AffineEtale.topology (Spec A)).comp_sheafifyCokernelπ α)) :=
  GrothendieckTopology.isColimitSheafifyCokernelCofork _ α

end AlgebraicGeometry.EtaleCategory
