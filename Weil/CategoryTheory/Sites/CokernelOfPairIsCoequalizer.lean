module

public import Weil.Attr
public import Weil.CategoryTheory.Sites.CokernelEquivalenceRelationEffective
public import Mathlib.CategoryTheory.Sites.Sheafification

/-!
# The cokernel of a pair of morphisms of sheaves of sets is a coequalizer

Let `u v : F ⟶ G` be morphisms of sheaves of types on a site `(C, J)`. The sectionwise quotient
presheaf `Q : U ↦ G(U) / ~`, where `~` is the equivalence relation generated by the pairs
`(u_U r, v_U r)`, receives a projection `G ⟶ Q`; its sheafification `Q̂` together with the
composite `c : G ⟶ Q ⟶ Q̂` is the cokernel of the pair `(u, v)`. We show that `c ∘ u = c ∘ v`
and that `c` is a coequalizer of `u` and `v` in the category of sheaves: every morphism of
sheaves `g : G ⟶ T` with `g ∘ u = g ∘ v` factors uniquely as `h ∘ c`.

The proof first factors `g` uniquely through the sectionwise quotient `G ⟶ Q` (each `g_U` is
constant on the classes of `~`), then through `Q ⟶ Q̂` by the universal property of
sheafification.

## Main definitions

* `CategoryTheory.Sheaf.pairCokernel`: the sheafification of the sectionwise quotient presheaf.
* `CategoryTheory.Sheaf.pairCokernelπ`: the morphism `c : G ⟶ pairCokernel u v`.
* `CategoryTheory.Sheaf.pairCokernelCofork`: the cofork of `u` and `v` given by `c`.
* `CategoryTheory.Sheaf.isColimitPairCokernelCofork`: this cofork is a colimit cofork.
* `CategoryTheory.Sheaf.pairCokernelIsoCoequalizer`: the comparison with the chosen
  coequalizer of the category of sheaves.

## Main results

* `CategoryTheory.Sheaf.pairCokernelπ_isCoequalizer`: `c ∘ u = c ∘ v`, and every `g` with
  `g ∘ u = g ∘ v` factors uniquely through `c`.

## Implementation notes

The statement is proved for an arbitrary site with a sheafification functor for type-valued
presheaves; Freitag–Kiehl state it for the étale site of a scheme, which is a special case.
The sectionwise quotient is `Quot` of the relation `(s, t) ↦ ∃ r, u_U r = s ∧ v_U r = t`,
which is the quotient by the equivalence relation it generates.

## References

* [FK] E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, Chapter I, §4.
-/

@[expose] public section

universe w v u

namespace CategoryTheory

open Limits Opposite

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}

namespace Sheaf

variable {F G : Sheaf J (Type w)} (u v : F ⟶ G)

/-- A morphism of presheaves out of `G` that coequalizes `u` and `v` factors through the
sectionwise quotient presheaf. -/
def pairQuotientPresheafDesc {T : Cᵒᵖ ⥤ Type w} (g : G.obj ⟶ T)
    (hg : u.hom ≫ g = v.hom ≫ g) : pairQuotientPresheaf u v ⟶ T where
  app U := TypeCat.ofHom (Quot.lift (g.app U) (by
    rintro _ _ ⟨r, rfl, rfl⟩
    exact congrArg (fun φ : F.obj ⟶ T => φ.app U r) hg))
  naturality U V f := by
    ext x
    induction x using Quot.ind
    exact NatTrans.naturality_apply g f _

@[reassoc (attr := simp)]
lemma toPairQuotientPresheaf_desc {T : Cᵒᵖ ⥤ Type w} (g : G.obj ⟶ T)
    (hg : u.hom ≫ g = v.hom ≫ g) :
    toPairQuotientPresheaf u v ≫ pairQuotientPresheafDesc u v g hg = g := by
  ext U x
  rfl

lemma pairQuotientPresheaf_hom_ext {T : Cᵒᵖ ⥤ Type w} {a b : pairQuotientPresheaf u v ⟶ T}
    (h : toPairQuotientPresheaf u v ≫ a = toPairQuotientPresheaf u v ≫ b) : a = b := by
  ext U x
  induction x using Quot.ind with | mk s => ?_
  exact congrArg (fun φ : G.obj ⟶ T => φ.app U s) h

variable [HasWeakSheafify J (Type w)]

/-- The cokernel of a pair of morphisms of sheaves of types: the sheafification of the
sectionwise quotient presheaf `U ↦ G(U) / ~`. -/
noncomputable def pairCokernel : Sheaf J (Type w) :=
  (presheafToSheaf J (Type w)).obj (pairQuotientPresheaf u v)

/-- The morphism `c : G ⟶ pairCokernel u v`, the projection to the sectionwise quotient followed
by the unit of sheafification. -/
noncomputable def pairCokernelπ : G ⟶ pairCokernel u v :=
  ObjectProperty.homMk (toPairQuotientPresheaf u v ≫ toSheafify J (pairQuotientPresheaf u v))

lemma pairCokernelπ_hom :
    (pairCokernelπ u v).hom =
      toPairQuotientPresheaf u v ≫ toSheafify J (pairQuotientPresheaf u v) :=
  rfl

@[reassoc]
lemma pairCokernelπ_condition : u ≫ pairCokernelπ u v = v ≫ pairCokernelπ u v := by
  apply Sheaf.hom_ext
  change u.hom ≫ toPairQuotientPresheaf u v ≫ toSheafify J _ =
    v.hom ≫ toPairQuotientPresheaf u v ≫ toSheafify J _
  rw [← Category.assoc, condition_toPairQuotientPresheaf, Category.assoc]

/-- The cofork of `u` and `v` with point `pairCokernel u v` and projection `pairCokernelπ u v`. -/
noncomputable def pairCokernelCofork : Cofork u v :=
  Cofork.ofπ (pairCokernelπ u v) (pairCokernelπ_condition u v)

/-- The factorization of a morphism `g : G ⟶ T` with `u ≫ g = v ≫ g` through `pairCokernelπ`. -/
noncomputable def pairCokernelDesc {T : Sheaf J (Type w)} (g : G ⟶ T) (hg : u ≫ g = v ≫ g) :
    pairCokernel u v ⟶ T :=
  ObjectProperty.homMk (sheafifyLift J (pairQuotientPresheafDesc u v g.hom
    (congrArg (fun φ : F ⟶ T => φ.hom) hg)) T.property)

@[reassoc (attr := simp)]
lemma pairCokernelπ_desc {T : Sheaf J (Type w)} (g : G ⟶ T) (hg : u ≫ g = v ≫ g) :
    pairCokernelπ u v ≫ pairCokernelDesc u v g hg = g := by
  apply Sheaf.hom_ext
  change (toPairQuotientPresheaf u v ≫ toSheafify J _) ≫ sheafifyLift J _ T.property = g.hom
  rw [Category.assoc, toSheafify_sheafifyLift, toPairQuotientPresheaf_desc]

lemma pairCokernel_hom_ext {T : Sheaf J (Type w)} {a b : pairCokernel u v ⟶ T}
    (h : pairCokernelπ u v ≫ a = pairCokernelπ u v ≫ b) : a = b := by
  apply Sheaf.hom_ext
  refine sheafify_hom_ext J _ _ T.property (pairQuotientPresheaf_hom_ext u v ?_)
  have := congrArg (fun φ : G ⟶ T => φ.hom) h
  exact this

/-- The cokernel of a pair is a coequalizer in the category of sheaves of types. -/
noncomputable def isColimitPairCokernelCofork : IsColimit (pairCokernelCofork u v) :=
  Cofork.IsColimit.mk _ (fun s => pairCokernelDesc u v s.π s.condition)
    (fun s => pairCokernelπ_desc u v s.π s.condition)
    (fun s m hm => pairCokernel_hom_ext u v (by
      rw [pairCokernelπ_desc]
      exact hm))

/-- **The cokernel of a pair of morphisms of sheaves of sets is a coequalizer**
(Freitag–Kiehl I.4): for `u v : F ⟶ G`, the morphism `c : G ⟶ pairCokernel u v` satisfies
`u ≫ c = v ≫ c`, and every morphism of sheaves `g : G ⟶ T` with `u ≫ g = v ≫ g` factors as
`c ≫ h` for a unique `h : pairCokernel u v ⟶ T`. -/
@[weil "lem_fk104_cokernel_of_pair_is_coequalizer"]
theorem pairCokernelπ_isCoequalizer :
    u ≫ pairCokernelπ u v = v ≫ pairCokernelπ u v ∧
      ∀ (T : Sheaf J (Type w)) (g : G ⟶ T), u ≫ g = v ≫ g →
        ∃! h : pairCokernel u v ⟶ T, pairCokernelπ u v ≫ h = g :=
  ⟨pairCokernelπ_condition u v, fun _ g hg =>
    ⟨pairCokernelDesc u v g hg, pairCokernelπ_desc u v g hg,
      fun _ hh => pairCokernel_hom_ext u v (by rw [hh, pairCokernelπ_desc])⟩⟩

/-- The cokernel of a pair is isomorphic to the chosen coequalizer of the category of sheaves,
compatibly with the projections. -/
noncomputable def pairCokernelIsoCoequalizer [HasCoequalizer u v] :
    pairCokernel u v ≅ coequalizer u v :=
  (isColimitPairCokernelCofork u v).coconePointUniqueUpToIso (colimit.isColimit _)

@[reassoc (attr := simp)]
lemma pairCokernelπ_pairCokernelIsoCoequalizer_hom [HasCoequalizer u v] :
    pairCokernelπ u v ≫ (pairCokernelIsoCoequalizer u v).hom = coequalizer.π u v :=
  (isColimitPairCokernelCofork u v).comp_coconePointUniqueUpToIso_hom
    (colimit.isColimit _) WalkingParallelPair.one

end Sheaf

end CategoryTheory
