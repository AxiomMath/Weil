module

public import Weil.Attr
public import Mathlib.Algebra.Category.Grp.Abelian
public import Mathlib.Algebra.Category.Grp.FilteredColimits
public import Mathlib.CategoryTheory.Abelian.FunctorCategory
public import Mathlib.Algebra.Homology.ShortComplex.Ab
public import Mathlib.CategoryTheory.Sites.LeftExact
public import StacksFrontier.AlgebraicGeometry.Topologies.SmallEtaleAbelian

/-!
# Sheafification of abelian presheaves is left exact

Let `0 → K → F → G` be a sequence of presheaves of abelian groups on a site which is exact at
every object. Then the sheafified sequence `0 → K̂ → F̂ → Ĝ` is again exact at every object
[FK, I.2]. Here `F̂` is either the sheaf generated by `F` through the plus construction applied
twice, `J.sheafify F = J⁺(J⁺ F)`, or Mathlib's sheafification `sheafify J F` (the presheaf
underlying the left adjoint of the inclusion of sheaves), which exists for every site with
`HasSheafify`, in particular for the small étale site of a scheme.

## Main results

* `CategoryTheory.Functor.injective_app_map_and_exact_app_map`: a finite-limit preserving functor
  between categories of abelian presheaves preserves objectwise left exact sequences.
* `CategoryTheory.GrothendieckTopology.injective_app_sheafifyMap_and_exact_app_sheafifyMap`:
  the plus-plus sheafification `J.sheafify` preserves objectwise left exact sequences.
* `CategoryTheory.injective_app_sheafifyMap_and_exact_app_sheafifyMap`: the same for the
  sheafification `sheafify J` of any site with `HasSheafify J AddCommGrpCat`.
* `AlgebraicGeometry.SmallEtale.injective_app_sheafifyMap_and_exact_app_sheafifyMap`: the case
  of abelian presheaves on the small étale site `SmallEtale B S hS` of a scheme.

## Implementation notes

The proof is categorical rather than the element-wise argument of [FK]: an objectwise left
exact sequence `0 → K → F → G` exhibits `K` as the kernel of `F → G` in the presheaf category
(limits in functor categories are computed objectwise), sheafification preserves finite limits
(`CategoryTheory.GrothendieckTopology.preservesFiniteLimits_sheafification`,
`CategoryTheory.HasSheafify.isLeftExact`), and so does the forgetful functor from sheaves to
presheaves followed by evaluation at an object. This is the content of [FK]'s argument: the
groups of matching families on a covering sieve are cut out of products by equations, and the
colimit over the directed set of covering sieves is exact.

## References

* [FK] E. Freitag, R. Kiehl, *Étale Cohomology and the Weil Conjecture*, I.2.
-/

@[expose] public section

universe w w' v u u'

open CategoryTheory Limits

namespace CategoryTheory

namespace Functor

variable {C : Type u} [Category.{v} C] {E : Type u'} [Category.{w'} E]

/-- A functor between categories of abelian presheaves which preserves finite limits sends a
sequence `0 → K → F → G` which is exact at every object to a sequence which is exact at every
object. -/
theorem injective_app_map_and_exact_app_map
    (Φ : (C ⥤ AddCommGrpCat.{w}) ⥤ (E ⥤ AddCommGrpCat.{w})) [PreservesFiniteLimits Φ]
    {K F G : C ⥤ AddCommGrpCat.{w}} (f : K ⟶ F) (g : F ⟶ G)
    (hf : ∀ U, Function.Injective (f.app U)) (hfg : ∀ U, Function.Exact (f.app U) (g.app U))
    (U : E) :
    Function.Injective ((Φ.map f).app U) ∧
      Function.Exact ((Φ.map f).app U) ((Φ.map g).app U) := by
  have w : f ≫ g = 0 := by
    ext U x
    exact (hfg U).apply_apply_eq_zero x
  let S : ShortComplex (C ⥤ AddCommGrpCat.{w}) := ShortComplex.mk f g w
  have hSU : ∀ U, (S.map ((evaluation _ _).obj U)).Exact := fun U =>
    (ShortComplex.ab_exact_iff_function_exact _).2 (hfg U)
  have hmono : ∀ U, Mono (S.map ((evaluation _ _).obj U)).f := fun U =>
    (AddCommGrpCat.mono_iff_injective _).2 (hf U)
  have hlim : IsLimit (KernelFork.ofι S.f S.zero) :=
    evaluationJointlyReflectsLimits _ fun U =>
      (KernelFork.isLimitMapConeEquiv _ _).symm (hSU U).fIsKernel
  have hS : S.Exact := ShortComplex.exact_of_f_is_kernel S hlim
  have : Mono S.f := @NatTrans.mono_of_mono_app _ _ _ _ _ _ _ hmono
  let Ψ : (C ⥤ AddCommGrpCat.{w}) ⥤ AddCommGrpCat.{w} := Φ ⋙ (evaluation _ _).obj U
  have hΨ : (S.map Ψ).Exact :=
    hS.map_of_mono_of_preservesKernel Ψ inferInstance inferInstance
  refine ⟨(AddCommGrpCat.mono_iff_injective _).1 (Ψ.map_mono S.f), ?_⟩
  exact (ShortComplex.ab_exact_iff_function_exact _).1 hΨ

end Functor

namespace GrothendieckTopology

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)

/-- **Sheafification is left exact** [FK, I.2]: if `0 → K → F → G` is a sequence of presheaves
of abelian groups which is exact at every object, then so is the sequence
`0 → J⁺⁺K → J⁺⁺F → J⁺⁺G` of the sheaves generated by them through the plus construction applied
twice. -/
@[weil "lem_fk102_sheafification_left_exact"]
theorem injective_app_sheafifyMap_and_exact_app_sheafifyMap
    {K F G : Cᵒᵖ ⥤ AddCommGrpCat.{max u v}} (f : K ⟶ F) (g : F ⟶ G)
    (hf : ∀ U, Function.Injective (f.app U)) (hfg : ∀ U, Function.Exact (f.app U) (g.app U))
    (U : Cᵒᵖ) :
    Function.Injective ((J.sheafifyMap f).app U) ∧
      Function.Exact ((J.sheafifyMap f).app U) ((J.sheafifyMap g).app U) :=
  (J.sheafification AddCommGrpCat.{max u v}).injective_app_map_and_exact_app_map f g hf hfg U

end GrothendieckTopology

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  [HasSheafify J AddCommGrpCat.{w}]

/-- **Sheafification is left exact** [FK, I.2], for the sheafification `sheafify J` of any site
admitting one (e.g. the small étale site of a scheme): if `0 → K → F → G` is a sequence of
presheaves of abelian groups which is exact at every object, then so is the sheafified
sequence `0 → K̂ → F̂ → Ĝ`. -/
@[weil "lem_fk102_sheafification_left_exact"]
theorem injective_app_sheafifyMap_and_exact_app_sheafifyMap
    {K F G : Cᵒᵖ ⥤ AddCommGrpCat.{w}} (f : K ⟶ F) (g : F ⟶ G)
    (hf : ∀ U, Function.Injective (f.app U)) (hfg : ∀ U, Function.Exact (f.app U) (g.app U))
    (U : Cᵒᵖ) :
    Function.Injective ((sheafifyMap J f).app U) ∧
      Function.Exact ((sheafifyMap J f).app U) ((sheafifyMap J g).app U) :=
  have := comp_preservesFiniteLimits (presheafToSheaf J AddCommGrpCat.{w})
    (sheafToPresheaf J AddCommGrpCat.{w})
  (presheafToSheaf J AddCommGrpCat.{w} ⋙ sheafToPresheaf J _).injective_app_map_and_exact_app_map
    f g hf hfg U

end CategoryTheory

namespace AlgebraicGeometry.SmallEtale

variable (B : BigEtaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- **Sheafification on the small étale site is left exact** [FK, I.2]: if `0 → K → F → G` is a
sequence of presheaves of abelian groups on the small étale site of `S` which is exact at every
object, then so is the sheafified sequence `0 → K̂ → F̂ → Ĝ`. -/
@[weil "lem_fk102_sheafification_left_exact"]
theorem injective_app_sheafifyMap_and_exact_app_sheafifyMap
    {K F G : (SmallEtale B S hS)ᵒᵖ ⥤ AddCommGrpCat.{u}} (f : K ⟶ F) (g : F ⟶ G)
    (hf : ∀ U, Function.Injective (f.app U)) (hfg : ∀ U, Function.Exact (f.app U) (g.app U))
    (U : (SmallEtale B S hS)ᵒᵖ) :
    Function.Injective ((sheafifyMap (topology B S hS) f).app U) ∧
      Function.Exact ((sheafifyMap (topology B S hS) f).app U)
        ((sheafifyMap (topology B S hS) g).app U) :=
  CategoryTheory.injective_app_sheafifyMap_and_exact_app_sheafifyMap _ f g hf hfg U

end AlgebraicGeometry.SmallEtale
